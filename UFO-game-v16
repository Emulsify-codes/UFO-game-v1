        self.inv = 0.8
        mut_float(self, self.px, GROUND - 70, "WARD", 0.9)
        self.rings.append([self.px, GROUND, 90, 0.4, 0.4, "#64d2ff"])
        return
    if mut_has(self, "phoenix") and self.hp - dmg <= 0 \
            and not getattr(self, "mut_rebirth", False):
        self.mut_rebirth = True
        self.hp = max(1, self.max_hp // 2)
        self.inv = 2.0
        self.shake = 0.4

def _pick_save_file():
    """Prefer the folder next to this script; fall back to ~/.ufo_shooter/ when
    that folder is read-only (zip, protected directory, installed location...)."""
    name = "ufo_leaderboard.json"
    here = os.path.dirname(os.path.abspath(__file__))
    folders = [here, os.path.join(os.path.expanduser("~"), ".ufo_shooter")]
    for d in folders:                      # keep using an existing save file
        path = os.path.join(d, name)
        if os.path.isfile(path) and os.access(path, os.W_OK):
            return path
    for d in folders:                      # otherwise the first writable folder
        try:
            os.makedirs(d, exist_ok=True)
        except OSError:
            continue
        if os.access(d, os.W_OK):
            return os.path.join(d, name)
    return os.path.join(here, name)



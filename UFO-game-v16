class Sound:
    """Plays the generated effects. Backends, best first:
         pygame.mixer  - mixes many sounds at once (pip install pygame)
         winsound      - Windows built-in, one sound at a time
         afplay / paplay / pw-play / aplay / play - the OS's own command
       If nothing works the game simply stays silent."""

    def __init__(self, enabled=True, volume=1.0):
        self.enabled = enabled
        self.volume = max(0.0, min(1.0, volume))
        self.base_wavs = {}
        self._volume_ready = False
        self.backend = None          # "pygame" | "winsound" | "cmd" | None
        self.ready = False
        self.clips = {}              # name -> pygame Sound or wav file path
        self.length = {}             # name -> seconds
        self.last = {}               # name -> time it last played
        self.busy_until = 0.0        # winsound only
        self.busy_prio = 0
        self.procs = []              # running command-line players
        self.voices = []             # (ends at, name, priority, handle)
        self.max_voices = 8          # sounds allowed at the same time
        self.cmd = None
        self.tmp = None              # temp folder holding the wav files
        self.pg = None
        self.ws = None
        if enabled:
            self.start()

    def start(self):
        if self.ready:
            return
        self.ready = True
        try:
            samples = build_sounds()
            self.length = {n: len(s) / SR for n, s in samples.items()}
            wavs = {n: _wav_bytes(s) for n, s in samples.items()}
            self.base_wavs = wavs
            if not self._try_pygame(wavs):
                if self._try_files(wavs):
                    self.set_volume(self.volume)
            else:
                self.set_volume(self.volume)
        except Exception:
            self.backend = None

    def set_volume(self, volume):
        volume = max(0.0, min(1.0, float(volume)))
        if volume == self.volume and self._volume_ready:
            return
        if self.backend == "pygame":
            for clip in self.clips.values():
                clip.set_volume(volume)
            for _, _, priority, channel in self.voices:
                if channel is not None:
                    channel.set_volume(self._gain(priority))
        elif self.backend in ("winsound", "cmd") and self.tmp:
            if self.backend == "winsound":
                self.ws.PlaySound(None, 0)
            updated = {}
            percent = round(volume * 100)
            for name, raw in self.base_wavs.items():
                path = os.path.join(self.tmp, f"{name}_{percent}.wav")
                if not os.path.exists(path):
                    with open(path, "wb") as f:
                        f.write(_scaled_wav_bytes(raw, volume))
                updated[name] = path
            self.clips.update(updated)
        self.volume = volume
        self._volume_ready = self.backend is not None

    def _try_pygame(self, wavs):
        try:
            os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
            import pygame
            pygame.mixer.pre_init(SR, -16, 1, 512)
            pygame.mixer.init()
            pygame.mixer.set_num_channels(16)
            self.clips = {n: pygame.mixer.Sound(file=io.BytesIO(b))
                          for n, b in wavs.items()}
            self.pg = pygame
            self.backend = "pygame"
            self.max_voices = 8
            return True
        except Exception:
            return False

    def _try_files(self, wavs):
        mode, cmd = None, None
        if sys.platform.startswith("win"):
            try:
                import winsound
                self.ws = winsound
                mode = "winsound"
            except ImportError:
                return False
        else:
            for c in (["afplay"], ["paplay"], ["pw-play"],
                      ["aplay", "-q"], ["play", "-q"]):
                if shutil.which(c[0]):
                    mode, cmd = "cmd", c
                    break
            if mode is None:
                return False
        try:
            self.tmp = tempfile.mkdtemp(prefix="ufo_sfx_")
            for n, b in wavs.items():
                path = os.path.join(self.tmp, n + ".wav")
                with open(path, "wb") as f:
                    f.write(b)
                self.clips[n] = path
        except OSError:
            return False
        atexit.register(self.close)
        self.backend, self.cmd = mode, cmd
        self.max_voices = 4          # every voice is a separate process here
        return True

    def toggle(self):
        self.enabled = not self.enabled
        if self.enabled:
            self.start()
        return self.enabled

    def play(self, name):
        if not (self.enabled and self.backend):
            return
        now = time.time()
        prio, gap, copies = SFX_META.get(name, (1, 0.0, 1))
        if now - self.last.get(name, 0.0) < gap:
            return                  # same sound again too soon: merge them
        try:
            if self.backend == "winsound":
                # only one sound can play at a time here
                if now < self.busy_until and prio < self.busy_prio:
                    return          # don't cut off a more important sound
                self.ws.PlaySound(self.clips[name],
                                  self.ws.SND_FILENAME | self.ws.SND_ASYNC)
                self.busy_until = now + self.length.get(name, 0.2)
                self.busy_prio = prio
            else:
                self.voices = [v for v in self.voices if v[0] > now]
                if sum(1 for v in self.voices if v[1] == name) >= copies:
                    return          # enough copies of this sound already
                if len(self.voices) >= self.max_voices:
                    low = min(self.voices, key=lambda v: (v[2], v[0]))
                    if low[2] >= prio:
                        return      # everything playing matters just as much
                    self._stop(low[3])
                    self.voices.remove(low)
                handle = self._start(name, prio)
                self.voices.append((now + self.length.get(name, 0.2),
                                    name, prio, handle))
            self.last[name] = now
        except Exception:
            self.backend = None     # audio is misbehaving: go silent

    def _gain(self, prio):
        """Volume for a new sound: quieter the more is already playing, and
        quieter still if something more important is sounding."""
        g = 1.0 / (1.0 + 0.2 * len(self.voices))
        if self.voices and prio < max(v[2] for v in self.voices):
            g *= 0.7
        return max(0.3, g)

    def _start(self, name, prio):
        if self.backend == "pygame":
            ch = self.clips[name].play()
            if ch is not None:
                ch.set_volume(self._gain(prio))
                if prio >= 4:       # a big sound pulls the small ones down
                    for v in self.voices:
                        if v[2] < 3 and v[3] is not None:
                            v[3].set_volume(0.3)
            return ch
        self.procs = [p for p in self.procs if p.poll() is None]
        p = subprocess.Popen(self.cmd + [self.clips[name]],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        self.procs.append(p)
        return p

    def _stop(self, handle):
        if handle is None:
            return
        try:
            if self.backend == "pygame":
                handle.fadeout(40)  # short fade, so no click
            else:
                handle.terminate()
        except Exception:
            pass

    def close(self):
        for p in self.procs:
            try:
                p.terminate()
            except Exception:
                pass
        self.procs = []
        self.voices = []
        try:
            if self.backend == "winsound":
                self.ws.PlaySound(None, self.ws.SND_PURGE)
            elif self.backend == "pygame":
                self.pg.mixer.quit()
        except Exception:
            pass
        self.backend = None
        if self.tmp:
            shutil.rmtree(self.tmp, ignore_errors=True)
            self.tmp = None



# ---- running a mission -----------------------------------------------------------
def ms_active(self):
    m = getattr(self, "mission", None)
    return m if m and not m.get("done") else None


def ms_deploy(self, i):
    p = MS_PLANETS[i]
    if not ms_unlocked(self, i):
        self.sfx("deny")
        return
    self.mission = dict(i=i, pid=p["id"], base=p["base"], waves=p["waves"],
                        integrity=100.0, pdmg=p["hit"], done=False, kills=0)
    self.mission_result = None
    self.start_game("normal", p["tier"])


Game.ms_deploy = ms_deploy


def ms_hp_mult(p):
    """Enemy health multiplier for a planet (replaces starting at a high wave)."""
    return 1.0 + 0.05 * (p["base"] - 1)


def ms_start_credits(p):
    return 60 + 20 * (p["base"] - 1)


def ms_build_queue(p, i):
    roster = p["roster"]
    n = len(p["roster"])
    unlocked = min(n, max(2, math.ceil(n * i / p["waves"]) + 1)) \
        if n > 1 else 1
    kinds = list(roster[:unlocked])
    weights = [max(1, 8 - 2 * k + i // 2) for k in range(len(kinds))]
    tier = ("easy", "normal", "hard", "nightmare").index(p["tier"])
    count = 6 + i * 2 + tier * 2
    q = random.choices(kinds, weights, k=count)
    mid = p.get("mid")
    if mid and i < p["waves"] and i % 5 == 0:
        q = [mid[(i // 5 - 1) % len(mid)]] + q[: max(4, count // 3)]
    if i == p["waves"]:
        if p["boss"]:
            q = [p["boss"]] + q[: max(4, count // 3)]
        else:
            q = q + random.choices(kinds, weights, k=4)
    return q


_ms_prev_start_wave = Game.start_wave


def ms_start_wave(self):
    m = ms_active(self)
    if not m:
        return _ms_prev_start_wave(self)
    p = MS_PLANETS[m["i"]]
    self._briefing_bypass = True            # no pre-wave pop-ups in missions
    if not m.get("prepped"):
        # Waves are numbered 1..N. Tougher planets scale enemy health and
        # start you with credits, and the armory opens before wave 1.
        m["prepped"] = True
        self.run_objectives = []
        self.wave = 0
        self.credits += ms_start_credits(p)
        self.shop_msg = (f"{p['name']}: spend your starting credits, "
                         "then press NEXT to begin.")
        self.state = "shop"
        self.cancel_weapons()
        return
    _ms_prev_start_wave(self)
    if self.state != "play":
        return
    i = self.wave
    self.queue = ms_build_queue(p, i)
    self.wave_total = max(1, len(self.queue))
    self.floaters.append([W / 2, 150, f"{p['name']}  ·  WAVE {i}/{p['waves']}",
                          2.0])



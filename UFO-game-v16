def stats_update(self, dt):
    active_run = self.state == "play"
    _stats_original_update(self, dt)
    if not active_run:
        return
    elapsed = getattr(self, "_stats_time_fraction", 0.0) + dt
    whole_seconds = int(elapsed)
    self._stats_time_fraction = elapsed - whole_seconds
    if whole_seconds:
        self.data["stats"]["time_played"] = (
            self.stat("time_played") + whole_seconds)
    save_elapsed = getattr(self, "_stats_save_elapsed", 0.0) + dt
    if save_elapsed >= 30:
        self._stats_save_elapsed = save_elapsed % 30
        self.save_ok = save_data(self.data)
    else:
        self._stats_save_elapsed = save_elapsed


def stats_draw_scene(self):
    if self.state != "stats":
        return _stats_original_draw_scene(self)
    c = self.c
    dead = [i for i in c.find_all() if i not in self.bg_ids]
    if dead:
        c.delete(*dead)
    self.draw_stars()
    self.draw_stats()
    self.draw_toasts()


def stats_draw_menu(self):
    _stats_original_draw_menu(self)
    self.home_button(self.menu_rects, (12, 50, 150, 82), "STATS",
                     "Lifetime record", "stats", "blue", 10)


def stats_click(self, e):
    x, y = self.c.to_game(e.x, e.y)
    if self.state == "menu" and self.hit(self.menu_rects, x, y) == "stats":
        self.mouse_x, self.mouse_y = x, y
        self.open_stats()
        return
    if self.state == "stats":
        self.mouse_x, self.mouse_y = x, y
        if self.hit(self.lb_rects, x, y) == "back":
            self.close_leaderboard()
        return
    _stats_original_click(self, e)


def stats_key_down(self, e):
    if self.state == "stats" and e.keysym.lower() in (
            "escape", "backspace", "return", "b"):
        self.close_leaderboard()
        return
    _stats_original_key_down(self, e)


def stats_close(self):
    fraction = getattr(self, "_stats_time_fraction", 0.0)
    if fraction >= 0.5:
        self.data["stats"]["time_played"] = self.stat("time_played") + 1
    self._stats_time_fraction = 0.0
    _stats_original_close(self)



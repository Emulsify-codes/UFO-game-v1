def on_key_down(self, e):
    k = e.keysym.lower()
    if self.state == "crates":
        self.keys.add(k)
        if k in ("f11", "f"):
            self.set_fullscreen(not self.fullscreen)
        elif k == "s":
            self.toggle_sound()
        elif k == "escape" and self.fullscreen:
            self.set_fullscreen(False)
        else:
            self.crate_key(k)
        return
    if self.state == "menu" and k == "c":
        self.keys.add(k)
        self.open_crates()
        return
    _o_key_down(self, e)


def on_click(self, e):
    if self.state == "crates":
        self.mouse_x, self.mouse_y = self.c.to_game(e.x, e.y)
        self.crate_click(self.mouse_x, self.mouse_y)
        return
    if self.state == "menu":
        x, y = self.c.to_game(e.x, e.y)
        if self.hit(self.menu_rects, x, y) == "crates":
            self.mouse_x, self.mouse_y = x, y
            self.open_crates()
            return
    _o_click(self, e)


def scroll_lb(self, d):
    if self.state == "crates":
        if self.crate_tab == "library":
            n = len(self.data["ench"]["books"])
            self.crate_scroll = min(max(0, n - CR_ROWS),
                                    max(0, self.crate_scroll + d))
        return
    _o_scroll(self, d)



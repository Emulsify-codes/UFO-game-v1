def apply_ench_globals(self):
    """Push the equipped books into the tuning constants at the top of the
    script (bounces, beam size, minion stats...). Safe to call any time."""
    global BOUNCE_MAX, BOUNCE_DIRS, MINION_PER_SIDE, MINION_LIFE
    global MINION_FIRE_DELAY, MINION_DMG_SHARE, MINION_MISSILE_SHARE
    global MISSILE_DMG, BEAM_HW, BEAM_DUR, BEAM_TICK_DMG, CHARGE_T, UFO_SPEED
    L = self.ench_lvl
    BOUNCE_MAX = _B_BOUNCE_MAX + 2 * L("rebound") + L("echo")
    BOUNCE_DIRS = _B_BOUNCE_DIRS + 2 * L("scatter")
    MINION_PER_SIDE = _BASE_MINIONS + L("legion")
    MINION_LIFE = _B_MLIFE + 4.0 * L("fuel")
    MINION_FIRE_DELAY = _B_MFIRE * 0.85 ** L("rapid")
    MINION_DMG_SHARE = _B_MDS + 0.15 * L("might")
    MINION_MISSILE_SHARE = _B_MMS + 0.15 * L("might")
    MISSILE_DMG = _B_MDMG * (1 + 0.25 * L("warhead"))
    BEAM_HW = tuple(h * (1 + 0.15 * L("widebeam")) for h in _B_HW)
    BEAM_DUR = tuple(d * (1 + 0.25 * L("lingering")) for d in _B_DUR)
    BEAM_TICK_DMG = tuple(max(1, int(d * (1 + 0.25 * L("focus")) + 0.5))
                          for d in _B_TICK)
    CHARGE_T = tuple(t * 0.92 ** L("quick") for t in _B_CHARGE)
    UFO_SPEED = _B_UFO_SPEED * (1 - 0.06 * L("frost"))


_p_reset = Game.reset
_p_fire = Game.fire
_p_fire_bounce = Game.fire_bounce
_p_summon = Game.summon_minions
_p_fire_missile = Game.fire_missile
_p_hurt = Game.hurt_player


def reset(self):
    self._ench_cache = None         # re-read the equipped books
    _p_reset(self)
    self._ench_cache = None
    apply_ench_globals(self)


def fire(self):
    """Critical: some bullets deal double damage (and look bigger)."""
    n0 = len(self.bullets)
    _p_fire(self)
    lvl = self.ench_lvl("critical")
    chance = 0.02 + 0.02 * lvl
    for b in self.bullets[n0:]:
        if random.random() < chance:
            b["dmg"] *= 2
            b["s"] = 1.45
            b["critical"] = True


def fire_bounce(self):
    apply_ench_globals(self)
    n0 = len(self.bullets)
    _p_fire_bounce(self)
    apply_ench_globals(self)        # the older wrapper resets BOUNCE_MAX
    s = self.ench_lvl("surge")
    if s:
        for b in self.bullets[n0:]:
            b["dmg"] = max(1, int(b["dmg"] * (1 + 0.25 * s) + 0.5))


def summon_minions(self):
    apply_ench_globals(self)
    _p_summon(self)
    apply_ench_globals(self)


def fire_missile(self):
    n0 = len(self.missiles)
    _p_fire_missile(self)
    extra = self.ench_lvl("salvo")
    if not extra or len(self.missiles) <= n0:
        return
    base = self.missiles[-1]
    others = sorted((u for u in self.ufos
                     if not u["dead"] and u["mode"] != "dying"
                     and u["y"] > -20 and u is not base["target"]),
                    key=lambda u: math.hypot(u["x"] - self.px,
                                             u["y"] - GROUND))
    for i in range(extra):
        m = dict(base)
        side = 1 if i % 2 == 0 else -1
        m["a"] = base["a"] + side * 0.45 * (i // 2 + 1)
        if i < len(others):
            m["target"] = others[i]
        self.missiles.append(m)


def hurt_player(self, dmg):
    inv0 = self.inv
    dmg *= 1 - 0.08 * self.ench_lvl("aegis")
    if self.hp <= self.max_hp / 2:
        dmg *= 1 - 0.10 * self.ench_lvl("abyssal_ward")
    # stochastic rounding: 1.84 damage = 1 for sure, +1 with 84% chance
    whole = int(dmg)
    dmg = whole + (1 if random.random() < dmg - whole else 0)
    if dmg <= 0:
        return
    _p_hurt(self, dmg)
    lvl = self.ench_lvl("ironskin")
    if lvl and inv0 <= 0 and self.inv > 0 and self.state != "gameover":
        self.inv += 0.3 * lvl       # longer grace period after a hit



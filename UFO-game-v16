        self.sfx("repair")
        return
    hp0 = self.hp
    _mut2_prev_hurt(self, dmg)
    if 0 < self.hp < hp0:
        self.mut_streak2 = 0
        if mut_has(self, "medic") and self.hp <= 1 \
                and not getattr(self, "mut_repair", False):
            self.mut_repair = True
            self.hp = min(self.max_hp, 2)
            mut_float(self, self.px, GROUND - 70, "EMERGENCY REPAIR", 1.2)
            self.sfx("repair")



    dict(id="daily_score", title="Score Chaser",
         desc="Earn 1,000 score", target=1000, metric="score", icon="diamond"),
)
WEEKLY_QUESTS = (
    dict(id="weekly_hunter", title="Ace Pilot",
         desc="Destroy 150 UFOs", target=150, metric="kills", icon="target"),
    dict(id="weekly_frontline", title="Wavebreaker",
         desc="Clear 20 waves", target=20, metric="waves", icon="wave"),
    dict(id="weekly_missiles", title="Missile Command",
         desc="Destroy 25 UFOs with missiles", target=25, metric="missile",

def quests_click(self, e):
    x, y = self.c.to_game(e.x, e.y)
    if self.state == "menu" and self.hit(self.menu_rects, x, y) == "quests":
        self.mouse_x, self.mouse_y = x, y
        self.open_quests()
        return
    if self.state == "quests":
        self.mouse_x, self.mouse_y = x, y
        key = self.hit(self.quest_rects, x, y)
        if key == "back":
            self.close_leaderboard()
        elif isinstance(key, tuple) and key[0] == "tab":
            self.quest_tab = key[1]
            self.quest_scroll = 0
            self.sfx("click")
        return
    _quests_original_click(self, e)


def quests_key_down(self, e):
    key = e.keysym.lower()
    if self.state == "menu" and key == "q":
        self.open_quests()
        return
    if self.state == "quests":
        if key in ("escape", "backspace", "return", "b"):
            self.close_leaderboard()
        elif key in ("left", "right"):
            tabs = ("daily", "weekly", "achievements")
            step = -1 if key == "left" else 1
            self.quest_tab = tabs[(tabs.index(self.quest_tab) + step) % len(tabs)]
            self.quest_scroll = 0
            self.sfx("click")
        elif self.quest_tab == "achievements" and key == "up":
            self.quest_scroll = max(0, self.quest_scroll - 1)
        elif self.quest_tab == "achievements" and key == "down":
            self.quest_scroll = min(max(0, len(BADGES) - 7),
                                    self.quest_scroll + 1)
        elif self.quest_tab == "achievements" and key == "prior":
            self.quest_scroll = max(0, self.quest_scroll - 7)
        elif self.quest_tab == "achievements" and key == "next":
            self.quest_scroll = min(max(0, len(BADGES) - 7),
                                    self.quest_scroll + 7)
        return
    _quests_original_key_down(self, e)



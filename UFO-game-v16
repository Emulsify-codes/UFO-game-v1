                      font=(FONT, 12))

    def draw_victory_confetti(self):
        c = self.c
        for piece in self.victory_confetti:
            x, y = piece["x"], piece["y"]
            angle = piece["angle"]
            half_w, half_h = piece["size"], piece["size"] * 0.45
            points = []
            for dx, dy in ((-half_w, -half_h), (half_w, -half_h),
                           (half_w, half_h), (-half_w, half_h)):
                points.extend((x + dx * math.cos(angle) - dy * math.sin(angle),
                               y + dx * math.sin(angle) + dy * math.cos(angle)))
            c.create_polygon(points, fill=piece["color"], outline="")


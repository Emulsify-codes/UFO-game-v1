_mut_prev_spawn = Game.spawn_ufo


_mut_nospawn = [False]


def mut_spawn_ufo(self, kind, x=None, y=None):
    _mut_prev_spawn(self, kind, x, y)
    if _mut_nospawn[0] or not self.ufos:
        return
    if kind in ("boss", "grand") or kind in BOSS_WAVES.values():
        return
    if self.wave < MUT_START_WAVE or random.random() >= MUT_CHANCE * (1 + 0.15 * sk(self, "mutmag")):
        return
    u = self.ufos[-1]
    if u.get("kind") != kind or u.get("mut") or u.get("is_clone"):
        return
    pool = [m for m in MUT_ORDER
            if self.wave >= MUT_WAVE.get(m, MUT_START_WAVE)]
    mid = random.choice(pool)
    u["mut"] = mid
    if mid == "armored":
        u["hp"] = u["maxhp"] = max(1, round(u["hp"] * 1.6))
    elif mid == "swift":
        u["vx"] *= 1.5
    elif mid == "shielded":
        u["mshield"] = True
    elif mid == "giant":
        u["hp"] = u["maxhp"] = max(1, round(u["hp"] * 2.2))
        u["custom_scale"] = 1.4
        u["vx"] *= 0.7
    elif mid == "tiny":
        u["hp"] = u["maxhp"] = max(1, round(u["hp"] * 0.6))
        u["custom_scale"] = 0.6
        u["vx"] *= 1.2
    elif mid == "haunted":
        u["mrevive"] = True



            raw = json.load(f)
    except (OSError, ValueError):
        raw = None
    saved_level = level_progress_for_xp(
        sum(run["score"] for run in data["runs"]) // 1000)[0]
    ench = dict(books=[], equipped=[], nuid=1, opened=0,
                free_ancient=0, level_reward_level=saved_level)
    src = raw.get("ench") if isinstance(raw, dict) else None
    if isinstance(src, dict):
        try:
            ench["free_ancient"] = max(0, int(src.get("free_ancient", 0)))
        except (TypeError, ValueError):
            pass
        try:
            ench["level_reward_level"] = max(
                0, int(src.get("level_reward_level", saved_level)))
        except (TypeError, ValueError):
            pass
        used, ids = set(), {}
        for b in src.get("books", []) if isinstance(src.get("books"), list) else []:
            try:
                eid, lvl, uid = str(b["id"]), int(b["lvl"]), int(b["uid"])
            except (KeyError, TypeError, ValueError):
                continue
            en = ENCH_BY_ID.get(eid)
            if en is None or uid in used or not 1 <= lvl <= en["max"]:
                continue
            used.add(uid)
            ids[uid] = eid
            ench["books"].append(dict(uid=uid, id=eid, lvl=lvl))
        have = set()
        for u in src.get("equipped", []) if isinstance(src.get("equipped"), list) else []:
            try:
                u = int(u)
            except (TypeError, ValueError):
                continue
            if u in ids and ids[u] not in have and len(ench["equipped"]) < ENCH_SLOTS:
                have.add(ids[u])
                ench["equipped"].append(u)
        try:
            ench["opened"] = max(0, int(src.get("opened", 0)))
            ench["nuid"] = max(int(src.get("nuid", 1)), max(used, default=0) + 1)
        except (TypeError, ValueError):
            ench["nuid"] = max(used, default=0) + 1
    data["ench"] = ench
    return data



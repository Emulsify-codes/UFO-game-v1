def ms_noun(p):
    return "GALAXY" if p.get("sys") == "gal" else "PLANET"


def ms_star_rating(integrity):
    return 3 if integrity >= 80 else 2 if integrity >= 50 else 1


def ms_data(self):
    d = self.data.setdefault("missions", dict(cleared={}))
    d.setdefault("cleared", {})
    return d["cleared"]


def ms_unlocked(self, i):
    return i == 0 or MS_PLANETS[i - 1]["id"] in ms_data(self)


def ms_reward_name(p):
    return "SKILL POINTS" if "sp" in p else "GEMS"


def ms_reward(p, stars, first):
    base = round(p.get("sp", p.get("gems", 0)) * (0.6 + 0.2 * stars))
    return base if first else max(1, round(base * 0.25))



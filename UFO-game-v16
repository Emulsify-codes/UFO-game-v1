def _boss_for_wave(w):
    return BOSS_WAVES.get(w)


def nb_start_wave(self):
    _n_start_wave(self)
    boss = _boss_for_wave(self.wave)
    if boss is None:
        return
    # Replace the base wave builder's lead UFO with this milestone boss.
    escorts = self.queue[1:][:max(2, len(self.queue) // 3)]
    self.queue = [boss] + escorts
    self.wave_total = len(self.queue)


def nb_spawn_ufo(self, kind, x=None, y=None):
    _n_spawn_ufo(self, kind, x, y)
    u = self.ufos[-1]
    u["shot_warning"] = 0.0
    if kind in NEW_BOSSES:
        extra = max(0, self.wave - HP_RAMP_START)
        spec = UFO_SPECS[kind]
        tier = ADVANCED_BOSSES.index(kind) + 1 if kind in ADVANCED_BOSSES else 0
        hp = spec["hp"] + self.wave * (16 + tier * 4) + extra * (40 + tier * 12)
        u["y"] = -max(110.0, spec["size"] * 1.05)
        u["shoot"] = max(1.0, 2.0 - tier * 0.12)
        u["hp"] = u["maxhp"] = hp
        u["x"] = u["base_x"] = W / 2
        u["timer"] = 3.0        # countdown to launching escorts
        u["cur"] = 4.0          # countdown to the next ammo curtain
        u["spin"] = 1.0         # spiral stream timer (Exterminator)

    profile = self.difficulty_settings
    if kind == "boss":
        base_hp = 53
    elif kind == "grand":
        base_hp = 162
    elif kind in NEW_BOSSES:
        spec = UFO_SPECS[kind]
        tier = ADVANCED_BOSSES.index(kind) + 1 \
            if kind in ADVANCED_BOSSES else 0
        base_hp = spec["hp"] + 16 + tier * 4
    else:
        base_hp = UFO_SPECS[kind]["hp"]
    wave_hp = max(0, u["maxhp"] - base_hp)
    scaled_hp = max(1, round(base_hp * profile["health"]
                             + wave_hp * profile["growth"]))
    u["hp"] = u["maxhp"] = scaled_hp


def boss_rage(u):
    frac = u["hp"] / max(1, u["maxhp"])
    threshold = 0.5 if u["kind"] in EXTERMINATOR_STYLE_BOSSES else 0.35
    return frac < threshold


def nb_damage_taken(self, u, dmg):
    if self.hp > self.max_hp / 2:
        dmg *= 1 + 0.10 * self.ench_lvl("abyssal_ascendance")
    if u["kind"] in BOSS_WAVES.values():
        dmg *= 1 + 0.10 * self.ench_lvl("bossbreaker")
    if u["hp"] / max(1, u["maxhp"]) < 0.25:
        dmg *= 1 + 0.10 * self.ench_lvl("executioner")
    if u["hp"] / max(1, u["maxhp"]) < 0.5:
        dmg *= 1 + 0.10 * self.ench_lvl("abyssal_hunter")
    if u["kind"] in ENRAGED_RESIST_BOSSES and boss_rage(u):
        return dmg * ENRAGED_DAMAGE_MULTIPLIER
    return dmg


def nb_curtain(self, u, gap, speed):
    """A full-width wall of bullets with a gap to dodge through."""
    self.sfx("warn")
    n = 16
    step = (W - 80) / (n - 1)
    g = random.randrange(1, n - gap - 1)
    for i in range(n):
        if g <= i < g + gap:
            continue
        self.ebullets.append([40 + i * step, u["y"] + 55, 0.0, speed])


def nb_update_ufo(self, u, dt):
    kind = u["kind"]
    if kind not in NEW_BOSSES:
        return _n_update_ufo(self, u, dt)
    ex = kind in EXTERMINATOR_STYLE_BOSSES
    mv = dt * UFO_SPEED * self.difficulty_settings["speed"]
    u["t"] += mv
    u["flash"] = max(0.0, u["flash"] - dt)
    if u["mode"] == "dying":
        self.update_dying(u, dt)
        return
    if u["kvy"]:                                # barely budges when shot
        u["y"] = max(-60.0, u["y"] + u["kvy"] * dt)
        u["kvy"] *= math.exp(-7.0 * dt)
        if abs(u["kvy"]) < 4:
            u["kvy"] = 0.0
    u["kvx"] = 0.0

    top = 185.0 if ex else 175.0
    if u["y"] < top:
        u["y"] += (50 if ex else 55) * mv
    else:
        amp = W / 2 - (190 if ex else 180)
        u["x"] = W / 2 + math.sin(u["t"] * (0.5 if ex else 0.4)) * amp
    ready = u["y"] >= top - 10
    if not ready:
        return

    rage = boss_rage(u)
    k = 0.65 if rage else 1.0
    s = UFO_SPECS[kind]["size"]
    ux, uy = u["x"], u["y"] + s * 0.4

    # spread shots + aimed shots
    u["shoot"] -= dt
    if u["shoot"] <= 0:
        if ex:
            u["shoot"] = 2.2 * k
            for i in range(-5, 6):
                ang = math.pi / 2 + i * 0.2
                self.ebullets.append([ux, uy, math.cos(ang) * 215,
                                      math.sin(ang) * 215])
            for off in (-0.18, 0.0, 0.18):
                d = math.atan2(GROUND - uy, self.px - ux) + off
                self.ebullets.append([ux, uy, math.cos(d) * 280,
                                      math.sin(d) * 280])
            self.sfx("enemy")
        else:
            u["shoot"] = 2.3 * k
            for i in range(-4, 5):
                ang = math.pi / 2 + i * 0.22
                self.ebullets.append([ux, uy, math.cos(ang) * 215,
                                      math.sin(ang) * 215])
            self.enemy_shot(ux, uy, self.px, GROUND, 290)

    # rotating spiral stream (Exterminator only)
    if ex:
        u["spin"] -= dt
        if u["spin"] <= 0:
            u["spin"] = 0.15 * k
            a = math.pi / 2 + math.sin(u["t"] * 2.2) * 1.1
            self.ebullets.append([ux, uy, math.cos(a) * 190,
                                  math.sin(a) * 190])
            if rage:
                a2 = math.pi / 2 - math.sin(u["t"] * 2.2) * 1.1
                self.ebullets.append([ux, uy, math.cos(a2) * 190,
                                      math.sin(a2) * 190])

    # ammo curtain: dodge through the gap
    u["cur"] -= dt
    if u["cur"] <= 0:
        u["cur"] = (5.5 if ex else 7.0) * k
        self.boss_curtain(u, 2 if ex else 3, 170 if ex else 150)

    # launch escorts
    u["timer"] -= dt
    if u["timer"] <= 0:
        u["timer"] = (4.0 if ex else max(3.5, 5.5 - self.wave * 0.05)) * k
        n = sum(1 for o in self.ufos
                if o["kind"] in ("diver", "heavy") and not o["dead"])
        if n < 8:
            kinds = ("heavy", "diver") if ex else ("diver", "diver")
            for off, kd in zip((-80, 80), kinds):
                self.spawn_ufo(kd, ux + off, u["y"] + s * 0.5)


def nb_kill_ufo(self, u, src=None):
    kind = u["kind"]
    if kind not in NEW_BOSSES:
        return _n_kill_ufo(self, u, src)
    spec = UFO_SPECS[kind]
    st = self.data["stats"]
    st["kills"] = st.get("kills", 0) + 1
    key = "kill_" + kind
    st[key] = st.get(key, 0) + 1
    skey = {"missile": "kill_missile", "bounce": "kill_bounce",
        "beam": "kill_beam", "shock": "kill_shock"}.get(src)
    if skey:
        st[skey] = st.get(skey, 0) + 1
    self.score += spec["score"]
    self.credits += spec["credits"]
    f = self.ench_lvl("fortune")
    if f:
        self.credits += round(spec["credits"] * 0.10 * f)
    self.score_pop = 0.25
    self.unlock(kind)
    self.begin_boss_death(u)
    self.check_badges()


def nb_begin_death(self, u):
    _n_begin_death(self, u)
    if u["kind"] == "destroyer":
        u["dur"] = 4.4
    elif u["kind"] in EXTERMINATOR_STYLE_BOSSES:
        u["dur"] = 5.6
    elif u["kind"] in ("triton", "atlas", "behemoth"):
        u["dur"] = 5.0


def nb_finish_death(self, u):
    _n_finish_death(self, u)
    if u["kind"] not in NEW_BOSSES:
        return
    ex = u["kind"] in EXTERMINATOR_STYLE_BOSSES
    spec = UFO_SPECS[u["kind"]]
    x, y, s = u["x"], u["y"], spec["size"]
    self.explode(x, y, spec["color"], 140 if ex else 100, 520)
    self.explode(x, y, "#ffffff", 30, 600)
    for dx in (-0.6, 0.6):
        self.explode(x + dx * s, y, spec["dome"], 40, 380)
    self.rings.append([x, y, 420, 1.1, 1.1, "#ffffff"])
    self.rings.append([x, y, 300, 0.9, 0.9, spec["color"]])
    self.slow = 0.8
    self.hit_flash = 0.8
    self.shake = 0.7
    self.finale = 3.6 if ex else 3.0


def nb_draw_ufo(self, u, ox, oy, scale=1.0):
    kind = u["kind"]
    if kind not in NEW_BOSSES:
        return _n_draw_ufo(self, u, ox, oy, scale)
    c = self.c
    t = time.time()
    ex = kind in EXTERMINATOR_STYLE_BOSSES
    spec = UFO_SPECS[kind]
    s = spec["size"] * scale
    col = spec["color"]
    dark = mix(col, "#000000", 0.5)
    x = u["x"] + ox
    y = u["y"] + oy + math.sin(u["t"] * 3 + len(kind)) * 2 * scale
    dying = u["mode"] == "dying"

    if not dying:                               # behind the hull
        rage = boss_rage(u)
        pulse = 0.5 + 0.5 * math.sin(t * (10 if rage else 4))
        aura = mix(col, "#ffffff", 0.5 * pulse) if rage else col
        glow(c, x, y + s * 0.2, s * 2.0, aura, layers=5, a=0.5)
        pr = s * (1.45 + 0.05 * math.sin(u["t"] * 4))
        c.create_oval(x - pr, y - s * 0.45, x + pr, y + s * 0.85,
                      outline=aura, width=3)
        c.create_oval(x - pr * 1.12, y - s * 0.55, x + pr * 1.12,
                      y + s * 0.95, outline=mix(col, "#ffffff", 0.4),
                      width=1, dash=(8, 5))
        if ex:                                  # crown of spikes
            for dx in (-0.4, -0.2, 0.0, 0.2, 0.4):
                h = 0.95 if dx == 0 else 0.75
                c.create_polygon(x + (dx - 0.08) * s, y - s * 0.5,
                                 x + dx * s, y - s * (0.5 + h * 0.6),
                                 x + (dx + 0.08) * s, y - s * 0.5,
                                 fill=aura, outline=dark)
        else:                                   # underside blades
            for dx in (-0.6, -0.4, -0.2, 0.0, 0.2, 0.4, 0.6):
                c.create_polygon(x + (dx - 0.09) * s, y + s * 0.3,
                                 x + dx * s, y + s * 0.82,
                                 x + (dx + 0.09) * s, y + s * 0.3,
                                 fill=dark, outline=col)

    hp = u["hp"]
    u["hp"] = u["maxhp"]        # hides the small bar; the HUD has a big one
    try:
        _n_draw_ufo(self, u, ox, oy, scale)
    finally:
        u["hp"] = hp
    if dying:
        return

    if ex:                                      # orbiting plasma orbs
        for i in range(6):
            a = t * 1.4 + i * math.tau / 6
            px = x + math.cos(a) * s * 1.25
            py = y + s * 0.15 + math.sin(a) * s * 0.35
            glow(c, px, py, 12 * scale, col, layers=3, a=0.7)
            c.create_oval(px - 4 * scale, py - 4 * scale, px + 4 * scale,
                          py + 4 * scale, fill="#ffffff", outline=col)
    else:                                       # side gun pods
        for sg in (-1, 1):
            tx, ty = x + sg * s * 0.95, y + s * 0.12
            c.create_rectangle(tx - s * 0.12, ty - s * 0.1, tx + s * 0.12,
                               ty + s * 0.5, fill=dark, outline=col, width=2)
            c.create_rectangle(tx - s * 0.04, ty + s * 0.5, tx + s * 0.04,
                               ty + s * 0.72, fill="#dddddd", outline="")
            glow(c, tx, ty + s * 0.74, 10 * scale, "#ffd24d", layers=3,
                 a=0.5 + 0.4 * math.sin(t * 6 + sg))


def nb_draw_hud(self):
    _n_draw_hud(self)
    live = [u for u in self.ufos if not u["dead"] and u["mode"] != "dying"]
    if any(u["kind"] in ("boss", "grand") for u in live):

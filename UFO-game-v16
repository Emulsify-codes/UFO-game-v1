            self.combo_t = 0.0
        return
    if getattr(self, "combo", 0) > 0:
        self.combo_t -= dt
        if self.combo_t <= 0:
            self.combo = 0
            self.combo_t = 0.0
    if getattr(self, "combo_pop", 0) > 0:
        self.combo_pop = max(0.0, self.combo_pop - dt)



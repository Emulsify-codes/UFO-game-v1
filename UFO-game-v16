PET_COLORS = {rarity: color for rarity, _, color, *_ in PET_RARITIES}


_pets_previous_load_data = load_data


def load_data():
    data = _pets_previous_load_data()
    pets = dict(owned={}, huge={},
                eggs={rarity: 0 for rarity, *_ in PET_RARITIES},
                equipped=None, equipped_huge=None)
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as save_file:
            raw = json.load(save_file)
    except OSError:
        raw = None
    except ValueError:
        raw = None
    saved = raw.get("pets") if isinstance(raw, dict) else None
    if isinstance(saved, dict):
        owned = saved.get("owned")
        if isinstance(owned, dict):
            for pet_id, count in owned.items():
                if pet_id not in PET_BY_ID:
                    continue
                try:
                    count = max(0, int(count))
                except (TypeError, ValueError):
                    continue
                if count:
                    pets["owned"][pet_id] = count
        huge = saved.get("huge")
        if isinstance(huge, dict):
            for pet_id, buffs in huge.items():
                pet = PET_BY_ID.get(pet_id)
                if pet is None or not isinstance(buffs, list):
                    continue
                _, main_buff, _ = pet_buff_details(pet)
                valid_buffs = [
                    buff for buff in buffs
                    if isinstance(buff, str) and buff in PET_BUFF_TYPES
                    and buff != main_buff
                    and _pet_buff_amount(pet, buff) > 0
                ]
                if valid_buffs:
                    pets["huge"][pet_id] = valid_buffs
        eggs = saved.get("eggs")
        if isinstance(eggs, dict):
            for rarity in pets["eggs"]:
                try:
                    pets["eggs"][rarity] = max(0, int(eggs.get(rarity, 0)))
                except (TypeError, ValueError):
                    continue
        equipped = saved.get("equipped")
        if isinstance(equipped, str) and (
                equipped in pets["owned"] or pets["huge"].get(equipped)):
            huge_index = saved.get("equipped_huge")
            if isinstance(huge_index, int) and not isinstance(huge_index, bool) \
                    and 0 <= huge_index < len(pets["huge"].get(equipped, [])):
                pets["equipped"] = equipped
                pets["equipped_huge"] = huge_index
            elif equipped in pets["owned"]:
                pets["equipped"] = equipped
    data["pets"] = pets
    return data


def _pets_ensure_data(self):
    if "pets" not in self.data or not isinstance(self.data["pets"], dict):
        self.data["pets"] = dict(
            owned={}, huge={}, eggs={r: 0 for r, *_ in PET_RARITIES},
            equipped=None, equipped_huge=None)
    pets = self.data["pets"]
    if not isinstance(pets.get("owned"), dict):
        pets["owned"] = {}
    if not isinstance(pets.get("huge"), dict):
        pets["huge"] = {}
    for pet_id in list(pets["huge"]):
        pet = PET_BY_ID.get(pet_id)
        buffs = pets["huge"][pet_id]
        if pet is None or not isinstance(buffs, list):
            del pets["huge"][pet_id]
            continue
        _, main_buff, _ = pet_buff_details(pet)
        pets["huge"][pet_id] = [
            buff for buff in buffs
            if isinstance(buff, str) and buff in PET_BUFF_TYPES
            and buff != main_buff and _pet_buff_amount(pet, buff) > 0
        ]
        if not pets["huge"][pet_id]:
            del pets["huge"][pet_id]
    if not isinstance(pets.get("eggs"), dict):
        pets["eggs"] = {}
    for rarity, *_ in PET_RARITIES:
        pets["eggs"].setdefault(rarity, 0)
    equipped = pets.get("equipped")
    huge_buffs = pets["huge"].get(equipped, [])
    huge_index = pets.get("equipped_huge")
    if not isinstance(huge_index, int) or isinstance(huge_index, bool) \
            or huge_index < 0 or huge_index >= len(huge_buffs):
        pets["equipped_huge"] = None
    if not isinstance(equipped, str) or (
            equipped not in pets["owned"] and not huge_buffs):
        pets["equipped"] = None
        pets["equipped_huge"] = None



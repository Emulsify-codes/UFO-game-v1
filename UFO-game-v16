    if u.get("sh_on"):                  # keep a shield's core/shield split
        u["core_hp"] = max(1, round(u["core_hp"] * mult))
        u["sh_max"] = max(2, round(u["sh_max"] * mult))
        u["hp"] = u["maxhp"] = u["core_hp"] + u["sh_max"]
    else:
        u["hp"] = u["maxhp"] = max(1, round(u["hp"] * mult))



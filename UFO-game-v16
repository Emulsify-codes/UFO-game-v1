    dict(id="weekly_deploy", title="Veteran Pilot",
         desc="Launch 8 runs", target=8, metric="games", icon="gun"),
    dict(id="weekly_score", title="High Scorer",
         desc="Earn 10,000 score", target=10000, metric="score",
         icon="diamond"),
    dict(id="weekly_bosses", title="Boss Breaker",
         desc="Defeat 3 milestone bosses", target=3, metric="bosses",
         icon="crown"),
)
QUEST_BY_ID = {quest["id"]: quest
               for quest in (*DAILY_QUESTS, *WEEKLY_QUESTS)}


def quest_period_keys(now=None):
    now = now or datetime.datetime.now()
    today = now.date()
    iso = today.isocalendar()
    return (today.isoformat(), f"{iso.year}-W{iso.week:02d}")


def quest_set(period, daily):
    if daily:
        offset = datetime.date.fromisoformat(period).toordinal()
        pool = DAILY_QUESTS
    else:
        year, week = period.split("-W")
        offset = datetime.date.fromisocalendar(
            int(year), int(week), 1).toordinal()
        pool = WEEKLY_QUESTS
    start = offset % len(pool)
    return [pool[(start + i) % len(pool)] for i in range(3)]


def active_quest_entries(self, period_name):
    active = self.data["quests"][period_name + "_active"]
    return [(task_id, QUEST_BY_ID[task_id.split("@", 1)[0]])
            for task_id in active]


def add_next_quest(self, period_name, daily):
    quests = self.data["quests"]
    active_key = period_name + "_active"
    next_key = period_name + "_next"
    active = quests[active_key]
    pool = DAILY_QUESTS if daily else WEEKLY_QUESTS
    active_ids = {task_id.split("@", 1)[0] for task_id in active}
    start = quests[next_key]
    for offset in range(len(pool)):
        pool_index = (start + offset) % len(pool)
        quest = pool[pool_index]
        if quest["id"] not in active_ids:
            serial = quests[next_key]
            quests[next_key] = serial + 1
            task_id = f"{quest['id']}@{serial}"
            active.append(task_id)
            return quest, task_id
    raise RuntimeError(f"No inactive {period_name} quest is available.")


def ensure_quest_periods(self):
    data = self.data
    state = data.get("quests")
    if not isinstance(state, dict):
        state = {}
    daily_period, weekly_period = quest_period_keys()
    normalized = {}
    for name, period in (("daily", daily_period), ("weekly", weekly_period)):
        period_key = name + "_period"
        progress_key = name + "_progress"
        claimed_key = name + "_claimed"
        active_key = name + "_active"
        next_key = name + "_next"
        completed_key = name + "_completed"
        old_progress = state.get(progress_key)
        fresh_period = (state.get(period_key) != period
                        or not isinstance(old_progress, dict))
        if fresh_period:
            normalized[period_key] = period
            normalized[progress_key] = {}
            normalized[claimed_key] = []
            normalized[active_key] = [
                quest["id"] for quest in quest_set(period, name == "daily")]
            normalized[next_key] = len(normalized[active_key])
            normalized[completed_key] = 0
        else:
            normalized[period_key] = period
            normalized[progress_key] = {}
            for metric in QUEST_METRICS:
                try:
                    normalized[progress_key][metric] = max(
                        0, int(old_progress.get(metric, 0)))
                except (TypeError, ValueError):
                    normalized[progress_key][metric] = 0
            old_claimed = state.get(claimed_key, [])
            normalized[claimed_key] = (
                [quest_id for quest_id in old_claimed
                 if isinstance(quest_id, str)]
                if isinstance(old_claimed, list) else [])
            old_active = state.get(active_key)
            if isinstance(old_active, list):
                active_ids = []
                for task_id in old_active:
                    if (isinstance(task_id, str)
                            and task_id.split("@", 1)[0] in QUEST_BY_ID
                            and task_id not in active_ids):
                        active_ids.append(task_id)
                normalized[active_key] = active_ids[:3]
            else:
                normalized[active_key] = [
                    quest["id"] for quest in quest_set(
                        period, name == "daily")]
            try:
                next_serial = max(0, int(state.get(
                    next_key, len(normalized[active_key]))))
            except (TypeError, ValueError):
                next_serial = len(normalized[active_key])
            for task_id in normalized[active_key] + normalized[claimed_key]:
                if "@" in task_id:
                    try:
                        next_serial = max(next_serial,
                                          int(task_id.rsplit("@", 1)[1]) + 1)
                    except ValueError:
                        continue
            normalized[next_key] = next_serial
            try:
                normalized[completed_key] = max(
                    0, int(state.get(completed_key, 0)))
            except (TypeError, ValueError):
                normalized[completed_key] = 0
    data["quests"] = normalized
    replacements_added = False
    for period_name, daily in (("daily", True), ("weekly", False)):
        progress = normalized[period_name + "_progress"]
        claimed = normalized[period_name + "_claimed"]
        active = normalized[period_name + "_active"]
        for task_id, quest in active_quest_entries(self, period_name)[:]:
            if task_id in claimed:
                active.remove(task_id)
                add_next_quest(self, period_name, daily)
                progress[quest["metric"]] = 0
                replacements_added = True
            elif progress.get(quest["metric"], 0) >= quest["target"]:
                if grant_quest_reward(self, period_name, quest, task_id):
                    normalized[period_name + "_completed"] += 1
                active.remove(task_id)
                add_next_quest(self, period_name, daily)
                progress[quest["metric"]] = 0
                replacements_added = True
        while len(active) < 3:
            add_next_quest(self, period_name, daily)
            replacements_added = True
    if state != normalized or replacements_added:
        self.save_ok = save_data(data)


def grant_quest_reward(self, period_name, quest, task_id=None):
    claimed = self.data["quests"][period_name + "_claimed"]
    claim_id = task_id or quest["id"]
    if claim_id in claimed:
        return False
    reward = QUEST_GEM_REWARDS[period_name]
    claimed.append(claim_id)
    self.data["gems"] += reward
    if hasattr(self, "floaters") and self.state == "play":
        self.floaters.append([
            self.px, GROUND - 70,
            f"QUEST COMPLETE  +{reward} GEMS", 1.8])
    if hasattr(self, "snd"):
        self.sfx("badge")
    return True


def quest_count(self, period_name, metric):
    ensure_quest_periods(self)
    return self.data["quests"][period_name + "_progress"].get(metric, 0)


def add_quest_progress(self, metric, amount=1):
    if metric not in QUEST_METRICS or amount <= 0:
        return
    ensure_quest_periods(self)
    changed = False
    reward_granted = False
    replacement_added = False
    for period_name, daily in (("daily", True), ("weekly", False)):
        active = active_quest_entries(self, period_name)
        matching = [(task_id, quest) for task_id, quest in active
                    if quest["metric"] == metric]
        progress = self.data["quests"][period_name + "_progress"]
        previous = progress.get(metric, 0)
        target = max((quest["target"] for _, quest in matching), default=0)
        new_value = min(target, previous + amount) if target else previous
        if new_value != previous:
            progress[metric] = new_value
            changed = True
        if target and previous < target <= new_value:
            for task_id, quest in matching:
                if quest["target"] == target:
                    if grant_quest_reward(self, period_name, quest, task_id):
                        self.data["quests"][period_name + "_completed"] += 1
                        reward_granted = True
                    active_ids = self.data["quests"][period_name + "_active"]
                    active_ids.remove(task_id)
                    add_next_quest(self, period_name, daily)
                    progress[metric] = 0
                    changed = True
                    replacement_added = True
    if changed and (metric != "score" or reward_granted
                    or replacement_added):
        self.save_ok = save_data(self.data)


def open_quests(self):
    ensure_quest_periods(self)
    self.sfx("click")
    self.lb_return = "menu"
    self.quest_tab = "daily"
    self.quest_scroll = 0
    self.quest_rects = []
    self.state = "quests"


def quest_time_left(daily, now=None):
    now = now or datetime.datetime.now()
    today = now.date()
    if daily:
        next_reset = datetime.datetime.combine(
            today + datetime.timedelta(days=1), datetime.time.min)
    else:
        days = 7 - today.weekday()
        next_reset = datetime.datetime.combine(
            today + datetime.timedelta(days=days), datetime.time.min)
    seconds = max(0, int((next_reset - now).total_seconds()))
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes = seconds // 60
    return f"{days}d {hours}h" if days else f"{hours}h {minutes:02d}m"



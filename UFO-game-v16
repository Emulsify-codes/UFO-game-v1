_sk_prev_hurt = Game.hurt_player


def sk_hurt_player(self, dmg):
    if self.inv <= 0 and self.state == "play" and sk(self, "lastres") \
            and not getattr(self, "sk_lastres_used", False) \
            and self.hp - dmg <= 0:
        self.sk_lastres_used = True
        self.hp = max(1, self.max_hp // 2)
        self.inv = 2.0
        self.shake = 0.4
        self.explode(self.px, GROUND, "#4dff88", 30, 320)
        self.rings.append([self.px, GROUND, 150, 0.6, 0.6, "#4dff88"])
        self.floaters.append([self.px, GROUND - 70, "LAST RESORT!", 1.4])
        self.sfx("repair")
        return
    if self.inv <= 0 and self.state == "play":
        r = sk(self, "plating2")
        if r and random.random() < 0.05 * r:
            self.inv = 0.5
            self.floaters.append([self.px, GROUND - 70, "DEFLECT", 0.8])
            return
        r = sk(self, "waveguard")
        if r and getattr(self, "sk_wave_blocks", 0) < r:
            self.sk_wave_blocks = getattr(self, "sk_wave_blocks", 0) + 1
            self.inv = 0.8
            self.floaters.append([self.px, GROUND - 70, "WAVE GUARD", 0.9])
            self.rings.append([self.px, GROUND, 90, 0.4, 0.4, "#4dff88"])
            return
        if sk(self, "bulwark"):
            dmg = min(dmg, 2)
    hp0 = self.hp
    _sk_prev_hurt(self, dmg)
    if 0 < self.hp < hp0 and sk(self, "skin"):
        self.inv += 0.15 * sk(self, "skin")



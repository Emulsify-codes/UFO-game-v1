_mut_prev_update = Game.update


def mut_update(self, dt):
    _mut_prev_update(self, dt)
    if self.state != "play":
        return
    for u in self.ufos:
        if u.get("mut") == "regen" and not u.get("dead") \
                and u.get("mode") != "x" and u["hp"] < u["maxhp"]:
            u["hp"] = min(u["maxhp"], u["hp"] + u["maxhp"] * 0.03 * dt)
    self.mut_clock = getattr(self, "mut_clock", 0.0) + dt
    for u in self.ufos:
        if u.get("dead") or u.get("mode") == "x":
            continue
        mid = u.get("mut")
        if mid == "berserk" and not u.get("rage") \
                and u["hp"] < u["maxhp"] * 0.5:
            u["rage"] = True
            u["vx"] *= 1.8
            mut_float(self, u["x"], u["y"] - 24, "ENRAGED", 0.9)
        elif mid == "rapid" and isinstance(u.get("shoot"), (int, float)):
            u["shoot"] -= dt * 0.6
        elif mid == "magnetic" and u["y"] > 0:
            self.px += (1 if u["x"] > self.px else -1) * 35 * dt
            self.px = min(W - 20, max(20, self.px))
    if mut_has(self, "rapid") and self.cooldown > 0:
        self.cooldown -= dt * 0.1
    if (mut_has(self, "berserk") and self.hp <= self.max_hp / 2) \
            or (mut_has(self, "haunted") and self.hp <= 1):
        self.cooldown = min(self.cooldown, self.delay * 0.5)
    if mut_has(self, "cloaked"):
        self.mut_shadow = getattr(self, "mut_shadow", 0.0) + dt
        if self.mut_shadow >= 20.0:
            self.mut_shadow = 0.0
            self.inv = max(self.inv, 1.5)
            mut_float(self, self.px, GROUND - 70, "SHADOW STEP", 0.9)
    if getattr(self, "mut_aegis", 0.0) > 0:
        self.mut_aegis -= dt
    if mut_has(self, "regen"):
        self.mut_regen_t = getattr(self, "mut_regen_t", 0.0) + dt
        if self.mut_regen_t >= 30.0:
            self.mut_regen_t = 0.0
            if 0 < self.hp < self.max_hp:
                self.hp += 1
                mut_float(self, self.px, GROUND - 70, "+1 HULL", 0.9)



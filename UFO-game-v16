def wx2_update_ufo(self, u, dt):
    w = self.weather
    if self.state == "play" and w in ("eclipse", "acid") \
            and u["mode"] != "dying" and not u["dead"]:
        if w == "eclipse" and u.get("shoot") is not None:
            u["shoot"] -= dt * ECLIPSE_SHOT
        elif w == "acid" and u["y"] > -20:
            rate = ACID_BOSS_RATE if u["kind"] in BOSS_WAVES.values() \
                else ACID_RATE
            u["hp"] -= u["maxhp"] * rate * dt
            if u["hp"] <= 0:
                self.kill_ufo(u, "acid")
                return
    _wx2_prev_update_ufo(self, u, dt)



def draw_book(self, cx, cy, s, col, t=0.0, bg="#0b0f26"):
    """An enchantment book in the colour of its rarity."""
    c = self.c
    w, h = 16 * s, 22 * s
    cover = mix(col, "#000000", 0.6)
    glow(c, cx, cy, 34 * s, col, layers=3, a=0.45, bg=bg)
    c.create_rectangle(cx - w + 4 * s, cy - h + 2 * s, cx + w, cy + h - 2 * s,
                       fill="#f2ead2", outline="#b8ad8a")          # pages
    c.create_rectangle(cx - w, cy - h, cx + w - 3 * s, cy + h,
                       fill=cover, outline=col, width=2)           # cover
    c.create_rectangle(cx - w, cy - h, cx - w + 5 * s, cy + h,
                       fill=mix(cover, "#000000", 0.4), outline="")  # spine
    ex, d = cx + 1 * s, 6 * s
    c.create_polygon(ex, cy - d * 1.3, ex + d, cy, ex, cy + d * 1.3, ex - d,
                     cy, fill=col, outline="")
    c.create_polygon(ex, cy - d * .6, ex + d * .4, cy, ex, cy + d * .6,
                     ex - d * .4, cy, fill=mix(col, "#ffffff", 0.7),
                     outline="")
    c.create_rectangle(cx + w - 9 * s, cy + h - 1, cx + w - 6 * s,
                       cy + h + 7 * s, fill=col, outline="")       # ribbon
    k = 0.5 + 0.5 * math.sin(t * 4)
    sx, sy, r = cx + w - 6 * s, cy - h + 6 * s, (2 + 3 * k) * s
    c.create_line(sx - r, sy, sx + r, sy, fill="#ffffff", width=1)
    c.create_line(sx, sy - r, sx, sy + r, fill="#ffffff", width=1)


def draw_crate(self, cx, cy, s, cr, t=0.0, shake=0.0, lid=0.0, lit=None):
    """A crate; `lid` 0..1 lifts the lid, `lit` is a colour that glows out."""
    c = self.c
    cx += math.sin(t * 55) * shake * 3 * s
    cy += math.cos(t * 47) * shake * 2 * s
    w, h = 40 * s, 28 * s
    top = cy - h * 0.15
    body, dark, trim = cr["body"], cr["dark"], cr["trim"]
    if lit:
        glow(c, cx, cy, 80 * s, lit, layers=5, a=0.7, bg="#0b0f26")
    c.create_rectangle(cx - w, top, cx + w, cy + h, fill=body, outline=dark,
                       width=2)
    for f in (1 / 3, 2 / 3):
        yy = top + (cy + h - top) * f
        c.create_line(cx - w, yy, cx + w, yy, fill=dark, width=1)
    for sx in (-0.58, 0.58):
        c.create_rectangle(cx + w * sx - 4 * s, top, cx + w * sx + 4 * s,
                           cy + h, fill=trim, outline=dark)
    if cr["id"] == "iron":
        for rx in (-w + 6 * s, w - 6 * s):
            for ry in (top + 6 * s, cy + h - 6 * s):
                c.create_oval(rx - 2 * s, ry - 2 * s, rx + 2 * s, ry + 2 * s,
                              fill=dark, outline="")
    elif cr["id"] == "ancient":
        pulse = 0.5 + 0.5 * math.sin(t * 3)
        rc = mix(trim, cr["glow"], pulse)
        for dx in (-0.25, 0.25):
            px, py, d = cx + w * dx, cy + h * 0.45, 5 * s
            c.create_polygon(px, py - d, px + d * .6, py, px, py + d,
                             px - d * .6, py, fill=rc, outline="")
    elif cr["id"] in ("abyssal", "trident", "astral_poseidon"):
        pulse = 0.5 + 0.5 * math.sin(t * 3)
        sigil = mix(trim, "#ffffff", 0.2 * pulse)
        sx, sy = cx, cy + h * 0.43
        if cr["id"] == "trident":
            c.create_line(sx, sy - 8 * s, sx, sy + 8 * s,
                          fill=sigil, width=max(1, int(s * 1.4)))
            c.create_line(sx - 7 * s, sy - 7 * s, sx - 7 * s, sy - 2 * s,
                          sx - 5 * s, sy + 1 * s, sx, sy - 2 * s,
                          sx + 5 * s, sy + 1 * s, sx + 7 * s, sy - 2 * s,
                          sx + 7 * s, sy - 7 * s, fill=sigil,
                          width=max(1, int(s * 1.2)), smooth=True)
        elif cr["id"] == "astral_poseidon":
            for i in range(8):
                a = i * math.tau / 8 + t * 0.2
                c.create_line(sx, sy, sx + math.cos(a) * 7 * s,
                              sy + math.sin(a) * 7 * s, fill=sigil,
                              width=max(1, int(s)))
            c.create_oval(sx - 2 * s, sy - 2 * s, sx + 2 * s,
                          sy + 2 * s, fill="#ffffff", outline="")
        else:
            c.create_oval(sx - 6 * s, sy - 4 * s, sx + 6 * s,
                          sy + 4 * s,
                          fill=mix(dark, trim, 0.5 + pulse * 0.35),
                          outline=sigil, width=max(1, int(s)))
            c.create_oval(sx - 2 * s, sy - 2 * s, sx + 2 * s,
                          sy + 2 * s, fill="#ffffff", outline="")
    if lid > 0:                                  # light spilling out
        glow(c, cx, top - 4 * s, 46 * s * lid, lit or trim, layers=4,
             a=0.9, bg="#0b0f26")
        c.create_rectangle(cx - w + 3 * s, top - 1, cx + w - 3 * s,
                           top + 5 * s, fill=mix(dark, "#000000", 0.5),
                           outline="")
    yb = top - lid * 8 * s
    yt = top - 12 * s - lid * 30 * s
    sh = lid * 8 * s
    c.create_polygon(cx - w - 3 * s, yb, cx + w + 3 * s, yb,
                     cx + w + 3 * s - sh, yt, cx - w - 3 * s + sh, yt,
                     fill=mix(body, "#ffffff", 0.12), outline=dark, width=2)
    for sx in (-0.58, 0.58):
        x0 = cx + w * sx
        c.create_polygon(x0 - 4 * s, yb, x0 + 4 * s, yb, x0 + 4 * s - sh * .6,
                         yt, x0 - 4 * s + sh * .6, yt, fill=trim, outline=dark)
    c.create_oval(cx - 5 * s, yb - 6 * s, cx + 5 * s, yb + 2 * s, fill=trim,
                  outline=dark)



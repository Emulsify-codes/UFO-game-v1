        pu_orb(self, 112, y + 19, 11, rc, t, seed=offset * 1.3,
               huge=bool(huge_on), bg="#0a0e22")
        buff_name, _b, buff_desc = pet_buff_details(pet)
        c.create_text(136, y + 12, anchor="w", text=pet["name"],
                      fill="#ffffff", font=(FONT, 9, "bold"))
        if huge_on:
            pu_pill(c, 136 + 7 * len(pet["name"]) + 6, y + 5,
                    136 + 7 * len(pet["name"]) + 58, y + 19, "#ffd24d")
            c.create_text(136 + 7 * len(pet["name"]) + 32, y + 12,
                          text=f"HUGE x{len(huge_on)}", fill="#ffe066",
                          font=(FONT, 6, "bold"))
        c.create_text(136, y + 27, anchor="w",
                      text=f"{buff_name}: {buff_desc}", fill=rc,
                      font=(FONT, 7, "bold"))
        amount = owned.get(pet_id, 0)
        pu_pill(c, 420, y + 8, 486, y + 28, "#2c3568", alpha=0.95)
        c.create_text(453, y + 18, text=f"x{amount}  H:{len(huge_buffs)}",
                      fill="#c6d2e8", font=(FONT, 8, "bold"))
        if amount >= 3:
            self.button(self.pet_rects, (495, y + 3, 557, y + 33), "HUGE",
                        ("combine", pet_id), "gold", 7)
        if amount:
            self.button(self.pet_rects, (562, y + 3, 630, y + 33),
                        "ON" if normal_on else "EQUIP", ("equip", pet_id),
                        "green" if normal_on else "purple", 7)
        if huge_buffs:
            self.button(self.pet_rects, (635, y + 3, 715, y + 33),
                        f"H {len(huge_on)}/{len(huge_buffs)}" if huge_on
                        else "EQUIP H", ("equip_huge", pet_id),
                        "green" if huge_on else "purple", 7)
    if len(found) > visible:
        tx, ty1, ty2 = W - 72, 235, 235 + visible * 41 - 5
        c.create_rectangle(tx, ty1, tx + 4, ty2, fill="#202744", outline="")
        th = max(20, (ty2 - ty1) * visible / len(found))
        ty = ty1 + (ty2 - ty1 - th) * self.pet_scroll / max(
            1, len(found) - visible)
        c.create_rectangle(tx, ty, tx + 4, ty + th, fill=rc, outline="")
        c.create_text(W / 2, 527, fill="#8290ad", font=(FONT, 8),
                      text=f"UP/DOWN OR MOUSE WHEEL TO SCROLL  ·  "
                           f"{self.pet_scroll + 1}-"
                           f"{min(len(found), self.pet_scroll + visible)} "
                           f"OF {len(found)}")


def pu_upgrade_tab(self, t, pets):
    c = self.c
    count = pets["slot_count"]
    c.create_text(W / 2, 150, text="COMPANION SLOTS", fill="#eff6ff",
                  font=(FONT, 12, "bold"))
    c.create_text(W / 2, 170, fill="#aab8d5", font=(FONT, 8, "bold"),
                  text="Equip several pets at once. Their buffs stack. "
                       "Spend gems to unlock more slots.")
    box_w, gap = 128, 8
    x0 = (W - (PET_SLOT_MAX * box_w + (PET_SLOT_MAX - 1) * gap)) / 2
    pulse = 0.5 + 0.5 * math.sin(t * 4)
    for i in range(PET_SLOT_MAX):
        x1 = x0 + i * (box_w + gap)
        y1, y2 = 190, 286
        cx = x1 + box_w / 2
        slot = pets["slots"][i] if i < len(pets["slots"]) else None
        if i < count:
            pet = PET_BY_ID.get(slot["id"]) if slot else None
            edge = pet["color"] if pet else "#2a3162"
            rrect(c, x1, y1, x1 + box_w, y2, 12,
                  fill=mix(edge, "#0a0e22", 0.88) if pet else "#0f1430",
                  outline=edge, width=2 if pet else 1)
            c.create_text(cx, y1 + 12, text=f"SLOT {i + 1}",
                          fill="#8895b2", font=(FONT, 7, "bold"))
            if pet:
                big = slot["huge"] is not None
                pu_orb(self, cx, y1 + 46, 17 if big else 14, pet["color"], t,
                       seed=i * 1.7, huge=big, bg="#0f1430")
                label = ("HUGE " if big else "") + pet["name"]
                c.create_text(cx, y1 + 78, text=label, fill="#ffffff",
                              font=(FONT, 8, "bold"), width=box_w - 12,
                              justify="center")
            else:
                pu_orb(self, cx, y1 + 46, 14, "#4a5190", t, sleepy=True,
                       bg="#0f1430")
                c.create_text(cx, y1 + 78, text="EMPTY", fill="#4a5190",
                              font=(FONT, 9, "bold"))
        else:
            nxt = i == count
            col = "#ffd24d" if nxt else "#252b46"
            rrect(c, x1, y1, x1 + box_w, y2, 12, fill="#0b0f22",
                  outline=mix(col, "#ffffff", 0.2 * pulse) if nxt else col,
                  width=2 if nxt else 1)
            c.create_text(cx, y1 + 12, text=f"SLOT {i + 1}",
                          fill="#667090", font=(FONT, 7, "bold"))
            lock = "#ffd24d" if nxt else "#4a5190"
            if nxt:
                glow(c, cx, y1 + 46, 24, "#ffd24d", layers=3, a=0.14,
                     bg="#0b0f22")
            c.create_arc(cx - 9, y1 + 28, cx + 9, y1 + 52, start=0,
                         extent=180, style="arc", outline=lock, width=3)
            c.create_rectangle(cx - 12, y1 + 42, cx + 12, y1 + 62,
                               fill=lock, outline="")
            c.create_oval(cx - 2, y1 + 48, cx + 2, y1 + 52, fill="#0b0f22",
                          outline="")
            if nxt:
                pu_gem(c, cx - 28, y1 + 80, 5)
                c.create_text(cx - 20, y1 + 80, anchor="w",
                              text=f"{PET_SLOT_COSTS[i - PET_SLOT_BASE]:,}",
                              fill="#ffe066", font=(FONT, 9, "bold"))
            else:
                c.create_text(cx, y1 + 80, text="LOCKED", fill="#667090",
                              font=(FONT, 8, "bold"))
    # upgrade card
    rrect(c, 160, 306, W - 160, 466, 14, fill="#0f1430", outline="#4a5bd0",
          width=2)
    c.create_rectangle(168, 310, 168 + (W - 336) * 0.25, 313, fill="#c78bff",
                       outline="")
    c.create_text(W / 2, 330, text=f"SLOTS UNLOCKED   {count} / "
                  f"{PET_SLOT_MAX}", fill="#ffffff", font=(FONT, 12, "bold"))
    for i in range(PET_SLOT_MAX):
        px = W / 2 - 62 + i * 26
        on = i < count
        c.create_oval(px, 344, px + 18, 362,
                      fill="#ffd24d" if on else "#1c2145",
                      outline="#ffe066" if on else "#39406b", width=2)
    if count >= PET_SLOT_MAX:
        pu_orb(self, W / 2, 408, 16, "#8df0bd", t, bg="#0f1430")
        c.create_text(W / 2, 442, text="ALL SLOTS UNLOCKED",
                      fill="#8df0bd", font=(FONT, 13, "bold"))
    else:
        cost = PET_SLOT_COSTS[count - PET_SLOT_BASE]
        afford = self.gems >= cost
        c.create_text(W / 2, 382, fill="#ffe066", font=(FONT, 12, "bold"),
                      text=f"Unlock slot {count + 1}  ·  {cost:,} gems")
        c.create_text(W / 2, 402, fill="#aab8d5" if afford else "#ff9a9a",
                      font=(FONT, 9),
                      text=f"You have {self.gems:,} gems"
                           + ("" if afford
                              else f"  ({cost - self.gems:,} short)"))
        bw = 200
        c.create_rectangle(W / 2 - bw / 2, 414, W / 2 + bw / 2, 418,
                           fill="#1c2145", outline="")
        c.create_rectangle(W / 2 - bw / 2, 414,
                           W / 2 - bw / 2 + bw * min(1.0, self.gems / cost),
                           418, fill="#4dd8ff" if afford else "#ffd24d",
                           outline="")
        self.button(self.pet_rects, (W / 2 - 90, 424, W / 2 + 90, 458),
                    "UPGRADE", ("upgrade", None),
                    "gold" if afford else "blue", 11)
    c.create_text(W / 2, 486, fill="#7f88b8", font=(FONT, 9),
                  text=f"Slot 4: {PET_SLOT_COSTS[0]:,} gems     ·     "
                       f"Slot 5: {PET_SLOT_COSTS[1]:,} gems")



def _pet_pierce(self):
    value = _pets_base_pierce(self)
    return value + _pet_bonus_amount(self, "piercing")


def _pet_kill_ufo(self, u, src=None):
    before_score, before_credits = self.score, self.credits
    _pets_base_kill_ufo(self, u, src)
    amount = _pet_bonus_amount(self, "credits_score")
    if not amount:
        return
    score_reward = max(0, self.score - before_score)
    credit_reward = max(0, self.credits - before_credits)
    self.score += round(score_reward * amount)
    self.credits += round(credit_reward * amount)


def _pet_hud(self):
    _pets_base_hud(self)
    if self.state not in ("play", "paused"):
        return
    data = getattr(self, "data", {})
    pets = data.get("pets", {}) if isinstance(data, dict) else {}
    pet_id = pets.get("equipped") if isinstance(pets, dict) else None
    if pet_id not in PET_BY_ID:
        return
    pet = PET_BY_ID[pet_id]
    huge_index = pets.get("equipped_huge")
    is_huge = isinstance(huge_index, int) and not isinstance(huge_index, bool)
    buff_name, _, buff_description = pet_buff_details(pet, huge=is_huge)
    if is_huge:
        huge_buffs = pets.get("huge", {}).get(pet_id, [])
        if 0 <= huge_index < len(huge_buffs):
            extra_name, extra_description = pet_buff_description(
                pet, huge_buffs[huge_index])
            buff_description += f" · {extra_name} {extra_description}"
    self.c.create_text(
        W - 10, 191, anchor="ne",
        text=f"PET: {'HUGE ' if is_huge else ''}{pet['name']}  ·  "
             f"{buff_name} {buff_description}",
        fill=pet["color"], font=(FONT, 8, "bold"))



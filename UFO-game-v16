def ms_update(self, dt):
    _ms_prev_update(self, dt)
    m = getattr(self, "mission", None)
    if not m:
        return
    if self.state == "menu":
        self.mission = None
        return
    if m.get("done"):
        return
    if self.data.get("current") is not None:     # never recover a mission
        self.data["current"] = None              # as an ordinary run
        ms_save(self)
    if self.state == "gameover":
        ms_finish(self, False, "Your ship was destroyed.")
    elif self.state in ("shop", "victory") \
            and self.wave >= m["waves"]:
        ms_finish(self, True)



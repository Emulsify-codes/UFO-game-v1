            frac, col = left / MINION_LIFE, "#4dd8ff"
        else:
            frac = 1.0 if ready else 1 - self.minion_cd / MINION_CD
            col = "#7CFC00" if ready else "#b36bff"
        c.create_rectangle(ability_bar_x1, 134,
                           ability_bar_x1 + (ability_bar_x2 - ability_bar_x1)
                           * frac, 142, fill=col, outline="")
        # ricochet cooldown
        ready = self.bounce_cd <= 0

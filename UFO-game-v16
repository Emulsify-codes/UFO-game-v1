def mut_draw_ufo(self, u, ox, oy, scale=1.0):
    mid = u.get("mut")
    hidden = mid == "cloaked" and not u.get("dead") \
        and u.get("mode") != "x" and u.get("t", 0.0) % 3.0 < 1.8
    if not hidden:
        _mut_prev_draw_ufo(self, u, ox, oy, scale)
    if not mid or u.get("dead") or u.get("mode") == "x":
        return
    info = MUTATIONS[mid]
    col = info["color"]
    s = UFO_SPECS[u["kind"]]["size"] * scale * u.get("custom_scale", 1.0)
    x = u["x"] + ox
    y = u["y"] + oy + math.sin(u["t"] * 3 + len(u["kind"])) * 2 * scale
    c = self.c
    c.create_oval(x - s * 1.2, y - s * 0.62, x + s * 1.2, y + s * 0.7,
                  outline=col, width=2, dash=(2, 3))
    if mid == "shielded" and u.get("mshield"):
        c.create_oval(x - s * 1.35, y - s * 0.85, x + s * 1.35, y + s * 0.95,
                      outline="#4dd8ff", width=1)
    if mid == "phasing" and u.get("t", 0.0) % 4.0 > 2.8:
        c.create_oval(x - s, y - s * 0.5, x + s, y + s * 0.55,
                      outline="#ffffff", width=1, dash=(1, 4))
    c.create_text(x, y - s * 0.95 - 8, text=info["name"], fill=col,
                  font=(FONT, 7, "bold"))



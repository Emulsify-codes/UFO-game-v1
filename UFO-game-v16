def wx2_draw_strikes(self, ox, oy):
    c = self.c
    t = time.time()
    bgc = sky(300)
    for s in self.wx2.get("strikes", []):
        x = s["x"] + ox
        storm = s["kind"] == "storm"
        base = "#9fd8ff" if storm else "#ff9f43"
        if not s["done"]:
            k = min(1.0, s["t"] / STRIKE_WARN)
            pulse = 0.5 + 0.5 * math.sin(t * (8 + 14 * k))
            col = "#fff200" if self.high_contrast else mix(
                bgc, mix(base, "#ffffff", pulse * 0.4), 0.35 + 0.65 * k)
            c.create_line(x, 40 + oy, x, GROUND + 34 + oy, fill=col,
                          dash=(6, 6), width=2)
            c.create_oval(x - WX2_PLAYER_HALF, GROUND + 24 + oy,
                          x + WX2_PLAYER_HALF, GROUND + 44 + oy,
                          outline=col, width=2)
            inner = WX2_PLAYER_HALF * (1 - k)
            if inner > 3:
                c.create_oval(x - inner, GROUND + 28 + oy, x + inner,
                              GROUND + 40 + oy, outline=col, width=1)
            if abs(self.px - s["x"]) < WX2_PLAYER_HALF:
                c.create_text(self.px + ox, GROUND - 60 + oy, text="MOVE!",
                              fill=col, font=(FONT, 12, "bold"))
            if not storm:                       # the falling rock
                f = max(0.0, (s["t"] - (STRIKE_WARN - 0.35)) / 0.35)
                if f > 0:
                    ry = -20 + (GROUND + 32) * f + oy
                    for j in range(5):
                        rr = 10 - j * 1.4
                        c.create_oval(x - rr, ry - j * 14 - rr,
                                      x + rr, ry - j * 14 + rr,
                                      fill=mix("#ff6a1f", "#3a1a08", j / 5),
                                      outline="")
        else:
            a = max(0.0, s["hold"] / 0.35)
            if storm:
                pts = [x, -10 + oy]
                yy = -10
                while yy < GROUND + 20:
                    yy += 36
                    pts += [x + random.uniform(-16, 16), yy + oy]
                c.create_line(pts, fill=mix(bgc, base, a), width=7)
                c.create_line(pts, fill=mix(bgc, "#ffffff", a), width=3)
            else:
                r = 20 + 60 * (1 - a)
                c.create_oval(x - r, GROUND + 30 - r * 0.3 + oy, x + r,
                              GROUND + 30 + r * 0.3 + oy,
                              outline=mix(bgc, base, a), width=3)



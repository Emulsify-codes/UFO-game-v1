# ---- drawing helpers ----------------------------------------------------------------
def ms_star(c, x, y, r, col):
    pts = []
    for k in range(10):
        rr = r if k % 2 == 0 else r * 0.45
        a = k * math.pi / 5 - math.pi / 2
        pts += [x + math.cos(a) * rr, y + math.sin(a) * rr]
    c.create_polygon(pts, fill=col, outline="")


def ms_draw_galaxy(self, p, x, y, r, dim, t):
    c = self.c
    pid = p["id"]
    col = mix(p["color"], "#05060f", 0.68) if dim else p["color"]
    rnd = random.Random(pid)
    if not dim:
        glow(c, x, y, r + 14, p["color"], layers=3, a=0.16)
    flat, tilt, arms, spin = 1.0, 0.0, 2, 0.12
    if pid == "andromeda":
        flat, tilt, spin = 0.38, -0.5, 0.0
    elif pid == "sombrero":
        flat, tilt, arms, spin = 0.28, 0.0, 2, 0.0
    elif pid == "triangulum":
        arms = 3
    rot = tilt + (t * spin if not dim else 0.0)
    cr, sr = math.cos(rot), math.sin(rot)

    def put(px, py, rr, colr):
        c.create_oval(x + px * cr - py * sr - rr, y + px * sr + py * cr - rr,
                      x + px * cr - py * sr + rr, y + px * sr + py * cr + rr,
                      fill=colr, outline="")
    if pid == "cartwheel":
        for k in range(0, 360, 20):
            a = math.radians(k) + rot
            put(math.cos(a) * r * 0.62, math.sin(a) * r * 0.62, 1.4,
                mix(col, "#ffffff", 0.2))
        for k in range(30):
            a = k * math.tau / 30 + rot
            put(math.cos(a) * r * 0.95, math.sin(a) * r * 0.95,
                1.6 + rnd.random(), mix(col, "#ffffff", 0.35))
        for k in range(0, 360, 60):
            a = math.radians(k) + rot
            c.create_line(x, y, x + math.cos(a) * r * 0.9,
                          y + math.sin(a) * r * 0.9,
                          fill=mix(col, "#05060f", 0.5), width=1)
        put(0, 0, r * 0.14, mix(col, "#ffffff", 0.7))
        return
    n = 34
    for arm in range(arms):
        for k in range(n):
            th = arm * math.tau / arms + k * 0.2
            rr = r * (0.14 + 0.86 * k / n)
            px = rr * math.cos(th) + rnd.uniform(-2, 2)
            py = (rr * math.sin(th) + rnd.uniform(-2, 2)) * flat
            put(px, py, 1.0 + 1.3 * (1 - k / n),
                mix(col, "#ffffff", 0.15 + 0.55 * rnd.random()
                    * (1 - k / n)))
    if pid == "sombrero":
        c.create_oval(x - r, y - r * 0.2, x + r, y + r * 0.2,
                      outline=mix(col, "#05060f", 0.2), width=1)
        c.create_line(x - r * 0.9, y + 1, x + r * 0.9, y + 1,
                      fill="#1a1020" if not dim else "#0a0810", width=2)
    if pid == "whirlpool":
        put(r * 0.95, -r * 0.8, r * 0.16, mix(col, "#ffffff", 0.4))
    put(0, 0, r * (0.22 if pid != "sombrero" else 0.3),
        mix(col, "#ffffff", 0.55))


def ms_draw_planet(self, p, x, y, r, dim=False, t=0.0):
    if p.get("sys") == "gal":
        return ms_draw_galaxy(self, p, x, y, r, dim, t)
    c = self.c
    col = p["color"]
    body = mix(col, "#05060f", 0.65) if dim else col
    pid = p["id"]
    if not dim:
        glow(c, x, y, r + 10, col, layers=3, a=0.2)
    if pid == "saturn":
        rw, rh = r * 1.85, r * 0.5
        ring = mix(col, "#05060f", 0.6 if dim else 0.15)
        c.create_oval(x - rw, y - rh, x + rw, y + rh, outline=ring, width=3)
    c.create_oval(x - r, y - r, x + r, y + r, fill=body,
                  outline=mix(body, "#ffffff", 0.25), width=1)
    shade = mix(body, "#000000", 0.45)
    if pid in ("jupiter", "saturn", "venus"):
        for dy, k in ((-0.55, 0.6), (-0.15, 0.9), (0.3, 0.8), (0.65, 0.5)):
            hw = math.sqrt(max(0.0, 1 - (dy * 1.0) ** 2)) * r * 0.92
            c.create_line(x - hw, y + dy * r, x + hw, y + dy * r,
                          fill=shade, width=max(1, int(r / 9)))
    elif pid == "earth":
        for ox_, oy_, rr in ((-0.3, -0.2, 0.34), (0.35, 0.25, 0.28),
                             (-0.1, 0.5, 0.2)):
            c.create_oval(x + ox_ * r - rr * r, y + oy_ * r - rr * r,
                          x + ox_ * r + rr * r, y + oy_ * r + rr * r,
                          fill="#2f9e57" if not dim else "#1a3d2a",
                          outline="")
    elif pid == "mars":
        c.create_oval(x - r * 0.35, y - r * 0.98, x + r * 0.35, y - r * 0.55,
                      fill="#f2e6e0" if not dim else "#3a3030", outline="")
        c.create_oval(x - r * 0.4, y + r * 0.1, x - r * 0.05, y + r * 0.4,
                      fill=shade, outline="")
    elif pid == "mercury":
        for ox_, oy_ in ((-0.3, -0.2), (0.3, 0.3), (0.1, -0.5)):
            c.create_oval(x + ox_ * r - 2, y + oy_ * r - 2, x + ox_ * r + 2,
                          y + oy_ * r + 2, fill=shade, outline="")
    elif pid == "proxima":
        c.create_oval(x - r * 0.1, y - r * 0.95, x + r * 0.95, y + r * 0.95,
                      fill=mix(body, "#000000", 0.5), outline="")
        c.create_oval(x - r * 0.6, y - r * 0.4, x - r * 0.1, y + r * 0.1,
                      fill=mix(body, "#ffd9a0", 0.35), outline="")
    elif pid == "trappist":
        c.create_oval(x - r * 0.9, y - r * 0.9, x + r * 0.9, y - r * 0.5,
                      fill="#e8f8ff" if not dim else "#2a3640", outline="")
        c.create_oval(x - r * 0.3, y - r * 0.1, x + r * 0.6, y + r * 0.5,
                      fill=shade, outline="")
    elif pid == "kepler452":
        for ox_, oy_, rr in ((-0.35, -0.1, 0.4), (0.3, 0.3, 0.3),
                             (0.1, -0.5, 0.2)):
            c.create_oval(x + ox_ * r - rr * r, y + oy_ * r - rr * r,
                          x + ox_ * r + rr * r, y + oy_ * r + rr * r,
                          fill="#2b7a3a" if not dim else "#16301c", outline="")
    elif pid == "pegasi":
        for dy in (-0.55, -0.1, 0.35, 0.7):
            hw = math.sqrt(max(0.0, 1 - dy * dy)) * r * 0.92
            c.create_line(x - hw, y + dy * r, x + hw, y + dy * r,
                          fill="#ffd24d" if not dim else shade, width=2)
    elif pid == "hd189733":
        for dy in (-0.4, 0.2, 0.6):
            hw = math.sqrt(max(0.0, 1 - dy * dy)) * r * 0.9
            c.create_line(x - hw, y + dy * r, x + hw, y + dy * r,
                          fill="#9fb8ff" if not dim else shade, width=1)
    elif pid in ("uranus", "neptune"):
        c.create_oval(x - r * 0.5, y - r * 0.4, x + r * 0.1, y + r * 0.1,
                      fill=mix(body, "#ffffff", 0.18), outline="")
    if pid == "saturn":
        rw, rh = r * 1.85, r * 0.5
        c.create_arc(x - rw, y - rh, x + rw, y + rh, start=180, extent=180,
                     style="arc",
                     outline=mix(col, "#05060f", 0.6 if dim else 0.15),
                     width=3)


def ms_planet_pos(j, tab="sol"):
    if tab in ("exo", "gal"):
        return 210 + j * 104, 236 + 22 * math.sin(j * 1.7)
    return 176 + j * 71, 232 + 18 * math.sin(j * 1.4)



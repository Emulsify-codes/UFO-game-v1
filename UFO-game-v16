def _pets2_hud(self):
    _pets2_prev_hud(self)
    if self.state not in ("play", "paused"):
        return
    pets = self.data.get("pets", {})
    huge = pets.get("huge", {})
    y = 191
    for slot in pets.get("slots", []):
        pet = PET_BY_ID.get(slot.get("id"))
        if pet is None:
            continue
        idx = slot.get("huge")
        buffs = huge.get(pet["id"], [])
        is_huge = isinstance(idx, int) and not isinstance(idx, bool) \
            and 0 <= idx < len(buffs)
        name, desc = pet_buff_description(
            pet, pet_buff_details(pet)[1], huge=is_huge)
        if is_huge:
            extra_name, extra_desc = pet_buff_description(pet, buffs[idx])
            desc += f" · {extra_name} {extra_desc}"
        self.c.create_text(
            W - 10, y, anchor="ne",
            text=f"PET: {'HUGE ' if is_huge else ''}{pet['name']}  ·  "
                 f"{name} {desc}",
            fill=pet["color"], font=(FONT, 8, "bold"))
        y += 12



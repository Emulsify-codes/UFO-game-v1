_mut_prev_hurt = Game.hurt_player


def mut_hurt_player(self, dmg):
    if self.inv > 0 or self.state != "play":
        _mut_prev_hurt(self, dmg)
        return
    if mut_has(self, "giant"):
        dmg = min(dmg, 1)
    if mut_has(self, "tiny") and random.random() < 0.08:
        self.inv = 0.5
        mut_float(self, self.px, GROUND - 70, "ROLL", 0.8)
        return
    if mut_has(self, "armored") and random.random() < 0.20:
        self.inv = 0.5
        mut_float(self, self.px, GROUND - 70, "DEFLECT", 0.8)
        self.sfx("deny")
        return
    if mut_has(self, "shielded") and getattr(self, "mut_aegis", 0.0) <= 0:
        self.mut_aegis = 25.0
        self.inv = 0.8
        self.rings.append([self.px, GROUND, 90, 0.4, 0.4, "#4dd8ff"])
        mut_float(self, self.px, GROUND - 70, "AEGIS", 0.9)
        return
    for o in self.ufos:
        if o.get("mut") == "vampiric" and not o.get("dead"):
            o["hp"] = min(o["maxhp"], o["hp"] + o["maxhp"] * 0.25)
    hp0 = self.hp
    _mut_prev_hurt(self, dmg)
    if 0 < self.hp < hp0:
        if mut_has(self, "phasing"):
            self.inv += 0.8
        if mut_has(self, "haunted") and self.hp <= 1:
            self.inv += 0.6
        if mut_has(self, "slippery"):
            self.ebullets = []
        if mut_has(self, "thorned"):
            for o in list(self.ufos):
                if not o.get("dead") and o.get("mode") != "x" \
                        and o["y"] > 0:
                    self.hurt_ufo(o, 2, "shock")



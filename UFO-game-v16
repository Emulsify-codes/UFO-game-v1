_bh_prev_update = Game.update


def bh_update(self, dt):
    play0 = self.state == "play"
    hole = play0 and bh_active(self)
    shield = play0 and self.shield_t > 0
    if hole:                                  # bullets can't hurt a UFO now
        bh_absorb(self)
        self.bullets = _AbsorbList(self.bullets)
    if shield:
        shield_absorb(self, dt)
    try:
        _bh_prev_update(self, dt)
    finally:
        if isinstance(self.bullets, _AbsorbList):
            self.bullets = list(self.bullets)
    if not play0 or self.state != "play":
        return
    if hole:                                  # bullets fired this very frame
        bh_absorb(self)
    if getattr(self, "weather", None) == "blackhole":
        bh_tick(self, dt)
    if shield:
        shield_absorb(self, dt)
    self.shield_flash = max(0.0, self.shield_flash - dt)
    self.shield_cd = max(0.0, self.shield_cd - dt)
    if self.shield_t > 0:
        self.shield_t -= dt
        if self.shield_t <= 0:
            self.shield_t = 0.0
            self.floaters.append([self.px, GROUND - 70, "SHIELD DOWN", 0.9])
            self.sfx("shield_down")



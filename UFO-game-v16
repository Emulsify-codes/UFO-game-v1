def sk_ranks(self):
    d = self.data.setdefault("skills", dict(ranks={}))
    return d.setdefault("ranks", {})


def sk(self, sid):
    try:
        return self.data["skills"]["ranks"].get(sid, 0)
    except (KeyError, AttributeError):
        return 0


def sk_prereq(sid):
    """The skill that must have a rank before this one (None for the first)."""
    idx = [s[0] for s in SKILLS]
    i = idx.index(sid)
    if i == 0 or SKILLS[i - 1][1] != SKILLS[i][1]:
        return None
    return SKILLS[i - 1][0]


def sk_spent(self):
    return sum(SKILL_BY_ID[k][4] * n for k, n in sk_ranks(self).items()
               if k in SKILL_BY_ID)


def sk_bonus(self):
    try:
        return int(self.data["skills"].get("bonus", 0))
    except (KeyError, AttributeError, TypeError, ValueError):
        return 0


def sk_bonus_add(self, n):
    d = self.data.setdefault("skills", dict(ranks={}))
    d["bonus"] = sk_bonus(self) + int(n)


def sk_earned(self):
    return self.level_progress[0] * SKILL_POINTS_PER_LEVEL + sk_bonus(self)


def sk_free(self):
    return max(0, sk_earned(self) - sk_spent(self))



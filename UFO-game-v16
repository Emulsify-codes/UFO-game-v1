    self.shield_cd = self.shield_cd_max = SHIELD_COOLDOWN * k
    self.shield_t = SHIELD_DURATION
    self.explode(self.px, GROUND - 10, "#8affff", 22, 240)
    self.rings.append([self.px, GROUND + 8, SHIELD_RADIUS * 2, 0.45, 0.45,
                       "#8affff"])
    self.floaters.append([self.px, GROUND - 70, "PLASMA SHIELD", 1.2])
    self.sfx("shield_up")


def shield_absorb(self, dt):
    """Destroy every UFO bullet that reaches the dome (swept by one frame of
    travel so fast bullets and a moving gun can't slip through)."""
    cx, cy = self.px, GROUND + 8
    sweep = PLAYER_SPEED * dt * 1.2
    keep, hit = [], 0
    for e in self.ebullets:
        reach = SHIELD_RADIUS + math.hypot(e[2], e[3]) * dt * 1.2 + sweep
        if math.hypot(e[0] - cx, e[1] - cy) <= reach:
            hit += 1
            self.explode(e[0], e[1], "#8affff", 4, 120)
        else:
            keep.append(e)
    if hit:
        self.ebullets = keep
        self.shield_flash = 0.25
        self.sfx("shield_hit")


def ps_key_down(self, e):
    if self.state == "play":
        k = e.keysym.lower()
        if k == SHIELD_KEY and k not in _feature_controls(self).values():
            if getattr(self, "freeze_t", 0.0) <= 0:        # frozen: no input
                self.activate_shield()
            return
    _ps_prev_key_down(self, e)


def ps_draw_player(self, ox, oy):
    _ps_prev_draw_player(self, ox, oy)
    if self.shield_t <= 0 or self.state not in ("play", "paused"):
        return
    if self.shield_t < 1.2 and int(self.shield_t * 8) % 2 == 0:
        return                                        # blinks as it ends
    c = self.c
    t = time.time()
    x, y = self.px + ox, GROUND + 8 + oy
    R = SHIELD_RADIUS
    flash = max(0.0, self.shield_flash) / 0.25
    a, b = "#8affff", "#ff7bff"
    if self.high_contrast:
        a = b = "#fff200"
    glow(c, x, y, R * 1.25, a, layers=4, a=0.18 + 0.25 * flash)
    c.create_oval(x - R, y - R, x + R, y + R, outline=mix(a, "#ffffff", flash),
                  width=2 + int(2 * flash))
    c.create_oval(x - R + 5, y - R + 5, x + R - 5, y + R - 5,
                  outline=mix(b, "#05060f", 0.45), width=1, dash=(3, 5))
    for i in range(3):                                # crackling plasma arcs
        start = (t * 160 + i * 120) % 360
        c.create_arc(x - R, y - R, x + R, y + R, start=start, extent=60,
                     style="arc", outline=b if i % 2 else a, width=3)
    for _ in range(2):                                # little lightning forks
        ang = random.uniform(0, math.tau)
        r0, r1 = R - 8, R + 4
        c.create_line(x + math.cos(ang) * r0, y + math.sin(ang) * r0,
                      x + math.cos(ang + 0.15) * (R - 2)
                      + random.uniform(-3, 3),
                      y + math.sin(ang + 0.15) * (R - 2)
                      + random.uniform(-3, 3),
                      x + math.cos(ang + 0.05) * r1,
                      y + math.sin(ang + 0.05) * r1, fill="#ffffff", width=1)


def ps_draw_hud(self):
    _ps_prev_hud(self)
    if self.state not in ("play", "paused"):
        return
    c = self.c
    on = self.shield_t > 0
    ready = self.shield_cd <= 0
    col = "#fff200" if self.high_contrast else "#8affff"
    rrect(c, 8, 320, 160, 344, 9, fill="#0b0f26",
          outline=col if on else "#3a4690", width=2)
    lab = "#ffffff" if on else (col if ready else "#8a93c9")
    c.create_text(16, 332, anchor="w", fill=lab, font=(FONT, 9, "bold"),
                  text=f"[{SHIELD_KEY.upper()}] SHIELD")
    c.create_rectangle(98, 328, 150, 336, fill="#171c3e", outline="")
    if on:
        frac, bar = self.shield_t / SHIELD_DURATION, col
    elif ready:
        frac, bar = 1.0, "#7CFC00"
    else:
        frac = 1 - self.shield_cd / max(0.1, self.shield_cd_max)
        bar = mix(col, "#171c3e", 0.45)
    c.create_rectangle(98, 328, 98 + 52 * max(0.0, min(1.0, frac)), 336,
                       fill=bar, outline="")
    if on:
        c.create_rectangle(97, 327, 151, 337, outline=col, width=1)



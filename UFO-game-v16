    # ---- badges -----------------------------------------------------
    def draw_badge_icon(self, kind, cx, cy, r, col):
        c = self.c
        if kind == "star":
            pts = []
            for i in range(10):
                rr = r if i % 2 == 0 else r * 0.42
                a = i * math.pi / 5 - math.pi / 2
                pts += [cx + math.cos(a) * rr, cy + math.sin(a) * rr]
            c.create_polygon(pts, fill=col, outline="")
        elif kind == "target":
            for rr, f in ((r, col), (r * 0.68, "#0b0f26"), (r * 0.38, col)):
                c.create_oval(cx - rr, cy - rr, cx + rr, cy + rr, fill=f,
                              outline="")
        elif kind == "ufo":
            c.create_oval(cx - r * 0.5, cy - r * 0.8, cx + r * 0.5,
                          cy + r * 0.05, fill=mix(col, "#ffffff", 0.5),
                          outline="")
            c.create_oval(cx - r, cy - r * 0.2, cx + r, cy + r * 0.6,
                          fill=col, outline="")
        elif kind == "gun":
            for a in (-0.6, 0, 0.6):
                c.create_line(cx, cy + r * 0.9, cx + math.sin(a) * r * 1.7,
                              cy + r * 0.9 - math.cos(a) * r * 1.7, fill=col,
                              width=3, capstyle="round")
        elif kind == "wave":
            pts = []
            for fx, fy in ((-1, .4), (-.5, -.4), (0, .4), (.5, -.4), (1, .4)):
                pts += [cx + fx * r, cy + fy * r]
            c.create_line(pts, fill=col, width=3, joinstyle="round")
        elif kind == "plus":
            c.create_rectangle(cx - r * 0.3, cy - r, cx + r * 0.3, cy + r,
                               fill=col, outline="")
            c.create_rectangle(cx - r, cy - r * 0.3, cx + r, cy + r * 0.3,
                               fill=col, outline="")
        else:
            shapes = {
                "bolt": ((.15, -1), (-.55, .1), (-.05, .1), (-.2, 1),
                         (.6, -.2), (.05, -.2)),
                "shield": ((-.8, -.8), (.8, -.8), (.8, .1), (0, 1), (-.8, .1)),
                "crown": ((-1, .7), (-1, -.6), (-.5, 0), (0, -.9), (.5, 0),
                          (1, -.6), (1, .7)),
                "diamond": ((0, -1), (.8, 0), (0, 1), (-.8, 0)),
            }[kind]
            pts = []
            for fx, fy in shapes:
                pts += [cx + fx * r, cy + fy * r]
            c.create_polygon(pts, fill=col, outline="")


    v / (1 + 0.1 * s.ench_lvl("abyssal_ascendance") / 3)
    if s.hp > s.max_hp / 2 else v))


def _cd_wrap(method, attr):
    orig = getattr(Game, method)

    def w(self):
        before = getattr(self, attr)
        orig(self)
        after = getattr(self, attr)
        if before <= 0 < after:         # the weapon really fired
            k = max(0.2, 1 - 0.08 * self.ench_lvl("cooldown"))
            setattr(self, attr, after * k)
    w.__name__ = method
    setattr(Game, method, w)


_cd_wrap("fire_missile", "missile_cd")

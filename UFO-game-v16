def pets_on_click(self, event):
    x, y = self.c.to_game(event.x, event.y)
    if self.state == "menu" and self.hit(self.menu_rects, x, y) == "pets":
        self.mouse_x, self.mouse_y = x, y
        self.open_pets()
        return
    if self.state == "pets":
        self.mouse_x, self.mouse_y = x, y
        action = self.hit(self.pet_rects, x, y)
        if action == "back":
            self.close_leaderboard()
        elif isinstance(action, tuple):
            kind, value = action[:2]
            if kind == "tab":
                self.pets_tab = value
                self.pet_scroll = 0
            elif kind == "buy":
                buy_pet_egg(self, value)
            elif kind == "hatch":
                hatch_pet_egg(self, value)
            elif kind == "rarity":
                self.pet_rarity = value
                self.pet_scroll = 0
            elif kind == "equip":
                pets = self.data["pets"]
                pet_id, huge_index = value, action[2]
                already_equipped = pets["equipped"] == pet_id and \
                    pets["equipped_huge"] == huge_index
                pets["equipped"] = None if already_equipped else pet_id
                pets["equipped_huge"] = (
                    None if already_equipped else huge_index)
                self.save_ok = save_data(self.data)
                self.pet_message = ("Companion unequipped."
                                    if pets["equipped"] is None
                                    else f"{'Huge ' if huge_index is not None else ''}"
                                         f"{PET_BY_ID[pet_id]['name']} equipped.")
                self.pet_message_t = 2.0
                self.sfx("click")
            elif kind == "equip_huge":
                pets = self.data["pets"]
                huge_buffs = pets["huge"][value]
                current_index = pets["equipped_huge"]
                if pets["equipped"] == value and current_index is not None:
                    next_index = current_index + 1
                    if next_index >= len(huge_buffs):
                        pets["equipped"] = None
                        pets["equipped_huge"] = None
                    else:
                        pets["equipped_huge"] = next_index
                else:
                    pets["equipped"] = value
                    pets["equipped_huge"] = 0
                self.save_ok = save_data(self.data)
                if pets["equipped"] is None:
                    self.pet_message = "Companion unequipped."
                else:
                    self.pet_message = (
                        f"Huge {PET_BY_ID[value]['name']} "
                        f"({pets['equipped_huge'] + 1}/{len(huge_buffs)}) equipped.")
                self.pet_message_t = 2.0
                self.sfx("click")
            elif kind == "combine":
                _combine_huge_pet(self, value)
        return
    _pets_previous_on_click(self, event)


def pets_on_key_down(self, event):
    key = event.keysym.lower()
    if self.state == "menu" and key == "p":
        self.open_pets()

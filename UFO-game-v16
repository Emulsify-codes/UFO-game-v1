def load_data():
    data = _ms_prev_load_data()
    cleared = {}
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = None
    saved = raw.get("missions") if isinstance(raw, dict) else None
    saved = saved.get("cleared") if isinstance(saved, dict) else None
    if isinstance(saved, dict):
        for k, v in saved.items():
            if k in MS_BY_ID and isinstance(v, dict):
                stars = v.get("stars", 1)
                clears = v.get("clears", 1)
                cleared[k] = dict(
                    stars=min(3, max(1, stars if isinstance(stars, int) else 1)),
                    clears=clears if isinstance(clears, int) and clears > 0
                    else 1)
    data["missions"] = dict(cleared=cleared)
    return data



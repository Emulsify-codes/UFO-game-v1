def _pet_damage(self):
    value = _pets_base_damage(self)
    amount = _pet_bonus_amount(self, "damage")
    return round(value * (1 + amount), 2) if amount else value


def _pet_power(self):
    value = _pets_base_power(self)
    amount = _pet_bonus_amount(self, "damage")
    return value * (1 + amount) if amount else value


def _pet_delay(self):
    value = _pets_base_delay(self)
    amount = _pet_bonus_amount(self, "fire_rate")

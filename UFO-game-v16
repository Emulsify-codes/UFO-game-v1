def sk_kill_ufo(self, u, src=None):
    s0, c0 = self.score, self.credits
    _sk_prev_kill(self, u, src)
    gain_s, gain_c = self.score - s0, self.credits - c0
    if gain_s <= 0 and gain_c <= 0:
        return                       # nothing died (e.g. a shield broke)
    r = sk(self, "hunter")
    if r:
        self.score += round(gain_s * 0.04 * r)
    r = sk(self, "streak")
    if r and getattr(self, "combo", 0) >= 10:
        self.score += round(gain_s * 0.05 * r)
    if sk(self, "midas"):
        self.credits += round(gain_c * 0.25)
    r = sk(self, "bounty")
    if r and u.get("mut"):
        self.credits += 20 * r
    r = sk(self, "frenzy")
    if r and random.random() < 0.05 * r:
        self.cooldown = 0.0
    r = sk(self, "scav")
    if r:
        self.credits += round(gain_c * 0.05 * r)
    r = sk(self, "jackpot")
    if r and random.random() < 0.02 * r:
        self.credits += gain_c * 2
        self.floaters.append([u["x"], u["y"] - 20, "JACKPOT", 0.9])
    r = sk(self, "salvage")
    if r and 0 < self.hp < self.max_hp and random.random() < 0.02 * r:
        self.hp += 1
        self.floaters.append([u["x"], u["y"] - 20, "+1 HULL", 0.9])
    r = sk(self, "chain")
    if r and getattr(self, "combo", 0) > 0:
        self.combo_t += 0.3 * r



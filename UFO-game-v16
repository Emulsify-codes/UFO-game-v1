    @property
    def damage(self):
        return 1 + self.level["damage"]

    @property
    def power(self):
        """Damage multiplier for missiles and beams (Bullet Damage upgrades
        make them hit harder too)."""
        return 1.0 + 0.15 * self.level["damage"]

    @property
    def delay(self):
        return 0.42 * (0.84 ** self.level["rate"])

    @property
    def bullet_speed(self):
        return 520 + 70 * self.level["speed"]

    @property
    def shots(self):
        return 1 + self.level["multi"]

    @property
    def pierce(self):
        return self.level["pierce"]

    @property
    def knock(self):
        return self.level["knock"]

    @property
    def gems(self):
        return self.data["gems"]

    @property
    def lifetime_score(self):
        """Score across saved runs, plus the current run until it is saved."""
        saved_score = sum(run["score"] for run in self.scores)
        return saved_score + (self.score if not self.run_saved else 0)

    @property
    def level_progress(self):
        return level_progress_for_xp(self.lifetime_score // 1000)

    @property
    def bullet_skin(self):
        return BULLET_BY_ID[self.data["skins"]["bullet"]]

    @property
    def gun_skin(self):
        return GUN_BY_ID[self.data["skins"]["gun"]]

    @property
    def missile_skin(self):
        return MISSILE_BY_ID[self.data["skins"]["missile"]]

    @property
    def max_hp(self):
        return 5 + 2 * self.level["hull"]

    def cost(self, key):
        for k, _, _, mx, base, mult in UPGRADES:
            if k == key:
                return int(base * mult ** self.level[k])


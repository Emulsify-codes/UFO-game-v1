    fire_control = next(
        (b for b in self.run_bonuses if b["id"] == "fire_control"), None)
    if fire_control:
        delay /= 1 + fire_control["tier_values"][fire_control["tier"] - 1]
    return delay


def _feature_update_game(self, dt):
    cleared_before = self.cleared_wave
    bullets_before = {id(b) for b in self.ebullets}
    _base_update(self, dt)
    if self.active_modifier == "overclock":
        for bullet in self.ebullets:
            if id(bullet) not in bullets_before:
                bullet[2] *= 1.25
                bullet[3] *= 1.25
    if self.cleared_wave > cleared_before \
            and self.cleared_wave > self._processed_clear:
        self._processed_clear = self.cleared_wave
        _grant_modifier_reward(self)
        regen = next(
            (b for b in self.run_bonuses if b["id"] == "hull_regen"),
            None)
        if regen:
            restored = min(
                regen["tier_values"][regen["tier"] - 1],
                self.max_hp - self.hp)
            if restored > 0:
                self.hp += restored
                self.floaters.append([
                    self.px, GROUND - 70, f"+{restored} HULL", 1.0])
        current = self.data.get("current")
        if isinstance(current, dict) and not self.run_saved:
            current["score"] = self.score
            current["cleared_wave"] = self.cleared_wave
            self.save_ok = save_data(self.data)
        for bonus in self.run_bonuses:
            bonus["waves_left"] -= 1
        self.run_bonuses = [b for b in self.run_bonuses
                            if b["waves_left"] > 0]
        self.active_modifier = None


def _feature_bonus_kill_ufo(self, u, src=None):
    credits_before = self.credits
    _feature_bonus_kill_ufo.original(self, u, src)
    bonus = next(
        (b for b in self.run_bonuses if b["id"] == "salvage_crew"), None)
    if bonus:
        earned = max(0, self.credits - credits_before)
        self.credits += round(
            earned * bonus["tier_values"][bonus["tier"] - 1])


def _grant_modifier_reward(self):
    if not self.active_modifier or self._modifier_rewarded_wave == self.wave:
        return
    modifier = next(m for m in WAVE_MODIFIERS
                    if m["id"] == self.active_modifier)
    self.credits += modifier["reward"]
    self.score += modifier["reward"]
    self.run_modifier_rewards += modifier["reward"]
    self._modifier_rewarded_wave = self.wave
    self.floaters.append([
        self.px, GROUND - 90,
        f"{modifier['name']} CLEAR  +{modifier['reward']}", 1.6])



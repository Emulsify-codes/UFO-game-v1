# ---- bullets that can never hurt a UFO (used while a black hole is open) -------
class _AllSet(set):
    """A 'hit' set that claims it already contains every UFO, so the normal
    bullet-vs-UFO test skips the bullet."""

    def __contains__(self, item):
        return True


class _AbsorbList(list):
    """self.bullets while a black hole is open: any bullet added during the
    frame (the gun, minions...) is born harmless."""

    def append(self, b):
        if isinstance(b, dict):
            b["hit"] = _AllSet(b.get("hit") or ())
        list.append(self, b)

    def extend(self, items):
        for b in items:
            self.append(b)



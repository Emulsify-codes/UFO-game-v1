    def on_key_down(self, e):
        k = e.keysym.lower()
        self.keys.add(k)
        if k in ("f11", "f"):
            self.set_fullscreen(not self.fullscreen)
            return
        if k == "s":
            self.toggle_sound()
            return
        if k == "escape" and self.fullscreen and \
                self.state in ("menu", "mode_select", "difficulty_select",
                               "play", "paused", "shop"):
            self.set_fullscreen(False)
            return
        if self.state == "menu":
            if k in ("return", "space"):
                self.show_mode_select()
            elif k == "l":
                self.open_leaderboard("menu")
            elif k == "b":
                self.open_badges()
            elif k == "k":
                self.open_skins()
            elif k == "i":
                self.open_index()
            elif k == "e":
                self.open_enchantments()
            elif k == "g":
                self.open_levels()
        elif self.state == "mode_select":
            if k in ("escape", "backspace"):
                self.state = "menu"
                self.sfx("click")
            elif k in ("return", "space", "n"):
                self.show_difficulty_select("normal")
            elif k == "i":
                self.show_difficulty_select("infinity")
            elif k == "a":
                self.show_difficulty_select("adaptive")
        elif self.state == "difficulty_select":
            if k in ("escape", "backspace"):
                self.state = "mode_select"
                self.sfx("click")
            else:
                difficulty_keys = {
                    "1": "easy", "e": "easy",
                    "2": "normal", "n": "normal",
                    "3": "hard", "h": "hard",
                    "4": "nightmare", "m": "nightmare",
                }
                difficulty = difficulty_keys.get(k)
                if difficulty:
                    self.start_game(self.selected_run_mode, difficulty)
        elif self.state == "skins":
            if k in ("escape", "backspace", "b", "return"):
                self.close_leaderboard()
            elif k in ("left", "right", "tab"):
                step = -1 if k == "left" else 1
                i = (SKIN_TABS.index(self.skin_tab) + step) % len(SKIN_TABS)
                self.skin_tab = SKIN_TABS[i]
                self.skin_scroll = 0
                self.sfx("click")
            elif k == "up":
                self.scroll_lb(-1)
            elif k == "down":
                self.scroll_lb(1)
            elif k == "prior":
                self.scroll_lb(-SK_VISIBLE)
            elif k == "next":
                self.scroll_lb(SK_VISIBLE)
            elif k.replace("kp_", "").isdigit():
                # number keys pick one of the rows currently on screen
                i = int(k.replace("kp_", "")) - 1 + self.skin_scroll
                lst = SKIN_CATS[self.skin_tab][0]
                if self.skin_scroll <= i < min(len(lst),
                                               self.skin_scroll + SK_VISIBLE):
                    self.skin_click(self.skin_tab, lst[i]["id"])
        elif self.state in ("leaderboard", "badges"):
            page = LB_VISIBLE if self.state == "leaderboard" else BD_VISIBLE
            if k in ("escape", "backspace", "return", "b"):
                self.close_leaderboard()
            elif k == "up":
                self.scroll_lb(-1)
            elif k == "down":
                self.scroll_lb(1)
            elif k == "prior":
                self.scroll_lb(-page)
            elif k == "next":
                self.scroll_lb(page)
        elif self.state == "index":
            if k in ("escape", "backspace", "return", "b", "i"):
                self.close_leaderboard()
            elif k in ("left", "right", "tab"):
                self.index_tab = ("pets" if self.index_tab == "ufos"
                                  else "ufos")
                self.index_scroll = 0
                self.sfx("click")
            elif k == "up":
                self.scroll_lb(-1)
            elif k == "down":
                self.scroll_lb(1)
            elif k == "prior":
                self.scroll_lb(-INDEX_VISIBLE)
            elif k == "next":
                self.scroll_lb(INDEX_VISIBLE)
        elif self.state == "enchantments":
            if k in ("escape", "backspace", "return", "b", "e"):
                self.close_leaderboard()
            elif k == "up":
                self.scroll_lb(-1)
            elif k == "down":
                self.scroll_lb(1)
            elif k == "prior":
                self.scroll_lb(-INDEX_VISIBLE)
            elif k == "next":
                self.scroll_lb(INDEX_VISIBLE)
        elif self.state == "levels":
            if k in ("escape", "backspace", "return", "b", "g"):
                self.close_leaderboard()
        elif self.state == "shop":
            if k in ("return", "space"):
                self.start_wave()
            elif k.replace("kp_", "").isdigit():      # number row or keypad
                i = int(k.replace("kp_", "")) - 1
                if 0 <= i < len(UPGRADES):
                    self.buy(UPGRADES[i][0])
                elif i == len(UPGRADES):
                    self.buy("repair")
        elif self.state == "gameover":
            if k in ("r", "return"):
                self.start_game(self.run_mode, self.difficulty)
            elif k in ("m", "escape"):
                self.go_menu()
            elif k == "l":
                self.open_leaderboard("gameover")
        elif self.state == "victory":
            if k in ("r", "return"):
                self.start_game(self.run_mode, self.difficulty)
            elif k in ("m", "escape"):
                self.go_menu()
            elif k == "l":
                self.open_leaderboard("victory")
        elif self.state == "play" and k == "t":
            self.fire_missile()
        elif self.state == "play" and k == "b":
            self.fire_bounce()
        elif self.state == "play" and k == "m":
            self.summon_minions()
        elif self.state == "play" and k == "v":
            self.begin_charge()
        elif self.state in ("play", "paused") and k == "p":
            self.state = "paused" if self.state == "play" else "play"
            self.cancel_charge()
            self.sfx("pause")
            self.last = time.time()

    def on_key_up(self, e):
        k = e.keysym.lower()
        self.keys.discard(k)
        if k == "v" and self.charging:
            # Some systems send a fake release between auto-repeated key
            # presses, so the release is only acted on if no new press follows
            # right away (see update_charge).
            self.charge_up_t = time.time()

    def on_motion(self, e):
        self.mouse_x, self.mouse_y = self.c.to_game(e.x, e.y)
        if self.state == "play":
            self.px = min(W - 25, max(25, self.mouse_x))

    def on_wheel(self, e):
        if e.delta:
            self.scroll_lb(-1 if e.delta > 0 else 1)

    def on_click(self, e):
        self.mouse_down = True
        self.mouse_x, self.mouse_y = self.c.to_game(e.x, e.y)
        if self.state == "menu":
            key = self.hit(self.menu_rects, self.mouse_x, self.mouse_y)
            if key == "play":
                self.show_mode_select()
            elif key == "board":
                self.open_leaderboard("menu")
            elif key == "badges":
                self.open_badges()
            elif key == "skins":
                self.open_skins()
            elif key == "index":
                self.open_index()
            elif key == "enchantments":
                self.open_enchantments()
            elif key == "levels":
                self.open_levels()
            elif key == "sound":
                self.toggle_sound()
        elif self.state == "mode_select":
            key = self.hit(self.mode_rects, self.mouse_x, self.mouse_y)
            if key == "normal":
                self.show_difficulty_select("normal")
            elif key == "infinity":
                self.show_difficulty_select("infinity")
            elif key == "adaptive":
                self.show_difficulty_select("adaptive")
            elif key == "back":
                self.state = "menu"
                self.sfx("click")
        elif self.state == "difficulty_select":
            key = self.hit(self.difficulty_rects, self.mouse_x, self.mouse_y)
            if key in DIFFICULTIES:
                self.start_game(self.selected_run_mode, key)
            elif key == "back":
                self.state = "mode_select"
                self.sfx("click")
        elif self.state == "skins":
            key = self.hit(self.skin_rects, self.mouse_x, self.mouse_y)
            if key == "back":
                self.close_leaderboard()
            elif isinstance(key, tuple):
                if key[0] == "tab":
                    if key[1] != self.skin_tab:
                        self.skin_tab = key[1]
                        self.skin_scroll = 0
                        self.sfx("click")
                else:
                    self.skin_click(self.skin_tab, key[1])
        elif self.state in ("leaderboard", "badges", "index",
                            "enchantments", "levels"):
            rects = (self.index_rects if self.state == "index" else
                     self.enchantment_rects if self.state == "enchantments"
                     else self.lb_rects)
            key = self.hit(rects, self.mouse_x, self.mouse_y)
            if self.state == "leaderboard" and isinstance(key, tuple):
                if key[0] == "mode":
                    self.lb_mode_filter = key[1]
                    self.lb_scroll = 0
                    self.sfx("click")
                elif key[0] == "difficulty":
                    self.lb_difficulty_filter = key[1]
                    self.lb_scroll = 0
                    self.sfx("click")
            elif self.state == "index" and isinstance(key, tuple) \
                    and key[0] == "index_tab":
                if key[1] != self.index_tab:
                    self.index_tab = key[1]
                    self.index_scroll = 0
                    self.sfx("click")
            elif self.state == "enchantments" and isinstance(key, tuple) \
                    and key[0] == "filter":
                self.enchantment_filter = key[1]
                self.enchantment_scroll = 0
                self.sfx("click")
            elif key == "back":
                self.close_leaderboard()
        elif self.state == "gameover":
            key = self.hit(self.over_rects, self.mouse_x, self.mouse_y)
            if key == "play":
                self.start_game(self.run_mode, self.difficulty)
            elif key == "board":
                self.open_leaderboard("gameover")
            elif key == "menu":
                self.go_menu()
        elif self.state == "victory":
            key = self.hit(self.over_rects, self.mouse_x, self.mouse_y)
            if key == "play":
                self.start_game(self.run_mode, self.difficulty)
            elif key == "board":
                self.open_leaderboard("victory")
            elif key == "menu":
                self.go_menu()
        elif self.state == "shop":
            key = self.hit(self.shop_rects, self.mouse_x, self.mouse_y)
            if key == "next":
                self.start_wave()
            elif key:
                self.buy(key)

    def on_release(self, e):
        self.mouse_down = False

    def on_focus_out(self, e):
        """Alt-tabbing away: pause the game and forget held keys (otherwise the
        gun keeps sliding because the key-release event never arrives)."""
        if e.widget is not self.root or time.time() < self.fs_guard:
            return
        self.keys.clear()
        self.mouse_down = False
        self.cancel_charge()
        if self.state == "play":
            self.state = "paused"

    def set_fullscreen(self, on):
        root = self.root
        try:
            if on:
                root.resizable(True, True)
                root.attributes("-fullscreen", True)
            else:
                root.attributes("-fullscreen", False)
                root.resizable(False, False)
        except tk.TclError:
            return
        self.fullscreen = on
        self.fs_guard = time.time() + 0.8
        root.update_idletasks()
        if on:
            sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
            k = min(sw / W, sh / H)
        else:
            sw, sh, k = W, H, 1.0
        self.c.config(width=sw, height=sh)
        if not on:
            root.geometry("")
        self.c.set_view(k, (sw - W * k) / 2, (sh - H * k) / 2)
        self.screen = (sw, sh)
        self.build_background()
        self.last = time.time()

    # ------------------------------------------------------------------
    # game flow
    # ------------------------------------------------------------------
    def show_mode_select(self):
        self.state = "mode_select"
        self.sfx("click")

    def show_difficulty_select(self, mode):
        if mode not in ("normal", "infinity", "adaptive"):
            raise ValueError(f"Unknown run mode: {mode}")
        self.selected_run_mode = mode
        self.state = "difficulty_select"
        self.sfx("click")

    def start_game(self, mode="normal", difficulty="normal"):
        if mode not in ("normal", "infinity", "adaptive"):
            raise ValueError(f"Unknown run mode: {mode}")
        if difficulty not in DIFFICULTIES:
            raise ValueError(f"Unknown difficulty: {difficulty}")
        self.reset()
        self.run_mode = mode
        self.difficulty = difficulty
        self.difficulty_settings = DIFFICULTIES[difficulty]
        self.run_objectives = [
            dict(objective, progress=0, completed=False)
            for objective in random.sample(RUN_OBJECTIVES, 3)]
        self.latest = None          # clear the old "LATEST" highlight
        self.mouse_down = False     # don't fire from the click on PLAY
        st = self.data["stats"]
        st["games"] = st.get("games", 0) + 1
        self.start_wave()

    def start_wave(self):
        self.victory = False
        self.victory_confetti = []
        self.wave += 1
        self.wave_hit = False
        self.clear_field()
        w = self.wave
        pool = ["scout"]
        weights = [6]
        if w >= 2:
            pool.append("saucer"); weights.append(4 + w)
        if w >= 3:
            pool.append("diver"); weights.append(2 + w // 2)
        if w >= 4:
            pool.append("heavy"); weights.append(1 + w // 2)
        if w >= 11:
            pool.extend(("wraith", "leviathan"))
            weights.extend((1 + w // 4, 1 + w // 6))
        if w >= 51:
            pool.extend(("siren", "ravager"))
            weights.extend((1 + w // 8, 1 + w // 10))
        if w >= 76:
            pool.extend(("interceptor", "bomber", "phantom", "sentinel",
                         "tempest", "reaper"))
            weights.extend((1 + w // 8, 1 + w // 10, 1 + w // 9,
                            1 + w // 11, 1 + w // 12, 1 + w // 13))
        count = 5 + w * 2
        self.queue = random.choices(pool, weights, k=count)
        if w == 10:
            self.queue = self.queue[: count // 3]
            self.queue.insert(0, "grand")
        elif w == 5:
            self.queue = self.queue[: count // 2]
            self.queue.insert(0, "boss")
        self.wave_total = max(1, len(self.queue))
        self.spawn_timer = 0.8
        self.banner = BANNER_T
        self.state = "play"
        self.last = time.time()
        self.sfx("boss" if _boss_for_wave(w) else "wave")
        self.check_badges()

    def buy(self, key):
        if key == "repair":
            if self.hp >= self.max_hp:
                self.shop_msg = "Hull is already full."
                self.sfx("deny")
            elif self.credits < REPAIR_COST:
                self.shop_msg = "Not enough credits."
                self.sfx("deny")
            else:
                self.credits -= REPAIR_COST
                self.hp = self.max_hp
                self.shop_msg = "Hull fully repaired!"
                self.sfx("repair")
            return
        for k, name, _, mx, _, _ in UPGRADES:
            if k != key:
                continue
            if self.level[k] >= mx:
                self.shop_msg = f"{name} is already maxed."
                self.sfx("deny")
                return
            c = self.cost(k)
            if self.credits < c:
                self.shop_msg = "Not enough credits."
                self.sfx("deny")
                return
            self.credits -= c
            self.level[k] += 1
            self.sfx("buy")
            self.upgrades_bought += 1
            if k == "hull":
                self.hp = min(self.max_hp, self.hp + 2)
            self.shop_msg = f"Upgraded {name} to level {self.level[k]}!"
            self.check_badges()

    # ------------------------------------------------------------------
    # spawning / helpers
    # ------------------------------------------------------------------
    def spawn_ufo(self, kind, x=None, y=None, is_clone=False, custom_hp=None, custom_scale=1.0):
        spec = UFO_SPECS[kind]
        extra = max(0, self.wave - HP_RAMP_START)
        scale = 1 + (self.wave - 1) * 0.12 + extra * HP_RAMP_NORMAL
        hp = custom_hp if custom_hp is not None else max(1, round(spec["hp"] * scale))
        if kind == "boss" and custom_hp is None:
            hp = 45 + self.wave * 8 + extra * HP_RAMP_BOSS
        elif kind == "grand" and custom_hp is None:
            hp = 150 + self.wave * 12 + extra * HP_RAMP_GRAND
        if x is None:
            x = random.uniform(50, W - 50)
        if y is None:
            y = -40.0
        x = min(W - 40, max(40, x))
        u = dict(kind=kind, x=x, y=y, hp=hp, maxhp=hp, t=0.0,
                 base_x=x, vx=random.choice((-1, 1)) * random.uniform(90, 150),
                 vy=0.0, shoot=random.uniform(1.5, 4.0), flash=0.0,
                 shot_warning=0.0,
                 mode="enter", timer=0.0, dead=False, kvx=0.0, kvy=0.0,
                 is_clone=is_clone, custom_scale=custom_scale)
        self.ufos.append(u)
        discovered = self.data["discovered_ufos"]
        if kind not in discovered:
            discovered.append(kind)
            self.save_ok = save_data(self.data)

    def explode(self, x, y, color, n=18, speed=220):
        for _ in range(n):
            a = random.uniform(0, math.tau)
            s = random.uniform(40, speed)
            life = random.uniform(0.3, 0.8)
            # x, y, vx, vy, life, colour, max life, kind (0 = spark)
            self.particles.append([x, y, math.cos(a) * s, math.sin(a) * s,
                                   life, color, life, 0])
        if n >= 14:                       # shockwave ring: x, y, max r, life...
            self.rings.append([x, y, 28 + n * 1.5, 0.38, 0.38, color])

    def enemy_shot(self, x, y, tx=None, ty=None, speed=240):
        self.sfx("enemy")
        if tx is None:
            vx, vy = 0, speed
        else:
            d = math.hypot(tx - x, ty - y) or 1
            vx, vy = (tx - x) / d * speed, (ty - y) / d * speed
        self.ebullets.append([x, y, vx, vy])

    def hurt_player(self, dmg):
        if self.inv > 0:
            return
        self.wave_hit = True
        self.hp -= dmg
        self.inv = 0.9
        self.shake = 0.25
        self.hit_flash = 0.35
        self.flash_col = "#ff2a2a"
        self.explode(self.px, GROUND, "#ff5555", 14, 180)
        self.sfx("hurt")
        if self.hp <= 0:
            self.cancel_weapons()
            self.minions = []
            self.state = "gameover"
            self.sfx("over")
            self.record_run()

    # ------------------------------------------------------------------
    # special weapons: homing missile (T) and charge beam (V)
    # ------------------------------------------------------------------
    def cancel_charge(self):
        self.charging = False
        self.charge_t = 0.0
        self.charge_seen = 0        # highest power level already announced
        self.charge_up_t = None     # when V was released (None = still held)

    def cancel_weapons(self):
        self.cancel_charge()
        self.missiles = []
        self.beams = []

    def summon_minions(self):
        """M: call small copies of your gun that fly beside it for a while."""
        if self.minion_cd > 0:
            self.sfx("deny")
            return
        self.minion_cd = MINION_CD
        self.minions = []
        n = 0
        for slot in range(MINION_PER_SIDE):
            for side in (-1, 1):
                self.minions.append(dict(
                    side=side, slot=slot, x=self.px,
                    y=GROUND + 30 - 30 * MINION_SCALE, age=0.0,
                    life=MINION_LIFE,
                    fire=0.25 + 0.12 * n,           # stagger the first shots
                    mt=MINION_MISSILE_EVERY + 0.4 * n,
                    recoil=0.0, muzzle=0.0))
                n += 1
        self.rings.append([self.px, GROUND, 90, 0.4, 0.4, "#9fe8ff"])
        self.explode(self.px, GROUND - 10, "#9fe8ff", 16, 200)
        self.sfx("summon")

    def update_minions(self, dt):
        """Minions follow the gun, shoot bullets all the time, and fire a
        homing missile every few seconds - but only while an enemy is on
        screen."""
        keep = []
        for mn in self.minions:
            mn["age"] += dt
            mn["life"] -= dt
            if mn["life"] <= 0:                     # time is up: vanish
                self.explode(mn["x"], mn["y"], "#9fe8ff", 10, 150)
                self.rings.append([mn["x"], mn["y"], 34, 0.25, 0.25,
                                   "#9fe8ff"])
                continue
            keep.append(mn)
            tx = self.px + mn["side"] * (MINION_SPACING
                                         + mn["slot"] * MINION_GAP)
            tx = min(W - 18, max(18, tx))
            mn["x"] += (tx - mn["x"]) * min(1.0, dt * 12)
            mn["recoil"] = max(0.0, mn["recoil"] - 40 * dt)
            mn["muzzle"] = max(0.0, mn["muzzle"] - dt)
            if mn["age"] < 0.35:                    # still arriving
                continue
            # bullets: straight up, like the real gun
            mn["fire"] -= dt
            if mn["fire"] <= 0:
                mn["fire"] = MINION_FIRE_DELAY
                self.bullets.append(dict(
                    x=mn["x"], y=mn["y"] - 22, vx=0.0, vy=-self.bullet_speed,
                    dmg=max(1, round(self.damage * MINION_DMG_SHARE)),
                    pierce=0, hit=set(), dead=False, trail=[], kills=0,
                    s=0.8))
                mn["recoil"] = 4.0
                mn["muzzle"] = 0.06
                self.sfx("minionshot")
            # missiles: only when there is something to shoot at
            mn["mt"] = max(0.0, mn["mt"] - dt)
            if mn["mt"] <= 0:
                tg = self.nearest_ufo(mn["x"], mn["y"])
                if tg is not None:
                    mn["mt"] = MINION_MISSILE_EVERY
                    self.missiles.append(dict(
                        x=mn["x"], y=mn["y"] - 20, a=-math.pi / 2, sp=240.0,
                        vx=0.0, vy=-240.0, target=tg, life=5.0, age=0.0,
                        smoke=0.0, dead=False, mul=MINION_MISSILE_SHARE,
                        s=0.8))
                    mn["recoil"] = 7.0
                    self.explode(mn["x"], mn["y"] - 20, self.missile_boom(),
                                 4, 100)
                    self.sfx("missile")
        self.minions = keep

    def draw_minions(self, ox, oy):
        """Mini copies of the gun (same skin), each with a small timer bar."""
        c = self.c
        t = time.time()
        for mn in self.minions:
            grow = min(1.0, mn["age"] / 0.35)
            grow = 1 - (1 - grow) ** 2
            frac = max(0.0, mn["life"] / MINION_LIFE)
            if mn["life"] < 2.0 and int(mn["life"] * 8) % 2 == 0:
                continue                            # blink before vanishing
            x, y = mn["x"] + ox, mn["y"] + oy
            sc = max(0.06, MINION_SCALE * grow)
            if grow < 1.0:                          # materialising
                y = GROUND + 30 - 30 * sc + oy
            self.draw_gun(x, y, self.gun_skin, sc, 1, mn["recoil"] * sc / 0.5,
                          self.level["damage"], mn["muzzle"], self.bullet_skin)
            # little time-left bar under the minion
            bw = 22
            c.create_rectangle(x - bw / 2, GROUND + 37 + oy, x + bw / 2,
                               GROUND + 40 + oy, fill="#171c3e", outline="")
            c.create_rectangle(x - bw / 2, GROUND + 37 + oy,
                               x - bw / 2 + bw * frac, GROUND + 40 + oy,
                               fill="#4dd8ff" if frac > 0.25 else "#ff9f43",
                               outline="")

    def bounce_angles(self):
        """Directions of the ricochet burst, in radians (0 = straight up,
        positive = to the right)."""
        n = max(1, BOUNCE_DIRS)
        arc = math.radians(BOUNCE_ARC)
        if n == 1:
            base = [0.0]
        elif BOUNCE_ARC >= 360:             # full ring: no doubled direction
            base = [i * math.tau / n for i in range(n)]
        else:                               # fan centred on straight up
            base = [-arc / 2 + arc * i / (n - 1) for i in range(n)]
        per = max(1, BOUNCE_PER_DIR)
        out = []
        for a in base:                      # several bullets per direction:
            for j in range(per):            # spread them by a few degrees
                out.append(a + (j - (per - 1) / 2) * 0.07)
        return out

    def fire_bounce(self):
        """B: a burst of bullets that ricochet off the edges of the screen."""
        if self.bounce_cd > 0 or self.charging:
            self.sfx("deny")
            return
        self.bounce_cd = BOUNCE_CD
        v = self.bullet_speed * BOUNCE_SPEED
        for a in self.bounce_angles():
            sa, ca = math.sin(a), math.cos(a)
            self.bullets.append(dict(
                x=self.px + sa * 36, y=GROUND - ca * 36,
                vx=sa * v, vy=-ca * v, dmg=self.damage, pierce=99,
                hit=set(), dead=False, trail=[], kills=0,
                bn=0, life=BOUNCE_LIFE))
        self.muzzle = 0.1
        self.recoil = 10.0
        self.explode(self.px, GROUND - 38, "#9fe8ff", 10, 150)
        self.rings.append([self.px, GROUND - 38, 44, 0.25, 0.25, "#9fe8ff"])
        self.sfx("bounceshot")

    def bounce_bullet(self, b, dt):
        """Reflect a ricochet bullet off the screen edges (left, right, top
        and the ground line). After BOUNCE_MAX bounces it vanishes on the next
        wall it touches."""
        left, right, top, bottom = 6.0, W - 6.0, 6.0, HORIZON - 8.0
        touched = False
        if b["x"] < left:
            b["x"] = 2 * left - b["x"]
            b["vx"] = abs(b["vx"])
            touched = True
        elif b["x"] > right:
            b["x"] = 2 * right - b["x"]
            b["vx"] = -abs(b["vx"])
            touched = True
        if b["y"] < top:
            b["y"] = 2 * top - b["y"]
            b["vy"] = abs(b["vy"])
            touched = True
        elif b["y"] > bottom:
            b["y"] = 2 * bottom - b["y"]
            b["vy"] = -abs(b["vy"])
            touched = True
        b["life"] -= dt
        if touched:
            if b["bn"] >= BOUNCE_MAX:       # used up all its bounces
                b["dead"] = True
                self.explode(b["x"], b["y"], "#9fe8ff", 8, 130)
                return
            b["bn"] += 1
            b["hit"].clear()                # it can hurt the same UFO again
            b["trail"] = []
            self.rings.append([b["x"], b["y"], 20, 0.2, 0.2, "#ffffff"])
            self.explode(b["x"], b["y"], "#9fe8ff", 4, 110)
            self.sfx("ricochet")
        if b["life"] <= 0:
            b["dead"] = True

    def nearest_ufo(self, x, y):
        """The closest UFO that is on screen and not already blowing up."""
        best, bd = None, 1e9
        for u in self.ufos:
            if u["dead"] or u["mode"] == "dying" or u["y"] < -20:
                continue
            d = math.hypot(u["x"] - x, u["y"] - y)
            if d < bd:
                best, bd = u, d
        return best

    def hurt_ufo(self, u, dmg, src=None):
        """Damage a UFO from a missile or beam. Returns True if it was killed."""
        if u["dead"] or u["mode"] == "dying":
            return False
        u["hp"] -= nb_damage_taken(self, u, dmg)
        u["flash"] = 0.08
        if u["hp"] <= 0:
            self.kill_ufo(u, src)
            return True
        self.sfx("hit")
        return False

    def fire_missile(self):
        if self.missile_cd > 0:
            self.sfx("deny")
            return
        if self.nearest_ufo(self.px, GROUND) is None:
            self.floaters.append([self.px, GROUND - 70, "NO TARGET", 0.9])
            self.sfx("deny")
            return
        self.missile_cd = MISSILE_CD
        self.missiles.append(dict(
            x=self.px, y=GROUND - 30, a=-math.pi / 2, sp=240.0,
            vx=0.0, vy=-240.0, target=self.nearest_ufo(self.px, GROUND),
            life=5.0, age=0.0, smoke=0.0, dead=False))
        self.recoil = 8.0
        self.explode(self.px, GROUND - 30, self.missile_boom(), 6, 120)
        self.sfx("missile")

    def missile_boom(self):
        sk = self.missile_skin
        if sk["mode"] == "rainbow":
            return hsv(time.time() * 0.9, 0.8, 1.0)
        return sk["boom"]

    def update_missiles(self, dt):
        for m in self.missiles:
            m["age"] += dt
            m["life"] -= dt
            tg = m["target"]
            if tg is None or tg["dead"] or tg["mode"] == "dying" or \
                    not any(o is tg for o in self.ufos):
                tg = m["target"] = self.nearest_ufo(m["x"], m["y"])
            if tg is not None:                  # steer toward the target
                want = math.atan2(tg["y"] - m["y"], tg["x"] - m["x"])
                diff = (want - m["a"] + math.pi) % math.tau - math.pi
                rate = (3.5 + 5.0 * min(1.0, m["age"] / 0.8)) * dt
                m["a"] += max(-rate, min(rate, diff))
            m["sp"] = min(MISSILE_SPEED, m["sp"] + 520 * dt)
            m["vx"] = math.cos(m["a"]) * m["sp"]
            m["vy"] = math.sin(m["a"]) * m["sp"]
            m["x"] += m["vx"] * dt
            m["y"] += m["vy"] * dt
            m["smoke"] -= dt
            if m["smoke"] <= 0:                 # exhaust trail
                m["smoke"] = 0.03
                bx = m["x"] - math.cos(m["a"]) * 12
                by = m["y"] - math.sin(m["a"]) * 12
                sk = self.missile_skin
                mode = sk["mode"]
                col = hsv(time.time() * 0.9 + m["age"] * 2, 0.8, 1.0) \
                    if mode == "rainbow" else sk["smoke"]
                life = 1.0 if mode == "comet" else 0.6
                self.particles.append([bx, by, random.uniform(-12, 12),
                                       random.uniform(-12, 12), life,
                                       col, life, 1])
                if mode in ("fire", "comet", "snow", "rainbow"):
                    # extra sparks / flakes falling off the trail
                    self.particles.append([
                        bx, by, random.uniform(-45, 45),
                        random.uniform(-45, 45), 0.5,
                        "#ffffff" if mode in ("comet", "snow") else
                        (sk["flame"] if mode == "fire" else col), 0.5, 0])
            for u in self.ufos:
                if u["dead"] or u["mode"] == "dying":
                    continue
                s = UFO_SPECS[u["kind"]]["size"]
                dx = (m["x"] - u["x"]) / (s + 5)
                dy = (m["y"] - u["y"]) / (s * 0.6 + 5)
                if dx * dx + dy * dy < 1.0:
                    dmg = max(1, round(MISSILE_DMG * self.power
                                       * m.get("mul", 1.0)))
                    self.explode(m["x"], m["y"], self.missile_boom(), 18, 270)
                    self.explode(m["x"], m["y"], "#ffffff", 6, 170)
                    self.sfx("boom")
                    self.shake = max(self.shake, 0.1)
                    if not self.hurt_ufo(u, dmg, "missile"):
                        self.knock_ufo(u, m)
                    m["dead"] = True
                    break
            if not m["dead"]:
                if m["life"] <= 0:              # ran out of fuel
                    self.explode(m["x"], m["y"], self.missile_boom(), 8, 140)
                    m["dead"] = True
                elif m["y"] < -60 or m["y"] > H + 20 or \
                        m["x"] < -60 or m["x"] > W + 60:
                    m["dead"] = True
        self.missiles = [m for m in self.missiles if not m["dead"]]

    def charge_tier(self):
        """0 = not charged enough yet, 1 = small, 2 = medium, 3 = large."""
        t = self.charge_t
        return 3 if t >= CHARGE_T[2] else 2 if t >= CHARGE_T[1] \
            else 1 if t >= CHARGE_T[0] else 0

    def begin_charge(self):
        if self.charging:               # auto-repeat press: still holding V
            self.charge_up_t = None
            return
        self.charging = True
        self.charge_t = 0.0
        self.charge_seen = 0
        self.charge_up_t = None
        self.sfx("chargeup")

    def update_charge(self, dt):
        if not self.charging:
            return
        self.charge_t += dt
        tier = self.charge_tier()
        if tier > self.charge_seen:     # reached a new power level
            self.charge_seen = tier
            self.sfx("tier%d" % tier)
            self.rings.append([self.px, GROUND - 50, 50 + tier * 20, 0.35,
                               0.35, CHARGE_COL[tier]])
        if self.charge_up_t is not None and \
                time.time() - self.charge_up_t > 0.08:
            self.release_charge()

    def release_charge(self):
        tier = self.charge_tier()
        self.cancel_charge()
        if tier == 0:                   # let go too early: it fizzles out
            self.explode(self.px, GROUND - 44, "#9fb0ff", 5, 90)
            self.sfx("deny")
            return
        self.beams.append(dict(tier=tier, t=0.0, dur=BEAM_DUR[tier - 1],
                               tick=0.0, x=self.px, kills=0))
        self.recoil = 7.0 + 5.0 * tier
        self.muzzle = 0.1
        self.shake = max(self.shake, (0.12, 0.2, 0.35)[tier - 1])
        if tier == 3:
            self.hit_flash = 0.2
            self.flash_col = BEAM_COL[2]
            self.unlock("overcharge")
        self.sfx("beam%d" % tier)

    def update_beams(self, dt):
        for bm in self.beams:
            bm["t"] += dt
            bm["x"] = self.px           # the beam follows the gun
            bm["tick"] -= dt
            while bm["tick"] <= 0:
                bm["tick"] += BEAM_TICK
                self.beam_hit(bm)
        self.beams = [b for b in self.beams if b["t"] < b["dur"]]

    def beam_hit(self, bm):
        tier = bm["tier"]
        hw = BEAM_HW[tier - 1]
        dmg = max(1, round(BEAM_TICK_DMG[tier - 1] * self.power))
        col = BEAM_COL[tier - 1]
        for u in self.ufos:
            if u["dead"] or u["mode"] == "dying":
                continue
            if u["y"] < -20 or u["y"] > GROUND - 10:
                continue
            s = UFO_SPECS[u["kind"]]["size"]
            if abs(u["x"] - bm["x"]) < hw + s * 0.9:
                self.explode(u["x"], u["y"], col, 4, 150)
                if self.hurt_ufo(u, dmg, "beam"):
                    bm["kills"] += 1
                    if bm["kills"] >= 4:
                        self.unlock("laserwipe")
        for e in self.ebullets:         # the beam also vaporises enemy shots
            if abs(e[0] - bm["x"]) < hw + 6 and e[1] < GROUND - 20:
                self.explode(e[0], e[1], col, 4, 100)
                e[1] = H + 100


def ench_lvl(self, eid):
    """Level of an enchantment you currently have equipped (0 = none)."""
    m = getattr(self, "_ench_cache", None)
    if m is None:
        e = self.data["ench"]
        by = {b["uid"]: b for b in e["books"]}
        m = {}
        for uid in e["equipped"]:
            b = by.get(uid)
            if b:
                m[b["id"]] = b["lvl"]
        self._ench_cache = m
    return m.get(eid, 0)


def _prop(name, fn):
    old = getattr(Game, name).fget
    setattr(Game, name, property(lambda s, o=old: fn(s, o(s))))


_prop("damage", lambda s, v: v + s.ench_lvl("damage"))
_prop("delay", lambda s, v: v * 0.93 ** s.ench_lvl("haste"))
_prop("bullet_speed", lambda s, v: v * (1 + 0.08 * s.ench_lvl("velocity")))
_prop("pierce", lambda s, v: v + s.ench_lvl("pierce"))
_prop("knock", lambda s, v: v + s.ench_lvl("impact"))
_prop("max_hp", lambda s, v: v + s.ench_lvl("plating"))
_prop("shots", lambda s, v: v + s.ench_lvl("multishot"))
_prop("power", lambda s, v: v + 0.2 * s.ench_lvl("overpower"))
_prop("damage", lambda s, v: v + 2 * s.ench_lvl("abyssal_force"))
_prop("max_hp", lambda s, v: v + 2 * s.ench_lvl("abyssal_bulwark"))

def _feature_update_ufo(self, u, dt):
    if self.active_modifier == "rush" and self.state == "play":
        original_settings = self.difficulty_settings
        self.difficulty_settings = dict(original_settings)
        self.difficulty_settings["speed"] *= 1.2
        try:
            _base_update_ufo(self, u, dt)
        finally:
            self.difficulty_settings = original_settings
    else:
        _base_update_ufo(self, u, dt)

    if u["kind"] not in BOSS_WAVES.values() or u["dead"] \
            or u["mode"] == "dying":
        return
    threshold = 0.5 if u["kind"] in EXTERMINATOR_STYLE_BOSSES else 0.35
    frac = u["hp"] / max(1, u["maxhp"])
    if u.get("phase", 0) == 0 and frac <= threshold:
        u["phase"] = 1
        u["phase_warning"] = 1.1
        u["phase_attack_cd"] = 2.0
        self.floaters.append([u["x"], u["y"] - 45, "PHASE 2 INCOMING!", 1.4])
        self.sfx("warn")
    if u.get("phase", 0) < 1:
        return
    if u.get("phase_warning", 0) > 0:
        u["phase_warning"] = max(0.0, u["phase_warning"] - dt)
    else:
        u["phase_attack_cd"] = u.get("phase_attack_cd", 0) - dt
        if u["phase_attack_cd"] <= 0:
            if u["kind"] in EXTERMINATOR_STYLE_BOSSES:
                self.boss_curtain(u, 2, 170)
                u["phase_attack_cd"] = 7.0
            elif u["kind"] == "grand":
                self.boss_curtain(u, 3, 155)
                u["phase_attack_cd"] = 8.0
            else:
                self.boss_curtain(u, 4, 145)
                if u["kind"] not in ("boss",):
                    self.enemy_shot(u["x"], u["y"] + 35,
                                    self.px, GROUND, 220)
                u["phase_attack_cd"] = 8.0


def _feature_damage_taken(self, u, dmg):
    active = getattr(self, "run_bonuses", ())
    mult = 1.0
    heavy_payload = next(
        (b for b in active if b["id"] == "heavy_payload"), None)
    if heavy_payload:
        mult *= 1 + heavy_payload["tier_values"][heavy_payload["tier"] - 1]
    finisher = next((b for b in active if b["id"] == "finisher"), None)
    if finisher and u["hp"] / max(1, u["maxhp"]) < 0.5:
        mult *= 1 + finisher["tier_values"][finisher["tier"] - 1]
    dealt = _base_feature_damage_taken(self, u, dmg * mult)
    actual = min(max(0.0, u["hp"]), max(0.0, dealt))
    if hasattr(self, "run_damage_dealt"):
        self.run_damage_dealt += actual
        source = getattr(self, "_damage_source", "gun")
        self.run_damage_by_source[source] = (
            self.run_damage_by_source.get(source, 0) + actual)
    return dealt



def ms_on_click(self, e):
    x, y = self.c.to_game(e.x, e.y)
    if self.state == "menu" and self.hit(self.menu_rects, x, y) == "missions":
        self.mouse_x, self.mouse_y = x, y
        self.open_missions()
        return
    if self.state in ("missions", "mission_result"):
        self.mouse_x, self.mouse_y = x, y
        key = self.hit(self.mission_rects, x, y)
        if key == "back":
            if self.state == "mission_result":
                self.sfx("click")
                self.open_missions()
            else:
                self.close_leaderboard()
        elif isinstance(key, tuple) and key[0] == "ms_pick":
            self.ms_sel = key[1]
            self.sfx("click")
        elif isinstance(key, tuple) and key[0] == "ms_tab":
            self.ms_tab = key[1]
            self.ms_sel = ms_tab_planets(key[1])[0][0]
            self.sfx("click")
        elif isinstance(key, tuple) and key[0] == "ms_deploy":
            self.sfx("click")
            ms_deploy(self, key[1])
        return
    _ms_prev_click(self, e)


Game.on_click = ms_on_click

_ms_prev_key = Game.on_key_down


def ms_on_key_down(self, e):
    k = e.keysym.lower()
    if self.state == "menu" and k == "m":
        self.open_missions()
        return
    if self.state == "missions":
        if k in ("escape", "backspace"):
            self.close_leaderboard()
        elif k in ("left", "up", "right", "down"):
            step = -1 if k in ("left", "up") else 1
            self.ms_sel = min(len(MS_PLANETS) - 1, max(
                0, getattr(self, "ms_sel", 0) + step))
            self.ms_tab = MS_PLANETS[self.ms_sel].get("sys", "sol")
        elif k == "return" and ms_unlocked(self, self.ms_sel):
            ms_deploy(self, self.ms_sel)
        return
    if self.state == "mission_result":
        if k in ("return", "escape", "backspace"):
            self.open_missions()
        return
    _ms_prev_key(self, e)


Game.on_key_down = ms_on_key_down


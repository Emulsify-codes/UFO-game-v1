def pan_update(self, dt):
    if not hasattr(self, "_pan_observed_state"):
        self._pan_observed_state = self.state
        self._pan_transition_time = 1.0
    _pan_original_update(self, dt)
    if self.state != self._pan_observed_state:
        self._pan_observed_state = self.state
        self._pan_transition_time = 0.0
    elif self._pan_transition_time < 0.45:
        self._pan_transition_time = min(0.45,
                                        self._pan_transition_time + dt)


def pan_draw_scene(self):
    c = self.c
    existing_items = set(c.find_all())
    transition = min(1.0, self._pan_transition_time / 0.45)
    eased = 1 - (1 - transition) ** 3
    c._pan_fade = eased
    try:
        _pan_original_draw_scene(self)
    finally:
        c._pan_fade = 1.0
    if transition >= 1:
        return
    for item in set(c.find_all()) - existing_items:
        c.addtag_withtag("screen_pan_transition", item)
    c.move("screen_pan_transition", 0, (1 - eased) * 46 * c.k)



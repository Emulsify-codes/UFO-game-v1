    def update(self, dt):
        # starfield always scrolls
        for s in self.stars:
            s[1] += s[2] * dt
            if s[1] > STAR_MAX_Y:
                s[0], s[1] = random.uniform(0, W), 0
        self.update_meteor(dt)
        for m in self.menu_ufos:
            m["x"] += m["vx"] * dt
            m["t"] += dt
            if m["x"] < -70:
                m["x"] = W + 70
            elif m["x"] > W + 70:
                m["x"] = -70

        # purely cosmetic timers (run in every state)
        self.score_pop = max(0.0, self.score_pop - dt)
        self.sound_toast = max(0.0, self.sound_toast - dt)
        self.hit_flash = max(0.0, self.hit_flash - dt)
        for tt in self.toasts[:3]:
            tt[1] -= dt
        self.toasts = [tt for tt in self.toasts if tt[1] > 0]
        if self.disp_score < self.score:
            step = max(1.0, (self.score - self.disp_score) * min(1.0, dt * 8))
            self.disp_score = min(self.score, self.disp_score + step)
        if self.state != "paused":
            self.update_fx(dt)

        if self.state == "levels":
            self.levels_anim_time += dt
            return

        if self.state != "play":
            return

        # boss-kill slow motion (hit-stop)
        if self.slow > 0:
            self.slow -= dt
            dt *= 0.3

        # player movement
        move = 0
        if "left" in self.keys or "a" in self.keys:
            move -= 1
        if "right" in self.keys or "d" in self.keys:
            move += 1
        if move:
            self.px += move * PLAYER_SPEED * dt
        self.px = min(W - 25, max(25, self.px))

        self.inv = max(0.0, self.inv - dt)
        self.shake = max(0.0, self.shake - dt)
        self.banner = max(0.0, self.banner - dt)
        self.muzzle = max(0.0, self.muzzle - dt)
        self.recoil = max(0.0, self.recoil - 55 * dt)
        self.missile_cd = max(0.0, self.missile_cd - dt)
        self.bounce_cd = max(0.0, self.bounce_cd - dt)
        self.minion_cd = max(0.0, self.minion_cd - dt)

        # smoke when the hull is low
        if 0 < self.hp <= self.max_hp * 0.4:
            self.smoke_t -= dt
            if self.smoke_t <= 0:
                self.smoke_t = 0.07
                self.particles.append([self.px + random.uniform(-9, 9),
                                       GROUND - 4, random.uniform(-14, 14),
                                       random.uniform(-65, -35), 0.9,
                                       "#a4a4bc", 0.9, 1])

        # shooting (the normal gun is busy while a charge is building)
        self.cooldown -= dt
        if (self.mouse_down or "space" in self.keys) and self.cooldown <= 0 \
                and not self.charging:
            self.fire()
            self.cooldown = self.delay

        self.update_minions(dt)

        # bullets
        for b in self.bullets:
            b["trail"].append((b["x"], b["y"]))
            if len(b["trail"]) > 6:
                b["trail"].pop(0)
            b["x"] += b["vx"] * dt
            b["y"] += b["vy"] * dt
            if "bn" in b:                   # ricochet bullet
                self.bounce_bullet(b, dt)
        self.bullets = [b for b in self.bullets
                        if -20 < b["y"] < H and -20 < b["x"] < W + 20]

        # spawning
        if self.queue:
            self.spawn_timer -= dt
            if self.spawn_timer <= 0:
                self.spawn_ufo(self.queue.pop(0))
                self.spawn_timer = max(0.35, 1.1 - self.wave * 0.05)

        # UFOs
        for u in self.ufos:
            self.update_ufo(u, dt)
            if u["mode"] != "dying" and u.get("shoot") is not None \
                    and 0 < u["shoot"] <= SHOT_WARNING_TIME:
                u["shot_warning"] = min(
                    1.0, u.get("shot_warning", 0.0) + dt * 5)
            else:
                u["shot_warning"] = max(
                    0.0, u.get("shot_warning", 0.0) - dt * 4)

        # bullets vs UFOs
        for b in self.bullets:
            if b["dead"]:
                continue
            for u in self.ufos:
                if u["dead"] or u["mode"] == "dying" or id(u) in b["hit"]:
                    continue
                s = UFO_SPECS[u["kind"]]["size"]
                dx, dy = (b["x"] - u["x"]) / s, (b["y"] - u["y"]) / (s * 0.55)
                if dx * dx + dy * dy < 1.0:
                    u["hp"] -= nb_damage_taken(self, u, b["dmg"])
                    u["flash"] = 0.08
                    if b.get("critical"):
                        self.floaters.append([
                            u["x"], u["y"] - 20, "Critical!", 0.5])
                    if b.get("adaptive_shot") and not b.get("adaptive_hit"):
                        self.adaptive_wave_hits += 1
                        b["adaptive_hit"] = True
                    b["hit"].add(id(u))
                    self.explode(b["x"], b["y"], "#ffffaa", 3, 90)
                    if u["hp"] > 0:
                        self.sfx("hit")
                        self.knock_ufo(u, b)
                    if u["hp"] <= 0:
                        self.kill_ufo(u, "bounce" if b.get("bn", 0) > 0
                                      else None)
                        b["kills"] += 1
                        if b["kills"] >= 3:
                            self.unlock("skewer")
                    if b["pierce"] > 0:
                        b["pierce"] -= 1
                    else:
                        b["dead"] = True
                        break
        self.bullets = [b for b in self.bullets if not b["dead"]]
        self.ufos = [u for u in self.ufos if not u["dead"]]

        # special weapons: homing missiles, charge ball, laser beams
        self.update_missiles(dt)
        self.update_beams(dt)
        self.update_charge(dt)
        self.ufos = [u for u in self.ufos if not u["dead"]]

        # enemy bullets
        for e in self.ebullets:
            e[0] += e[2] * dt
            e[1] += e[3] * dt
            if math.hypot(e[0] - self.px, e[1] - (GROUND + 8)) < 24:
                e[1] = H + 100
                self.hurt_player(1)
        self.ebullets = [e for e in self.ebullets
                         if -20 < e[1] < H and -20 < e[0] < W + 20]

        # wave cleared?
        self.finale = max(0.0, self.finale - dt)
        if self.state == "play" and not self.queue and not self.ufos \
                and self.finale <= 0:
            bonus = 20 + self.wave * 10
            self.credits += bonus
            self.score += bonus
            self.shop_msg = f"Wave {self.wave} cleared!  Bonus +{bonus} credits."
            if not self.wave_hit and self.wave >= 3:
                self.unlock("untouchable")
            if self.hp == 1:
                self.unlock("close")
            self.progress_objectives("wave")
            if not self.wave_hit:
                self.progress_objectives("clean")
            self.check_badges()
            # checkpoint: if the game is killed now, this run is recovered
            self.cleared_wave = self.wave
            if self.wave == 100 and self.run_mode == "normal":
                self.victory = True
                self.victory_time = 0.0
                self.victory_confetti_spawn = 0.0
            self.data["current"] = dict(
                score=self.score, wave=self.wave,
                cleared_wave=self.cleared_wave,
                rank=rank_for_wave(self.cleared_wave),
                date=time.strftime("%Y-%m-%d %H:%M"),
                mode=self.run_mode, difficulty=self.difficulty,
                objectives=sum(o["completed"]
                               for o in self.run_objectives),
                run_objectives=self.run_objectives)
            self.save_ok = save_data(self.data)
            self.cancel_weapons()
            self.sfx("clear")
            if self.victory:
                self.state = "victory"
                self.record_run()
            else:
                self.state = "shop"

    def update_fx(self, dt):
        """Particles, shockwaves and floating text (also run on game over)."""
        for p in self.particles:
            p[0] += p[2] * dt
            p[1] += p[3] * dt
            p[4] -= dt
            if p[7] in (0, 2):
                p[3] += 140 * dt          # sparks fall a little
        self.particles = [p for p in self.particles if p[4] > 0]
        for r in self.rings:
            r[3] -= dt
        self.rings = [r for r in self.rings if r[3] > 0]
        for f in self.floaters:
            f[1] -= 35 * dt
            f[3] -= dt
        self.floaters = [f for f in self.floaters if f[3] > 0]
        if self.victory and self.state == "victory" and self.victory_time < 4.0:
            self.victory_time += dt
            self.victory_confetti_spawn += dt
            while self.victory_confetti_spawn >= 0.08:

PET_BUFF_TYPES = (
    "damage", "fire_rate", "piercing", "bullet_speed",
    "credits_score", "multishot",
)
_PET_DAMAGE_PERCENT = (5, 8, 11, 14, 17, 20, 23, 26, 29, 32)
_PET_FIRE_RATE_PERCENT = (3, 5, 7, 9, 11, 14, 17, 20, 23, 26)
_PET_SPEED_PERCENT = (5, 8, 11, 14, 17, 20, 23, 26, 29, 32)
_PET_REWARD_PERCENT = (5, 9, 13, 17, 21, 25, 29, 33, 37, 41)
_PET_PIERCE_AMOUNT = (1, 1, 1, 1, 1, 2, 2, 2, 3, 3)
_PET_MULTISHOT_AMOUNT = (0, 0, 0, 0, 1, 1, 1, 1, 1, 2)


def pet_buff_details(pet, huge=False):
    pet_number = int(pet["id"].rsplit("_", 1)[1])
    buff = PET_BUFF_TYPES[(pet_number - 1) % len(PET_BUFF_TYPES)]
    name, description = pet_buff_description(pet, buff, huge=huge)
    if buff == "multishot" and _pet_buff_amount(pet, buff) == 0:
        buff = "damage"
        name, description = pet_buff_description(pet, buff, huge=huge)
    return name, buff, description


def _pet_buff_amount(pet, buff):
    rarity_index = next(
        i for i, (rarity, *_) in enumerate(PET_RARITIES)
        if rarity == pet["rarity"])
    if buff == "damage":
        return _PET_DAMAGE_PERCENT[rarity_index] / 100
    if buff == "fire_rate":
        return _PET_FIRE_RATE_PERCENT[rarity_index] / 100
    if buff == "piercing":
        return _PET_PIERCE_AMOUNT[rarity_index]
    if buff == "bullet_speed":
        return _PET_SPEED_PERCENT[rarity_index] / 100
    if buff == "credits_score":
        return _PET_REWARD_PERCENT[rarity_index] / 100
    if buff == "multishot":
        return _PET_MULTISHOT_AMOUNT[rarity_index]
    return 0


def pet_buff_description(pet, buff, huge=False):
    amount = _pet_buff_amount(pet, buff) * (2 if huge else 1)
    names = {
        "damage": "DAMAGE",
        "fire_rate": "FIRE RATE",
        "piercing": "PIERCING",
        "bullet_speed": "BULLET SPEED",
        "credits_score": "SALVAGE",
        "multishot": "MULTI-SHOT",
    }
    if buff in ("damage", "fire_rate", "bullet_speed"):
        description = f"+{round(amount * 100)}%"
    elif buff == "credits_score":
        description = f"+{round(amount * 100)}% score and credits per UFO"
    elif buff == "piercing":
        description = f"+{amount} pierce"
    elif buff == "multishot":
        description = f"+{amount} barrel"
    else:
        description = ""
    return names.get(buff, "BUFF"), description


def _pet_equipped_buff(self):
    data = getattr(self, "data", None)
    pets = data.get("pets") if isinstance(data, dict) else None
    if not isinstance(pets, dict):
        return None, 0
    owned = pets.get("owned")
    pet_id = pets.get("equipped")
    if not isinstance(owned, dict):
        return None, 0
    pet = PET_BY_ID.get(pet_id)
    if pet is None:
        return None, 0
    huge_index = pets.get("equipped_huge")
    huge_buffs = pets.get("huge", {}).get(pet_id, [])
    is_huge = isinstance(huge_index, int) and not isinstance(huge_index, bool) \
        and 0 <= huge_index < len(huge_buffs)
    if pet_id not in owned and not is_huge:
        return None, 0
    _, buff, _ = pet_buff_details(pet)
    amount = _pet_buff_amount(pet, buff)
    if is_huge:
        amount *= 2
    return buff, amount


def _pet_equipped_extra_buff(self):
    data = getattr(self, "data", None)
    pets = data.get("pets", {}) if isinstance(data, dict) else {}
    if not isinstance(pets, dict):
        return None, 0
    pet_id = pets.get("equipped")
    huge_index = pets.get("equipped_huge")
    if not isinstance(pet_id, str) \
            or not isinstance(huge_index, int) or isinstance(huge_index, bool):
        return None, 0
    pet = PET_BY_ID.get(pet_id)
    huge = pets.get("huge", {})
    huge_buffs = huge.get(pet_id, []) if isinstance(huge, dict) else []
    if pet is None or huge_index < 0 or huge_index >= len(huge_buffs):
        return None, 0
    buff = huge_buffs[huge_index]
    return buff, _pet_buff_amount(pet, buff)


def _pet_bonus_amount(self, target_buff):
    buff, amount = _pet_equipped_buff(self)
    extra_buff, extra_amount = _pet_equipped_extra_buff(self)
    if buff == target_buff:
        return amount + (extra_amount if extra_buff == target_buff else 0)
    return extra_amount if extra_buff == target_buff else 0



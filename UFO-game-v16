# ---- black hole --------------------------------------------------------------------
def bh_active(self):
    return getattr(self, "weather", None) == "blackhole" \
        and self.wx2.get("bh") == "on"


def bh_absorb(self):
    """Swallow every bullet currently in flight (they spiral into the hole)."""
    if not self.bullets:
        return
    d = self.wx2
    sk = d.setdefault("suck", [])
    for b in self.bullets:
        sk.append([b["x"], b["y"], d["bh_x"], d["bh_y"], 0.0,
                   random.choice((-1, 1))])
    del sk[:-90]
    self.bullets = []


def bh_tick(self, dt):
    d = self.wx2
    for s in d.get("suck", []):
        s[4] += dt
    d["suck"] = [s for s in d.get("suck", []) if s[4] < 0.4]
    st = d.get("bh")
    if st is None:
        return
    d["bh_t"] -= dt
    if st == "wait":
        if d["bh_t"] <= 0 and d["bh_left"] > 0:
            d["bh_left"] -= 1
            d["bh_x"] = random.uniform(200, W - 200)
            d["bh_y"] = random.uniform(190, 300)
            d["bh"], d["bh_t"] = "warn", BLACKHOLE_WARN
            self.sfx("warn")
    elif st == "warn":
        if d["bh_t"] <= 0:
            d["bh"], d["bh_t"] = "on", BLACKHOLE_DURATION
            self.shake = max(self.shake, 0.25)
            self.sfx("blackhole")
            bh_absorb(self)                       # bullets already in flight
    elif st == "on":
        if d["bh_t"] <= 0:
            d["bh"], d["bh_t"] = "off", 0.5
    elif st == "off":
        if d["bh_t"] <= 0:
            if d["bh_left"] > 0:
                d["bh"], d["bh_t"] = "wait", random.uniform(*BLACKHOLE_GAP)
            else:
                d["bh"] = "done"


def bh_draw_world(self, ox, oy):
    d = self.wx2
    c = self.c
    t = time.time()
    for x0, y0, hx, hy, tt, sp in d.get("suck", []):
        p = min(1.0, tt / 0.4)
        k = 1 - p * p
        ang = sp * p * 2.4
        ca, sa = math.cos(ang), math.sin(ang)
        rx, ry = x0 - hx, y0 - hy
        x = hx + (rx * ca - ry * sa) * k + ox
        y = hy + (rx * sa + ry * ca) * k + oy
        r = 1.5 + 3.5 * (1 - p)
        c.create_oval(x - r, y - r, x + r, y + r,
                      fill=mix("#ffffff", "#c58bff", p), outline="")
    st = d.get("bh")
    if st not in ("warn", "on", "off"):
        return
    R = BLACKHOLE_RADIUS
    hx, hy = d["bh_x"] + ox, d["bh_y"] + oy
    col = "#fff200" if self.high_contrast else "#c58bff"
    if st == "warn":
        p = 1 - max(0.0, d["bh_t"]) / BLACKHOLE_WARN
        r = R * 0.6 * p
        ring = R * (2.2 - 1.2 * p)                  # a ring that closes in
        c.create_oval(hx - ring, hy - ring, hx + ring, hy + ring,
                      outline=col, width=2, dash=(5, 5))
        label = "BLACK HOLE OPENING"
    elif st == "on":
        r = R * (1 + 0.05 * math.sin(t * 9))
        label = f"ABSORBING  {max(0.0, d['bh_t']):.1f}s"
    else:
        r = R * max(0.0, d["bh_t"] / 0.5)
        label = ""
    if r < 2:
        return
    glow(c, hx, hy, r * 1.9, col, layers=4, a=0.25)
    for i in range(3):                              # swirling accretion arcs
        rr = r * (1.25 + 0.28 * i)
        start = (t * 140 * (1 if i % 2 == 0 else -1) + i * 70) % 360
        c.create_arc(hx - rr, hy - rr, hx + rr, hy + rr, start=start,
                     extent=110, style="arc",
                     outline=mix("#ffffff", col, 0.35 + 0.2 * i),
                     width=3 - i // 2)
    c.create_oval(hx - r, hy - r, hx + r, hy + r, fill="#000000",
                  outline=col, width=2)
    c.create_oval(hx - r * 0.62, hy - r * 0.62, hx + r * 0.62, hy + r * 0.62,
                  fill="#05020d", outline=mix(col, "#000000", 0.5), width=1)
    if label:
        c.create_text(hx, hy - r - 18, text=label, fill=col,
                      font=(FONT, 10, "bold"))



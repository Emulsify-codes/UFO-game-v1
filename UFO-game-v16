                      font=(FONT, 9, "bold"), text="[B] RICOCHET")
        c.create_rectangle(ability_bar_x1, 114, ability_bar_x2, 122,
                           fill="#171c3e", outline="")
        frac = 1.0 if ready else 1 - self.bounce_cd / BOUNCE_CD
        c.create_rectangle(ability_bar_x1, 114,
                           ability_bar_x1 + (ability_bar_x2 - ability_bar_x1)
                           * frac, 122, fill="#7CFC00" if ready else "#4dd8ff",
                           outline="")
        bx1, bx2 = 88, 150

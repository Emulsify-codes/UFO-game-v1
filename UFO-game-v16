# ---- state ------------------------------------------------------------------
_wx2_old_clear = wx_clear


def wx_clear(self):                 # called between waves and on reset
    _wx2_old_clear(self)
    self.wx2 = {}


def wx_roll(self):
    """Decide the weather for the wave that just started (replaces the old
    roll so the new events share the same pool)."""
    wx_clear(self)
    w = self.wave
    forced = WX2_FORCE if WX2_FORCE in WX2 else None
    if forced:
        self.weather = forced
    else:
        if not WEATHER_ENABLED or w < WORMHOLE_START_WAVE:
            return
        if BOSS_WAVES.get(w) and not WEATHER_ON_BOSS_WAVES:
            return
        chance = WEATHER_CHANCE
        if self.run_mode == "adaptive":
            chance = min(0.65, chance + 0.07 * self.adaptive_pressure)
        if random.random() >= chance:
            return
        pool = ["wormhole"]
        if w >= FLARE_START_WAVE:
            pool.append("flare")
        pool += [k for k, s in WX2.items() if w >= s["start"]]
        self.weather = random.choice(pool)
    self.weather_banner = WEATHER_BANNER_T
    kind = self.weather
    d = self.wx2
    if kind == "wormhole":
        self.wh_times = [random.uniform(*WORMHOLE_DELAY)]
        self.sfx("warn")
    elif kind == "flare":
        self.sfx("flare")
    else:
        if kind in ("meteor", "storm"):
            d.update(spawn=random.uniform(2.5, 4.0), strikes=[])
            self.sfx("warn")
        elif kind == "fog":
            d["puffs"] = [dict(x=random.uniform(0, W),
                               y=random.uniform(130, 420),
                               r=random.uniform(45, 75),
                               v=random.choice((-1, 1))
                               * random.uniform(8, 22))
                          for _ in range(FOG_PUFFS)]
            self.sfx("warn")
        elif kind == "wind":
            d.update(wind=0.0, wind_now=0.0, wind_t=0.0)
            self.sfx("wormhole")
        elif kind == "aurora":
            self.sfx("clear")
        elif kind == "acid":
            self.sfx("flare")
        else:                         # gravity, eclipse
            self.sfx("rumble")


# ---- strikes (meteor / lightning) ---------------------------------------------
def wx2_impact(self, s):
    x = s["x"]
    storm = s["kind"] == "storm"
    col = "#bfe8ff" if storm else "#ff9f43"
    self.explode(x, GROUND + 10, col, 26, 280)
    self.rings.append([x, GROUND + 10, 90, 0.4, 0.4, col])
    self.shake = max(self.shake, 0.2)
    self.sfx("boom")
    if storm:
        dmg = STORM_DMG_BASE + self.wave // 2
        for u in list(self.ufos):
            if u["dead"] or u["mode"] == "dying" or u["y"] < -20:
                continue
            reach = 40 + UFO_SPECS[u["kind"]]["size"] * 0.5
            if abs(u["x"] - x) < reach:
                self.explode(u["x"], u["y"], col, 8, 180)
                self.hurt_ufo(u, dmg)
        self.ufos = [u for u in self.ufos if not u["dead"]]
    if abs(self.px - x) < WX2_PLAYER_HALF + 4:
        self.hurt_player(1)


def wx2_update_effects(self, dt):
    w = self.weather
    d = self.wx2
    if w in ("meteor", "storm"):
        strikes = d.setdefault("strikes", [])
        d["spawn"] = d.get("spawn", 1.5) - dt
        live = [s for s in strikes if not s["done"]]
        if d["spawn"] <= 0 and len(live) < 3:
            d["spawn"] = random.uniform(
                *(METEOR_EVERY if w == "meteor" else STORM_EVERY))
            if random.random() < 0.55:
                x = self.px + random.uniform(-90, 90)
            else:
                x = random.uniform(40, W - 40)
            strikes.append(dict(x=min(W - 40, max(40, x)), t=0.0,
                                done=False, hold=0.0, kind=w))
            self.sfx("warn")
        for s in strikes:
            s["t"] += dt
            if not s["done"] and s["t"] >= STRIKE_WARN:
                s["done"] = True
                s["hold"] = 0.35
                self.wx2_impact(s)
            elif s["done"]:
                s["hold"] -= dt
        d["strikes"] = [s for s in strikes
                        if not s["done"] or s["hold"] > 0]
    elif w == "fog":
        for p in d.get("puffs", []):
            p["x"] += p["v"] * dt
            if p["x"] < -130:
                p["x"] = W + 130
            elif p["x"] > W + 130:
                p["x"] = -130
    elif w == "wind":
        d["wind_t"] = d.get("wind_t", 0.0) - dt
        if d["wind_t"] <= 0:
            d["wind_t"] = random.uniform(*WIND_FLIP)
            d["wind"] = random.choice((-1, 1)) * WIND_FORCE
        d["wind_now"] += (d["wind"] - d["wind_now"]) * min(1.0, dt * 1.5)
        wind = d["wind_now"]
        if self.freeze_t <= 0:
            self.px = min(W - 25, max(25, self.px + wind * dt))
        for b in self.bullets:
            b["vx"] += wind * 0.5 * dt
        for e in self.ebullets:
            e[2] += wind * 0.5 * dt


# ---- update wrapper -------------------------------------------------------------
_wx2_prev_update = Game.update


def wx2_update(self, dt):
    w0 = self.weather
    cleared0 = self.cleared_wave
    live0 = {id(e) for e in self.ebullets}
    last_px = self.wx2.get("px", self.px)
    _wx2_prev_update(self, dt)

    if w0 in WX2 and self.cleared_wave > cleared0:      # wave cleared
        bonus = WX2[w0]["bonus"]
        if bonus:
            self.credits += bonus
            self.shop_msg += (f"  {WX2[w0]['name'].title()} "
                              f"bonus +{bonus} credits.")
        return
    if self.state != "play" or self.weather not in WX2 \
            or self.weather != w0:
        return
    d = self.wx2
    if w0 == "gravity":
        for e in self.ebullets:
            if id(e) not in live0:
                e[2] *= GRAVITY_BULLETS
                e[3] *= GRAVITY_BULLETS
        lim = GRAVITY_MOVE * dt
        delta = max(-lim, min(lim, self.px - last_px))
        self.px = last_px + delta
        d["px"] = self.px
    self.wx2_update_effects(dt)



def activate_shield(self):
    if self.shield_t > 0:
        return
    if self.shield_cd > 0:
        self.floaters.append([self.px, GROUND - 70,
                              f"PLASMA SHIELD {self.shield_cd:.0f}s", 0.8])
        self.sfx("deny")

            c.create_line(tx, 93, tx, 103, fill="#ffffff", width=1)
        tx = bx1 + (bx2 - bx1) * CHARGE_T[0] / CHARGE_T[2]
        c.create_line(tx, 93, tx, 103, fill="#ffffff", width=1)


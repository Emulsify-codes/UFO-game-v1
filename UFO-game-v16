def load_data():
    data = _sk_prev_load_data()
    ranks = {}
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = None
    saved = raw.get("skills") if isinstance(raw, dict) else None
    saved = saved.get("ranks") if isinstance(saved, dict) else None
    if isinstance(saved, dict):
        for k, v in saved.items():
            if k in SKILL_BY_ID and isinstance(v, int) and v > 0:
                ranks[k] = min(v, SKILL_BY_ID[k][3])
    bonus = 0
    if isinstance(raw, dict) and isinstance(raw.get("skills"), dict):
        b = raw["skills"].get("bonus", 0)
        bonus = b if isinstance(b, int) and b > 0 else 0
    data["skills"] = dict(ranks=ranks, bonus=bonus)
    return data



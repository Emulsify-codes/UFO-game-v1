        left = max((mn["life"] for mn in self.minions), default=0.0)
        ability_bar_x1, ability_bar_x2 = 104, 150
        c.create_text(16, 138, anchor="w",
                      fill="#ffe066" if (ready or active) else "#8a93c9",

# ELEMENTAL BALLS  (paste this whole block into ufo_shooter.py, directly
# ABOVE the line:   if __name__ == "__main__":
# It must come AFTER every other add-on block (it is the new last block).)
#
# With an element active, the homing Missile (T) becomes an elemental ball:
#     Fire -> Fireball      Frost -> Frost Ball
#     Thunder -> Thunder Ball      Poison -> Poison Ball
# Combined elements fire TWO balls at the nearest enemy, one per element:
#     Fire + Thunder  -> Fireball + Thunder Ball
#     Frost + Poison  -> Frost Ball + Poison Ball
# Each ball keeps the element's status effect (burn speed boost, slow, stun,
# poison). The cooldown, damage and Salvo enchantment work as before.
# Tune BALL_* below.
# ==========================================================================
BALL_NAMES = dict(fire="FIREBALL", frost="FROST BALL",
                  thunder="THUNDER BALL", poison="POISON BALL")
BALL_SPLIT_ANGLE = 0.30      # radians the two balls of a combo fan apart
BALL_SIZE = 1.0              # visual size multiplier

_ball_prev_fire_missile = Game.fire_missile
_ball_prev_draw_missile = Game.draw_missile
_ball_prev_update = Game.update


def ball_fire_missile(self):
    active = el_ids(getattr(self, "elements", ()))
    n0 = len(self.missiles)
    f0 = len(self.floaters)
    _ball_prev_fire_missile(self)
    if not active or len(self.missiles) <= n0:
        return
    # drop the old "<ELEMENT> MISSILE" floater; we show our own
    self.floaters = self.floaters[:f0] + [
        f for f in self.floaters[f0:] if not str(f[2]).endswith("MISSILE")]
    for m in list(self.missiles[n0:]):
        elems = (el_ids(m.get("elem")) or active)[:2]
        m["ball"] = True
        m["elem"] = (elems[0],)
        if len(elems) > 1:                  # combo: a second ball
            twin = dict(m)
            twin["elem"] = (elems[1],)
            m["a"] -= BALL_SPLIT_ANGLE
            twin["a"] += BALL_SPLIT_ANGLE
            self.missiles.append(twin)
    names = " + ".join(BALL_NAMES[e] for e in active[:2])
    self.floaters.append([self.px, GROUND - 90, names, 1.0])
    for e in active[:2]:
        self.sfx("el_" + e)


def ball_update(self, dt):
    _ball_prev_update(self, dt)
    if self.state != "play":
        return
    for m in self.missiles:
        if not m.get("ball") or m["dead"]:
            continue
        m["pt"] = m.get("pt", 0.0) - dt
        if m["pt"] > 0:
            continue
        m["pt"] = 0.02
        eid = m["elem"][0]
        col = ELEMENTS[eid]["color"]
        bx = m["x"] - math.cos(m["a"]) * 8
        by = m["y"] - math.sin(m["a"]) * 8
        if eid == "fire":
            col = random.choice(("#ff7a2d", "#ffb347", "#ff4d1f"))
            self.particles.append([bx, by, random.uniform(-25, 25),
                                   random.uniform(-45, -5), 0.4, col, 0.4, 0])
        elif eid == "frost":
            self.particles.append([bx, by, random.uniform(-30, 30),
                                   random.uniform(-10, 40), 0.5,
                                   random.choice(("#ffffff", col)), 0.5, 0])
        elif eid == "thunder":
            self.particles.append([bx, by, random.uniform(-70, 70),
                                   random.uniform(-70, 70), 0.25, col,
                                   0.25, 0])
        else:
            self.particles.append([bx, by, random.uniform(-15, 15),
                                   random.uniform(-25, 10), 0.6,
                                   mix(col, "#1b3a10", 0.4), 0.6, 1])


def _ball_reticle(self, m, ox, oy, col):
    tg = m["target"]
    if tg is None or tg["dead"] or tg["mode"] == "dying" \
            or not any(o is tg for o in self.ufos):
        return
    c = self.c
    t = time.time()
    s = UFO_SPECS[tg["kind"]]["size"]
    tx, ty = tg["x"] + ox, tg["y"] + oy
    r = s * 1.1 + 4 + 2 * math.sin(t * 10)
    kk = r * 0.45
    for sx, sy in ((-1, -1), (1, -1), (1, 1), (-1, 1)):
        cx, cy = tx + sx * r, ty + sy * r * 0.7
        c.create_line(cx - sx * kk, cy, cx, cy, cx, cy - sy * kk * 0.7,
                      fill=col, width=2)


def _draw_ball(self, eid, x, y, a, age):
    c = self.c
    t = time.time()
    col = ELEMENTS[eid]["color"]
    r = (9 + 1.2 * math.sin(t * 14 + age * 9)) * BALL_SIZE
    ca, sa = math.cos(a), math.sin(a)

    def P(d, w):                      # d behind the ball, w sideways
        return (x - ca * d - sa * w, y - sa * d + ca * w)

    glow(c, x, y, r * 2.6, col, layers=4, a=0.55)
    if eid == "fire":
        for i in range(5):
            w = (i - 2) * r * 0.42
            ln = r * (1.9 + 0.6 * math.sin(t * 22 + i * 1.7)) \
                * (1.0 - abs(i - 2) * 0.18)
            p1, p2, p3 = P(0, w - r * 0.4), P(ln * 1.5, w), P(0, w + r * 0.4)
            c.create_polygon(*p1, *p2, *p3, fill=mix("#ff3b1f", "#ff9f43",
                             i / 4), outline="")
        c.create_oval(x - r, y - r, x + r, y + r, fill="#ff6a1f",
                      outline="#ffd24d", width=2)
        c.create_oval(x - r * .65, y - r * .65, x + r * .65, y + r * .65,
                      fill="#ffb347", outline="")
        c.create_oval(x - r * .3, y - r * .3, x + r * .3, y + r * .3,
                      fill="#fff6c0", outline="")
    elif eid == "frost":
        c.create_oval(x - r, y - r, x + r, y + r, fill="#bff0ff",
                      outline="#ffffff", width=2)
        c.create_oval(x - r * .6, y - r * .6, x + r * .6, y + r * .6,
                      fill="#e6fbff", outline="")
        for i in range(6):              # spinning snowflake
            ang = t * 4 + i * math.tau / 6
            c.create_line(x, y, x + math.cos(ang) * r * 1.5,
                          y + math.sin(ang) * r * 1.5, fill="#ffffff",
                          width=2)
        for i in range(3):
            ang = -t * 3 + i * math.tau / 3
            cp_sparkle(c, x + math.cos(ang) * r * 1.9,
                       y + math.sin(ang) * r * 1.9, 3, "#ffffff")
    elif eid == "thunder":
        c.create_oval(x - r, y - r, x + r, y + r, fill="#fff3a0",
                      outline="#ffe84d", width=2)
        c.create_oval(x - r * .55, y - r * .55, x + r * .55, y + r * .55,
                      fill="#ffffff", outline="")
        for _ in range(5):              # crackling arcs
            ang = random.uniform(0, math.tau)
            pts = [x, y]
            px, py = x, y
            for _j in range(3):
                ang += random.uniform(-0.8, 0.8)
                px += math.cos(ang) * r * 0.8
                py += math.sin(ang) * r * 0.8
                pts += [px, py]
            c.create_line(pts, fill="#ffe84d", width=2)
    else:                               # poison
        c.create_oval(x - r, y - r, x + r, y + r, fill="#2f6b1d",
                      outline="#9dff3a", width=2)
        c.create_oval(x - r * .7, y - r * .7, x + r * .7, y + r * .7,
                      fill="#4fae2a", outline="")
        for i in range(3):              # bubbling inside
            ph = (t * 1.8 + i * 0.33) % 1.0
            bx = x + math.sin(i * 2.4 + t * 3) * r * 0.4
            by = y + r * 0.5 - ph * r * 1.1
            br = r * (0.12 + 0.12 * (1 - ph))
            c.create_oval(bx - br, by - br, bx + br, by + br,
                          fill="#d8ffa0", outline="")
        for i in range(3):              # dripping blobs behind
            dx, dy = P(r * (1.3 + i * 0.7), math.sin(t * 9 + i) * r * 0.4)
            rr = r * (0.38 - i * 0.09)
            c.create_oval(dx - rr, dy - rr, dx + rr, dy + rr,
                          fill=mix("#7CFC00", "#1b3a10", i * 0.3),
                          outline="")
        c.create_oval(x - r * .45, y - r * .55, x - r * .1, y - r * .2,
                      fill="#ffffff", outline="")



def _quality_on_key_down(self, event, base_handler=None):
    key = event.keysym.lower()
    if self.state == "tutorial":
        if key in ("escape", "backspace"):
            _quality_finish_tutorial(self)
        elif key in ("return", "space", "right", "n"):
            if self.tutorial_step < 3:
                self.tutorial_step += 1
            else:
                _quality_finish_tutorial(self)
        elif key in ("left", "b") and self.tutorial_step > 0:
            self.tutorial_step -= 1
        return
    if self.state in ("play", "paused") and key == "o":
        self.objectives_collapsed = not getattr(
            self, "objectives_collapsed", False)
        return
    return (base_handler or _quality_base_on_key_down)(self, event)


def _quality_on_click(self, event):
    x, y = self.c.to_game(event.x, event.y)
    if self.state == "tutorial":
        key = self.hit(self.tutorial_rects, x, y)
        if key == "previous" and self.tutorial_step > 0:
            self.tutorial_step -= 1
        elif key == "next":
            self.tutorial_step = min(3, self.tutorial_step + 1)
        elif key in ("skip", "start"):
            _quality_finish_tutorial(self)
        return
    if self.state in ("play", "paused") and \
            W - 158 <= x <= W - 8 and 58 <= y <= 80:
        self.objectives_collapsed = not getattr(
            self, "objectives_collapsed", False)
        self.mouse_down = False
        return
    return _quality_base_on_click(self, event)



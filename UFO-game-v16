def ms_finish(self, win, why=""):
    m = getattr(self, "mission", None)
    if not m or m.get("done"):
        return
    m["done"] = True
    p = MS_PLANETS[m["i"]]
    stars = ms_star_rating(m["integrity"]) if win else 0
    res = dict(win=win, i=m["i"], stars=stars, kind="GEMS", integrity=m["integrity"],
               kills=m["kills"], gems=0, first=False, new_best=False,
               unlocked=None, why=why)
    if win:
        cleared = ms_data(self)
        old = cleared.get(p["id"])
        first = old is None
        res["first"] = first
        res["gems"] = ms_reward(p, stars, first)
        res["new_best"] = (not first) and stars > old["stars"]
        cleared[p["id"]] = dict(
            stars=max(stars, old["stars"]) if old else stars,
            clears=(old["clears"] + 1) if old else 1)
        res["kind"] = ms_reward_name(p)
        if "sp" in p:                      # galaxies pay skill points
            sk_bonus_add(self, res["gems"])
        else:
            self.data["gems"] += res["gems"]
        if first and m["i"] + 1 < len(MS_PLANETS):
            res["unlocked"] = MS_PLANETS[m["i"] + 1]["name"]
        self.sfx("clear")
    else:
        self.sfx("over")
    self.data["current"] = None
    self.run_saved = True            # mission runs never go on the leaderboard
    self.run_gems = 0
    self.cancel_weapons()
    self.minions = []
    self.mission_result = res
    self.state = "mission_result"
    self.mouse_down = False
    ms_save(self)



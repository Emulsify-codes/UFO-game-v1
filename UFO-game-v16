# ==========================================================================
# COMBO / MULTIPLIER SYSTEM
# Every kill within COMBO_WINDOW seconds of the last one extends the combo.
# Each COMBO_STEP kills adds COMBO_BONUS to the score multiplier (max x5).
# ==========================================================================
COMBO_WINDOW = 2.5          # seconds you have to land the next kill
COMBO_STEP = 3              # kills per multiplier step
COMBO_BONUS = 0.25          # multiplier added per step
COMBO_MAX_MULT = 5.0


def combo_mult(n):
    return min(COMBO_MAX_MULT, 1.0 + COMBO_BONUS * (n // COMBO_STEP))


def combo_reset_state(self):
    self.combo = 0
    self.combo_t = 0.0
    self.combo_best_run = 0
    self.combo_pop = 0.0


_combo_prev_kill = Game.kill_ufo


def combo_kill_ufo(self, u, src=None):
    s0 = self.score
    _combo_prev_kill(self, u, src)
    n = getattr(self, "combo", 0) + 1
    old_mult = combo_mult(n - 1)
    self.combo = n
    self.combo_t = COMBO_WINDOW
    mult = combo_mult(n)
    gained = self.score - s0
    if mult > 1.0 and gained > 0:
        self.score += round(gained * (mult - 1.0))
    if mult > old_mult:
        self.combo_pop = 0.6
        self.floaters.append([self.px, GROUND - 90, f"COMBO x{mult:.2f}", 1.0])
    if n > getattr(self, "combo_best_run", 0):
        self.combo_best_run = n
    st = self.data["stats"]
    if n > st.get("best_combo", 0):
        st["best_combo"] = n
    best_mult = combo_mult(st.get("best_combo", 0))
    if best_mult > st.get("best_multiplier", 1.0):
        st["best_multiplier"] = best_mult



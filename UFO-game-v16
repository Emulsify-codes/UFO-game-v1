# ==========================================================================
# MULTI-PET SLOTS + PET SLOT UPGRADES
# (paste this whole block into ufo_shooter.py, directly ABOVE the line:
#     if __name__ == "__main__":
#  It must come AFTER the "AUTOMATIC RUN SUMMARY + QUIT BUTTON" block, so it
#  is the very last add-on block.)
#
#   * You can now equip up to PET_SLOT_BASE (3) pets at once.
#   * New UPGRADE tab on the Pets screen: spend gems to unlock slot 4 and
#     slot 5 (PET_SLOT_MAX = 5). Tune the prices in PET_SLOT_COSTS.
#   * Buffs from every equipped pet stack (damage, fire rate, piercing,
#     bullet speed, salvage, multi-shot).
#   * The same normal pet can only be equipped once; each Huge pet (by its
#     own bonus buff) can be equipped once too.
#   * Old saves are migrated automatically: your currently equipped pet moves
#     into slot 1. Slots and upgrades are saved in ufo_leaderboard.json.
# ==========================================================================
PET_SLOT_BASE = 3
PET_SLOT_MAX = 5
PET_SLOT_COSTS = (1000, 3000)       # gems to unlock slot 4, then slot 5
PET_TABS = ("eggs", "collection", "upgrade")


# ---- save data -------------------------------------------------------------
def _pets_normalize(pets):
    """Make pets['slots'] / pets['slot_count'] valid (and migrate old saves)."""
    owned = pets.get("owned", {})
    huge = pets.get("huge", {})
    count = pets.get("slot_count")
    if not isinstance(count, int) or isinstance(count, bool):
        count = PET_SLOT_BASE
    count = max(PET_SLOT_BASE, min(PET_SLOT_MAX, count))
    pets["slot_count"] = count

    if isinstance(pets.get("slots"), list):
        raw_slots = pets["slots"]
    else:                               # old save: one equipped pet
        raw_slots = []
        eq = pets.get("equipped")
        if isinstance(eq, str):
            hi = pets.get("equipped_huge")
            if not isinstance(hi, int) or isinstance(hi, bool):
                hi = None
            raw_slots.append(dict(id=eq, huge=hi))

    clean, seen = [], set()
    for s in raw_slots:
        if not isinstance(s, dict):
            continue
        pid, h = s.get("id"), s.get("huge")
        if pid not in PET_BY_ID:
            continue
        if h is not None:
            if not isinstance(h, int) or isinstance(h, bool) \
                    or not 0 <= h < len(huge.get(pid, [])):
                continue
        elif owned.get(pid, 0) <= 0:
            continue
        if (pid, h) in seen:
            continue
        seen.add((pid, h))
        clean.append(dict(id=pid, huge=h))
        if len(clean) >= count:
            break
    pets["slots"] = clean
    pets["equipped"] = None             # the old single-slot fields are unused
    pets["equipped_huge"] = None


_pets2_prev_load_data = load_data


def load_data():
    data = _pets2_prev_load_data()
    pets = data["pets"]
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = None
    saved = raw.get("pets") if isinstance(raw, dict) else None
    if isinstance(saved, dict):
        if isinstance(saved.get("slots"), list):
            pets["slots"] = [s for s in saved["slots"] if isinstance(s, dict)]
        pets["slot_count"] = saved.get("slot_count")
    _pets_normalize(pets)
    return data


_pets2_prev_ensure = _pets_ensure_data


def _pets_ensure_data(self):
    _pets2_prev_ensure(self)
    _pets_normalize(self.data["pets"])


# ---- buffs from ALL equipped pets -----------------------------------------
def _pet_bonus_amount(self, target_buff):
    data = getattr(self, "data", None)
    pets = data.get("pets") if isinstance(data, dict) else None
    if not isinstance(pets, dict):
        return 0
    huge = pets.get("huge", {})
    total = 0
    for slot in pets.get("slots", []):
        pet = PET_BY_ID.get(slot.get("id"))
        if pet is None:
            continue
        idx = slot.get("huge")
        buffs = huge.get(pet["id"], [])
        is_huge = isinstance(idx, int) and not isinstance(idx, bool) \
            and 0 <= idx < len(buffs)
        if idx is not None and not is_huge:
            continue
        _, main, _ = pet_buff_details(pet)
        if main == target_buff:
            total += _pet_buff_amount(pet, main) * (2 if is_huge else 1)
        if is_huge and buffs[idx] == target_buff:
            total += _pet_buff_amount(pet, buffs[idx])
    return total


# ---- actions ---------------------------------------------------------------
def _pet_msg(self, text, secs=2.5):
    self.pet_message = text
    self.pet_message_t = secs


def pets_toggle_equip(self, pet_id):
    _pets_ensure_data(self)
    pets = self.data["pets"]
    slots = pets["slots"]
    name = PET_BY_ID[pet_id]["name"]
    for i, s in enumerate(slots):
        if s["id"] == pet_id and s["huge"] is None:
            del slots[i]
            _pet_msg(self, f"{name} unequipped.")
            self.sfx("click")
            self.save_ok = save_data(self.data)
            return
    if pets["owned"].get(pet_id, 0) <= 0:
        _pet_msg(self, f"You don't own a normal {name}.")
        self.sfx("deny")
    elif len(slots) >= pets["slot_count"]:
        _pet_msg(self, f"All {pets['slot_count']} slots are full - "
                       "unequip a pet first.")
        self.sfx("deny")
    else:
        slots.append(dict(id=pet_id, huge=None))
        _pet_msg(self, f"{name} equipped.")
        self.sfx("click")
        self.save_ok = save_data(self.data)


def pets_cycle_huge(self, pet_id):
    """Equip the next unequipped Huge version; when none are left to add,
    unequip this pet's Huge versions."""
    _pets_ensure_data(self)
    pets = self.data["pets"]
    slots = pets["slots"]
    name = PET_BY_ID[pet_id]["name"]
    total = len(pets["huge"].get(pet_id, []))
    on = [s["huge"] for s in slots
          if s["id"] == pet_id and s["huge"] is not None]
    free = [i for i in range(total) if i not in on]
    if free and len(slots) < pets["slot_count"]:
        slots.append(dict(id=pet_id, huge=free[0]))
        _pet_msg(self, f"Huge {name} ({free[0] + 1}/{total}) equipped.")
    elif on:
        pets["slots"] = [s for s in slots
                         if not (s["id"] == pet_id
                                 and s["huge"] is not None)]
        _pet_msg(self, f"Huge {name} unequipped.")
    else:
        _pet_msg(self, f"All {pets['slot_count']} slots are full - "
                       "unequip a pet first.")
        self.sfx("deny")
        return
    self.sfx("click")
    self.save_ok = save_data(self.data)


def pets_upgrade_slots(self):
    _pets_ensure_data(self)
    pets = self.data["pets"]
    count = pets["slot_count"]
    if count >= PET_SLOT_MAX:
        _pet_msg(self, "All pet slots are already unlocked.")
        self.sfx("deny")
        return
    cost = PET_SLOT_COSTS[count - PET_SLOT_BASE]
    if self.gems < cost:
        _pet_msg(self, f"Need {cost - self.gems:,} more gems for slot "
                       f"{count + 1}.")
        self.sfx("deny")
        return
    self.data["gems"] -= cost
    pets["slot_count"] = count + 1
    self.save_ok = save_data(self.data)
    _pet_msg(self, f"Slot {count + 1} unlocked! You can now equip "
                   f"{count + 1} pets.", 4.0)
    self.sfx("badge")


def _pets_found(self):
    pets = self.data["pets"]
    return [p for p in PET_CATALOG[self.pet_rarity]
            if p["id"] in pets["owned"] or pets["huge"].get(p["id"])]



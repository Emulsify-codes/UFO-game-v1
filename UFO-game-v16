PET_RARITY_INDEX = {}
for _rarity, _, _color, _count, *_adjectives in PET_RARITIES:
    _pets = []
    for _adjective in _adjectives:
        for _creature in _PET_CREATURES:
            if len(_pets) >= _count:
                break
            _pet_id = f"{_rarity.lower()}_{len(_pets) + 1:02d}"
            _pets.append(dict(
                id=_pet_id, name=f"{_adjective} {_creature}",
                rarity=_rarity, color=_color))
        if len(_pets) >= _count:
            break
    PET_CATALOG[_rarity] = _pets
    PET_RARITY_INDEX.update({pet["id"]: _rarity for pet in _pets})
PET_BY_ID = {
    pet["id"]: pet for pets in PET_CATALOG.values() for pet in pets
}

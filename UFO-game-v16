# ---- drawing ----------------------------------------------------------------
def draw_wormhole(self, ox, oy):
    w = self.wh
    if w is None:
        return
    c = self.c
    t = time.time()
    x, y = w["x"] + ox, w["y"] + oy
    warn = min(1.0, w["t"] / WORMHOLE_WARN_T)
    grow = min(1.0, w["t"] / 0.6)
    fade_out = 1.0 if not w["fired"] else max(0.0, 1.0 - w["done_t"] / 0.6)
    k = grow * fade_out
    if k <= 0.02:
        return
    bgc = sky(300)
    pulse = 0.5 + 0.5 * math.sin(t * (8 + 14 * warn))
    col = mix("#b36bff", "#4dd8ff", 0.5 + 0.5 * math.sin(t * 3))
    danger = "#fff200" if self.high_contrast else mix("#ff5577", "#ffd0dd",
                                                      pulse)
    r = w["r"]
    if not w["fired"]:
        lc = mix(bgc, danger, 0.3 + 0.7 * warn)
        for sx in (-r, r):              # the danger column
            c.create_line(x + sx, y + 40 * k, x + sx, GROUND + 34 + oy,
                          fill=lc, dash=(6, 6), width=2)
        c.create_oval(x - r, GROUND + 22 + oy, x + r, GROUND + 42 + oy,
                      outline=lc, width=2)
        inner = r * (1 - warn)          # closing ring = time left
        if inner > 4:
            c.create_oval(x - inner, GROUND + 26 + oy, x + inner,
                          GROUND + 38 + oy, outline=lc, width=1)
        if abs(self.px - w["x"]) < r:
            c.create_text(self.px + ox, GROUND - 60 + oy, text="MOVE!",
                          fill=danger, font=(FONT, 12, "bold"))
    else:                               # the strike
        a = fade_out
        for sx in (-r * 0.5, 0, r * 0.5):
            c.create_line(x + sx, y, x + sx, GROUND + 40 + oy,
                          fill=mix(bgc, "#bfeeff", a), width=4)
    # swirling portal
    portal_scale = r / WORMHOLE_RADIUS
    for i in range(3):
        rr = (46 - i * 12) * portal_scale * k
        for j in range(3):
            st = (t * (240 + i * 90) * (1 if i % 2 == 0 else -1)
                  + j * 120) % 360
            c.create_arc(x - rr, y - rr, x + rr, y + rr, start=st, extent=60,
                         style="arc", outline=mix(col, "#ffffff", i * 0.2),
                         width=max(3, min(16, 3 * portal_scale)))
    center_r = 9 * portal_scale * k
    c.create_oval(x - center_r, y - center_r, x + center_r, y + center_r,
                  fill="#05030f",
                  outline=col, width=2)
    for i in range(6):
        a = t * 3 + i * math.tau / 6
        orbit_r = 52 * portal_scale * k
        px, py = x + math.cos(a) * orbit_r, y + math.sin(a) * orbit_r
        particle_r = max(2, min(8, 2 * portal_scale)) * k
        c.create_oval(px - particle_r, py - particle_r,
                      px + particle_r, py + particle_r, fill="#ffffff",
                      outline="")


def draw_flare_world(self):
    if self.weather != "flare":
        return
    c = self.c
    t = time.time()
    pulse = 0.5 + 0.5 * math.sin(t * 3)
    for i in range(5):                  # hot orange screen edge
        col = mix("#05060f", "#ff7a2d", (0.55 - i * 0.1) * (0.7 + 0.3 * pulse))
        c.create_rectangle(i * 5 + 2, i * 5 + 2, W - i * 5 - 2,
                           H - i * 5 - 2, outline=col, width=5)
    for i in range(16):                 # embers streaking down
        ph = (t * 0.35 + i * 0.137) % 1.0
        sx = (i * 97.3 + t * 25) % W
        sy = ph * (HORIZON - 40)
        c.create_line(sx, sy, sx - 10, sy + 22,
                      fill=mix(sky(sy), "#ffb347", 0.6 * (1 - ph)), width=2)



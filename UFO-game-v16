def load_data():
    data = _mut_prev_load_data()
    m = dict(kills={}, equipped=[])
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = None
    saved = raw.get("mutations") if isinstance(raw, dict) else None
    if isinstance(saved, dict):
        kills = saved.get("kills")
        if isinstance(kills, dict):
            for k, v in kills.items():
                if k in MUTATIONS and isinstance(v, int) and v > 0:
                    m["kills"][k] = v
        eq = saved.get("equipped")
        if isinstance(eq, list):
            for k in eq:
                if k in MUTATIONS and k not in m["equipped"] \
                        and m["kills"].get(k, 0) >= MUT_UNLOCK_KILLS:
                    m["equipped"].append(k)
    m["equipped"] = m["equipped"][:MUT_SLOTS]
    data["mutations"] = m
    return data


def mut_data(self):
    m = self.data.setdefault("mutations", dict(kills={}, equipped=[]))
    m.setdefault("kills", {})
    m.setdefault("equipped", [])
    return m


def mut_unlocked(self, mid):
    return mut_data(self)["kills"].get(mid, 0) >= MUT_UNLOCK_KILLS


def mut_has(self, mid):
    """True when the player has this mutation's perk equipped."""
    return mid in mut_data(self)["equipped"]


def mut_save(self):
    try:
        save_data(self.data)
    except Exception:
        pass



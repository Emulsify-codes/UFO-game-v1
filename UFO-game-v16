def el_draw_shocks(self, ox, oy):
    c = self.c
    for s in self.shocks:
        eid = el_primary(s.get("elem"))
        col = ELEMENTS[eid]["color"] if eid else SHOCK_COL
        p = min(1.0, s["r"] / SHOCK_MAX_R)
        r = max(2.0, s["r"])
        x, y = s["x"] + ox, s["y"] + oy
        c.create_oval(x - r - 7, y - r - 7, x + r + 7, y + r + 7,
                      outline=fade(col, y, 0.75 + 0.2 * p), width=8)
        c.create_oval(x - r - 2, y - r - 2, x + r + 2, y + r + 2,
                      outline=fade(col, y, 0.35 + 0.5 * p), width=4)
        c.create_oval(x - r, y - r, x + r, y + r,
                      outline=fade("#ffffff", y, 0.2 + 0.7 * p), width=2)


def el_draw_ufo(self, u, ox, oy, scale=1.0):
    _el_prev_draw_ufo(self, u, ox, oy, scale)
    if u.get("mode") == "x" or u.get("dead"):
        return
    frost = u.get("frost_t", 0.0) > 0
    stun = u.get("stun_t", 0.0) > 0
    poison = u.get("poison_t", 0.0) > 0
    if not (frost or stun or poison):
        return
    c = self.c
    t = time.time()
    s = UFO_SPECS[u["kind"]]["size"] * scale
    x = u["x"] + ox
    y = u["y"] + oy + math.sin(u["t"] * 3 + len(u["kind"])) * 2 * scale
    seed = (id(u) >> 4) % 97
    if frost:
        col = ELEMENTS["frost"]["color"]
        c.create_oval(x - s * 1.08, y - s * 0.52, x + s * 1.08, y + s * 0.58,
                      outline=col, width=2, dash=(4, 3))
        for i in range(4):
            a = t * 1.2 + i * math.tau / 4 + seed
            cp_sparkle(c, x + math.cos(a) * s, y + math.sin(a) * s * 0.3,
                       3 + 1.5 * math.sin(t * 6 + i), "#ffffff")
    if stun:
        col = ELEMENTS["thunder"]["color"]
        for i in range(3):
            a = t * 7 + i * math.tau / 3 + seed
            cp_sparkle(c, x + math.cos(a) * s * 0.9,
                       y - s * 0.85 + math.sin(a) * s * 0.18, 4, col)
        for _ in range(2):
            bx = x + random.uniform(-s, s)
            c.create_line(bx, y - s * 0.4,
                          bx + random.uniform(-6, 6), y - s * 0.1,
                          bx + random.uniform(-8, 8), y + s * 0.2,
                          bx + random.uniform(-6, 6), y + s * 0.45,
                          fill=col, width=2)
    if poison:
        col = ELEMENTS["poison"]["color"]
        c.create_oval(x - s * 1.05, y - s * 0.55, x + s * 1.05, y + s * 0.6,
                      outline=mix(col, sky(y), 0.4), width=1)
        for i in range(5):
            ph = (t * 0.8 + i * 0.2 + seed * 0.1) % 1.0
            bx = x + math.sin(ph * 6 + i * 2 + seed) * s * 0.55
            by = y + s * 0.3 - ph * s * 1.1
            r = 1.5 + 2.0 * (1 - ph)
            c.create_oval(bx - r, by - r, bx + r, by + r, outline=col,
                          fill=mix(col, "#05060f", 0.6))


def el_draw_player(self, ox, oy):
    if self.element and not (self.inv > 0 and int(self.inv * 14) % 2 == 0):
        active = el_ids(self.elements)
        if self.el_t > 2.0 or int(self.el_t * 6) % 2 == 0:   # blinks at the end
            c = self.c
            t = time.time()
            x = self.px + ox
            for idx, eid in enumerate(active):
                spec = ELEMENTS[eid]
                glow(c, x, GROUND + 14 + oy, 54 - idx * 8,
                     spec["color"], layers=3, a=0.24)
                for i in range(3):
                    a = t * 2.4 + i * math.tau / 3 + idx * math.pi / 3
                    ex = x + math.cos(a) * (38 - idx * 8)
                    ey = GROUND + 10 + oy + math.sin(a) * 14
                    c.create_oval(ex - 3, ey - 3, ex + 3, ey + 3,
                                  fill=spec["color"], outline="#ffffff")
    _el_prev_draw_player(self, ox, oy)


def el_draw_hud(self):
    _el_prev_draw_hud(self)
    if self.state not in ("play", "paused"):
        return
    c = self.c
    active_elements = el_ids(getattr(self, "elements", self.element))
    act = ELEMENTS[active_elements[0]]["color"] if active_elements else None
    rrect(c, 8, 234, 160, 314, 9, fill="#0b0f26", outline=act or "#3a4690",
          width=2)
    for i, eid in enumerate(ELEMENT_ORDER):
        spec = ELEMENTS[eid]
        y = 247 + i * 18
        active = eid in active_elements
        cd = self.el_cd.get(eid, 0.0)
        ready = cd <= 0
        lab = "#ffffff" if active else (spec["color"] if ready else "#8a93c9")
        c.create_text(16, y, anchor="w", fill=lab, font=(FONT, 9, "bold"),
                      text=f"[{ELEMENT_KEYS[eid]}] {spec['name']}")
        c.create_rectangle(98, y - 4, 150, y + 4, fill="#171c3e", outline="")
        if active:
            frac, bar = max(0.0, self.el_t / ELEMENT_DURATION), spec["color"]
        elif ready:
            frac, bar = 1.0, "#7CFC00"
        else:
            frac = 1 - cd / max(0.1, self.el_cd_max.get(eid, ELEMENT_CD))
            bar = mix(spec["color"], "#171c3e", 0.45)
        c.create_rectangle(98, y - 4, 98 + 52 * frac, y + 4, fill=bar,
                           outline="")
        if active:
            c.create_rectangle(97, y - 5, 151, y + 5, outline=spec["color"],
                               width=1)
    if self.charging and self.element:
        names = " + ".join(ELEMENTS[e]["name"] for e in active_elements)
        spec = ELEMENTS[active_elements[0]]
        shadow_text(c, self.px, GROUND - 106, f"{names} CHARGE",
                    spec["color"], (FONT, 10, "bold"), off=1)



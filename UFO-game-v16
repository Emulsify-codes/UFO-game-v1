def _pets2_on_click(self, event):
    if self.state != "pets":
        return _pets2_prev_on_click(self, event)
    x, y = self.c.to_game(event.x, event.y)
    self.mouse_x, self.mouse_y = x, y
    action = self.hit(self.pet_rects, x, y)
    if action == "back":
        self.close_leaderboard()
    elif isinstance(action, tuple):
        kind, value = action[:2]
        if kind == "tab":
            self.pets_tab = value
            self.pet_scroll = 0
            self.sfx("click")
        elif kind == "buy":
            buy_pet_egg(self, value)
        elif kind == "hatch":
            hatch_pet_egg(self, value)
        elif kind == "rarity":
            self.pet_rarity = value
            self.pet_scroll = 0
        elif kind == "equip":
            pets_toggle_equip(self, value)
        elif kind == "equip_huge":
            pets_cycle_huge(self, value)
        elif kind == "combine":
            _combine_huge_pet(self, value)
        elif kind == "upgrade":
            pets_upgrade_slots(self)


def _pets2_on_key_down(self, event):
    if self.state != "pets":
        return _pets2_prev_on_key_down(self, event)
    key = event.keysym.lower()
    if key in ("escape", "backspace", "return"):
        self.close_leaderboard()
    elif key in ("left", "right", "tab"):
        step = -1 if key == "left" else 1
        self.pets_tab = PET_TABS[
            (PET_TABS.index(self.pets_tab) + step) % len(PET_TABS)]
        self.pet_scroll = 0
        self.sfx("click")
    elif key == "u":
        self.pets_tab = "upgrade"
        self.sfx("click")
    elif self.pets_tab == "collection" and key in ("up", "down"):
        found = _pets_found(self)
        self.pet_scroll = min(max(0, len(found) - 7),
                              max(0, self.pet_scroll
                                  + (-1 if key == "up" else 1)))
    elif key.isdigit():
        index = 9 if key == "0" else int(key) - 1
        if index < len(PET_RARITIES):
            self.pet_rarity = PET_RARITIES[index][0]
            self.pets_tab = "collection"
            self.pet_scroll = 0



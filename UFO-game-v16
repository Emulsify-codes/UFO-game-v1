PU_TAB_STYLE = dict(eggs=("EGGS", "#ffd24d"), collection=("COLLECTION", "#4dd8ff"),
                    upgrade=("UPGRADE", "#c78bff"))


def pu_orb(self, x, y, r, color, t, seed=0.0, huge=False, sleepy=False,
           bg="#0d1124"):
    """A little round pet with ears, eyes and a smile."""
    c = self.c
    bob = 0.0 if sleepy else math.sin(t * 2.4 + seed) * 1.6
    y = y + bob
    glow(c, x, y, r + 9, color, layers=3, a=0.26 if not sleepy else 0.1,
         bg=bg)
    dark = mix(color, "#000000", 0.4)
    for sg in (-1, 1):                       # ears
        c.create_polygon(x + sg * r * 0.85, y - r * 0.1,
                         x + sg * r * 0.62, y - r * 1.12,
                         x + sg * r * 0.18, y - r * 0.78,
                         fill=dark, outline="")
    body = mix(color, "#ffffff", 0.3)
    c.create_oval(x - r, y - r * 0.9, x + r, y + r * 0.9,
                  fill=body if not sleepy else mix(body, bg, 0.6),
                  outline=color, width=2)
    c.create_oval(x - r * 0.55, y + r * 0.05, x + r * 0.55, y + r * 0.82,
                  fill=mix(body, "#ffffff", 0.45), outline="")
    blink = sleepy or (t + seed * 3) % 3.4 < 0.12
    for sg in (-1, 1):
        ex, ey = x + sg * r * 0.4, y - r * 0.18
        if blink:
            c.create_line(ex - r * 0.17, ey, ex + r * 0.17, ey,
                          fill="#101426", width=2)
        else:
            c.create_oval(ex - r * 0.17, ey - r * 0.22, ex + r * 0.17,
                          ey + r * 0.22, fill="#101426", outline="")
            c.create_oval(ex - r * 0.08, ey - r * 0.16, ex + r * 0.02,
                          ey - r * 0.04, fill="#ffffff", outline="")
        c.create_oval(ex + sg * r * 0.05 - r * 0.2, ey + r * 0.3,
                      ex + sg * r * 0.05 + r * 0.2, ey + r * 0.5,
                      fill=mix(color, "#ff7aa8", 0.55), outline="")
    c.create_arc(x - r * 0.2, y + r * 0.12, x + r * 0.2, y + r * 0.42,
                 start=200, extent=140, style="arc", outline="#101426",
                 width=1)
    if huge:                                 # crown of sparkles
        for k, off in enumerate((-0.6, 0.0, 0.6)):
            sx = x + off * r
            sy = y - r * (1.35 if k == 1 else 1.18) - 2
            sp = 0.5 + 0.5 * math.sin(t * 5 + k * 2)
            ms_star(c, sx, sy, 3 + 2 * sp, "#ffe066")


def pu_pill(c, x1, y1, x2, y2, color, fill=None, width=1, alpha=0.9):
    rrect(c, x1, y1, x2, y2, (y2 - y1) / 2,
          fill=fill or mix(color, "#0a0e22", alpha), outline=color,
          width=width)


def pu_gem(c, x, y, s, col="#4dd8ff"):
    c.create_polygon(x, y - s, x + s * 0.8, y, x, y + s, x - s * 0.8, y,
                     fill=col, outline="")
    c.create_polygon(x, y - s, x + s * 0.8, y, x, y, x - s * 0.8, y,
                     fill=mix(col, "#ffffff", 0.4), outline="")


def pu_egg(self, x, y, color, t, seed=0.0, active=False):
    c = self.c
    wob = math.sin(t * 6 + seed) * 2 if active else 0
    if active:
        glow(c, x, y, 16, color, layers=3, a=0.3, bg="#0a0e22")
    c.create_oval(x - 8 + wob * 0.3, y - 11, x + 8 + wob * 0.3, y + 11,
                  fill=mix(color, "#ffffff", 0.55), outline=color, width=2)
    for dx, dy, rr in ((-3, -3, 2), (3, 2, 2.4), (-2, 5, 1.6)):
        c.create_oval(x + dx - rr + wob * 0.3, y + dy - rr,
                      x + dx + rr + wob * 0.3, y + dy + rr,
                      fill=mix(color, "#000000", 0.15), outline="")



                        color=random.choice(("#ffe066", "#ff65b8", "#4dd8ff",
                                             "#8df0bd", "#ff9f43")),
                        size=random.uniform(3, 6)))
        for piece in self.victory_confetti:
            piece["x"] += piece["vx"] * dt
            piece["y"] += piece["vy"] * dt
            piece["vy"] += 35 * dt
            piece["angle"] += piece["spin"] * dt
            piece["life"] -= dt
        self.victory_confetti = [
            piece for piece in self.victory_confetti
            if piece["life"] > 0 and piece["y"] < 108]


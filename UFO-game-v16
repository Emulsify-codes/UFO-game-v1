        self.draw_crate(cx, y1 + 78 + math.sin(t * 2 + i) * 2.5, 1.25, cr, t,
                        0.0, 0.12 if lit else 0.0, cr["glow"] if lit else None)
        if afford:                                  # orbiting sparkles
            for k in range(4):
                a = t * 1.3 + k * math.tau / 4 + i
                sx = cx + math.cos(a) * 64
                sy = y1 + 72 + math.sin(a) * 26
                tw = 0.5 + 0.5 * math.sin(t * 5 + k * 2 + i)
                cp_sparkle(c, sx, sy, 2 + 3 * tw,
                           mix(band, "#ffffff", 0.5 + 0.5 * tw))

        # ---- name and tier chip
        title = f"{i + 1}. {cr['name']}"
        c.create_text(cx, y1 + 158, text=title,
                      fill="#ffffff" if afford else "#8a93c9",
                      font=(FONT, 10 if cr["id"] == "astral_poseidon"
                            else 14, "bold"))
        chip = CP_TAGS.get(cr["id"], "")
        cw = 28 + len(chip) * 7
        rrect(c, cx - cw / 2, y1 + 171, cx + cw / 2, y1 + 187, 8,
              fill=mix(fill, cr["trim"], 0.18 if afford else 0.05),
              outline=cr["trim"] if afford else "#2a3162", width=1)
        c.create_text(cx, y1 + 179, text=chip,
                      fill=cr["trim"] if afford else "#6a6f99",
                      font=(FONT, 8, "bold"))

        # ---- rarity odds: one stacked bar, then a one-column legend
        bx1, bx2, by = x1 + 20, x2 - 20, y1 + 194
        total = float(sum(cr["weights"])) or 1.0
        c.create_rectangle(bx1 - 1, by - 1, bx2 + 1, by + 9,
                           fill="#05060f", outline="#2a3162")
        xx = float(bx1)

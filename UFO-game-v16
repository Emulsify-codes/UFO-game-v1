def _feature_save_control(self, action, key):
    reserved = {"escape", "f11", "f", "s", "tab", "return", "backspace"}
    if key in reserved or (len(key) != 1 and key not in (
            "left", "right", "up", "down", "space")):
        self.option_message = "Choose one letter, number, arrow, or SPACE."
        return
    if key in (v for a, v in self.control_bindings.items() if a != action):
        self.option_message = "That key is already assigned."
        return
    self.control_bindings[action] = key
    self.data["settings"]["controls"] = dict(self.control_bindings)
    self.option_message = f"{CONTROL_LABELS[action]} is now {key.upper()}."
    self._binding_action = None
    self.save_ok = save_data(self.data)


def _feature_option_click(self, key):
    if key == "back":
        self.state = "menu"
        self._binding_action = None
    elif isinstance(key, tuple):
        action, value = key
        if action == "bind":
            self._binding_action = value
            self.option_message = ""
        elif action == "volume":
            self.snd.set_volume(max(
                0.0, min(1.0, self.snd.volume + value / 100)))
            _save_feature_settings(self)
        elif action == "toggle" and value == 1:
            self.reduced_shake = not self.reduced_shake
            _save_feature_settings(self)
        elif action == "toggle" and value == 2:
            self.high_contrast = not self.high_contrast
            _save_feature_settings(self)
        elif action == "toggle" and value == 3:
            self.reduce_flashes = not self.reduce_flashes
            _save_feature_settings(self)
        elif action == "toggle" and value == 4:
            self.large_hud_text = not self.large_hud_text
            _save_feature_settings(self)
    elif key == "tutorial":
        self.launch_tutorial("normal", "normal")


def _feature_on_key_down(self, e):
    k = e.keysym.lower()
    if self.state == "options":
        if self._binding_action:
            _feature_save_control(self, self._binding_action, k)
        elif k in ("escape", "backspace", "o"):
            self.state = "menu"
        elif k in ("left", "right"):
            self.snd.set_volume(max(
                0.0, min(1.0, self.snd.volume
                         + (-0.1 if k == "left" else 0.1))))
            _save_feature_settings(self)
        elif k == "r":
            self.reduced_shake = not self.reduced_shake
            _save_feature_settings(self)
        elif k == "h":
            self.high_contrast = not self.high_contrast
            _save_feature_settings(self)
        return
    if self.state == "briefing":
        if k in ("escape", "backspace"):
            _choose_briefing(self, len(RUN_BONUS_CHOICES)
                             if self._briefing_step == "bonus"
                             else len(WAVE_MODIFIERS))
        elif k in ("1", "2", "3", "4", "5"):
            _choose_briefing(self, int(k) - 1)
        return
    if self.state == "run_summary":
        if k in ("tab", "escape", "backspace"):
            self.state = self.summary_return_state
        elif k in ("r", "return"):
            self.start_game(self.run_mode, self.difficulty)
        elif k == "m":
            self.go_menu()
        elif k == "l":
            self.open_leaderboard(self.summary_return_state)
        return
    if self.state == "menu" and k == "o":
        self.state = "options"
        self.control_bindings = _feature_controls(self)
        return
    if self.state in ("gameover", "victory") and k == "tab":
        self.summary_return_state = self.state
        self.state = "run_summary"
        return

    controls = _feature_controls(self)
    action_by_key = {value: action for action, value in controls.items()}
    action = action_by_key.get(k) if self.state in ("play", "paused") else None
    if action:
        canonical = dict(left="left", right="right", fire="space",
                         missile="t", charge="v", ricochet="b",
                         minions="m", pause="p")[action]
        _base_on_key_down(self, type("KeyEvent", (), {"keysym": canonical})())
        return
    _base_on_key_down(self, e)


def _feature_on_key_up(self, e):
    k = e.keysym.lower()
    controls = _feature_controls(self)
    action = next((a for a, value in controls.items() if value == k), None)
    if action and self.state in ("play", "paused"):
        canonical = dict(left="left", right="right", fire="space",
                         missile="t", charge="v", ricochet="b",
                         minions="m", pause="p")[action]
        _base_on_key_up(self, type("KeyEvent", (), {"keysym": canonical})())
        return
    _base_on_key_up(self, e)


def _feature_on_click(self, e):
    x, y = self.c.to_game(e.x, e.y)
    if self.state == "options":
        self._feature_last_pointer = (x, y)
        _feature_option_click(self, self.hit(self.options_rects, x, y))
        return
    if self.state == "briefing":
        key = self.hit(self.briefing_rects, x, y)
        if isinstance(key, tuple) and key[0] == "choice":
            _choose_briefing(self, key[1])
        return
    if self.state == "run_summary":
        key = self.hit(self.over_rects, x, y)
        if key == "summary_back":
            self.state = self.summary_return_state
        elif key == "play":
            self.start_game(self.run_mode, self.difficulty)
        elif key == "board":
            self.open_leaderboard(self.summary_return_state)
        elif key == "menu":
            self.go_menu()
        return
    if self.state == "menu" and self.hit(self.menu_rects, x, y) == "options":
        self.state = "options"
        self.control_bindings = _feature_controls(self)
        return
    if self.state in ("gameover", "victory"):
        key = self.hit(self.over_rects, x, y)
        if key == "summary":
            self.summary_return_state = self.state
            self.state = "run_summary"
            return

    _base_on_click(self, e)



        owned = {book["id"] for book in self.data["ench"]["books"]}
        if self.enchantment_filter == "owned":
            return [en for en in ENCHANTS if en["id"] in owned]
        if self.enchantment_filter == "missing":
            return [en for en in ENCHANTS if en["id"] not in owned]
        return ENCHANTS

    def skin_click(self, cat, sid):
        """Equip a skin, or buy it (and equip it) if it isn't owned yet."""
        if cat not in SKIN_CATS:
            return
        _lst, table, key, _dflt = SKIN_CATS[cat]
        sk = table.get(sid)
        if sk is None:
            return
        sd = self.data["skins"]
        if sid in sd[cat]:
            if sd[key] == sid:
                self.skin_msg = f"{sk['name']} is already equipped."
                return
            sd[key] = sid
            self.skin_msg = f"Equipped {sk['name']}."
            self.sfx("click")
        elif self.data["gems"] >= sk["cost"]:
            self.data["gems"] -= sk["cost"]
            sd[cat].append(sid)
            sd[key] = sid
            self.skin_msg = f"Bought and equipped {sk['name']}!"
            self.sfx("buy")
        else:
            need = sk["cost"] - self.data["gems"]
            self.skin_msg = f"Not enough gems - you need {need} more."
            self.sfx("deny")
            return
        self.save_ok = save_data(self.data)

    def open_leaderboard(self, came_from):
        self.sfx("click")
        self.lb_return = came_from
        self.lb_scroll = 0
        if self.latest is not None and came_from in ("gameover", "victory"):
            self.lb_mode_filter = self.latest.get("mode", "normal")
            self.lb_difficulty_filter = self.latest.get("difficulty", "normal")
            rows = self.sorted_scores()
            for i, r in enumerate(rows):
                if r is self.latest and i >= LB_VISIBLE:
                    self.lb_scroll = min(self.max_lb_scroll(),
                                         i - LB_VISIBLE + 1)
                    break
        self.state = "leaderboard"

    def close_leaderboard(self):
        self.sfx("click")
        self.state = self.lb_return
        self.last = time.time()

    def go_menu(self):
        if self.state in ("play", "shop", "paused") and self.score > 0:
            self.record_run()

        self.clear_field()
        self.cancel_charge()
        self.mouse_down = False
        self.sfx("click")
        self.state = "menu"
        self.last = time.time()

    @staticmethod
    def hit(rects, x, y):
        for x1, y1, x2, y2, key in rects:
            if x1 <= x <= x2 and y1 <= y <= y2:
                return key
        return None


                      font=(FONT, 9, "bold"), text="[T] MISSILE")
        c.create_rectangle(bx1, 74, bx2, 82, fill="#171c3e", outline="")
        frac = 1.0 if ready else 1 - self.missile_cd / MISSILE_CD
        c.create_rectangle(bx1, 74, bx1 + (bx2 - bx1) * frac, 82,
                           fill="#7CFC00" if ready else "#ff9f43", outline="")
        # charge meter with a tick at each power level
        tier = self.charge_tier() if self.charging else 0
        c.create_text(16, 98, anchor="w",
                      fill=CHARGE_COL[tier] if self.charging else "#8a93c9",
                      font=(FONT, 9, "bold"),
                      text=BEAM_NAMES[tier - 1] if tier else "[V] CHARGE")
        c.create_rectangle(bx1, 94, bx2, 102, fill="#171c3e", outline="")
        if self.charging:
            f = min(1.0, self.charge_t / CHARGE_T[2])
            c.create_rectangle(bx1, 94, bx1 + (bx2 - bx1) * f, 102,
                               fill=CHARGE_COL[tier], outline="")

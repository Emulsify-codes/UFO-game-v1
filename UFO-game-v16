# ---- damage dealt to UFOs ----------------------------------------------------
_mut2_prev_damage = nb_damage_taken


def nb_damage_taken(self, u, dmg):
    dmg = _mut2_prev_damage(self, u, dmg)
    if dmg <= 0:
        return dmg
    mid = u.get("mut")
    if u.get("mshield") and mid != "shielded":
        u["mshield"] = False
        self.explode(u["x"], u["y"], "#4dd8ff", 10, 140)
        mut_float(self, u["x"], u["y"] - 24, "BLOCKED", 0.8)
        return 0
    if mid == "ironclad":
        dmg = min(dmg, 2)
    elif mid == "adaptive":
        n = u.get("adapt", 0)
        u["adapt"] = n + 1
        dmg *= 1 - min(0.5, 0.08 * n)
    elif mid == "overcharged" and u.get("t", 0.0) % 10.0 < 5.0:
        dmg *= 0.4
    for o in self.ufos:
        if o is not u and o.get("mut") == "overlord" and mut_alive(o) \
                and math.hypot(o["x"] - u["x"], o["y"] - u["y"]) < 150:
            dmg *= 0.7
            break
    if mut_has(self, "ironclad") and mid:
        dmg *= 1.25
    if mut_has(self, "minelayer") and u["hp"] >= u["maxhp"]:
        dmg *= 1.5
    if mut_has(self, "blinker") and random.random() < 0.10:
        dmg *= 2
    if mut_has(self, "hunter"):
        dmg *= 1.2
    if mut_has(self, "adaptive") and mut_is_boss(u):
        dmg *= 1.5
    if mut_has(self, "vortex"):
        dmg *= 1 + 0.03 * min(10, getattr(self, "mut_streak2", 0))
    if mut_has(self, "sniper") and not mut_is_boss(u) \
            and u["hp"] - dmg < u["maxhp"] * 0.15:
        dmg = max(dmg, u["hp"] + 1)
    return dmg



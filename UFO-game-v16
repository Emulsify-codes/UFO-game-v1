        if lvl <= 0 or u["mode"] == "dying":
            return
        v = math.hypot(b["vx"], b["vy"]) or 1.0
        power = 170 * lvl * KB_RESIST.get(u["kind"], 1.0)
        u["kvx"] = max(-400, min(400, u["kvx"] + b["vx"] / v * power * 0.6))
        u["kvy"] = max(-650, min(650, u["kvy"] + b["vy"] / v * power))
        self.rings.append([b["x"], b["y"], 16, 0.18, 0.18, "#ffffff"])
        self.sfx("knock")

    def begin_boss_death(self, u):
        u["mode"] = "dying"
        u["dtm"] = 0.0
        u["dur"] = 2.4 if u["kind"] == "boss" else 3.4
        u["prog"] = 0.0
        u["shk"] = 1.5
        u["burst"] = 0.0
        u["r2"] = False
        u["seed"] = random.randrange(1 << 30)
        for e in self.ebullets:             # pop every enemy bullet
            self.explode(e[0], e[1], "#ff8a8a", 4, 90)
        self.ebullets = []
        self.slow = 0.35                    # brief hit-stop
        self.shake = 0.3
        self.sfx("rumble")

    def update_dying(self, u, dt):
        """Boss death animation: it shakes, cracks and chain-explodes, then
        blows up. Runs on real time, not the UFO speed multiplier."""
        s = UFO_SPECS[u["kind"]]["size"]
        u["dtm"] += dt
        prog = min(1.0, u["dtm"] / u["dur"])
        u["prog"] = prog
        u["shk"] = 1.5 + 6.0 * prog
        u["y"] += 10 * dt
        if u["kind"] == "grand" and not u["r2"] and u["dtm"] >= 2.4:
            u["r2"] = True
            self.sfx("rumble")
        u["burst"] -= dt
        if u["burst"] <= 0:
            u["burst"] = max(0.05, 0.22 - 0.17 * prog)
            bx = u["x"] + random.uniform(-0.9, 0.9) * s
            by = u["y"] + random.uniform(-0.35, 0.35) * s
            col = random.choice(("#ffd24d", "#ff9f43", "#ff5a3a", "#ffffff"))
            self.explode(bx, by, col, 9, 170)
            self.particles.append([bx, by, random.uniform(-20, 20),
                                   random.uniform(-70, -30), 1.0,
                                   "#7a7a96", 1.0, 1])
            self.rings.append([bx, by, 22 + 14 * prog, 0.25, 0.25, col])
            self.shake = max(self.shake, 0.12)
            self.sfx("crackle")
        if u["dtm"] >= u["dur"]:
            self.finish_boss_death(u)

    def finish_boss_death(self, u):
        spec = UFO_SPECS[u["kind"]]
        grand = u["kind"] == "grand"
        s = spec["size"]
        x, y = u["x"], u["y"]
        u["dead"] = True
        self.explode(x, y, spec["color"], 110 if grand else 70, 460)
        self.explode(x, y, spec["dome"], 70 if grand else 40, 320)
        self.explode(x, y, "#ffffff", 20, 520)
        for _ in range(36 if grand else 24):            # flying hull chunks
            a = random.uniform(0, math.tau)
            sp = random.uniform(80, 340)
            life = random.uniform(0.9, 1.6)
            self.particles.append([
                x + random.uniform(-0.8, 0.8) * s,
                y + random.uniform(-0.3, 0.3) * s,
                math.cos(a) * sp, math.sin(a) * sp - 90, life,
                random.choice((spec["color"], spec["dome"], "#3a3a55")),
                life, 2])
        self.rings.append([x, y, 340, 0.9, 0.9, "#ffffff"])
        self.rings.append([x, y, 230, 0.7, 0.7, spec["color"]])
        self.rings.append([x, y, 130, 0.5, 0.5, spec["dome"]])
        self.slow = 0.6
        self.hit_flash = 0.6
        self.flash_col = spec["color"]
        self.shake = 0.5
        self.finale = 2.2 if grand else 1.6     # let the blast play out
        self.floaters.append([x, y, f"+{spec['credits']}c", 1.6])
        self.sfx("death")

    def update_ufo(self, u, dt):
        kind = u["kind"]
        mv = dt * UFO_SPEED * self.difficulty_settings["speed"]
        u["t"] += mv
        u["flash"] = max(0.0, u["flash"] - dt)

        if u["mode"] == "dying":
            self.update_dying(u, dt)
            return

        # knockback: slide along the push, then slow down
        if u["kvx"] or u["kvy"]:
            u["x"] += u["kvx"] * dt
            u["base_x"] = min(W - 40, max(40, u["base_x"] + u["kvx"] * dt))
            u["x"] = min(W - 30, max(30, u["x"]))
            u["y"] = max(-60.0, u["y"] + u["kvy"] * dt)
            damp = math.exp(-7.0 * dt)
            u["kvx"] *= damp
            u["kvy"] *= damp
            if abs(u["kvx"]) < 4:
                u["kvx"] = 0.0
            if abs(u["kvy"]) < 4:
                u["kvy"] = 0.0

        if kind == "scout":
            u["x"] += u["vx"] * mv
            u["y"] += 22 * mv
            if u["y"] < 40:
                u["y"] += 120 * mv
            if u["x"] < 30 or u["x"] > W - 30:
                u["vx"] = -u["vx"]
                u["x"] = min(W - 30, max(30, u["x"]))
                u["y"] += 38

        elif kind == "saucer":
            u["y"] += 38 * mv
            u["x"] = min(W - 40, max(40, u["base_x"] + math.sin(u["t"] * 2.0) * 110))
            if self.wave >= 3:
                u["shoot"] -= dt
                if u["shoot"] <= 0:
                    u["shoot"] = random.uniform(3.0, 5.0)
                    self.enemy_shot(u["x"], u["y"] + 15, speed=230)

        elif kind == "heavy":
            u["y"] += 20 * mv
            u["x"] = min(W - 50, max(50, u["base_x"] + math.sin(u["t"] * 0.8) * 50))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.6
                self.enemy_shot(u["x"], u["y"] + 20, self.px, GROUND, 250)

        elif kind == "wraith":
            u["y"] += 34 * mv
            u["x"] = min(W - 42, max(42, u["base_x"]
                                     + math.sin(u["t"] * 2.4) * 145))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = random.uniform(2.2, 3.2)
                for side in (-1, 1):
                    self.enemy_shot(u["x"] + side * 10, u["y"] + 12,
                                    self.px + side * 90, GROUND, 245)

        elif kind == "leviathan":
            u["y"] += 15 * mv
            u["x"] = min(W - 60, max(60, u["base_x"]
                                     + math.sin(u["t"] * 0.65) * 70))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.8
                for off in (-0.28, 0.0, 0.28):
                    ang = math.atan2(GROUND - u["y"], self.px - u["x"]) + off
                    self.ebullets.append([u["x"], u["y"] + 22,
                                          math.cos(ang) * 235,
                                          math.sin(ang) * 235])
                self.sfx("enemy")

        elif kind == "siren":
            u["y"] += 30 * mv
            u["x"] = min(W - 45, max(45, u["base_x"]
                                     + math.sin(u["t"] * 1.8) * 120))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.0
                self.enemy_shot(u["x"] - 12, u["y"] + 14, self.px - 100,
                                GROUND, 260)
                self.enemy_shot(u["x"] + 12, u["y"] + 14, self.px + 100,
                                GROUND, 260)

        elif kind == "ravager":
            u["y"] += 18 * mv
            u["x"] = min(W - 65, max(65, u["base_x"]
                                     + math.sin(u["t"] * 0.55) * 60))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.4
                for i in range(-2, 3):
                    ang = math.pi / 2 + i * 0.22
                    self.ebullets.append([u["x"], u["y"] + 25,
                                          math.cos(ang) * 250,
                                          math.sin(ang) * 250])
                self.sfx("enemy")

        elif kind == "interceptor":
            u["y"] += 48 * mv
            u["x"] = min(W - 38, max(38, u["base_x"]
                                     + math.sin(u["t"] * 3.2) * 155))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 1.7
                self.enemy_shot(u["x"], u["y"] + 14, self.px, GROUND, 290)

        elif kind == "bomber":
            u["y"] += 16 * mv
            u["x"] = min(W - 55, max(55, u["base_x"]
                                     + math.sin(u["t"] * 0.9) * 75))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 3.0
                for off in (-0.3, 0.0, 0.3):
                    ang = math.pi / 2 + off
                    self.ebullets.append([u["x"], u["y"] + 22,
                                          math.cos(ang) * 190,
                                          math.sin(ang) * 190])
                self.sfx("enemy")

        elif kind == "phantom":
            u["y"] += 40 * mv
            u["x"] = min(W - 42, max(42, u["base_x"]
                                     + math.sin(u["t"] * 2.7) * 130))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.4
                for side in (-1, 1):
                    self.enemy_shot(u["x"] + side * 10, u["y"] + 14,
                                    self.px + side * 80, GROUND, 270)

        elif kind == "sentinel":
            u["y"] += 19 * mv
            u["x"] = min(W - 58, max(58, u["base_x"]
                                     + math.sin(u["t"] * 0.75) * 55))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.5
                for off in (-0.16, 0.0, 0.16):
                    ang = math.atan2(GROUND - u["y"], self.px - u["x"]) + off
                    self.ebullets.append([u["x"], u["y"] + 22,
                                          math.cos(ang) * 240,
                                          math.sin(ang) * 240])
                self.sfx("enemy")

        elif kind == "tempest":
            u["y"] += 30 * mv
            u["x"] = min(W - 48, max(48, u["base_x"]
                                     + math.sin(u["t"] * 1.8) * 115))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.2
                for i in range(-2, 3):
                    ang = math.pi / 2 + i * 0.2
                    self.ebullets.append([u["x"], u["y"] + 18,
                                          math.cos(ang) * 235,
                                          math.sin(ang) * 235])
                self.sfx("enemy")

        elif kind == "reaper":
            u["y"] += 14 * mv
            u["x"] = min(W - 62, max(62, u["base_x"]
                                     + math.sin(u["t"] * 0.6) * 65))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.0
                self.enemy_shot(u["x"] - 12, u["y"] + 24,
                                self.px - 70, GROUND, 275)
                self.enemy_shot(u["x"] + 12, u["y"] + 24,
                                self.px + 70, GROUND, 275)

        elif kind == "diver":
            if u["mode"] == "enter":
                u["y"] += 110 * mv
                if u["y"] >= 110:
                    u["mode"] = "aim"
                    u["timer"] = 0.9
                    self.sfx("warn")
            elif u["mode"] == "aim":
                u["timer"] -= dt
                u["x"] += math.sin(u["t"] * 50) * 40 * mv   # telegraph wobble
                if u["timer"] <= 0:
                    d = math.hypot(self.px - u["x"], GROUND - u["y"]) or 1
                    u["vx"] = (self.px - u["x"]) / d * 330
                    u["vy"] = (GROUND - u["y"]) / d * 330
                    u["mode"] = "dive"
            else:
                u["x"] += u["vx"] * mv
                u["y"] += u["vy"] * mv
                if math.hypot(u["x"] - self.px, u["y"] - GROUND) < 30:
                    u["dead"] = True
                    self.explode(u["x"], u["y"], "#ff4d6d", 25)
                    self.hurt_player(2)
                    return

        elif kind == "boss":
            if u["y"] < 95:
                u["y"] += 60 * mv
            else:
                u["x"] = W / 2 + math.sin(u["t"] * 0.7) * (W / 2 - 110)
            u["shoot"] -= dt
            if u["shoot"] <= 0 and u["y"] >= 90:
                u["shoot"] = 1.8
                for i in range(-2, 3):
                    ang = math.pi / 2 + i * 0.28
                    self.ebullets.append([u["x"], u["y"] + 30,
                                          math.cos(ang) * 230, math.sin(ang) * 230])
                self.enemy_shot(u["x"], u["y"] + 30, self.px, GROUND, 280)

        elif kind == "grand":
            if u["y"] < 150:
                u["y"] += 45 * mv
            else:
                u["x"] = W / 2 + math.sin(u["t"] * 0.4) * (W / 2 - 170)
            ready = u["y"] >= 140
            # wide spread of shots plus one aimed shot
            u["shoot"] -= dt
            if u["shoot"] <= 0 and ready:
                u["shoot"] = 2.4
                for i in range(-3, 4):
                    ang = math.pi / 2 + i * 0.24
                    self.ebullets.append([u["x"], u["y"] + 45,
                                          math.cos(ang) * 210, math.sin(ang) * 210])
                self.enemy_shot(u["x"], u["y"] + 45, self.px, GROUND, 270)
            # launch Scouts and Saucers
            u["timer"] -= dt
            if u["timer"] <= 0 and ready:
                u["timer"] = max(2.0, 4.0 - self.wave * 0.1)
                escorts = sum(1 for o in self.ufos
                              if o["kind"] in ("scout", "saucer") and not o["dead"])
                if escorts < 10:
                    for off in (-70, 70):
                        self.spawn_ufo(random.choice(("scout", "saucer")),
                                       u["x"] + off, u["y"] + 55)

        # reached the ground
        if kind not in ("boss", "grand") and not u["dead"] and u["y"] > GROUND - 20:
            u["dead"] = True
            self.explode(u["x"], GROUND, "#ffaa33", 20)
            self.hurt_player(1)

    # ------------------------------------------------------------------
    # drawing
    # ------------------------------------------------------------------
    def draw(self):
        self.draw_scene()
        self.draw_sound_toast()
        self.c.letterbox(*self.screen)

    def draw_sound_toast(self):
        """Small 'SOUND ON / OFF' note in the top-right corner after pressing S."""
        if self.sound_toast <= 0:
            return
        if self.snd.enabled and self.snd.backend is None:
            txt = "NO AUDIO PLAYER FOUND"
        else:
            txt = "SOUND ON" if self.snd.enabled else "SOUND OFF"
        shadow_text(self.c, W - 14, 62, txt, "#ffe066", (FONT, 10, "bold"),
                    anchor="e", off=1)

    def draw_scene(self):
        c = self.c
        # delete everything except the static background
        dead = [i for i in c.find_all() if i not in self.bg_ids]
        if dead:
            c.delete(*dead)
        ox = oy = 0
        if self.shake > 0 and self.state == "play":
            ox, oy = random.randint(-4, 4), random.randint(-4, 4)

        self.draw_stars()

        if self.state == "menu":
            self.draw_menu()
            return
        if self.state == "mode_select":
            self.draw_mode_select()
            return
        if self.state == "difficulty_select":
            self.draw_difficulty_select()
            return
        if self.state == "victory":
            self.draw_victory()
            self.draw_toasts()
            return
        if self.state == "leaderboard":
            self.draw_leaderboard()
            return
        if self.state == "badges":
            self.draw_badges()
            return
        if self.state == "skins":
            self.draw_skins()
            return
        if self.state == "index":
            self.draw_index()
            return
        if self.state == "enchantments":
            self.draw_enchantments()
            return
        if self.state == "levels":
            self.draw_levels()
            self.draw_toasts()
            return

        for u in self.ufos:
            self.draw_ufo(u, ox, oy)

        for b in self.bullets:
            self.draw_bullet(b, ox, oy)
        for m in self.missiles:
            self.draw_missile(m, ox, oy)
        for e in self.ebullets:
            x, y = e[0] + ox, e[1] + oy
            glow(c, x, y, 13, "#ff3b3b", layers=3, a=0.55)
            c.create_oval(x - 5, y - 5, x + 5, y + 5, fill="#ff4d4d",
                          outline="#ffaaaa")
            c.create_oval(x - 2, y - 2, x + 2, y + 2, fill="#ffffff",
                          outline="")

        self.draw_fx(ox, oy)

        for f in self.floaters:
            k = min(1.0, f[3] / 0.45)
            shade_c = mix("#000000", sky(f[1]), 1 - k)
            c.create_text(f[0] + 1, f[1] + 1, text=f[2], fill=shade_c,
                          font=(FONT, 11, "bold"))
            c.create_text(f[0], f[1], text=f[2],
                          fill=mix(sky(f[1]), "#ffe066", k),
                          font=(FONT, 11, "bold"))

        self.draw_beams(ox, oy)
        if self.state != "gameover":
            self.draw_player(ox, oy)
            self.draw_minions(ox, oy)
            self.draw_charge(ox, oy)
        self.draw_hud()
        self.draw_flash()

        if self.banner > 0 and self.state == "play":
            self.draw_banner()
        if self.state == "paused":
            rrect(c, W / 2 - 190, H / 2 - 55, W / 2 + 190, H / 2 + 55, 16,
                  fill="#0b0f26", outline="#4a5bd0", width=3)
            shadow_text(c, W / 2, H / 2 - 8, "PAUSED", "#ffffff",
                        (FONT, 30, "bold"))
            c.create_text(W / 2, H / 2 + 28, text="press P to resume",
                          fill="#8a93c9", font=(FONT, 11))
        if self.state == "shop":
            self.draw_shop()
        if self.state == "gameover":
            self.draw_gameover()
        self.draw_toasts()

    def draw_stars(self):
        c = self.c
        t = time.time()
        mx, my, mr = MOON
        for x, y, sp, sz, ph, br in self.stars:
            if (x - mx) ** 2 + (y - my) ** 2 < (mr + 8) ** 2:
                continue
            tw = 0.75 + 0.25 * math.sin(t * ph + x)
            g = min(255, int((90 + sp * 2.5) * br * tw))
            c.create_rectangle(x, y, x + sz, y + sz,
                               fill=f"#{g:02x}{g:02x}{min(255, g + 40):02x}",
                               outline="", tags="stars")
        m = self.meteor
        if m:
            k = max(0.0, min(1.0, m[4] / 0.9))
            for i in range(4):
                f0, f1 = i * 0.045, (i + 1) * 0.045
                col = mix("#ffffff", sky(m[1]), 1 - k * (1 - i * 0.25))
                c.create_line(m[0] - m[2] * f0, m[1] - m[3] * f0,
                              m[0] - m[2] * f1, m[1] - m[3] * f1,
                              fill=col, width=3 - i * 0.6, tags="stars")
        # stars sit above the sky but behind mountains / city / ground
        c.tag_lower("stars", self.front_first)

    def draw_bullet(self, b, ox, oy):
        trail = [(tx + ox, ty + oy) for tx, ty in b["trail"]]
        # ricochet bullets are drawn a little bigger so you can follow them
        self.draw_bullet_skin(self.bullet_skin, b["x"] + ox, b["y"] + oy,
                              trail, 1.3 if "bn" in b else b.get("s", 1.0))

    def draw_bullet_skin(self, sk, x, y, trail, s=1.0, bg=None, t=None):
        """One bullet with its trail, in the given skin (also used as the
        preview in the skin shop)."""
        c = self.c
        t = time.time() if t is None else t
        mode = sk.get("mode")
        n = len(trail)
        for i, (tx, ty) in enumerate(trail):
            k = (i + 1) / (n + 1)
            r = (1 + 2.5 * k) * s
            if mode == "rainbow":
                col = hsv(t * 0.9 + i * 0.09, 0.85, 1.0)
            elif mode == "fire":
                col = mix("#ff3b1f", "#ffd24d", k)
            elif mode == "duo":
                col = mix(sk["trail"], sk["trail2"], k)
            else:
                col = sk["trail"]
            if mode == "matrix":            # falling 0s and 1s
                c.create_text(tx, ty, text="01"[(i + int(t * 12)) % 2],
                              fill=mix(col, bg or sky(ty), 1 - k * 0.9),
                              font=(FONT, max(6, int(10 * s)), "bold"))
                continue
            fade_c = mix(col, bg or sky(ty), 1 - k * 0.85)
            if mode == "bubble":            # empty soap-bubble rings
                rb = r * 1.7
                c.create_oval(tx - rb, ty - rb, tx + rb, ty + rb,
                              outline=fade_c, width=1)
                continue
            if mode == "petal":             # fluttering petals
                px = tx + math.sin(i * 2.1 + t * 6) * 5 * s
                c.create_polygon(px, ty - r * 1.6, px + r * 1.1, ty,
                                 px, ty + r * 1.6, px - r * 1.1, ty,
                                 fill=fade_c, outline="")
                continue
            if mode == "heart":             # tiny hearts
                c.create_polygon(self.heart_pts(tx, ty, r * 1.3),
                                 fill=fade_c, outline="")
                continue
            if mode == "beam":              # drawn as one streak below
                continue
            c.create_oval(tx - r, ty - r, tx + r, ty + r,
                          fill=mix(col, bg or sky(ty), 1 - k * 0.85),
                          outline="")
            if mode == "sparkle" and (i + int(t * 18)) % 3 == 0:
                sx = tx + math.sin(i * 5 + t * 10) * 5 * s
                c.create_line(sx - 2 * s, ty, sx + 2 * s, ty,
                              fill="#ffffff", width=1)
                c.create_line(sx, ty - 2 * s, sx, ty + 2 * s,
                              fill="#ffffff", width=1)
        if mode == "zap" and n >= 1:        # jagged lightning along the trail
            pts = []
            for tx, ty in trail:
                pts += [tx + random.uniform(-5, 5) * s, ty]
            pts += [x, y]
            c.create_line(pts, fill="#ffffff", width=2)
            c.create_line([v + (random.uniform(-3, 3) * s if j % 2 == 0
                                else 0) for j, v in enumerate(pts)],
                          fill="#ffe84d", width=1)
        if mode == "rainbow":
            hue = t * 0.9
            glowc, body = hsv(hue, 0.8, 1.0), hsv(hue + 0.15, 0.3, 1.0)
            outline = hsv(hue, 0.9, 1.0)
        else:
            glowc, body, outline = sk["glow"], sk["body"], sk["outline"]
        glow(c, x, y, 13 * s, glowc, layers=3, a=0.55, bg=bg)
        if mode == "beam":                  # a thin laser streak
            top = trail[0][1] if trail else y + 16 * s
            c.create_line(x, min(top, y + 12 * s), x, y - 8 * s,
                          fill=mix(sk["trail"], bg or sky(y), 0.35),
                          width=3 * s, capstyle="round")
            c.create_line(x, y + 10 * s, x, y - 14 * s, fill=sk["trail"],
                          width=3 * s, capstyle="round")
            c.create_line(x, y + 9 * s, x, y - 12 * s, fill="#ffffff",
                          width=1.2 * s, capstyle="round")
            return
        if mode == "heart":
            c.create_polygon(self.heart_pts(x, y, 7.5 * s), fill=body,
                             outline=outline)
            c.create_oval(x - 3.5 * s, y - 4 * s, x - 1.5 * s, y - 2 * s,
                          fill="#ffffff", outline="")
            return
        if mode == "bubble":
            c.create_oval(x - 6 * s, y - 6 * s, x + 6 * s, y + 6 * s,
                          fill=mix(body, bg or sky(y), 0.7), outline=outline,
                          width=1)
            c.create_oval(x - 3.5 * s, y - 4 * s, x - 1 * s, y - 1.5 * s,
                          fill="#ffffff", outline="")
            return
        if mode == "orbit":                 # nucleus with 2 electrons
            ring = mix(sk["outline"], bg or sky(y), 0.55)
            for rx, ry in ((9, 4), (4, 9)):         # two crossed orbits
                c.create_oval(x - rx * s, y - ry * s, x + rx * s,
                              y + ry * s, outline=ring, width=1)
                ang = t * 9 + (0 if rx > ry else math.pi)
                ex, ey = x + math.cos(ang) * rx * s, y + math.sin(ang) * ry * s
                c.create_oval(ex - 1.8 * s, ey - 1.8 * s, ex + 1.8 * s,
                              ey + 1.8 * s, fill="#ffffff", outline="")
            c.create_oval(x - 3.5 * s, y - 3.5 * s, x + 3.5 * s, y + 3.5 * s,
                          fill=sk["glow"], outline=outline)
            c.create_oval(x - 1.5 * s, y - 1.5 * s, x + 1.5 * s, y + 1.5 * s,
                          fill="#ffffff", outline="")
            return
        if mode == "coin":                  # a coin spinning on its edge
            wd = max(0.6, abs(math.cos(t * 11))) * 6 * s
            c.create_oval(x - wd, y - 7 * s, x + wd, y + 7 * s, fill=body,
                          outline=outline, width=1)
            if wd > 3 * s:
                c.create_oval(x - wd * 0.55, y - 4 * s, x + wd * 0.55,
                              y + 4 * s, outline=mix(body, "#7a5a00", 0.5),
                              width=1)
            c.create_line(x - wd * 0.6, y - 4 * s, x - wd * 0.2, y - 6 * s,
                          fill="#ffffff", width=1)
            return
        if mode in ("rainbow", "void"):
            c.create_oval(x - 5 * s, y - 9 * s, x + 5 * s, y + 9 * s,
                          outline=hsv(t * 0.9 + 0.5, 0.8, 1.0)
                          if mode == "rainbow" else "#8a3dff", width=1)
        c.create_oval(x - 3 * s, y - 7 * s, x + 3 * s, y + 7 * s,
                      fill=body, outline=outline)
        c.create_oval(x - 1 * s, y - 4 * s, x + 1 * s, y + 2 * s,
                      fill=sk["core"], outline="")

    @staticmethod
    def heart_pts(cx, cy, hw):
        """Outline of a heart, hw = half its width (flat list of x, y)."""
        pts = []
        for j in range(16):
            a = j * math.tau / 16
            hx = 16 * math.sin(a) ** 3
            hy = -(13 * math.cos(a) - 5 * math.cos(2 * a)
                   - 2 * math.cos(3 * a) - math.cos(4 * a))
            pts += [cx + hx * hw / 16, cy + hy * hw / 16 + hw * 0.1]
        return pts

    def draw_missile(self, m, ox, oy):
        """A homing missile with a flame, plus a lock-on reticle on its target."""
        c = self.c
        t = time.time()
        x, y, a = m["x"] + ox, m["y"] + oy, m["a"]

        # lock-on reticle
        tg = m["target"]
        if tg is not None and not tg["dead"] and tg["mode"] != "dying" \
                and any(o is tg for o in self.ufos):
            s = UFO_SPECS[tg["kind"]]["size"]
            tx, ty = tg["x"] + ox, tg["y"] + oy
            r = s * 1.1 + 4 + 2 * math.sin(t * 10)
            col = mix("#ff3b3b", "#ffd0d0", 0.5 + 0.5 * math.sin(t * 12))
            kk = r * 0.45
            for sx, sy in ((-1, -1), (1, -1), (1, 1), (-1, 1)):
                cx, cy = tx + sx * r, ty + sy * r * 0.7
                c.create_line(cx - sx * kk, cy, cx, cy, cx, cy - sy * kk * 0.7,
                              fill=col, width=2)

        self.draw_missile_skin(self.missile_skin, x, y, a, m.get("s", 1.0),
                               m["age"], t)

    def draw_missile_skin(self, sk, x, y, a, s=1.0, age=0.0, t=None, bg=None):
        """One missile (flame, fins, body) pointing in direction `a`, in the
        given skin. Also used for the preview in the skin shop (scaled by s)."""
        c = self.c
        t = time.time() if t is None else t
        mode = sk["mode"]
        ca, sa = math.cos(a), math.sin(a)

        def P(d, w):                    # point d along the missile, w sideways
            return (x + (ca * d - sa * w) * s, y + (sa * d + ca * w) * s)

        def poly(pts, **kw):
            flat = []
            for px, py in pts:
                flat += [px, py]
            c.create_polygon(flat, **kw)

        if mode == "rainbow":
            hue = t * 0.9 + age
            body = hsv(hue, 0.55, 1.0)
            nose, fin = hsv(hue + 0.33, 0.8, 1.0), hsv(hue + 0.66, 0.8, 1.0)
            stripe = hsv(hue + 0.5, 0.9, 1.0)
            flame, flame2 = hsv(hue + 0.15, 0.8, 1.0), "#ffffff"
            gcol = hsv(hue, 0.7, 1.0)
        else:
            body, nose, fin = sk["body"], sk["nose"], sk["fin"]
            stripe, flame, flame2 = sk["stripe"], sk["flame"], sk["flame2"]
            gcol = sk["glow"]
        edge = mix(body, "#000000", 0.4)

        # exhaust flame
        fx, fy = P(-12, 0)
        if mode != "comet":
            glow(c, fx, fy, 16 * s, gcol, layers=3, a=0.6, bg=bg)
        L = (11 + 6 * math.sin(t * 45 + age * 30)) * (1.5 if mode == "fire"
                                                      else 1.0)
        poly([P(-9, -3), P(-9 - L, 0), P(-9, 3)], fill=flame, outline="")
        poly([P(-9, -1.7), P(-9 - L * 0.6, 0), P(-9, 1.7)], fill=flame2,
             outline="")

        if mode == "comet":                 # no rocket: a glowing star
            glow(c, x, y, 20 * s, gcol, layers=4, a=0.8, bg=bg)
            r = 7 * s
            c.create_oval(x - r, y - r, x + r, y + r, fill="#ffffff",
                          outline=mix("#ffffff", gcol, 0.5), width=1)
            r2 = 3.5 * s
            c.create_oval(x - r2, y - r2, x + r2, y + r2,
                          fill=mix("#ffffff", gcol, 0.35), outline="")
            for k in range(4):              # four-point sparkle
                ang = t * 3 + k * math.pi / 2
                p2 = (x + math.cos(ang) * 13 * s, y + math.sin(ang) * 13 * s)
                c.create_line(x, y, p2[0], p2[1], fill="#ffffff", width=1)
            return

        # fins, body, nose cone, stripe
        for sg in (-1, 1):
            poly([P(-10, sg * 3.4), P(-15, sg * 8.5), P(-4, sg * 3.4)],
                 fill=fin, outline="")
        poly([P(-10, -3.5), P(7, -3.5), P(14, 0), P(7, 3.5), P(-10, 3.5)],
             fill=body, outline=edge)
        if mode == "hazard":                # warning stripes along the body
            for d in (-9, -3, 3):
                poly([P(d, -3.5), P(d + 3, -3.5), P(d + 3, 3.5), P(d, 3.5)],
                     fill=stripe, outline="")
        elif mode == "snow":                # icy glints
            for d, w in ((-6, -1.5), (-1, 1.5), (3, -1)):
                r = 0.9 * s
                px, py = P(d, w)
                c.create_oval(px - r, py - r, px + r, py + r,
                              fill="#ffffff", outline="")
        elif mode == "fire":                # flame licks along the body
            poly([P(-10, -3.5), P(-4, -1), P(-1, -3.5)], fill=stripe,
                 outline="")
            poly([P(-10, 3.5), P(-4, 1), P(-1, 3.5)], fill=stripe, outline="")
        poly([P(7, -3.5), P(14, 0), P(7, 3.5)], fill=nose, outline="")
        if mode not in ("hazard", "fire"):
            poly([P(-3, -3.5), P(0, -3.5), P(0, 3.5), P(-3, 3.5)],
                 fill=stripe, outline="")

    def draw_charge(self, ox, oy):
        """The energy ball that grows at the gun's muzzle while V is held."""
        if not self.charging:
            return
        c = self.c
        t = time.time()
        tier = self.charge_tier()
        frac = min(1.0, self.charge_t / CHARGE_T[2])
        r = 5 + 19 * frac
        col = CHARGE_COL[tier]
        x = self.px + ox
        y = GROUND - 46 - r * 0.5 + oy
        pulse = 1 + 0.08 * math.sin(t * (12 + 4 * tier))
        glow(c, x, y, (r * 2.3 + 4) * pulse, col, layers=5, a=0.8)
        # energy being sucked in
        for i in range(6):
            ph = (t * 1.6 + i / 6) % 1.0
            ang = i * math.tau / 6 + t * 0.9
            d0 = r + 6 + (1 - ph) * 46
            d1 = d0 - 9
            c.create_line(x + math.cos(ang) * d0, y + math.sin(ang) * d0,
                          x + math.cos(ang) * d1, y + math.sin(ang) * d1,
                          fill=mix(sky(y), col, ph), width=2)
        c.create_oval(x - r, y - r, x + r, y + r,
                      fill=mix(col, "#000000", 0.4), outline=col, width=2)
        c.create_oval(x - r * 0.7, y - r * 0.7, x + r * 0.7, y + r * 0.7,
                      fill=col, outline="")
        c.create_oval(x - r * 0.35, y - r * 0.35, x + r * 0.35, y + r * 0.35,
                      fill="#ffffff", outline="")
        # orbiting sparks (more of them at higher levels)
        n = 3 + tier * 2
        for i in range(n):
            ang = t * (5 + tier) + i * math.tau / n
            rr = r * 1.55 + 4 * math.sin(t * 7 + i)
            sx, sy = x + math.cos(ang) * rr, y + math.sin(ang) * rr * 0.75
            c.create_oval(sx - 2, sy - 2, sx + 2, sy + 2,
                          fill=mix(col, "#ffffff", 0.6), outline="")
        # progress ring
        rr = r + 9
        c.create_arc(x - rr, y - rr, x + rr, y + rr, start=90,
                     extent=-359.9 * frac, style="arc", outline="#ffffff",
                     width=3)

    def draw_beams(self, ox, oy):
        """The laser beams: layered columns from the muzzle to the top."""
        c = self.c
        t = time.time()
        for bm in self.beams:
            tier = bm["tier"]
            col = BEAM_COL[tier - 1]
            age, dur = bm["t"], bm["dur"]
            env = max(0.0, min(1.0, age / 0.06, (dur - age) / 0.18))
            if env <= 0:
                continue
            hw = BEAM_HW[tier - 1] * env * (0.93 + 0.07 * math.sin(t * 70))
            x = bm["x"] + ox
            yb = GROUND - 40 + oy
            yt = -10 + oy
            bgc = sky(300)
            glow(c, x, yb, hw * 2.6 + 12, col, layers=4, a=0.7)
            for f, fill in ((1.7, mix(bgc, col, 0.16)),
                            (1.3, mix(bgc, col, 0.32)),
                            (1.0, mix(bgc, col, 0.72)),
                            (0.65, mix(col, "#ffffff", 0.55)),
                            (0.32, "#ffffff")):
                c.create_rectangle(x - hw * f, yt, x + hw * f, yb,
                                   fill=fill, outline="")
            # energy streaks racing up the beam
            span = yb - yt
            for i in range(10):
                yy = yb - ((t * 700 + i * 97) % span)
                sx = x + math.sin(i * 1.7) * hw * 0.6
                c.create_line(sx, yy, sx, yy - 18,
                              fill=mix(col, "#ffffff", 0.7), width=2)
            glow(c, x, yb, hw * 2 + 6, "#ffffff", layers=3, a=0.5)

    def draw_fx(self, ox, oy):
        c = self.c
        for x, y, maxr, life, mlife, col in self.rings:
            p = 1 - life / mlife
            r = maxr * (1 - (1 - p) ** 2)
            x, y = x + ox, y + oy
            if p < 0.25:                       # bright flash at the centre
                fr = maxr * 0.4 * (1 - p * 2)
                c.create_oval(x - fr, y - fr, x + fr, y + fr,
                              fill=mix("#ffffff", col, p * 4), outline="")
            c.create_oval(x - r, y - r, x + r, y + r,
                          outline=fade(col, y, p * 0.9),
                          width=max(1, 5 * (1 - p)))
        for x, y, vx, vy, life, col, mlife, kind in self.particles:
            k = max(0.0, life / mlife)
            x, y = x + ox, y + oy
            if kind == 2:                      # hull chunk
                r = 2 + 3 * k
                c.create_rectangle(x - r, y - r, x + r, y + r,
                                   fill=fade(col, y, (1 - k) * 0.8),
                                   outline="")
                continue
            if kind == 1:                      # smoke puff
                r = 3 + (1 - k) * 7
                c.create_oval(x - r, y - r, x + r, y + r,
                              fill=fade(col, y, 0.45 + 0.55 * (1 - k)),
                              outline="")
            else:                              # spark streak
                hot = mix(col, "#ffffff", max(0.0, k - 0.5))
                c.create_line(x, y, x - vx * 0.035, y - vy * 0.035,
                              fill=fade(hot, y, 1 - k), width=2,
                              capstyle="round")

    def draw_flash(self):
        """Screen-edge vignette for damage / boss kills (no alpha in tk)."""
        if self.hit_flash <= 0:
            return
        c = self.c
        k = min(1.0, self.hit_flash / 0.35)
        for i in range(7):
            col = mix(self.flash_col, "#05060f", 1 - k * (1 - i / 7))
            c.create_rectangle(i * 5 + 2, i * 5 + 2, W - i * 5 - 2,
                               H - i * 5 - 2, outline=col, width=5)


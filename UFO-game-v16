                            _tone(750, 190, 0.09, 0.3, "saw", 1.5)), 0.30)
    # bullet hits a UFO that survives
    S["hit"] = _norm(_mix(_tone(900, 650, 0.05, 0.5, "square", 1.0),
                          _noise(0.05, 0.5, 1.5, 0.9, 0.6, 3)), 0.32)
    # UFO destroyed / boss destroyed

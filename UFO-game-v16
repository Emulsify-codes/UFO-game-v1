def mut_on_click(self, e):
    if self.state == "index" and self.index_tab == "mutations":
        key = self.hit(self.index_rects, self.mouse_x, self.mouse_y)
        if isinstance(key, tuple) and key[0] == "mut_equip":
            mid = key[1]
            d = mut_data(self)
            if mid in d["equipped"]:
                d["equipped"].remove(mid)

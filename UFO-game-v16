def _quality_launch_tutorial(self, mode="normal", difficulty="normal"):
    self.tutorial_pending = (mode, difficulty)
    self.tutorial_step = 0
    self.tutorial_rects = []
    self.state = "tutorial"
    self.mouse_down = False
    self.last = time.time()


def _quality_finish_tutorial(self, start_run=True):
    self.tutorial_done = True
    self.data["settings"]["tutorial_done"] = True
    self.save_ok = save_data(self.data)
    mode, difficulty = getattr(
        self, "tutorial_pending", ("normal", "normal"))
    self.state = "menu"
    if start_run:
        self.start_game(mode, difficulty)


def _quality_start_game(self, mode="normal", difficulty="normal"):
    if not getattr(self, "tutorial_done", True) \
            and not getattr(self, "_tutorial_starting", False):
        _quality_launch_tutorial(self, mode, difficulty)
        return
    self.run_seen_ufos = set()
    self.enemy_briefing = None
    self.enemy_briefing_queue = []
    _quality_base_start_game(self, mode, difficulty)


def _quality_spawn_ufo(self, kind, x=None, y=None):
    is_new = kind not in self.data["discovered_ufos"]
    _quality_base_spawn_ufo(self, kind, x, y)
    if is_new and kind not in getattr(self, "run_seen_ufos", set()):
        self.run_seen_ufos.add(kind)
        queue = getattr(self, "enemy_briefing_queue", [])
        queue.append((kind, _UFO_FIELD_NOTES.get(
            kind, "New contact. Watch its movement and attack cues.")))
        self.enemy_briefing_queue = queue
        if self.enemy_briefing is None:
            _quality_show_next_enemy_briefing(self)


def _quality_show_next_enemy_briefing(self):
    queue = getattr(self, "enemy_briefing_queue", [])
    if queue:
        kind, note = queue.pop(0)
        self.enemy_briefing = dict(
            name=UFO_SPECS[kind]["name"], note=note, timer=4.0)
    else:
        self.enemy_briefing = None


def _quality_update(self, dt, base_update=None):
    (base_update or _quality_base_update)(self, dt)
    briefing = getattr(self, "enemy_briefing", None)
    if briefing and self.state == "play":
        briefing["timer"] -= dt
        if briefing["timer"] <= 0:
            _quality_show_next_enemy_briefing(self)



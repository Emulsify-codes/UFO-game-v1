        rrect(c, x1, y, x2, y + rh, 10, fill=fill, outline=line, width=2)
        # icon badge
        maxed = mx is not None and lvl is not None and lvl >= mx
        icol = "#ffe066" if maxed else ("#8fa4ff" if afford else "#4a5190")
        c.create_oval(x1 + 10, y + 6, x1 + 42, y + 38, fill="#0b0f26",
                      outline=line)
        self.draw_icon(key, x1 + 26, y + 22, icol)
        c.create_text(x1 + 54, y + 13, anchor="w", text=title,
                      fill="#ffffff" if afford else "#8a93c9",
                      font=(FONT, 13, "bold"))
        c.create_text(x1 + 54, y + 31, anchor="w", text=desc,
                      fill="#8a93c9", font=(FONT, 10))
        if mx:
            for i in range(mx):
                px = x1 + 330 + i * 17
                c.create_rectangle(px, y + 16, px + 13, y + 28,
                                   fill="#7CFC00" if i < lvl else "#222a55",
                                   outline="")
        c.create_text(x2 - 14, y + 22, anchor="e", text=cost_txt,
                      fill="#ffe066" if afford else "#6a6f99",
                      font=(FONT, 14, "bold"))

    def draw_gameover(self):
        c = self.c
        t = time.time()
        rrect(c, 180, 170, W - 180, 470, 20, fill="#14080c",
              outline="#ff5555", width=3)
        pulse = 0.5 + 0.5 * math.sin(t * 3)
        shadow_text(c, W / 2, 218, "EARTH HAS FALLEN",
                    mix("#ff5555", "#ff9a9a", pulse), (FONT, 32, "bold"))
        c.create_text(W / 2, 266, fill="#ffffff", font=(FONT, 16),
                      text=f"Score {self.score}    Reached wave {self.wave}")
        new_best = self.latest is not None and self.latest["score"] >= self.best \
            and self.latest["score"] > 0
        if new_best:
            c.create_text(W / 2, 298, fill=mix("#ffe066", "#ffffff", pulse),
                          font=(FONT, 14, "bold"), text="NEW BEST SCORE!")
        else:
            c.create_text(W / 2, 298, fill="#ffe066", font=(FONT, 14),
                          text=f"Best score: {self.best}")
        if self.run_gems:
            txt = f"+{self.run_gems} gems   ({self.gems:,} total)"
            self.draw_gem(W / 2 - len(txt) * 3.6 - 10, 328, 8)
            c.create_text(W / 2 + 8, 328, fill="#9fe8ff",
                          font=(FONT, 13, "bold"), text=txt)
        else:
            c.create_text(W / 2, 328, fill="#6a6f99", font=(FONT, 11),
                          text="No gems earned (you need 50+ points)")
        if self.score <= 0:
            msg, mcol = "Score 0 - not added to the leaderboard", "#8a93c9"
        elif self.save_ok:
            msg, mcol = "Run saved to the leaderboard", "#8a93c9"
        else:
            msg, mcol = "Couldn't save to ufo_leaderboard.json", "#ff9a9a"
        c.create_text(W / 2, 354, font=(FONT, 10), fill=mcol, text=msg)
        if self.run_badges:
            n = self.run_badges
            c.create_text(W / 2, 372, fill="#ffe066", font=(FONT, 10, "bold"),
                          text=f"+{n} new badge{'s' if n != 1 else ''} "
                               f"unlocked!")

        self.over_rects = []
        by1, by2 = 394, 440
        self.button(self.over_rects, (195, by1, 325, by2), "PLAY AGAIN",
                    "play", "green", 11)
        self.button(self.over_rects, (335, by1, 465, by2), "LEADERBOARD",
                    "board", "gold", 11)
        self.button(self.over_rects, (475, by1, 605, by2), "MAIN MENU",
                    "menu", "blue", 11)

    # ------------------------------------------------------------------
    def loop(self):
        now = time.time()
        dt = min(0.05, now - self.last)
        self.last = now
        self.update(dt)
        self.draw()
        spent = int((time.time() - now) * 1000)
        self.root.after(max(1, 16 - spent), self.loop)



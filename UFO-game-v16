# ---- buying ------------------------------------------------------------------
SK_VISIBLE = 4               # skill rows shown at once


def sk_rows():
    return max(sum(1 for s in SKILLS if s[1] == b[0])
               for b in SKILL_BRANCHES)


def sk_clamp_scroll(self):
    self.sk_scroll = min(max(0, sk_rows() - SK_VISIBLE),
                         max(0, getattr(self, "sk_scroll", 0)))
    return self.sk_scroll


def sk_say(self, text, secs=2.0):
    self.sk_msg = text
    self.sk_msg_until = time.time() + secs


def sk_buy(self, sid):
    _, branch, name, mx, cost, _t = SKILL_BY_ID[sid]
    ranks = sk_ranks(self)
    pre = sk_prereq(sid)
    if ranks.get(sid, 0) >= mx:
        sk_say(self, f"{name} is already maxed.")
        self.sfx("deny")
    elif pre and ranks.get(pre, 0) < 1:
        sk_say(self, f"Needs a rank in {SKILL_BY_ID[pre][2]} first.")
        self.sfx("deny")
    elif sk_free(self) < cost:
        sk_say(self, f"Not enough skill points (need {cost}).")
        self.sfx("deny")
    else:
        ranks[sid] = ranks.get(sid, 0) + 1
        sk_save(self)
        sk_say(self, f"{name} rank {ranks[sid]}/{mx}", 1.5)
        self.sfx("repair")


def sk_reset_all(self):
    if sk_spent(self) == 0:
        sk_say(self, "Nothing to reset.")
        return
    if time.time() > getattr(self, "sk_confirm_until", 0):
        self.sk_confirm_until = time.time() + 3.0
        sk_say(self, "Click RESET again to refund every point.", 3.0)
        self.sfx("click")
        return
    self.data["skills"]["ranks"] = {}
    self.sk_confirm_until = 0
    sk_save(self)
    sk_say(self, "Skills reset. All points refunded.")
    self.sfx("click")



def mut_wave_of(mid):
    return MUT_WAVE.get(mid, MUT_START_WAVE)


def mut_is_boss(u):
    return u["kind"] in ("boss", "grand") or u["kind"] in BOSS_WAVES.values()


def mut_alive(o):
    return not o.get("dead") and o.get("mode") != "x"


def mut_timer(self, key, dt, period):
    """Shared timers; True once every `period` seconds."""
    t = getattr(self, "mut_tm", None)
    if t is None:
        t = self.mut_tm = {}
    t[key] = t.get(key, 0.0) + dt
    if t[key] >= period:
        t[key] = 0.0
        return True
    return False


def mut_ufo_timer(u, key, dt, period):
    u[key] = u.get(key, random.uniform(0, period)) + dt
    if u[key] >= period:
        u[key] = 0.0
        return True
    return False



def buy_pet_egg(self, rarity):
    _pets_ensure_data(self)
    cost = PET_COSTS[rarity]
    if self.gems < cost:
        self.pet_message = f"Need {cost - self.gems} more gems for a {rarity} egg."
        self.pet_message_t = 2.5
        self.sfx("deny")
        return
    self.data["gems"] -= cost
    self.data["pets"]["eggs"][rarity] += 1
    self.save_ok = save_data(self.data)
    self.pet_message = f"{rarity} egg added to your inventory."
    self.pet_message_t = 2.5
    self.sfx("buy")


def hatch_pet_egg(self, rarity):
    _pets_ensure_data(self)
    eggs = self.data["pets"]["eggs"]
    if eggs.get(rarity, 0) <= 0:
        self.pet_message = f"You don't have a {rarity} egg to hatch."
        self.pet_message_t = 2.5
        self.sfx("deny")
        return
    pet = random.choice(PET_CATALOG[rarity])
    eggs[rarity] -= 1
    owned = self.data["pets"]["owned"]
    already_owned = pet["id"] in owned
    owned[pet["id"]] = owned.get(pet["id"], 0) + 1
    self.pet_rarity = rarity
    self.pets_tab = "collection"
    self.pet_scroll = 0
    self.pet_message = (
        f"DUPLICATE: {pet['name']}  ·  x{owned[pet['id']]}"
        if already_owned else f"NEW PET: {pet['name']}  ({rarity})")
    self.pet_message_t = 4.0
    self.save_ok = save_data(self.data)
    self.sfx("badge")


def _combine_huge_pet(self, pet_id):
    _pets_ensure_data(self)
    pets = self.data["pets"]
    owned = pets["owned"]
    if owned.get(pet_id, 0) < 3:
        self.pet_message = "You need 3 identical pets to make a Huge pet."
        self.pet_message_t = 2.5
        self.sfx("deny")
        return
    pet = PET_BY_ID[pet_id]
    _, main_buff, _ = pet_buff_details(pet)
    bonus_buffs = [
        buff for buff in PET_BUFF_TYPES
        if buff != main_buff and _pet_buff_amount(pet, buff) > 0
    ]
    if not bonus_buffs:
        self.pet_message = "This pet has no available Huge bonus buff."
        self.pet_message_t = 2.5
        self.sfx("deny")
        return
    bonus_buff = random.choice(bonus_buffs)
    owned[pet_id] -= 3
    if owned[pet_id] <= 0:
        del owned[pet_id]
    pets["huge"].setdefault(pet_id, []).append(bonus_buff)
    self.save_ok = save_data(self.data)
    _, _, main_desc = pet_buff_details(pet, huge=True)
    bonus_name, bonus_desc = pet_buff_description(pet, bonus_buff)
    self.pet_message = (
        f"HUGE {pet['name']} created! {main_desc} + "
        f"{bonus_name} {bonus_desc}")
    self.pet_message_t = 4.0
    self.sfx("badge")



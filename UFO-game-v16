_mut2_prev_update = Game.update


def mut2_update(self, dt):
    _mut2_prev_update(self, dt)
    if self.state != "play":
        return
    self.mut_ward = getattr(self, "mut_ward", 15.0) + dt
    if mut_has(self, "ravager") and getattr(self, "mut_wave_seen", None) \
            != self.wave:
        self.mut_wave_seen = self.wave
        self.mut_ablative = True
    ufos = [u for u in self.ufos if mut_alive(u) and u["y"] > 20]
    for u in ufos:
        mid = u.get("mut")
        if not mid or mid not in MUT_WAVE:
            continue
        x, y = u["x"], u["y"]
        shoot_ok = y < GROUND - 120
        if mid == "blinker" and mut_ufo_timer(u, "m_a", dt, 5.0):
            nx = min(W - 40, max(40, random.uniform(50, W - 50)))
            self.explode(x, y, "#7df9ff", 8, 120)
            u["x"] = u["base_x"] = nx
            self.explode(nx, y, "#7df9ff", 8, 120)
        elif mid == "medic":
            for o in ufos:
                if o is not u and math.hypot(o["x"] - x, o["y"] - y) < 130:
                    o["hp"] = min(o["maxhp"], o["hp"] + o["maxhp"] * 0.04 * dt)
        elif mid == "gunner" and shoot_ok and mut_ufo_timer(u, "m_a", dt, 4.0):
            self.sfx("enemy")
            for vx in (-90, 0, 90):
                self.ebullets.append([x, y + 20, vx, 220])
        elif mid == "sniper" and shoot_ok and mut_ufo_timer(u, "m_a", dt, 5.0):
            self.enemy_shot(x, y + 20, self.px, GROUND, 420)
        elif mid == "minelayer" and shoot_ok \
                and mut_ufo_timer(u, "m_a", dt, 2.0):
            self.ebullets.append([x, y + 20, 0, 70])
        elif mid == "recharging" and mut_ufo_timer(u, "m_a", dt, 6.0):
            u["mshield"] = True
        elif mid == "warden" and mut_ufo_timer(u, "m_a", dt, 8.0):
            for o in ufos:
                if o is not u and math.hypot(o["x"] - x, o["y"] - y) < 150:
                    o["mshield"] = True
        elif mid == "hunter" and shoot_ok and mut_ufo_timer(u, "m_a", dt, 3.0):
            for off in (-50, 0, 50):
                self.enemy_shot(x, y + 20, self.px + off, GROUND, 260)
        elif mid == "doppel" and mut_ufo_timer(u, "m_a", dt, 6.0) \
                and u.get("copies", 0) < 2 and len(self.ufos) < 40:
            u["copies"] = u.get("copies", 0) + 1
            _mut_nospawn[0] = True
            try:
                self.spawn_ufo(u["kind"], min(W - 30, max(30, x + 30)), y)
                n = self.ufos[-1]
                hp = max(1, u["maxhp"] // 2)
                n.update(hp=hp, maxhp=hp, is_clone=True, custom_scale=0.7)
            finally:
                _mut_nospawn[0] = False
        elif mid == "ravager" and shoot_ok and mut_ufo_timer(u, "m_a", dt, 5.0):
            self.sfx("warn")
            for i in range(8):
                a = i * math.tau / 8
                self.ebullets.append([x, y, math.cos(a) * 150,
                                      math.sin(a) * 150])
        elif mid == "vortex":
            self.px += (1 if x > self.px else -1) * 70 * dt
            self.px = min(W - 20, max(20, self.px))
    # ---- equipped perks
    if mut_has(self, "gunner") and mut_timer(self, "shock", dt, 15.0):
        for o in ufos:
            self.hurt_ufo(o, 2, "shock")
        self.rings.append([self.px, GROUND, 240, 0.5, 0.5, "#ffcf56"])
    if mut_has(self, "recharging") and mut_timer(self, "chrono", dt, 25.0):
        for b in self.ebullets:
            b[2] *= 0.5
            b[3] *= 0.5
        self.rings.append([self.px, GROUND, 200, 0.5, 0.5, "#5cb8ff"])
        mut_float(self, self.px, GROUND - 70, "CHRONO BURST", 0.9)
    if mut_has(self, "overcharged") and ufos \
            and mut_timer(self, "storm", dt, 10.0):
        o = random.choice(ufos)
        self.hurt_ufo(o, 3, "shock")
        self.rings.append([o["x"], o["y"], 60, 0.35, 0.35, "#00f5d4"])
    if mut_has(self, "doppel"):
        for u in ufos:
            if isinstance(u.get("shoot"), (int, float)):
                u["shoot"] += dt * 0.15



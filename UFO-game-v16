def _quality_draw_shop(self):
    _quality_base_draw_shop(self)
    hovered = None
    for x1, y1, x2, y2, key in self.shop_rects:
        if x1 <= self.mouse_x <= x2 and y1 <= self.mouse_y <= y2:
            hovered = key
            break
    if hovered in self.level:
        level = self.level[hovered]
        if hovered == "damage":
            detail = f"Bullet damage: {self.damage} -> {self.damage + 1}"
        elif hovered == "rate":
            next_delay = self.delay * 0.84
            detail = (f"Fire interval: {self.delay:.2f}s -> {next_delay:.2f}s "
                      f"({1 / next_delay:.1f} shots/s)")
        elif hovered == "speed":
            detail = f"Bullet velocity: {self.bullet_speed} -> {self.bullet_speed + 70}"
        elif hovered == "multi":
            detail = f"Barrels per shot: {self.shots} -> {self.shots + 1}"
        elif hovered == "pierce":
            detail = f"Additional UFOs pierced: {self.pierce} -> {self.pierce + 1}"
        elif hovered == "hull":
            detail = f"Maximum hull: {self.max_hp} -> {self.max_hp + 2}; also heals 2"
        elif hovered == "knock":
            detail = f"Knockback level: {self.knock} -> {self.knock + 1}"
        else:
            detail = "Improves this upgrade by one level."
        if level >= next((u[3] for u in UPGRADES if u[0] == hovered), level):
            detail = "MAX LEVEL - no further upgrade available."
        detail = f"NEXT LEVEL: {detail}"
    elif hovered == "repair":
        detail = f"Restore hull to full: {self.hp}/{self.max_hp} -> {self.max_hp}/{self.max_hp}"
    else:
        detail = "Hover over an upgrade to preview its next-level effect."

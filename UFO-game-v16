def cp_draw_crate_shop(self, t):
    c = self.c
    free_ancient = self.data["ench"]["free_ancient"]
    page_crates = CRATES[
        self.crate_page * CRATES_PER_PAGE:
        (self.crate_page + 1) * CRATES_PER_PAGE]
    for slot, cr in enumerate(page_crates):
        i = self.crate_page * CRATES_PER_PAGE + slot
        x1 = 80 + slot * 220
        x2, y1, y2 = x1 + 200, 168, 478
        cx = (x1 + x2) / 2
        self.crate_rects.append((x1, y1, x2, y2, ("crate", cr["id"])))
        hov = x1 <= self.mouse_x <= x2 and y1 <= self.mouse_y <= y2
        use_free_crate = cr["id"] == "ancient" and free_ancient > 0
        afford = use_free_crate or self.gems >= cr["cost"]
        lit = hov and afford
        lift = -4 if lit else 0
        y1 += lift
        y2 += lift

        # ---- card body: shadow, base, tinted top band, trim line
        rrect(c, x1, y1 + 5, x2, y2 + 5, 14, fill="#070918", outline="")
        if afford:
            fill = "#20296a" if hov else "#161e52"
            line = mix(cr["trim"], "#ffffff", 0.3) if hov else cr["trim"]
        else:
            fill = "#141a3a" if hov else "#10142c"
            line = "#2a3162"
        rrect(c, x1, y1, x2, y2, 14, fill=fill, outline=line,
              width=3 if lit else 2)
        band = mix(fill, cr["glow"], 0.28 if afford else 0.08)
        rrect(c, x1 + 5, y1 + 5, x2 - 5, y1 + 144, 10, fill=band, outline="")

        # ---- spotlight (kept inside the band), pedestal and crate
        glow(c, cx, y1 + 76, 60, cr["glow"], layers=6,
             a=(0.7 if lit else 0.45) if afford else 0.14, bg=band)
        py = y1 + 122
        c.create_oval(cx - 56, py - 7, cx + 56, py + 9, fill="#070918",
                      outline=mix(cr["trim"], "#070918", 0.4 if afford
                                  else 0.8), width=2)
        c.create_oval(cx - 42, py - 4, cx + 42, py + 5,
                      fill=mix("#070918", cr["glow"], 0.25 if afford else 0.05),

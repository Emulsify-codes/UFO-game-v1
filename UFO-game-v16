CP_PANEL = "#0b0f26"
CP_TAGS = {"wood": "STARTER", "iron": "BALANCED", "ancient": "PREMIUM",
           "abyssal": "ABYSSAL", "trident": "TRIDENT",
           "astral_poseidon": "MYTHIC"}


def cp_sparkle(c, x, y, r, col):
    """A four-point twinkle."""
    c.create_line(x - r, y, x + r, y, fill=col, width=1)
    c.create_line(x, y - r, x, y + r, fill=col, width=1)
    c.create_line(x - r * .5, y - r * .5, x + r * .5, y + r * .5, fill=col,
                  width=1)
    c.create_line(x - r * .5, y + r * .5, x + r * .5, y - r * .5, fill=col,
                  width=1)


def cp_halo(c, cx, cy, rx, ry, col, layers=6, a=0.3, bg=CP_PANEL):
    """A wide, flat glow (stacked ovals) that stays inside a known height."""
    base = mix(bg, col, a)
    for i in range(layers, 0, -1):
        f = i / layers
        c.create_oval(cx - rx * f, cy - ry * f, cx + rx * f, cy + ry * f,
                      fill=mix(base, bg, i / (layers + 1)), outline="")


def cp_motes(self, t):
    """Tiny lights drifting upwards inside the panel."""
    c = self.c
    cols = ("#b36bff", "#4dd8ff", "#ffd24d", "#ff6bd6")
    for i in range(30):
        x = 82 + (i * 131.7) % 636 + math.sin(t * 0.8 + i) * 6
        y = 506 - ((t * (9 + (i % 4) * 5) + i * 53) % 450)
        k = 0.2 + 0.45 * abs(math.sin(t * 1.7 + i * 1.3))
        col = mix(CP_PANEL, cols[i % 4], k)
        r = 1 + (i % 3 == 0)
        c.create_rectangle(x - r, y - r, x + r, y + r, fill=col, outline="")



def mut2_kill_ufo(self, u, src=None):
    s0 = self.score
    _mut2_prev_kill(self, u, src)
    mid = u.get("mut")
    x, y = u["x"], u["y"]
    if mid == "brood" and not u.get("is_clone"):
        _mut_nospawn[0] = True
        try:
            hp = max(1, u["maxhp"] // 4)
            for off in (-36, 0, 36):
                self.spawn_ufo(u["kind"], min(W - 30, max(30, x + off)), y)
                n = self.ufos[-1]
                n.update(hp=hp, maxhp=hp, is_clone=True, custom_scale=0.5)
        finally:
            _mut_nospawn[0] = False
    elif mid == "nova":
        self.explode(x, y, MUTATIONS["nova"]["color"], 30, 300)
        for i in range(16):
            a = i * math.tau / 16
            self.ebullets.append([x, y, math.cos(a) * 150, math.sin(a) * 150])
    elif mid == "cursed":
        self.cooldown = max(self.cooldown, 1.5)
        mut_float(self, self.px, GROUND - 70, "GUN JAMMED", 1.0)
    elif mid == "phoenix" and u.get("mrevive") and not u.get("revived"):
        _mut_nospawn[0] = True
        try:
            self.spawn_ufo(u["kind"], x, max(30, y))
            n = self.ufos[-1]
            hp = max(1, round(u["maxhp"] * 0.6))
            n.update(hp=hp, maxhp=hp, mut="phoenix", revived=True,
                     nocount=True, is_clone=True, mrevive=False)
            mut_float(self, x, y - 20, "RISES AGAIN", 1.0)
        finally:
            _mut_nospawn[0] = False
    # ---- equipped perks
    if mut_has(self, "overlord") and mid and not u.get("nocount"):
        self.credits += 50
        mut_float(self, x, y - 20, "BOUNTY +50", 0.9)
    if mut_has(self, "cursed"):
        self.score += round(max(0, self.score - s0) * 0.10)
    if mut_has(self, "vortex"):
        self.mut_streak2 = getattr(self, "mut_streak2", 0) + 1
    if mut_has(self, "titan") and random.random() < 0.10:
        self.inv = max(self.inv, 3.0)
        mut_float(self, self.px, GROUND - 70, "OVERDRIVE", 0.9)
    if mut_has(self, "brood") and random.random() < 0.15:
        for o in list(self.ufos):
            if o is not u and mut_alive(o) and o["y"] > 0:
                self.hurt_ufo(o, 1, "shock")
    if mut_has(self, "nova") and random.random() < 0.10:
        self.ebullets = []
        for o in list(self.ufos):
            if o is not u and mut_alive(o) and o["y"] > 0:
                self.hurt_ufo(o, 3, "shock")
        self.rings.append([self.px, GROUND, 260, 0.5, 0.5, "#fff176"])
        mut_float(self, self.px, GROUND - 70, "SUPERNOVA", 1.0)



    # static background (built once, never deleted)
    # ------------------------------------------------------------------
    def make_sky(self, k):
        """Sky gradient + nebulae + moon halo, rendered at 1/zoom of the final
        resolution and then zoomed (cached per scale)."""
        key = round(k, 3)
        if key in self.sky_cache:
            return self.sky_cache[key]
        zoom = max(2, math.ceil(k * 1.3))
        hw = math.ceil(W * k / zoom)
        hh = math.ceil(HORIZON * k / zoom)
        blobs = [                       # x, y, radius (game px), colour, strength
            (190, 180, 200, (130, 60, 210), 0.42),    # purple nebula
            (610, 340, 170, (40, 120, 210), 0.34),    # blue nebula
            (430, 90, 130, (210, 60, 150), 0.30),     # pink wisp
            (MOON[0], MOON[1], 110, (255, 240, 205), 0.30),   # moon halo
        ]
        img = tk.PhotoImage(width=hw, height=hh)
        for y in range(hh):
            gy = (y + 0.5) * zoom / k
            base = hex2rgb(_sky(gy))
            row = []
            for x in range(hw):
                gx = (x + 0.5) * zoom / k
                r, g, b = base
                for bx, by, br, col, st in blobs:
                    dx, dy = gx - bx, gy - by
                    d2 = (dx * dx + dy * dy) / (br * br)
                    if d2 < 6:
                        hx, hy = gx / 2, gy / 2
                        wisp = 0.8 + 0.2 * math.sin(hx * 0.09 + hy * 0.05) * \
                            math.sin(hy * 0.11 - hx * 0.03)
                        f = math.exp(-d2) * st * wisp
                        r += (col[0] - r) * f
                        g += (col[1] - g) * f
                        b += (col[2] - b) * f
                row.append("#%02x%02x%02x" % (int(r), int(g), int(b)))
            img.put("{" + " ".join(row) + "}", to=(0, y))
        img = img.zoom(zoom, zoom)
        if len(self.sky_cache) >= 3:
            self.sky_cache.pop(next(iter(self.sky_cache)))
        self.sky_cache[key] = img
        return img

    def build_background(self):
        c = self.c
        c.delete("all")
        rng = random.Random(self.bg_seed)   # same city every time we rebuild
        self.bg_img = self.make_sky(c.k)    # keep a reference!
        c.create_image(0, 0, image=self.bg_img, anchor="nw", tags="bg")

        # --- moon
        mx, my, mr = MOON
        c.create_oval(mx - mr, my - mr, mx + mr, my + mr, fill="#a9a6c8",
                      outline="", tags="bg")
        c.create_oval(mx - mr + 2, my - mr + 2, mx + mr - 6, my + mr - 6,
                      fill="#ebe9fa", outline="", tags="bg")
        for cx, cy, cr in ((-10, -8, 7), (8, 6, 5), (-4, 14, 4), (12, -14, 4)):
            c.create_oval(mx + cx - cr, my + cy - cr, mx + cx + cr,
                          my + cy + cr, fill="#cfcce6", outline="", tags="bg")

        # --- distant mountains (first "front" item: stars sit just under it)
        pts = [0, HORIZON]
        x = 0
        while x < W + 60:
            pts += [x, HORIZON - rng.uniform(10, 34)]
            x += rng.uniform(40, 90)
        pts += [W, HORIZON]
        self.front_first = c.create_polygon(pts, fill="#1a1340", outline="",
                                            tags="bg")
        # --- city skyline with lit windows
        wall = "#0c0e26"
        x = 0
        while x < W:
            bw = rng.randint(24, 52)
            bh = rng.randint(10, 34)
            c.create_rectangle(x, HORIZON - bh, x + bw, HORIZON, fill=wall,
                               outline="", tags="bg")
            if bh > 26:
                c.create_line(x + bw / 2, HORIZON - bh, x + bw / 2,
                              HORIZON - bh - 8, fill=wall, width=2, tags="bg")
                c.create_oval(x + bw / 2 - 2, HORIZON - bh - 11,
                              x + bw / 2 + 2, HORIZON - bh - 7,
                              fill="#ff4d4d", outline="", tags="bg")
            for wy in range(HORIZON - bh + 5, HORIZON - 4, 8):
                for wx in range(x + 4, x + bw - 6, 8):
                    if rng.random() < 0.32:
                        col = rng.choice(("#ffd98a", "#ffb86b", "#9fe8ff"))
                        c.create_rectangle(wx, wy, wx + 3, wy + 4,
                                           fill=mix(col, wall, rng.uniform(0, .4)),
                                           outline="", tags="bg")
            x += bw + rng.randint(0, 5)
        # --- ground
        c.create_rectangle(0, HORIZON, W, H, fill="#10142a", outline="",
                           tags="bg")
        c.create_line(0, HORIZON, W, HORIZON, fill="#2f3b7a", width=2,
                      tags="bg")
        c.create_line(0, HORIZON + 2, W, HORIZON + 2, fill="#1a2150", width=1,
                      tags="bg")

        self.bg_ids = set(c.find_all())


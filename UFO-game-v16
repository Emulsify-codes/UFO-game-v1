def _sk_delay_bonus(s, v):
    f = 1.0
    r = sk(s, "momentum")
    if r:
        f *= 1 - 0.01 * r * min(5, getattr(s, "combo", 0) // 3)
    r = sk(s, "quickdraw")
    if r and getattr(s, "sk_wave_t", 99.0) < 3.0:
        f *= 1 - 0.05 * r
    if sk(s, "perfect") and s.hp >= s.max_hp:
        f *= 0.9
    r = sk(s, "adrenal")
    if r and s.hp <= s.max_hp * 0.4:
        f *= 1 - 0.06 * r
    return v * f



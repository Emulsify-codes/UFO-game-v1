# SHIELDED UFOS
# 2% of UFOs spawn behind an energy shield: extra health that has to be shot
# away before the UFO itself can take damage. Divers and bosses never get one.
# ==========================================================================
SHIELD_CHANCE = 0.02
SHIELD_EXTRA = 0.6            # shield strength as a fraction of the UFO's hull
SHIELD_COLOR = "#4dd8ff"
SHIELD_EXCLUDED = ("diver", "boss", "grand")


def shield_active(u):
    return bool(u.get("sh_on"))


_shield_prev_spawn = Game.spawn_ufo


def shield_spawn_ufo(self, kind, x=None, y=None):
    _shield_prev_spawn(self, kind, x, y)
    if not self.ufos or kind in SHIELD_EXCLUDED \
            or kind in BOSS_WAVES.values():
        return
    u = self.ufos[-1]
    if u.get("kind") != kind or u.get("sh_on") or u.get("is_clone") \
            or u.get("revived") or random.random() >= SHIELD_CHANCE:
        return
    core = u["hp"]
    extra = max(2, math.ceil(core * SHIELD_EXTRA))
    u["core_hp"] = core
    u["sh_max"] = extra
    u["sh_on"] = True
    u["hp"] = u["maxhp"] = core + extra


Game.spawn_ufo = shield_spawn_ufo

# hits can't bleed through the shield into the hull ---------------------------
_shield_prev_damage = nb_damage_taken


def nb_damage_taken(self, u, dmg):
    dmg = _shield_prev_damage(self, u, dmg)
    if shield_active(u) and dmg > 0:
        dmg = min(dmg, max(0.0, u["hp"] - u["core_hp"]))
    return dmg


def shield_break(self, u):
    u["sh_on"] = False
    u["hp"] = u["core_hp"] if u["hp"] <= 0 else min(u["hp"], u["core_hp"])
    u["maxhp"] = max(1, u["core_hp"])
    u["flash"] = 0.2
    self.explode(u["x"], u["y"], SHIELD_COLOR, 22, 260)
    self.rings.append([u["x"], u["y"], 70, 0.4, 0.4, SHIELD_COLOR])
    self.floaters.append([u["x"], u["y"] - 26, "SHIELD BROKEN", 1.0])
    self.sfx("boom")
    st = self.data["stats"]
    st["shields_broken"] = st.get("shields_broken", 0) + 1


# any damage path that would kill a shielded UFO breaks the shield instead
_shield_prev_kill = Game.kill_ufo


def shield_kill_ufo(self, u, src=None):
    if shield_active(u):
        shield_break(self, u)
        return
    _shield_prev_kill(self, u, src)



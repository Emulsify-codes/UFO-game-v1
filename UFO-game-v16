def nb_damage_taken(self, u, dmg):
    dmg = _sk_prev_damage(self, u, dmg)
    if dmg <= 0:
        return dmg
    r = sk(self, "crit")
    if r and random.random() < 0.03 * r:
        dmg *= 2
    r = sk(self, "slayer")
    if r and mut_is_boss(u):
        dmg *= 1 + 0.08 * r
    r = sk(self, "finisher")
    if r and u["hp"] < u["maxhp"] * 0.3:
        dmg *= 1 + 0.10 * r
    if sk(self, "salvo") and u["hp"] >= u["maxhp"]:
        dmg *= 1.5
    return dmg



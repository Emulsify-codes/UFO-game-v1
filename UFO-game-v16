    def draw_ufo(self, u, ox, oy, scale=1.0):
        # Apply clone scale and transparency stipple
        scale *= u.get("custom_scale", 1.0)
        stipple_val = "gray50" if u.get("is_clone", False) else ""
        
        c = self.c
        kind = u["kind"]
        spec = UFO_SPECS[kind]
        s = spec["size"] * scale
        # ... (rest of your draw_ufo method)
        c = self.c
        kind = u["kind"]
        spec = UFO_SPECS[kind]
        s = spec["size"] * scale
        live = u["mode"] != "x"
        bob = math.sin(u["t"] * 3 + len(kind)) * 2 * scale
        x, y = u["x"] + ox, u["y"] + oy + bob
        color = spec["color"]
        flashing = u["flash"] > 0
        if u["mode"] == "dying":            # shake and strobe white
            x += random.uniform(-1, 1) * u["shk"]
            y += random.uniform(-1, 1) * u["shk"] * 0.5
            if int(u["dtm"] * (8 + 18 * u["prog"])) % 2 == 0:
                flashing = True
        body = "#ffffff" if flashing else color
        if kind == "diver" and u["mode"] == "aim" and not flashing \
                and int(u["t"] * 30) % 2 == 0:
            body = "#ffffff"
        dark = mix(color, "#000000", 0.5)
        light = mix(color, "#ffffff", 0.5)
        big = kind in ("boss", "grand")

        # ground shadow: grows and darkens as the UFO gets closer
        if live and u["y"] > -20:
            k = max(0.0, min(1.0, u["y"] / GROUND))
            sw = s * (0.45 + 0.7 * k)
            c.create_oval(x - sw, HORIZON + 6, x + sw, HORIZON + 12,
                          fill=mix("#10142a", "#03040a", 0.3 + 0.7 * k),
                          outline="")

        # diver targeting line
        if live and kind == "diver" and u["mode"] == "aim":
            k = 1 - u["timer"] / 0.9
            c.create_line(x, y, self.px + ox, GROUND + oy,
                          fill=fade("#ff4d6d", y, 0.7 - 0.7 * k),
                          dash=(3, 7), width=2)

        # glow
        glow(c, x, y + s * 0.2, s * (1.5 if big else 1.3), color,
             layers=4 if big else 3, a=0.45 if big else 0.32)

        if big:
            pr = s * (1.25 + 0.06 * math.sin(u["t"] * 4))
            c.create_oval(x - pr, y - s * 0.35, x + pr, y + s * 0.7,
                          outline=color, width=2)
        if kind == "grand":
            c.create_oval(x - s * 1.45, y - s * 0.5, x + s * 1.45, y + s * 0.9,
                          outline="#bfeaff", width=2, dash=(6, 4))

        # dome (with a little highlight)
        c.create_oval(x - s * 0.45, y - s * 0.75, x + s * 0.45, y + s * 0.1,
                      fill=spec["dome"], outline=mix(spec["dome"], color, 0.5))
        c.create_oval(x - s * 0.3, y - s * 0.62, x - s * 0.06, y - s * 0.38,
                      fill="#ffffff", outline="")
        # underside (darker) then main hull then top sheen = rounded look
        c.create_oval(x - s * 0.8, y + s * 0.02, x + s * 0.8, y + s * 0.52,
                      fill=dark, outline="")
        c.create_oval(x - s, y - s * 0.35, x + s, y + s * 0.4,
                      fill=body, outline=light, width=1)
        if not flashing:
            c.create_oval(x - s * 0.78, y - s * 0.3, x + s * 0.3, y - s * 0.06,
                          fill=mix(body, "#ffffff", 0.3), outline="")
            c.create_arc(x - s * 0.95, y - s * 0.3, x + s * 0.95, y + s * 0.36,
                         start=200, extent=140, style="arc",
                         outline=dark, width=1)

        # rim lights that chase around the hull
        n = {"boss": 9, "grand": 13}.get(kind, 5)
        pos = int(u["t"] * 8) % n
        lr = max(1.5, 2 * scale)
        for i in range(n):
            lx = x + (i - (n - 1) / 2) * (s * 1.5 / max(1, n - 1))
            d = (i - pos) % n
            lc = ("#ffffb0", "#ffd24d", "#a08a30")[d] if d < 3 else "#44402a"
            c.create_oval(lx - lr, y + s * 0.04 - lr, lx + lr,
                          y + s * 0.04 + lr + 1, fill=lc, outline="")

        warning = u.get("shot_warning", 0.0)
        if live and warning > 0.05 and u["mode"] != "dying" \
                and not (kind == "diver" and u["mode"] == "aim"):
            pulse = 0.5 + 0.5 * math.sin(time.time() * 18)
            ring = min(s * 1.25, 70)
            warn_col = "#fff200" if getattr(
                self, "high_contrast", False) else mix("#ff4d6d", "#ffe066", pulse)
            c.create_oval(x - ring, y - ring * 0.62,
                          x + ring, y + ring * 0.62,
                          outline=warn_col, width=2, dash=(5, 3))
            c.create_text(x, y - s * 0.9 - 8, text="!",
                          fill=warn_col, font=(FONT, 12, "bold"))

        if kind == "diver" and u["mode"] == "aim":
            warn_col = "#fff200" if getattr(
                self, "high_contrast", False) else "#ff4d6d"
            c.create_text(x, y - s - 12, text="!", fill=warn_col,
                          font=(FONT, 14, "bold"))
        if u["mode"] == "dying":            # glowing cracks spread over the hull
            rng = random.Random(u["seed"])
            for _ in range(1 + int(u["prog"] * 9)):
                a = rng.uniform(0, math.tau)
                px = x + rng.uniform(-0.3, 0.3) * s
                py = y + rng.uniform(-0.1, 0.1) * s
                pts = [px, py]
                for _j in range(4):
                    a += rng.uniform(-0.7, 0.7)
                    px += math.cos(a) * s * 0.28
                    py += math.sin(a) * s * 0.12
                    pts += [px, py]
                c.create_line(pts, fill="#ffe9a0", width=2)
        # small health bar (bosses get a big one at the top of the screen)
        if live and not big and u["hp"] < u["maxhp"]:
            bw = s * 1.6
            frac = max(0, u["hp"] / u["maxhp"])
            c.create_rectangle(x - bw / 2 - 1, y - s - 8, x + bw / 2 + 1,
                               y - s - 1, fill="#1a0a0a", outline="#552222")
            c.create_rectangle(x - bw / 2, y - s - 7, x - bw / 2 + bw * frac,
                               y - s - 2, fill=mix("#ff3b3b", "#ffd24d", frac),
                               outline="")

    def draw_player(self, ox, oy):
        if self.inv > 0 and int(self.inv * 14) % 2 == 0:
            return
        self.draw_gun(self.px + ox, GROUND + oy, self.gun_skin, 1.0,
                      self.shots, self.recoil, self.level["damage"],
                      self.muzzle, self.bullet_skin)

    def draw_gun(self, x, y, skin, sc=1.0, shots=1, rec=0.0, dmg=0,
                 muzzle=0.0, bskin=None, bg=None, t=None):
        """The player's gun: armoured turret, finned base, a pattern panel and
        proper barrels with breech, rings and a muzzle brake. `sc` scales it
        (the skin shop draws small previews)."""
        c = self.c
        t = time.time() if t is None else t
        bgc = bg or sky(y)
        pat = skin["pattern"]
        base, plate, dark = skin["base"], skin["plate"], skin["dark"]
        accent, trim = skin["accent"], skin["trim"]
        barrel, core = skin["barrel"], skin["core"]
        if pat == "prism":
            accent = hsv(t * 0.4, 0.65, 1.0)
            trim = mix(accent, "#ffffff", 0.5)
            core = accent
        dl = min(1.0, dmg / 10)
        barrel = mix(barrel, "#ffd24d", dl * 0.45)

        def pl(pts, **kw):
            flat = []
            for px, py in pts:
                flat += [x + px * sc, y + py * sc]
            return c.create_polygon(flat, **kw)

        def ln(p1, p2, col, w=1.0):
            c.create_line(x + p1[0] * sc, y + p1[1] * sc,
                          x + p2[0] * sc, y + p2[1] * sc,
                          fill=col, width=max(1.0, w * sc))

        glow(c, x, y + 20 * sc, 48 * sc, accent, layers=3, a=0.3, bg=bgc)

        # ---- barrels
        n = max(1, shots)
        hw = 3.6 + 2.4 * dl
        if n > 1:
            hw *= max(0.55, 1 - 0.11 * (n - 1))
        L = 38 - rec
        dark_m = mix(barrel, "#000000", 0.45)
        for i in range(n):
            a = (i - (n - 1) / 2) * 0.14
            sa, ca = math.sin(a), math.cos(a)

            def B(d, w, sa=sa, ca=ca):
                return (sa * d + ca * w, -2 - ca * d + sa * w)

            # tube (slides back with the recoil), shaded in two tones + glint
            pl([B(2, -hw * .85), B(2, hw * .85), B(L - 8, hw * .72),
                B(L - 8, -hw * .72)], fill=dark_m, outline="")
            pl([B(2, -hw * .85), B(2, -hw * .05), B(L - 8, -hw * .05),
                B(L - 8, -hw * .72)], fill=barrel, outline="")
            pl([B(3, -hw * .6), B(3, -hw * .38), B(L - 9, -hw * .32),
                B(L - 9, -hw * .52)], fill=mix(barrel, "#ffffff", .65),
               outline="")
            for j, d0 in enumerate((L - 25, L - 17)):      # accent rings
                rc = hsv(t * 0.5 + j * 0.2, 0.7, 1.0) if pat == "prism" \
                    else accent
                pl([B(d0, -hw * .92), B(d0, hw * .92), B(d0 + 3, hw * .92),
                    B(d0 + 3, -hw * .92)], fill=rc, outline="")
            # breech block (stays put)
            pl([B(0, -hw * 1.3), B(0, hw * 1.3), B(11, hw * 1.12),
                B(11, -hw * 1.12)], fill=dark, outline=trim, width=1)
            pl([B(5, -hw * 1.2), B(5, hw * 1.2), B(7, hw * 1.17),
                B(7, -hw * 1.17)], fill=accent, outline="")
            # muzzle brake with slots and a dark bore
            m0 = L - 8
            pl([B(m0, -hw * 1.1), B(m0, hw * 1.1), B(L, hw * 1.32),
                B(L, -hw * 1.32)], fill=dark_m, outline=trim, width=1)
            for d in (m0 + 2.7, m0 + 5.3):
                ln(B(d, -hw * 1.2), B(d, hw * 1.2), dark, 1.2)
            tip = B(L, 0)
            r = hw * 0.5 * sc
            c.create_oval(x + tip[0] * sc - r, y + tip[1] * sc - r * .6,
                          x + tip[0] * sc + r, y + tip[1] * sc + r * .6,
                          fill="#05060f", outline="")

        # ---- muzzle flash (coloured like the bullet skin)
        if muzzle > 0:
            k = muzzle / 0.07
            fcol = bskin["glow"] if bskin else "#ffe9a0"
            if bskin and bskin.get("mode") == "rainbow":
                fcol = hsv(t * 0.9, 0.7, 1.0)
            for i in range(n):
                a = (i - (n - 1) / 2) * 0.14
                tx = x + math.sin(a) * (L + 3) * sc
                ty = y + (-2 - math.cos(a) * (L + 3)) * sc
                glow(c, tx, ty, (10 + 12 * k) * sc, fcol, layers=3, a=0.9,
                     bg=bgc)
                r = (3 + 5 * k) * sc
                c.create_oval(tx - r, ty - r, tx + r, ty + r,
                              fill=mix(fcol, "#ffffff", 0.75), outline="")

        # ---- side fins with blinking lights
        for sg in (-1, 1):
            pl([(sg * 38, 30), (sg * 28, 10), (sg * 20, 30)], fill=dark,
               outline=accent, width=1)
            pl([(sg * 33, 29), (sg * 28, 16), (sg * 25, 29)], fill=plate,
               outline="")
            blink = 0.5 + 0.5 * math.sin(t * 5 + sg)
            lx, ly = x + sg * 28 * sc, y + 11 * sc
            glow(c, lx, ly, 6 * sc, accent, layers=2, a=0.2 + 0.5 * blink,
                 bg=bgc)
            c.create_oval(lx - 1.5 * sc, ly - 1.5 * sc, lx + 1.5 * sc,
                          ly + 1.5 * sc, fill=mix(accent, "#ffffff", .5),
                          outline="")

        # ---- base, patterned plate, foot
        pl([(-30, 30), (-19, 0), (19, 0), (30, 30)], fill=base,
           outline=trim, width=2)
        for sg in (-1, 1):
            ln((sg * 26, 28), (sg * 18, 3), mix(trim, base, 0.35), 1)
        pl(GUN_PLATE, fill=plate, outline="")
        self.gun_pattern(x, y, sc, pat, accent, trim, dark, plate, t, pl, ln)
        pl(GUN_PLATE, fill="", outline=mix(trim, base, 0.4), width=1)
        c.create_rectangle(x - 33 * sc, y + 26 * sc, x + 33 * sc, y + 30 * sc,
                           fill=dark, outline=accent)

        # ---- turret ring and glowing core
        glow(c, x, y + 1 * sc, 19 * sc, core, layers=3, a=0.75, bg=bgc)
        c.create_oval(x - 15 * sc, y - 9 * sc, x + 15 * sc, y + 9 * sc,
                      fill=dark, outline=trim, width=2)
        c.create_oval(x - 10 * sc, y - 6 * sc, x + 10 * sc, y + 6 * sc,
                      fill=core,
                      outline=mix(core, "#ffffff", 0.35 + 0.25 * math.sin(t * 4)))
        c.create_oval(x - 6 * sc, y - 4 * sc, x - 1 * sc, y - 1 * sc,
                      fill=mix(core, "#ffffff", 0.8), outline="")

    def gun_pattern(self, x, y, sc, pat, accent, trim, dark, plate, t, pl, ln):
        """Pattern drawn on the gun's front plate, clipped to the plate."""
        c = self.c

        def clipped(pts, **kw):
            q = clip_convex(pts, GUN_PLATE)
            if len(q) >= 3:
                pl(q, **kw)

        if pat == "hazard":
            pl(GUN_PLATE, fill="#161616", outline="")
            for i in range(-1, 6):
                x0 = i * 9
                clipped([(x0, 5), (x0 + 4.5, 5), (x0 + 4.5 - 22, 27),
                         (x0 - 22, 27)], fill=accent, outline="")
        elif pat == "camo":
            pl(GUN_PLATE, fill="#35552f", outline="")
            for poly, col in CAMO:
                clipped(poly, fill=col, outline="")
        elif pat == "flame":
            pl(GUN_PLATE, fill="#2a0c08", outline="")
            for j, cx in enumerate(range(-18, 19, 6)):
                h = 12 + 5 * math.sin(t * 6 + j * 1.7) + (j % 2) * 4
                clipped([(cx - 4, 27), (cx - 3, 27 - h * .45),
                         (cx - .5, 27 - h * .6), (cx, 27 - h),
                         (cx + 1.5, 27 - h * .55), (cx + 4, 27 - h * .4),
                         (cx + 4, 27)], fill="#ff5a1f", outline="")
                h2 = h * 0.6
                clipped([(cx - 2, 27), (cx - 1, 27 - h2 * .5), (cx, 27 - h2),
                         (cx + 1, 27 - h2 * .5), (cx + 2, 27)],
                        fill="#ffd24d", outline="")
        elif pat == "circuit":
            pl(GUN_PLATE, fill="#07121c", outline="")
            for path in CIRCUIT:
                for a, b in zip(path, path[1:]):
                    ln(a, b, mix(accent, "#07121c", 0.35), 1.0)
                for px, py in (path[0], path[-1]):
                    r = 1.6 * sc
                    c.create_oval(x + px * sc - r, y + py * sc - r,
                                  x + px * sc + r, y + py * sc + r,
                                  fill=accent, outline="")
            path = CIRCUIT[int(t * 1.2) % len(CIRCUIT)]
            px, py = polyline_point(path, (t * 1.2) % 1.0)
            glow(c, x + px * sc, y + py * sc, 7 * sc, trim, layers=2, a=0.6,
                 bg="#07121c")
            r = 1.8 * sc
            c.create_oval(x + px * sc - r, y + py * sc - r, x + px * sc + r,
                          y + py * sc + r, fill="#ffffff", outline="")
        elif pat == "galaxy":
            pl(GUN_PLATE, fill="#0c0620", outline="")
            clipped(ellipse_poly(-8 + 3 * math.sin(t * 0.5), 14, 14, 8),
                    fill="#3b1f8f", outline="")
            clipped(ellipse_poly(9, 19 + 2 * math.cos(t * 0.4), 11, 7),
                    fill="#7a2fb0", outline="")
            clipped(ellipse_poly(-2, 13, 7, 4), fill="#b86be0", outline="")
            for sx, sy, ph in GALAXY_STARS:
                tw = 0.5 + 0.5 * math.sin(t * ph + sx)
                r = (0.7 + 0.7 * tw) * sc
                c.create_rectangle(x + sx * sc - r, y + sy * sc - r,
                                   x + sx * sc + r, y + sy * sc + r,
                                   fill=mix("#3b1f8f", "#ffffff",
                                            0.35 + 0.65 * tw), outline="")
        elif pat == "carbon":
            pl(GUN_PLATE, fill="#101014", outline="")
            for row in range(8):                        # woven checker
                for col in range(-5, 6):
                    if (row + col) % 2 == 0:
                        x0, y0 = col * 5.5, 5 + row * 3
                        clipped([(x0, y0), (x0 + 5.5, y0), (x0 + 5.5, y0 + 3),
                                 (x0, y0 + 3)], fill="#22222a", outline="")
            clipped([(-22, 19), (22, 19), (22, 21.5), (-22, 21.5)],
                    fill=accent, outline="")             # racing stripe
        elif pat == "ice":
            pl(GUN_PLATE, fill="#16384f", outline="")
            for pts, col in (([(-17, 27), (-12, 9), (-7, 27)], "#3a9bd0"),
                             ([(-7, 27), (-1, 6), (5, 27)], "#4fb4e6"),
                             ([(5, 27), (11, 11), (17, 27)], "#3a9bd0")):
                clipped(pts, fill=col, outline="")
                clipped([pts[0], pts[1], (pts[1][0], pts[0][1])],
                        fill=mix(col, "#ffffff", 0.45), outline="")
            x0 = -30 + (t * 28) % 80                    # passing glint
            clipped([(x0, 5), (x0 + 5, 5), (x0 - 8, 27), (x0 - 13, 27)],
                    fill="#bfeeff", outline="")
        elif pat == "bio":
            pl(GUN_PLATE, fill="#0f2412", outline="")
            clipped([(-22, 20), (22, 20), (22, 27), (-22, 27)],
                    fill="#1c4a22", outline="")           # sludge pool
            for i in range(7):                           # rising bubbles
                ph = (t * 0.5 + i * 0.37) % 1.0
                bx = -16 + i * 5.3 + math.sin(t * 2 + i) * 2
                by = 27 - ph * 22
                br = 1.2 + (i % 3) * 0.8
                clipped(ellipse_poly(bx, by, br, br, 8),
                        fill=mix(accent, "#0f2412", 0.3 + 0.6 * ph),
                        outline="")
        elif pat == "grid":
            pl(GUN_PLATE, fill="#12082a", outline="")
            clipped([(math.cos(math.pi + i * math.pi / 8) * 9,
                      14 + math.sin(math.pi + i * math.pi / 8) * 9)
                     for i in range(9)], fill="#ff9a3b", outline="")   # sun
            clipped([(-22, 14), (22, 14), (22, 27), (-22, 27)],
                    fill="#1a0b30", outline="")           # ground
            hw = lambda yy: 14 + (yy - 5) * 8 / 22
            for i in range(5):                           # scrolling lines
                yy = 14 + ((i + (t * 0.8) % 1.0) / 5) ** 1.6 * 13
                ln((-hw(yy), yy), (hw(yy), yy), accent, 1.0)
            for xx in (-18, -9, 0, 9, 18):
                ln((xx * 0.3, 14), (xx * 1.3, 27), trim, 1.0)
        elif pat == "gold":
            pl(GUN_PLATE, fill="#a37c1c", outline="")
            for row in range(5):                         # diamond lattice
                for col in range(-3, 4):
                    cx, cy = col * 8 + (row % 2) * 4, 8 + row * 5
                    clipped([(cx, cy - 3), (cx + 3.5, cy), (cx, cy + 3),
                             (cx - 3.5, cy)], fill="#c9a02c", outline="")
            x0 = -30 + (t * 30) % 80                    # gleaming shine
            clipped([(x0, 5), (x0 + 4, 5), (x0 - 9, 27), (x0 - 13, 27)],
                    fill="#fff6c0", outline="")
        elif pat == "checker":
            pl(GUN_PLATE, fill="#f2f2f2", outline="")
            off = (t * 8) % 11                          # scrolling squares
            for row in range(5):
                for col in range(-6, 6):
                    if (row + col) % 2 == 0:
                        x0, y0 = col * 5.5 + off, 5 + row * 4.4
                        clipped([(x0, y0), (x0 + 5.5, y0), (x0 + 5.5, y0 + 4.4),
                                 (x0, y0 + 4.4)], fill="#141414", outline="")
        elif pat == "tiger":
            pl(GUN_PLATE, fill="#d9781c", outline="")
            for i in range(-5, 5):
                x0 = i * 5 + (i % 2) * 1.5
                clipped([(x0, 5), (x0 + 2.4, 5), (x0 + 3.4, 16), (x0 + 1.4, 27),
                         (x0 - 1.2, 27), (x0 + 0.8, 16)],
                        fill="#1a0e06", outline="")
            clipped([(-22, 25), (22, 25), (22, 27), (-22, 27)],
                    fill="#f6e0b8", outline="")         # pale belly
        elif pat == "ocean":
            pl(GUN_PLATE, fill="#0a3a6a", outline="")
            for j, col in enumerate(("#1b78c0", "#12589a", "#0b3d72")):
                yb = 19.5 + j * 2.8         # (only the lower strip is visible)
                top = [(xx, yb + math.sin(xx * 0.32 + t * 3 + j * 1.7) * 2)
                       for xx in range(-24, 25, 4)]
                clipped(top + [(24, 27), (-24, 27)], fill=col, outline="")
                if j == 0:                              # foamy crest
                    for a, b in zip(top, top[1:]):
                        ln(a, b, "#e6fbff", 1.0)
        elif pat == "digital":
            pl(GUN_PLATE, fill="#030a05", outline="")
            fsz = max(4, int(5 * sc))
            for i in range(8):
                cx = -18 + i * 5.2
                for k in range(4):
                    ty = 17 + (t * (7 + i * 1.5) + k * 2.6 + i * 3) % 10
                    if abs(cx) > 14 + (ty - 5) * 8 / 22 - 2:
                        continue                        # outside the plate
                    c.create_text(x + cx * sc, y + ty * sc,
                                  text="01"[(i + k + int(t * 6)) % 2],
                                  fill=mix(accent, "#030a05", 0.2 + k * 0.22)
                                  if k else "#ffffff",
                                  font=(FONT, fsz, "bold"))
        elif pat == "lava":
            pl(GUN_PLATE, fill="#1a0a06", outline="")
            wob = math.sin(t * 2.5)
            clipped([(-22, 22 + wob), (-10, 20 - wob), (0, 22 + wob),
                     (10, 20 - wob), (22, 22 + wob), (22, 27), (-22, 27)],
                    fill="#c2400f", outline="")         # bubbling pool
            for idx, path in enumerate(LAVA_CRACKS):
                glowc = mix(accent, trim, 0.5 + 0.5 * math.sin(t * 3 + idx))
                for a, b in zip(path, path[1:]):
                    ln(a, b, mix(glowc, "#1a0a06", 0.55), 3)
                    ln(a, b, glowc, 1.3)
        elif pat == "storm":
            phase = (t * 0.9) % 3.0
            flash = phase < 0.2 or 0.3 < phase < 0.4
            pl(GUN_PLATE, fill="#3a3a5a" if flash else "#141830", outline="")
            for cx, cy, rx, ry in ((-11, 21.5, 9, 2.8), (6, 21, 9, 2.8),
                                   (-2, 24, 12, 2.6), (14, 24.5, 8, 2.2),
                                   (-16, 25, 7, 2.2)):
                clipped(ellipse_poly(cx + math.sin(t * 0.6 + cx) * 1.5, cy,
                                     rx, ry),
                        fill="#6a72a0" if flash else "#2e3560", outline="")
            if flash:                                   # the lightning bolt
                bolt = [(1, 19.5), (-2.5, 22.5), (2, 23.5), (-1.5, 27)]
                for a, b in zip(bolt, bolt[1:]):
                    ln(a, b, "#fff6a8", 3)
                    ln(a, b, "#ffffff", 1.2)
        elif pat == "skull":
            # (only the lower strip of the plate shows, so this is a small
            # skull with crossbones)
            pl(GUN_PLATE, fill="#161616", outline="")
            for sg in (-1, 1):                          # crossbones
                for (x1, y1, x2, y2) in ((9, 20.5, 17, 26.5),
                                         (9, 26.5, 17, 20.5)):
                    ln((sg * x1, y1), (sg * x2, y2), "#d8d8d8", 2.2)
                for ex in (9, 17):
                    for ey in (20.5, 26.5):
                        r = 1.3 * sc
                        c.create_oval(x + sg * ex * sc - r, y + ey * sc - r,
                                      x + sg * ex * sc + r, y + ey * sc + r,
                                      fill="#d8d8d8", outline="")
            pl(ellipse_poly(0, 22.6, 5.2, 3.8, 16), fill="#ececec", outline="")
            pl([(-2.8, 24.5), (2.8, 24.5), (2.4, 27), (-2.4, 27)],
               fill="#e0e0e0", outline="")
            for xx in (-1, 0, 1):                       # teeth
                ln((xx, 25.6), (xx, 27), "#3a3a3a", 0.8)
            pulse = 0.5 + 0.5 * math.sin(t * 4)
            eye = mix("#ff3b3b", "#ffb0b0", pulse)
            for sg in (-1, 1):
                ex, ey = sg * 2.1, 22.4
                pl(ellipse_poly(ex, ey, 1.5, 1.7, 8), fill="#2a0a0a",
                   outline="")
                pl(ellipse_poly(ex, ey, 0.9, 1.1, 8), fill=eye, outline="")
            pl([(0, 23.8), (-0.8, 25), (0.8, 25)], fill="#2a2a2a", outline="")
        elif pat == "prism":
            w = 44 / 7
            for i in range(7):
                col = mix(hsv(t * 0.35 + i / 7, 0.75, 1.0), "#000000", 0.25)
                clipped([(-22 + i * w, 5), (-22 + (i + 1) * w, 5),
                         (-22 + (i + 1) * w, 27), (-22 + i * w, 27)],
                        fill=col, outline="")
        else:                                  # plain: vents and a status bar
            for yy in (11, 16, 21):
                ln((-12, yy), (12, yy), dark, 2)
            pl([(-6, 23), (6, 23), (6, 25), (-6, 25)], fill=accent,
               outline="")

    def draw_hud(self):
        c = self.c
        panel = dict(fill="#0b0f26", outline="#3a4690", width=2)

        # score
        rrect(c, 8, 8, 176, 42, 9, **panel)
        c.create_text(20, 25, anchor="w", fill="#8a93c9",
                      font=(FONT, 9, "bold"), text="SCORE")
        pop = self.score_pop
        c.create_text(166, 25, anchor="e",
                      fill=mix("#ffffff", "#7CFC00", min(1.0, pop * 4)),
                      font=(FONT, 13 + int(pop * 28), "bold"),
                      text=str(int(self.disp_score)))
        c.create_text(14, 54, anchor="w", fill="#4dd8ff",
                      font=(FONT, 9, "bold"),
                      text=f"GEMS +{int(self.score / 100 + 0.5)}")
        self.draw_weapons_hud()
        # wave + progress
        boss = _boss_for_wave(self.wave) is not None
        rrect(c, W / 2 - 92, 8, W / 2 + 92, 52, 9, **panel)
        c.create_text(W / 2, 21, fill="#ff8a8a" if boss else "#9fb0ff",
                      font=(FONT, 12, "bold"), text=f"WAVE {self.wave}")
        remaining = len(self.queue) + sum(1 for u in self.ufos if not u["dead"])
        total = max(self.wave_total, remaining, 1)
        frac = 1 - remaining / total
        bx1, bx2 = W / 2 - 74, W / 2 + 74
        c.create_rectangle(bx1, 36, bx2, 44, fill="#171c3e", outline="")
        if frac > 0:
            c.create_rectangle(bx1, 36, bx1 + (bx2 - bx1) * frac, 44,
                               fill="#ff6b6b" if boss else "#7CFC00",
                               outline="")
        # credits
        rrect(c, W - 176, 8, W - 8, 42, 9, **panel)
        c.create_text(W - 164, 25, anchor="w", fill="#8a93c9",
                      font=(FONT, 9, "bold"), text="CREDITS")
        c.create_text(W - 18, 25, anchor="e", fill="#ffe066",
                      font=(FONT, 13, "bold"), text=str(self.credits))

        if self.run_objectives:
            x1, x2 = W - 158, W - 8
            rrect(c, x1, 58, x2, 151, 8, fill="#090e20",
                  outline="#354264", width=1)
            c.create_text(x1 + 8, 68, anchor="w", text="FLIGHT OBJECTIVES",
                          fill="#93a5ca", font=(FONT, 7, "bold"))
            for i, objective in enumerate(self.run_objectives):
                yy = 83 + i * 21
                done = objective["completed"]
                color = "#7CFC00" if done else "#d6def1"
                c.create_text(x1 + 8, yy, anchor="w",
                              text=objective["title"], fill=color,
                              font=(FONT, 7, "bold"))
                progress = (objective["target"] if done
                            else objective["progress"])
                c.create_text(x2 - 8, yy, anchor="e",
                              text="DONE" if done
                              else f"{progress}/{objective['target']}",
                              fill="#7CFC00" if done else "#8a93c9",
                              font=(FONT, 7, "bold"))
                bx1, bx2, by = x1 + 8, x2 - 8, yy + 7
                c.create_rectangle(bx1, by, bx2, by + 3,
                                   fill="#202944", outline="")
                frac = progress / objective["target"]
                if frac > 0:
                    c.create_rectangle(bx1, by, bx1 + (bx2 - bx1) * frac,
                                       by + 3, fill=color, outline="")

        # boss health bar
        bosses = [u for u in self.ufos
                  if u["kind"] in ("boss", "grand") and not u["dead"]
                  and u["mode"] != "dying"]
        if bosses:
            u = bosses[0]
            spec = UFO_SPECS[u["kind"]]
            x1, x2 = 170, W - 170
            rrect(c, x1 - 5, 60, x2 + 5, 84, 8, fill="#14080c",
                  outline=spec["color"], width=2)
            frac = max(0.0, u["hp"] / u["maxhp"])
            if frac > 0:
                c.create_rectangle(x1, 66, x1 + (x2 - x1) * frac, 78,
                                   fill=spec["color"], outline="")
                c.create_rectangle(x1, 66, x1 + (x2 - x1) * frac, 70,
                                   fill=mix(spec["color"], "#ffffff", 0.4),
                                   outline="")
            c.create_text(W / 2, 72, text=spec["name"].upper(),
                          fill="#ffffff", font=(FONT, 8, "bold"))

        # hull (segmented)
        rrect(c, 8, H - 40, 340, H - 8, 9, **panel)
        c.create_text(20, H - 24, anchor="w", fill="#ff9a9a",
                      font=(FONT, 10, "bold"), text="HULL")
        n = self.max_hp
        x0, total_w, gap = 62, 210, 3
        sw = (total_w - (n - 1) * gap) / n
        hurt = self.inv > 0
        for i in range(n):
            sx = x0 + i * (sw + gap)
            if i < self.hp:
                col = "#ffffff" if hurt else mix("#ff3b3b", "#ff9a7a",
                                                 i / max(1, n - 1))
            else:
                col = "#3a1818"
            c.create_rectangle(sx, H - 31, sx + sw, H - 17, fill=col,
                               outline="")

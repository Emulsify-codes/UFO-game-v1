    dmg = _mut_prev_damage(self, u, dmg)
    mid = u.get("mut")
    if mid == "armored":
        dmg *= 0.6
    elif mid == "shielded" and u.get("mshield"):
        u["mshield"] = False
        self.explode(u["x"], u["y"], MUTATIONS["shielded"]["color"], 10, 140)
        mut_float(self, u["x"], u["y"] - 24, "BLOCKED", 0.8)
        return 0
    elif mid == "phasing" and u.get("t", 0.0) % 4.0 > 2.8:
        return 0
    elif mid == "slippery" and random.random() < 0.25:
        mut_float(self, u["x"], u["y"] - 24, "DODGED", 0.7)
        return 0
    elif mid == "thorned" and random.random() < 0.25 and u["y"] > 0:
        self.enemy_shot(u["x"], u["y"], self.px, GROUND, 260)
    return dmg


# ---- kills: unlocks, death effects, perks -----------------------------------
_mut_prev_kill = Game.kill_ufo
_mut_busy = [False]


def mut_kill_ufo(self, u, src=None):
    c0 = self.credits
    _mut_prev_kill(self, u, src)
    mid = u.get("mut")
    if mid and not u.get("mut_counted") and not u.get("nocount"):
        u["mut_counted"] = True
        info = MUTATIONS[mid]
        d = mut_data(self)
        was = d["kills"].get(mid, 0) >= MUT_UNLOCK_KILLS
        d["kills"][mid] = d["kills"].get(mid, 0) + 1
        if not was and d["kills"][mid] >= MUT_UNLOCK_KILLS:
            mut_float(self, self.px, GROUND - 90,
                      f"MUTATION UNLOCKED: {info['name']}", 2.2)
            self.sfx("repair")
            mut_save(self)
            self.check_badges()
        mut_save(self)
        x, y = u["x"], u["y"]
        if mid == "splitting" and not u.get("is_clone"):
            _mut_nospawn[0] = True
            try:
                hp = max(1, u["maxhp"] // 3)
                for off in (-26, 26):
                    self.spawn_ufo(u["kind"], min(W - 30, max(30, x + off)),
                                   y)
                    n = self.ufos[-1]
                    n.update(hp=hp, maxhp=hp, is_clone=True,
                             custom_scale=0.6)
            finally:
                _mut_nospawn[0] = False
        elif mid == "lucky" and random.random() < 0.25 \
                and 0 < self.hp < self.max_hp:
            self.hp += 1
            mut_float(self, x, y - 20, "+1 HULL", 1.0)
        elif mid == "golden":
            gain = max(0, self.credits - c0)
            self.credits += gain * 2
            self.score += UFO_SPECS[u["kind"]]["score"] * 2
            mut_float(self, x, y - 20, "GOLDEN", 1.0)
        elif mid == "explosive":
            self.explode(x, y, info["color"], 26, 260)
            for i in range(8):
                a = i * math.tau / 8
                self.ebullets.append([x, y, math.cos(a) * 170,
                                      math.sin(a) * 170])
    if mid == "haunted" and u.get("mrevive") and not u.get("revived"):
        _mut_nospawn[0] = True
        try:
            self.spawn_ufo(u["kind"], u["x"], max(30, u["y"]))
            n = self.ufos[-1]
            hp = max(1, round(u["maxhp"] * 0.4))
            n.update(hp=hp, maxhp=hp, mut="haunted", revived=True,
                     nocount=True, is_clone=True, mrevive=False)
            mut_float(self, u["x"], u["y"] - 20, "IT RETURNS", 1.0)
        finally:
            _mut_nospawn[0] = False
    for o in self.ufos:
        if o.get("mut") == "parasitic" and o is not u \
                and not o.get("dead") and o.get("mode") != "x":
            o["hp"] = min(o["maxhp"], o["hp"] + o["maxhp"] * 0.08)
    # ---- equipped perks
    if mut_has(self, "magnetic"):
        self.score += 25
    if mut_has(self, "golden"):
        self.credits += round(max(0, self.credits - c0) * 0.10)
    if mut_has(self, "parasitic"):
        self.mut_siphon = getattr(self, "mut_siphon", 0) + 1
        if self.mut_siphon >= 15:
            self.mut_siphon = 0
            if 0 < self.hp < self.max_hp:
                self.hp += 1
                mut_float(self, u["x"], u["y"] - 20, "+1 HULL", 0.9)
    if mut_has(self, "lucky"):
        now = getattr(self, "mut_clock", 0.0)
        if now - getattr(self, "mut_last_kill", -9.0) <= 3.0:
            self.mut_streak = getattr(self, "mut_streak", 0) + 1
            bonus = min(10, self.mut_streak) * 5
            self.score += bonus
            mut_float(self, u["x"], u["y"] - 34, f"COMBO +{bonus}", 0.8)
        else:
            self.mut_streak = 0
        self.mut_last_kill = now
    if mut_has(self, "swift"):
        self.cooldown = 0.0
    if mut_has(self, "splitting") and random.random() < 0.10:
        self.credits += max(0, self.credits - c0)
        mut_float(self, u["x"], u["y"] - 20, "DOUBLE PAY", 0.9)
    if mut_has(self, "vampiric") and 0 < self.hp < self.max_hp \
            and random.random() < 0.05:
        self.hp += 1
        mut_float(self, u["x"], u["y"] - 20, "+1 HULL", 0.9)
    if mut_has(self, "explosive") and not _mut_busy[0]:
        _mut_busy[0] = True
        try:
            for o in list(self.ufos):
                if o is u or o.get("dead") or o.get("mode") == "x":
                    continue
                if math.hypot(o["x"] - u["x"], o["y"] - u["y"]) < 95:
                    self.hurt_ufo(o, 2, "shock")
            self.rings.append([u["x"], u["y"], 95, 0.35, 0.35, "#ff7a3d"])
        finally:
            _mut_busy[0] = False


Game.kill_ufo = mut_kill_ufo



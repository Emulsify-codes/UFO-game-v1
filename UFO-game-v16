def mut2_hurt_player(self, dmg):
    if self.inv > 0 or self.state != "play":
        _mut2_prev_hurt(self, dmg)
        return
    if mut_has(self, "ravager") and getattr(self, "mut_ablative", False):
        self.mut_ablative = False

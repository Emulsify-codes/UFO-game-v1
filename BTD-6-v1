TRACK = (196, 170, 120)
TRACK_EDGE = (150, 125, 85)
PANEL = (40, 44, 56)
WHITE = (240, 240, 240)

WAYPOINTS = [(-30, 120), (200, 120), (200, 300), (80, 300), (80, 520), (360, 520),
             (360, 200), (560, 200), (560, 440), (760, 440), (760, 100), (880, 100)]
PATH_WIDTH = 44

# ---- path helpers ---------------------------------------------------------
SEG = []
TOTAL = 0.0
for a, b in zip(WAYPOINTS, WAYPOINTS[1:]):
    length = math.dist(a, b)
    SEG.append((TOTAL, length, a, b))
    TOTAL += length


def pos_at(d):
    for start, length, a, b in SEG:
        if d <= start + length:
            t = (d - start) / length
            return a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t
    return WAYPOINTS[-1]


def dist_to_path(p):
    best = 1e9
    for _, _, a, b in SEG:
        ax, ay = a
        bx, by = b
        dx, dy = bx - ax, by - ay
        t = max(0, min(1, ((p[0] - ax) * dx + (p[1] - ay) * dy) / (dx * dx + dy * dy)))
        best = min(best, math.dist(p, (ax + dx * t, ay + dy * t)))
    return best


# ---- drawing helpers ------------------------------------------------------
TICK = [0]  # animation clock (frames)
PATH_COLORS = [(250, 205, 70), (90, 210, 250), (245, 110, 205)]


def shade(c, f):
    return tuple(max(0, min(255, int(v * f))) for v in c)


def blend(c1, c2, t):
    return tuple(int(a + (b - a) * t) for a, b in zip(c1, c2))


def rot_rect(cx, cy, ang, start, length, width):
    """Rectangle pointing along `ang`, starting `start` px from (cx, cy)."""
    ca, sa = math.cos(ang), math.sin(ang)
    hw = width / 2
    pts = []
    for u, v in ((start, -hw), (start + length, -hw), (start + length, hw), (start, hw)):
        pts.append((cx + u * ca - v * sa, cy + u * sa + v * ca))
    return pts


def regular_poly(cx, cy, r, n, rot):
    return [(cx + math.cos(rot + math.tau * i / n) * r, cy + math.sin(rot + math.tau * i / n) * r)
            for i in range(n)]


def build_bg():
    rng = random.Random(7)
    bg = pygame.Surface((MAP_W, H))
    bg.fill(GRASS)
    for _ in range(90):
        pygame.draw.circle(bg, shade(GRASS, rng.uniform(0.92, 1.08)),
                           (rng.randint(0, MAP_W), rng.randint(0, H)), rng.randint(25, 70))
    for _ in range(900):
        x, y = rng.randint(0, MAP_W), rng.randint(0, H)
        pygame.draw.line(bg, shade(GRASS, rng.choice((0.8, 1.2))), (x, y),
                         (x + rng.randint(-2, 2), y - rng.randint(3, 6)), 1)
    for _ in range(45):
        pygame.draw.circle(bg, rng.choice(((250, 240, 120), (255, 255, 255), (250, 170, 210))),
                           (rng.randint(0, MAP_W), rng.randint(0, H)), 2)
    for _, _, a, b in SEG:
        pygame.draw.line(bg, TRACK_EDGE, a, b, PATH_WIDTH + 8)
    for p in WAYPOINTS[1:-1]:
        pygame.draw.circle(bg, TRACK_EDGE, p, PATH_WIDTH // 2 + 4)
    for _, _, a, b in SEG:
        pygame.draw.line(bg, TRACK, a, b, PATH_WIDTH)
    for p in WAYPOINTS[1:-1]:
        pygame.draw.circle(bg, TRACK, p, PATH_WIDTH // 2)
    for _ in range(350):
        px, py = pos_at(rng.uniform(0, TOTAL))
        pygame.draw.circle(bg, shade(TRACK, rng.choice((0.85, 1.1))),
                           (int(px + rng.uniform(-17, 17)), int(py + rng.uniform(-17, 17))), rng.randint(1, 2))
    placed = tries = 0
    while placed < 16 and tries < 600:
        tries += 1
        p = (rng.randint(25, MAP_W - 25), rng.randint(25, H - 25))
        if dist_to_path(p) < 75:
            continue
        x, y = p
        pygame.draw.ellipse(bg, shade(GRASS, 0.7), (x - 18, y + 8, 36, 14))
        pygame.draw.rect(bg, (105, 72, 40), (x - 3, y - 2, 6, 14))
        pygame.draw.circle(bg, (40, 105, 48), (x, y - 8), 16)
        pygame.draw.circle(bg, (55, 130, 60), (x - 3, y - 12), 12)
        pygame.draw.circle(bg, (80, 160, 80), (x - 6, y - 15), 6)
        placed += 1
    return bg


# ---- balloons -------------------------------------------------------------
TIER_COLORS = {1: (220, 50, 50), 2: (60, 110, 230), 3: (60, 190, 70),
               4: (240, 210, 50), 5: (240, 120, 190), 6: (50, 50, 55)}
TIER_SPEED = {1: 1.4, 2: 1.8, 3: 2.2, 4: 2.8, 5: 3.4, 6: 2.6}


class Balloon:
    def __init__(self, tier, dist=0.0, boss=False, hp=120):
        self.tier = tier
        self.dist = dist
        self.boss = boss
        self.hp = hp if boss else 0
        self.max_hp = self.hp
        self.slow_timer = 0
        self.alive = True
        self.x, self.y = pos_at(dist)

    @property
    def speed(self):
        s = 0.7 if self.boss else TIER_SPEED[self.tier]
        return s * (0.45 if self.slow_timer > 0 else 1)

    @property
    def radius(self):
        return 26 if self.boss else 13 + (self.tier > 3)

    def update(self):
        self.dist += self.speed
        if self.slow_timer > 0:
            self.slow_timer -= 1
        self.x, self.y = pos_at(self.dist)

    def draw_blimp(self, surf, x, y):
        t = TICK[0]
        r = self.radius
        f = 1 if pos_at(self.dist + 6)[0] >= self.x else -1  # facing direction
        L, hh = r * 1.9, r * 0.95
        pygame.draw.ellipse(surf, (60, 110, 60), (x - L * 0.8, y + r + 16, L * 1.6, 12))  # ground shadow
        for s in (-1, 1):  # tail fins
            pts = [(x - f * L * 0.75, y + s * hh * 0.55), (x - f * (L + 14), y + s * (hh + 12)),
                   (x - f * (L + 14), y + s * 2)]
            pygame.draw.polygon(surf, (70, 45, 120), pts)
        body = pygame.Rect(int(x - L), int(y - hh), int(L * 2), int(hh * 2))
        pygame.draw.ellipse(surf, (50, 30, 90), body)
        pygame.draw.ellipse(surf, (112, 82, 175), body.inflate(-4, -4))
        for k in (-0.45, 0, 0.45):  # stripes
            px = x + k * L
            half = hh * math.sqrt(1 - k * k) - 3
            pygame.draw.line(surf, (82, 56, 140), (px, y - half), (px, y + half), 3)
        pygame.draw.ellipse(surf, (165, 135, 220), pygame.Rect(int(x - L * 0.55), int(y - hh * 0.8),
                                                                  int(L * 0.8), int(hh * 0.5)))
        pygame.draw.rect(surf, (70, 70, 80), (x - 12, y + hh - 3, 24, 9), border_radius=3)  # gondola
        pygame.draw.circle(surf, (190, 220, 250), (int(x + f * L * 0.6), int(y - 2)), 4)  # porthole
        px, py = x - f * (L + 16), y
        a = t * 0.5
        pygame.draw.line(surf, (30, 30, 35), (px - math.cos(a) * 8, py - math.sin(a) * 8),
                         (px + math.cos(a) * 8, py + math.sin(a) * 8), 3)  # propeller
        w = 70
        pygame.draw.rect(surf, (70, 0, 0), (x - w // 2, y - r - 18, w, 8), border_radius=4)
        pygame.draw.rect(surf, (60, 210, 70),
                         (x - w // 2, y - r - 18, w * max(0, self.hp) / self.max_hp, 8), border_radius=4)
        pygame.draw.rect(surf, (20, 20, 20), (x - w // 2, y - r - 18, w, 8), 1, border_radius=4)

    def draw(self, surf):
        x, y = int(self.x), int(self.y)
        if self.boss:
            self.draw_blimp(surf, x, y)
            return
        t = TICK[0]
        base = TIER_COLORS[self.tier]
        slowed = self.slow_timer > 0
        if slowed:
            base = blend(base, (190, 235, 255), 0.55)
        r = self.radius
        sway = math.sin(t * 0.12 + self.dist * 0.04) * 2.0
        cx = x + sway
        bw, bh = r * 1.75, r * 2.2
        top = y - r * 1.15
        bottom = top + bh
        # wavy string
        pts = [(cx, bottom + 3)]
        for i in range(1, 4):
            pts.append((cx + math.sin(t * 0.15 + i + self.dist * 0.05) * 3, bottom + 3 + i * 6))
        pygame.draw.lines(surf, (215, 215, 215), False, pts, 1)
        # body: outline, shade, base colour, glossy highlight
        body = pygame.Rect(int(cx - bw / 2), int(top), int(bw), int(bh))
        pygame.draw.ellipse(surf, shade(base, 0.5), body)
        pygame.draw.ellipse(surf, shade(base, 0.82), body.inflate(-3, -3))
        pygame.draw.ellipse(surf, base, body.inflate(-7, -7).move(-1, -1))
        pygame.draw.ellipse(surf, shade(base, 1.3), pygame.Rect(int(cx - bw * 0.3), int(top + bh * 0.13),
                                                                int(bw * 0.34), int(bh * 0.34)))
        pygame.draw.ellipse(surf, (255, 255, 255), pygame.Rect(int(cx - bw * 0.3), int(top + bh * 0.16),
                                                               max(2, int(bw * 0.15)), max(3, int(bh * 0.2))))
        # knot
        pygame.draw.polygon(surf, shade(base, 0.55), [(cx, bottom - 1), (cx - 3, bottom + 4), (cx + 3, bottom + 4)])
        if slowed:
            pygame.draw.circle(surf, (235, 250, 255), (int(cx + r * 0.5), int(y - r * 0.3)), 2)


# ---- projectiles ----------------------------------------------------------
class Dart:
    def __init__(self, x, y, angle, speed, dmg, pierce, life, bm=1, color=(250, 250, 250)):
        self.x, self.y = x, y
        self.vx, self.vy = math.cos(angle) * speed, math.sin(angle) * speed
        self.dmg, self.pierce, self.life, self.bm = dmg, pierce, life, bm
        self.hit = set()
        self.color = color
        self.alive = True

    def update(self, game):
        self.x += self.vx
        self.y += self.vy
        self.life -= 1
        if self.life <= 0:
            self.alive = False
            return
        for b in game.balloons:
            if b.alive and id(b) not in self.hit and math.dist((self.x, self.y), (b.x, b.y)) < b.radius + 4:
                self.hit.add(id(b))
                game.damage(b, self.dmg, self.bm)
                self.pierce -= 1
                if self.pierce <= 0:
                    self.alive = False
                    return

    def draw(self, surf):
        end = (self.x - self.vx * 1.6, self.y - self.vy * 1.6)
        pygame.draw.line(surf, self.color, (self.x, self.y), end, 2)
        pygame.draw.circle(surf, (60, 60, 70), (int(self.x), int(self.y)), 3)
        pygame.draw.circle(surf, (230, 230, 240), (int(self.x), int(self.y)), 1)


class Bomb:
    def __init__(self, x, y, tx, ty, dmg, radius, bm=1):
        self.x, self.y = x, y
        d = max(1, math.dist((x, y), (tx, ty)))
        self.vx, self.vy = (tx - x) / d * 7, (ty - y) / d * 7
        self.tx, self.ty = tx, ty
        self.dmg, self.radius, self.bm = dmg, radius, bm
        self.alive = True

    def update(self, game):
        self.x += self.vx
        self.y += self.vy
        if math.dist((self.x, self.y), (self.tx, self.ty)) < 8:
            self.alive = False
            game.effects.append(["boom", self.tx, self.ty, self.radius, 14])
            for b in list(game.balloons):
                if b.alive and math.dist((b.x, b.y), (self.tx, self.ty)) < self.radius + b.radius:
                    game.damage(b, self.dmg, self.bm)

    def draw(self, surf):
        x, y = int(self.x), int(self.y)
        pygame.draw.circle(surf, (20, 20, 24), (x, y), 7)
        pygame.draw.circle(surf, (70, 70, 80), (x - 2, y - 2), 2)
        pygame.draw.circle(surf, (255, 170, 40), (x + 4, y - 6), 2)


class Chakram:
    """Spinning disc that flies out to a point, then returns, hitting balloons both ways."""

    def __init__(self, ox, oy, tx, ty, dmg, pierce, bm):
        self.x, self.y = ox, oy
        self.ox, self.oy, self.tx, self.ty = ox, oy, tx, ty
        self.dmg, self.max_pierce, self.bm = dmg, pierce, bm
        self.left = pierce
        self.phase = 0
        self.hit = set()
        self.spin = 0.0
        self.age = 0
        self.alive = True

    def turn(self):
        if self.phase == 0:
            self.phase = 1
            self.hit.clear()
            self.left = self.max_pierce
        else:
            self.alive = False

    def update(self, game):
        self.age += 1
        self.spin += 0.5
        if self.age > 300:
            self.alive = False
            return
        gx, gy = (self.tx, self.ty) if self.phase == 0 else (self.ox, self.oy)
        d = math.dist((self.x, self.y), (gx, gy))
        if d <= 7:
            self.turn()
            return
        self.x += (gx - self.x) / d * 7
        self.y += (gy - self.y) / d * 7
        for b in game.balloons:
            if b.alive and id(b) not in self.hit and math.dist((self.x, self.y), (b.x, b.y)) < b.radius + 8:
                self.hit.add(id(b))
                game.damage(b, self.dmg, self.bm)
                self.left -= 1
                if self.left <= 0:
                    self.turn()
                    return

    def draw(self, surf):
        x, y = int(self.x), int(self.y)
        for i in range(4):
            a = self.spin + i * math.pi / 2
            pygame.draw.polygon(surf, (245, 245, 250), [
                (x + math.cos(a) * 10, y + math.sin(a) * 10),
                (x + math.cos(a + 0.6) * 4, y + math.sin(a + 0.6) * 4),
                (x + math.cos(a - 0.6) * 4, y + math.sin(a - 0.6) * 4)])
        pygame.draw.circle(surf, (200, 120, 50), (x, y), 5)
        pygame.draw.circle(surf, (60, 40, 25), (x, y), 2)


class Mine:
    """Sits on the track and explodes when a balloon touches it."""

    def __init__(self, x, y, dmg, radius, bm, owner):
        self.x, self.y = x, y
        self.dmg, self.radius, self.bm, self.owner = dmg, radius, bm, owner
        self.life = 1500
        self.alive = True

    def update(self, game):
        self.life -= 1
        if self.life <= 0:
            self.alive = False
            return
        for b in game.balloons:
            if b.alive and math.dist((self.x, self.y), (b.x, b.y)) < b.radius + 12:
                self.alive = False
                game.effects.append(["boom", self.x, self.y, self.radius, 14])
                for o in list(game.balloons):
                    if o.alive and math.dist((o.x, o.y), (self.x, self.y)) <= self.radius + o.radius:
                        game.damage(o, self.dmg, self.bm)
                return

    def draw(self, surf):
        x, y = int(self.x), int(self.y)
        pygame.draw.circle(surf, (25, 25, 28), (x, y), 8)
        pygame.draw.circle(surf, (70, 75, 60), (x, y), 6)
        blink = (TICK[0] // 20) % 2
        pygame.draw.circle(surf, (235, 60, 50) if blink else (110, 30, 30), (x, y), 2)



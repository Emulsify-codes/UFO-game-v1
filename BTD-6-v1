def make_round(r):
    groups = []
    for tier in range(1, 7):
        start = (tier - 1) * 4 + 1
        if r >= start:
            n = 8 + 2 * (r - start)
            if r > start + 6:
                n //= 3
            groups.append((tier, min(n, 45)))
    queue = []
    t = 0
    for tier, n in groups:
        gap = max(8, 30 - tier * 3)
        for _ in range(n):
            queue.append((t, tier, False))
            t += gap
        t += 40
    if r % 8 == 0:
        queue.append((t, 1, True))
    return queue


MAX_ROUND = 40


class Game:
    def __init__(self):
        self.reset()

    def reset(self):
        self.balloons, self.projectiles, self.towers, self.effects = [], [], [], []
        self.money, self.lives, self.round = 650, 100, 0
        self.queue, self.frame = [], 0
        self.round_active = False
        self.selected_shop = None
        self.selected_tower = None
        self.fast = False
        self.state = "play"  # play / over / win

    def damage(self, b, dmg, bm=1):
        if not b.alive:
            return
        if b.boss:
            b.hp -= dmg * bm
            self.money += 1
            if b.hp <= 0:
                b.alive = False
                self.money += 40
                for i in range(4):
                    self.balloons.append(Balloon(5, max(0, b.dist - i * 14)))
            return
        b.tier -= dmg
        self.money += 1
        if b.tier <= 0:
            b.alive = False
        else:
            b.x, b.y = pos_at(b.dist)

    def start_round(self):
        if self.round_active or self.state != "play":
            return
        self.round += 1
        self.queue = make_round(self.round)
        self.frame = 0
        self.round_active = True

    def step(self):
        if self.state != "play":
            return
        if self.round_active:
            while self.queue and self.queue[0][0] <= self.frame:
                _, tier, boss = self.queue.pop(0)
                hp = 100 + 60 * (self.round // 8)
                self.balloons.append(Balloon(tier, 0, boss, hp))
            self.frame += 1
        for t in self.towers:
            t.update(self)
        for p in self.projectiles:
            p.update(self)
        for b in self.balloons:
            if b.alive:
                b.update()
                if b.dist >= TOTAL:
                    b.alive = False
                    self.lives -= (30 if b.boss else b.tier)
        self.balloons = [b for b in self.balloons if b.alive]
        self.projectiles = [p for p in self.projectiles if p.alive]
        if self.lives <= 0:
            self.state = "over"
        if self.round_active and not self.queue and not self.balloons:
            self.round_active = False
            self.money += 100 + self.round * 5 + sum(t.stats["income"] for t in self.towers)
            self.money += sum(min(int(self.money * t.stats.get("interest", 0) / 100), 400)
                              for t in self.towers)
            if self.round >= MAX_ROUND:
                self.state = "win"

    def buff_for(self, tower):
        """Fire-rate multiplier (lower = faster) from nearby Trading Post support auras."""
        mult = 1.0
        for o in self.towers:
            aura = o.stats.get("aura", 0)
            if o is not tower and aura and math.dist((o.x, o.y), (tower.x, tower.y)) <= o.stats["range"]:
                mult *= 1 - aura / 100
        return max(0.5, mult)

    def can_place(self, p):
        if p[0] > MAP_W - 20 or p[0] < 20 or p[1] < 20 or p[1] > H - 20:
            return False
        if dist_to_path(p) < PATH_WIDTH / 2 + 18:
            return False
        return all(math.dist(p, (t.x, t.y)) > 40 for t in self.towers)



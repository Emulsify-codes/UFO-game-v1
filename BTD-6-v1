def handle_click(pos):
    if game.state != "play":
        return
    if pos[0] < MAP_W:
        if game.selected_shop:
            cost = TOWER_TYPES[game.selected_shop]["cost"]
            if game.money >= cost and game.can_place(pos):
                game.towers.append(Tower(game.selected_shop, *pos))
                game.money -= cost
                if not pygame.key.get_mods() & pygame.KMOD_SHIFT:
                    game.selected_shop = None
            return
        game.selected_tower = None
        for t in game.towers:
            if math.dist(pos, (t.x, t.y)) < 20:
                game.selected_tower = t
        return
    if not game.selected_tower:
        for name, rect in SHOP_RECTS.items():
            if rect.collidepoint(pos):
                game.selected_shop = None if game.selected_shop == name else name
                return
    t = game.selected_tower
    if t:
        if BACK_RECT.collidepoint(pos):
            game.selected_tower = None
            return
        for i, rect in enumerate(UPG_RECTS):
            if rect.collidepoint(pos):
                up, reason = t.upgrade_status(i)
                if up and not reason and game.money >= up[0]:
                    if t.upgrade(i):
                        game.money -= up[0]
                return
        if MODE_RECT.collidepoint(pos) and t.kind not in NO_TARGET:
            t.mode = (t.mode + 1) % 3
        elif SELL_RECT.collidepoint(pos):
            game.money += int(t.spent * 0.7)
            game.towers.remove(t)
            game.selected_tower = None
    if START_RECT.collidepoint(pos):
        game.start_round()
    if FAST_RECT.collidepoint(pos):
        game.fast = not game.fast


def main(max_frames=None):
    frames = 0
    while True:
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if e.type == pygame.MOUSEBUTTONDOWN and e.button == 1:
                handle_click(e.pos)
            if e.type == pygame.MOUSEBUTTONDOWN and e.button == 3:
                game.selected_shop = None
            if e.type == pygame.KEYDOWN:
                if e.key == pygame.K_SPACE:
                    game.start_round()
                elif e.key == pygame.K_f:
                    game.fast = not game.fast
                elif e.key == pygame.K_ESCAPE:
                    game.selected_shop = None
                    game.selected_tower = None
                elif e.key == pygame.K_r and game.state != "play":
                    game.reset()
        for _ in range(3 if game.fast else 1):
            game.step()
        TICK[0] += 1
        draw_world()
        draw_panel()
        if game.state == "over":
            draw_overlay("GAME OVER", f"You reached round {game.round}. Press R to restart.")
        elif game.state == "win":
            draw_overlay("YOU WIN!", "All balloons popped. Press R to play again.")
        pygame.display.flip()
        clock.tick(60)
        frames += 1
        if max_frames and frames >= max_frames:
            return


if __name__ == "__main__":
    main()

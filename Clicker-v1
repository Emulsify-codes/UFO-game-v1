def make_button(tag, bounds, label, command, fill=ACCENT,
                hover=ACCENT_HOVER, text_color=TEXT, font_size=13,
                target=None):
    target = target or canvas
    x1, y1, x2, y2 = bounds
    rounded_rectangle(x1, y1, x2, y2, radius=16, target=target,
                      fill=fill, outline="",
                      tags=(tag, tag + "-surface"))
    target.create_text((x1 + x2) / 2, (y1 + y2) / 2, text=label,
                       fill=text_color, font=("Segoe UI", font_size, "bold"),
                       tags=(tag,))

    def on_enter(_event):
        target.itemconfigure(tag + "-surface", fill=hover)
        target.configure(cursor="hand2")

    def on_leave(_event):
        target.itemconfigure(tag + "-surface", fill=fill)
        target.configure(cursor="")

    target.tag_bind(tag, "<Button-1>", lambda _event: command())
    target.tag_bind(tag + "-surface", "<Enter>", on_enter)
    target.tag_bind(tag + "-surface", "<Leave>", on_leave)


def show_home():

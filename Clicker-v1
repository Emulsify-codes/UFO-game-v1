                fill=PANEL_LIGHT, hover="#293956", font_size=10)

    canvas.create_text(center, height * 0.13, text="THE GAME ROOM",
                       fill=MINT, font=("Segoe UI", 10, "bold"))
    canvas.create_text(center, height * 0.20, text="Click. Score. Repeat.",
                       fill=TEXT, font=("Segoe UI", 27, "bold"))
    canvas.create_text(center, height * 0.25,
                       text=f"{click_power} per tap   |   {clicks_per_second()} clicks / sec",
                       fill=MUTED, font=("Segoe UI", 11))

    card_width = min(width - 64, 540)
    card_left = center - card_width / 2
    card_top = height * 0.29
    card_bottom = card_top + 96
    rounded_rectangle(card_left, card_top, card_left + card_width, card_bottom,
                      radius=22, fill=PANEL, outline="#26324d", width=1)
    canvas.create_text(center, card_top + 21, text="YOUR CLICKS",
                       fill=MUTED, font=("Segoe UI", 9, "bold"))
    canvas.create_text(center, card_top + 58, text=f"{clicks:,}",
                       fill=TEXT, font=("Segoe UI", 28, "bold"))
    canvas.create_text(card_left + 24, card_top + 48, anchor="w",
                       text="BEST", fill=GOLD, font=("Segoe UI", 8, "bold"))
    canvas.create_text(card_left + card_width - 24, card_top + 48, anchor="e",
                       text=f"{best:,}", fill=GOLD, font=("Segoe UI", 12, "bold"))

    radius = min(68, width * 0.12, height * 0.11)
    coin_y = card_bottom + radius + 22
    canvas.create_oval(center - radius - 7, coin_y - radius - 7,
                       center + radius + 7, coin_y + radius + 7,
                       fill="#26324d", outline="")
    canvas.create_oval(center - radius, coin_y - radius,
                       center + radius, coin_y + radius,
                       fill=GOLD, outline="#ffe0a2", width=3,
                       tags=("click-target", "click-surface"))
    canvas.create_text(center, coin_y, text="CLICK!",
                       fill="#38280d", font=("Segoe UI", 15, "bold"),
                       tags=("click-target",))
    draw_click_ripples()
    canvas.tag_bind("click-target", "<Button-1>", lambda _event: click_target())
    canvas.tag_bind("click-surface", "<Enter>",
                    lambda _event: canvas.configure(cursor="hand2"))
    canvas.tag_bind("click-surface", "<Leave>",
                    lambda _event: canvas.configure(cursor=""))

    shop_top = coin_y + radius + 38
    shop_width = min(width - 56, 860)
    shop_left = center - shop_width / 2
    viewport_height = max(80, height - shop_top - 68)
    shop_frame.place(x=shop_left, y=shop_top, width=shop_width,
                     height=viewport_height)
    canvas.create_text(center, shop_top - 18, text="YOUR UPGRADES  •  SCROLL TO EXPLORE",
                       fill=MINT, font=("Segoe UI", 10, "bold"))

    shop_scroll_position = shop_canvas.yview()[0]
    shop_canvas.delete("all")
    shop_content_width = max(shop_width - 20, 1)
    card_gap = 10
    item_width = (shop_content_width - card_gap * 2) / 3
    card_height = 132
    row_gap = 10
    for index, upgrade in enumerate(upgrades):
        key, name, description, _base_cost, rate = upgrade
        unlocked = is_upgrade_unlocked(index)
        column = index % 3
        row = index // 3
        x1 = column * (item_width + card_gap)
        x2 = x1 + item_width
        y1 = row * (card_height + row_gap)
        y2 = y1 + card_height
        card_fill = PANEL if unlocked else "#101726"
        rounded_rectangle(
            x1, y1, x2, y2, radius=18, target=shop_canvas,
            fill=card_fill, outline="#26324d" if unlocked else "#202a3b",
            width=1,
        )
        shop_canvas.create_text(x1 + 14, y1 + 22, anchor="w", text=name,
                                fill=TEXT if unlocked else MUTED,
                                font=("Segoe UI", 10, "bold"),
                                width=item_width - 28)
        detail = f"+{rate}/sec" if rate else "x2 click power"
        shop_canvas.create_text(x2 - 14, y1 + 47, anchor="e", text=detail,
                                fill=GOLD, font=("Segoe UI", 8, "bold"))
        card_description = description
        if not unlocked:
            card_description = f"Unlock {upgrades[index - 1][1]} first"
        shop_canvas.create_text(
            x1 + 14, y1 + 53, anchor="w", text=card_description,
            fill=MUTED, font=("Segoe UI", 8), width=item_width - 28,
            justify="left",
        )
        shop_canvas.create_text(
            x1 + 14, y1 + 83, anchor="w",
            text=f"OWNED  {owned[key]}" if unlocked else "LOCKED",
            fill=MINT if unlocked else "#77839a",
            font=("Segoe UI", 8, "bold"),
        )
        if unlocked:
            price = upgrade_cost(upgrade)
            can_afford = clicks >= price
            button_fill = ACCENT if can_afford else "#30394c"
            button_width = min(150, item_width - 28)
            make_button(f"buy-{key}",
                        (x1 + 14, y2 - 42, x1 + 14 + button_width, y2 - 10),
                        f"BUY  {price:,}", lambda item=key: buy_upgrade(item),
                        fill=button_fill,
                        hover=ACCENT_HOVER if can_afford else "#30394c",
                        text_color=TEXT if can_afford else MUTED,
                        font_size=9, target=shop_canvas)

    message = shop_message or "Click the coin or press SPACE  •  Upgrades keep working over time"
    canvas.create_text(center, height - 19, text=message,
                       fill=MUTED, font=("Segoe UI", 8))
    shop_canvas.configure(scrollregion=shop_canvas.bbox("all"))
    shop_canvas.yview_moveto(shop_scroll_position)


def scroll_shop(event):
    if event.delta:
        shop_canvas.yview_scroll(-1 if event.delta > 0 else 1, "units")
    return "break"


def scroll_leaderboard(event):
    if event.delta:
        leaderboard_canvas.yview_scroll(-1 if event.delta > 0 else 1, "units")
    return "break"


def redraw(_event=None):
    width = max(canvas.winfo_width(), 700)
    height = max(canvas.winfo_height(), 600)
    canvas.delete("all")
    draw_background(width, height)
    draw_brand(width)
    if page == "home":
        shop_frame.place_forget()
        draw_home(width, height)
    else:
        leaderboard_frame.place_forget()
        draw_game(width, height)


def handle_key(event):
    if page == "game" and event.keysym == "space":
        click_target()
        return "break"
    if event.keysym == "Escape" and page == "game":
        show_home()
        return "break"
    return None


last_tick = time.monotonic()


def game_tick():
    global clicks, best, passive_remainder, last_tick
    now = time.monotonic()
    elapsed = now - last_tick
    last_tick = now

    rate = clicks_per_second() if run_active else 0
    if rate:
        passive_remainder += rate * elapsed
        earned = int(passive_remainder)
        if earned:
            clicks += earned
            best = max(best, clicks)
            passive_remainder -= earned
            if page == "game":
                redraw()

    root.after(100, game_tick)


canvas.bind("<Configure>", redraw)
shop_canvas.bind("<MouseWheel>", scroll_shop)
leaderboard_canvas.bind("<MouseWheel>", scroll_leaderboard)
root.bind("<Key>", handle_key)
canvas.focus_set()
root.protocol("WM_DELETE_WINDOW", close_game)
root.after(100, game_tick)
root.mainloop()

def show_game():
    global best, click_power, clicks, page, passive_remainder
    global run_active, shop_message, owned
    if page != "game":
        clicks = 0
        best = 0
        click_power = 1
        passive_remainder = 0.0
        shop_message = ""
        owned = {upgrade[0]: 0 for upgrade in upgrades}
        run_active = True
        shop_canvas.yview_moveto(0)
    page = "game"
    root.title("Clicking World - Game")
    redraw()


def click_target():
    global clicks, best, ripple_animation_scheduled
    clicks += click_power
    best = max(best, clicks)
    click_ripples.append(time.monotonic())
    redraw()
    if not ripple_animation_scheduled:
        ripple_animation_scheduled = True
        root.after(16, animate_ripples)


def draw_click_ripples():
    canvas.delete("click-ripple")
    if page != "game":
        return

    width = max(canvas.winfo_width(), 700)
    height = max(canvas.winfo_height(), 600)
    center = width / 2
    card_bottom = height * 0.29 + 96
    radius = min(68, width * 0.12, height * 0.11)
    coin_y = card_bottom + radius + 22
    now = time.monotonic()
    colors = (GOLD, MINT, ACCENT, "#526184")

    for started_at in click_ripples:
        progress = (now - started_at) / 0.62
        if not 0 <= progress < 1:
            continue
        color = colors[min(int(progress * len(colors)), len(colors) - 1)]
        ring_radius = radius + 7 + progress * 130
        canvas.create_oval(
            center - ring_radius, coin_y - ring_radius,
            center + ring_radius, coin_y + ring_radius,
            outline=color, width=max(1, round(4 * (1 - progress))),
            tags=("click-ripple",),
        )

    canvas.tag_lower("click-ripple", "click-surface")


def animate_ripples():
    global click_ripples, ripple_animation_scheduled
    now = time.monotonic()
    click_ripples = [
        started_at for started_at in click_ripples
        if now - started_at < 0.62
    ]
    draw_click_ripples()
    if click_ripples:
        root.after(16, animate_ripples)
    else:
        ripple_animation_scheduled = False


def upgrade_cost(upgrade):
    key, _name, _description, base_cost, _rate = upgrade
    growth = 2 if key in (
        "gauntlet", "golden_gauntlet", "infinity_gauntlet"
    ) else 1.5
    return round(base_cost * growth ** owned[key])


def is_upgrade_unlocked(index):
    return index == 0 or owned[upgrades[index - 1][0]] > 0


def buy_upgrade(key):
    global clicks, shop_message
    index = next(i for i, item in enumerate(upgrades) if item[0] == key)
    upgrade = upgrades[index]
    if not is_upgrade_unlocked(index):
        shop_message = f"Unlock {upgrades[index - 1][1]} first to access this upgrade."
        redraw()
        return
    cost = upgrade_cost(upgrade)
    if clicks < cost:
        shop_message = f"Need {cost - clicks:,} more clicks for the {upgrade[1].lower()}."
        redraw()
        return

    clicks -= cost
    owned[key] += 1
    if key in ("gauntlet", "golden_gauntlet", "infinity_gauntlet"):
        global click_power
        click_power *= 2
        shop_message = f"{upgrade[1].title()} purchased! Your click power doubled."
    else:
        shop_message = f"{upgrade[1].title()} purchased! It is making clicks for you."
    redraw()


def clicks_per_second():
    return sum(owned[key] * rate
               for key, _name, _description, _cost, rate in upgrades)



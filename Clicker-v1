def load_leaderboard():
    global leaderboard_load_error
    try:
        data = json.loads(LEADERBOARD_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return []
    except (OSError, json.JSONDecodeError) as error:
        leaderboard_load_error = str(error)
        messagebox.showerror(
            "Leaderboard unavailable",
            f"Could not load {LEADERBOARD_FILE.name}:\n{error}",
            parent=root,
        )
        return []

    if not isinstance(data, list) or any(
        not isinstance(entry, dict)
        or not isinstance(entry.get("score"), int)
        or not isinstance(entry.get("date"), str)
        or not isinstance(entry.get("run"), int)
        for entry in data
    ):
        leaderboard_load_error = "The file does not contain valid run records."
        messagebox.showerror(
            "Leaderboard unavailable",
            f"{LEADERBOARD_FILE.name} does not contain valid run records.",
            parent=root,
        )
        return []
    return sorted(data, key=lambda entry: entry["score"], reverse=True)


def save_run(score):
    if leaderboard_load_error:
        messagebox.showerror(
            "Run not saved",
            "The existing leaderboard could not be loaded, so it was left "
            "unchanged. Fix leaderboard.json before starting another run.",
            parent=root,
        )
        return

    record = {
        "run": len(leaderboard) + 1,
        "score": score,
        "date": datetime.now().astimezone().isoformat(timespec="seconds"),
    }
    updated = sorted(
        [*leaderboard, record], key=lambda entry: entry["score"], reverse=True
    )
    try:
        LEADERBOARD_FILE.write_text(
            json.dumps(updated, indent=2) + "\n", encoding="utf-8",
        )
    except OSError as error:
        messagebox.showerror(
            "Run not saved",
            f"Could not save the leaderboard:\n{error}",
            parent=root,
        )
        return

    leaderboard[:] = updated


def finish_run():
    global run_active
    if not run_active:
        return
    save_run(best)
    run_active = False


def close_game():
    finish_run()
    root.destroy()


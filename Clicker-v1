def rounded_rectangle(x1, y1, x2, y2, radius=18, target=None, **kwargs):
    target = target or canvas
    radius = min(radius, (x2 - x1) / 2, (y2 - y1) / 2)
    points = [
        x1 + radius, y1,
        x2 - radius, y1,
        x2, y1,
        x2, y1 + radius,
        x2, y2 - radius,
        x2, y2,
        x2 - radius, y2,
        x1 + radius, y2,
        x1, y2,
        x1, y2 - radius,
        x1, y1 + radius,
        x1, y1,
    ]
    return target.create_polygon(points, smooth=True, splinesteps=12, **kwargs)


def draw_background(width, height):
    canvas.create_oval(
        width * 0.67, -height * 0.44, width * 1.16, height * 0.42,
        fill="#111a33", outline="",
    )
    canvas.create_oval(
        -width * 0.31, height * 0.64, width * 0.24, height * 1.24,
        fill="#101a30", outline="",
    )
    for x, y, size, color in (
        (0.12, 0.22, 3, "#6679aa"),
        (0.82, 0.19, 3, "#6575a0"),
        (0.88, 0.77, 4, "#3d9d91"),
        (0.20, 0.81, 3, "#7168b1"),
        (0.72, 0.36, 2, "#7b87ac"),
        (0.31, 0.27, 2, "#63708f"),
    ):
        cx, cy = width * x, height * y
        canvas.create_oval(cx - size, cy - size, cx + size, cy + size,
                           fill=color, outline="")



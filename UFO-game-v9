DROP_CHANCE = 0.08
DROP_FALL = 90
DROP_TYPES = (("hull", "#ff6b6b", "+"), ("credits", "#ffe066", "$"),
              ("rapid", "#4dd8ff", ">"))

_dr_reset = Game.reset
_dr_clear = Game.clear_field
_dr_kill = Game.kill_ufo
_dr_update = Game.update
_dr_hud = Game.draw_hud
_dr_delay = Game.delay.fget


def dr_reset(self):
    _dr_reset(self)
    self.rapid_t = 0.0


def dr_clear(self):
    _dr_clear(self)
    self.drops = []


def dr_kill(self, u, src=None):
    _dr_kill(self, u, src)
    if u["kind"] in BOSS_WAVES.values():
        return
    if random.random() < DROP_CHANCE:
        kind, col, ch = random.choice(DROP_TYPES)
        self.drops.append(dict(x=u["x"], y=u["y"], kind=kind, col=col,
                               ch=ch, t=0.0))


def collect_drop(self, d):
    if d["kind"] == "hull":
        if self.hp < self.max_hp:
            self.hp += 1
            msg = "+1 HULL"
        else:
            self.credits += 15
            msg = "+15c"
    elif d["kind"] == "credits":
        amt = 20 + self.wave * 2
        self.credits += amt
        msg = f"+{amt}c"
    else:
        self.rapid_t = 6.0
        msg = "RAPID FIRE!"
    self.floaters.append([d["x"], GROUND - 60, msg, 1.0])
    self.explode(d["x"], GROUND - 10, d["col"], 10, 140)
    self.sfx("buy")


def dr_update(self, dt):
    _dr_update(self, dt)
    if self.state != "play":
        return
    self.rapid_t = max(0.0, self.rapid_t - dt)
    keep = []
    for d in self.drops:
        d["t"] += dt
        d["y"] += DROP_FALL * dt
        if abs(d["x"] - self.px) < 34 and abs(d["y"] - GROUND) < 34:
            self.collect_drop(d)
        elif d["y"] < GROUND + 40:
            keep.append(d)
    self.drops = keep


def dr_hud(self):
    _dr_hud(self)
    if self.state not in ("play", "paused"):
        return
    c, t = self.c, time.time()
    for d in self.drops:
        pulse = 0.5 + 0.5 * math.sin(t * 8 + d["x"])
        glow(c, d["x"], d["y"], 16, d["col"], layers=3, a=0.5)
        c.create_oval(d["x"] - 8, d["y"] - 8, d["x"] + 8, d["y"] + 8,
                      fill="#0b0f26", width=2,
                      outline=mix(d["col"], "#ffffff", pulse * 0.5))
        c.create_text(d["x"], d["y"], text=d["ch"], fill=d["col"],
                      font=(FONT, 10, "bold"))
    if self.rapid_t > 0:
        c.create_text(W / 2, H - 54, text=f"RAPID FIRE {self.rapid_t:.1f}s",
                      fill="#4dd8ff", font=(FONT, 10, "bold"))



PET_BUFF_TYPES = (
    "damage", "fire_rate", "piercing", "bullet_speed",
    "credits_score", "multishot",
)
_PET_DAMAGE_PERCENT = (5, 8, 11, 14, 17, 20, 23, 26, 29, 32)
_PET_FIRE_RATE_PERCENT = (3, 5, 7, 9, 11, 14, 17, 20, 23, 26)
_PET_SPEED_PERCENT = (5, 8, 11, 14, 17, 20, 23, 26, 29, 32)
_PET_REWARD_PERCENT = (5, 9, 13, 17, 21, 25, 29, 33, 37, 41)
_PET_PIERCE_AMOUNT = (1, 1, 1, 1, 1, 2, 2, 2, 3, 3)
_PET_MULTISHOT_AMOUNT = (0, 0, 0, 0, 1, 1, 1, 1, 1, 2)


def pet_buff_details(pet):
    rarity_index = next(
        i for i, (rarity, *_) in enumerate(PET_RARITIES)
        if rarity == pet["rarity"])
    pet_number = int(pet["id"].rsplit("_", 1)[1])
    buff = PET_BUFF_TYPES[(pet_number - 1) % len(PET_BUFF_TYPES)]
    if buff == "damage":
        return ("DAMAGE", buff, f"+{_PET_DAMAGE_PERCENT[rarity_index]}% damage")
    if buff == "fire_rate":
        return ("FIRE RATE", buff,
                f"+{_PET_FIRE_RATE_PERCENT[rarity_index]}% fire rate")
    if buff == "piercing":
        amount = _PET_PIERCE_AMOUNT[rarity_index]
        return ("PIERCING", buff, f"+{amount} pierce")
    if buff == "bullet_speed":
        return ("BULLET SPEED", buff,
                f"+{_PET_SPEED_PERCENT[rarity_index]}% bullet speed")
    if buff == "credits_score":
        amount = _PET_REWARD_PERCENT[rarity_index]
        return ("SALVAGE", buff, f"+{amount}% score and credits per UFO")
    amount = _PET_MULTISHOT_AMOUNT[rarity_index]
    if amount:
        return ("MULTI-SHOT", buff, f"+{amount} barrel")
    return ("DAMAGE", "damage", f"+{_PET_DAMAGE_PERCENT[rarity_index]}% damage")


def _pet_equipped_buff(self):
    data = getattr(self, "data", None)
    pets = data.get("pets") if isinstance(data, dict) else None
    if not isinstance(pets, dict):
        return None, 0
    owned = pets.get("owned")
    pet_id = pets.get("equipped")
    if not isinstance(owned, dict) or pet_id not in owned:
        return None, 0
    pet = PET_BY_ID.get(pet_id)
    if pet is None:
        return None, 0
    _, buff, _ = pet_buff_details(pet)
    rarity_index = next(
        i for i, (rarity, *_) in enumerate(PET_RARITIES)
        if rarity == pet["rarity"])
    if buff == "damage":
        return buff, _PET_DAMAGE_PERCENT[rarity_index] / 100
    if buff == "fire_rate":
        return buff, _PET_FIRE_RATE_PERCENT[rarity_index] / 100
    if buff == "piercing":
        return buff, _PET_PIERCE_AMOUNT[rarity_index]
    if buff == "bullet_speed":
        return buff, _PET_SPEED_PERCENT[rarity_index] / 100
    if buff == "credits_score":
        return buff, _PET_REWARD_PERCENT[rarity_index] / 100
    if buff == "multishot":
        return buff, _PET_MULTISHOT_AMOUNT[rarity_index]
    return None, 0


_pets_base_damage = Game.damage.fget

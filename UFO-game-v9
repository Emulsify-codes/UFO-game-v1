RANK_TIERS = ("Bronze", "Silver", "Gold", "Platinum", "Diamond", "Master",
              "Grandmaster")


def rank_for_wave(wave):
    """Return the league rank for the highest wave cleared."""
    rank_step = max(0, wave // 5 - 1)
    tier, division = divmod(rank_step, 3)
    if tier >= len(RANK_TIERS):
        tier, division = len(RANK_TIERS) - 1, 2
    divisions = ("I", "II", "III")
    return f"{RANK_TIERS[tier]} {divisions[division]}" if wave >= 5 \
        else "Unranked"


def level_progress_for_xp(xp):
    """Return the level, XP progress, and XP needed for the next level."""
    level = 0
    needed = 10
    while xp >= needed:
        xp -= needed
        level += 1
        needed += 5
    return level, xp, needed



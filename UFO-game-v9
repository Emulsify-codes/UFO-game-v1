def hsv(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, s, v)
    return "#%02x%02x%02x" % (int(r * 255), int(g * 255), int(b * 255))


def clip_convex(poly, clip):
    """Clip a polygon to a convex polygon (Sutherland-Hodgman)."""
    cx = sum(p[0] for p in clip) / len(clip)
    cy = sum(p[1] for p in clip) / len(clip)
    out = list(poly)
    n = len(clip)
    for i in range(n):
        ax, ay = clip[i]
        bx, by = clip[(i + 1) % n]

        def side(p, ax=ax, ay=ay, bx=bx, by=by):
            return (bx - ax) * (p[1] - ay) - (by - ay) * (p[0] - ax)

        ref = side((cx, cy))
        inp, out = out, []
        if not inp:
            break
        s = inp[-1]
        for e in inp:
            e_in = side(e) * ref >= 0
            s_in = side(s) * ref >= 0
            if e_in:
                if not s_in:
                    t = side(s) / (side(s) - side(e))
                    out.append((s[0] + (e[0] - s[0]) * t,
                                s[1] + (e[1] - s[1]) * t))
                out.append(e)
            elif s_in:
                t = side(s) / (side(s) - side(e))
                out.append((s[0] + (e[0] - s[0]) * t,
                            s[1] + (e[1] - s[1]) * t))
            s = e
    return out


def ellipse_poly(cx, cy, rx, ry, n=12, rng=None):
    pts = []
    for i in range(n):
        a = i * math.tau / n
        j = 1.0 if rng is None else rng.uniform(0.8, 1.2)
        pts.append((cx + math.cos(a) * rx * j, cy + math.sin(a) * ry * j))
    return pts


def polyline_point(pts, f):
    segs = [math.hypot(b[0] - a[0], b[1] - a[1]) for a, b in zip(pts, pts[1:])]
    d = f * sum(segs)
    for (a, b), s in zip(zip(pts, pts[1:]), segs):
        if d <= s or s == 0:
            u = d / s if s else 0.0
            return (a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u)
        d -= s
    return pts[-1]



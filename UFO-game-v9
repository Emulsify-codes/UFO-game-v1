def hex2rgb(h):
    return [int(h[i:i + 2], 16) for i in (1, 3, 5)]


def mix(c1, c2, t):
    """Blend hex colour c1 toward c2 by t (0..1). Used to fake transparency."""
    t = 0.0 if t < 0 else 1.0 if t > 1 else t
    a, b = hex2rgb(c1), hex2rgb(c2)
    return "#%02x%02x%02x" % tuple(int(a[i] + (b[i] - a[i]) * t)
                                   for i in range(3))


SKY_TOP, SKY_MID, SKY_HOR = "#04040f", "#171248", "#4a2468"


def _sky(y):
    t = max(0.0, min(1.0, y / HORIZON))
    col = mix(SKY_TOP, SKY_MID, t ** 1.2)
    if t > 0.7:
        col = mix(col, SKY_HOR, (t - 0.7) / 0.3 * 0.8)
    return col


_GRAD = [_sky(i * 8) for i in range(81)]


def sky(y):
    """Sky colour at height y (cached) - used as the 'background' for fades."""
    return _GRAD[max(0, min(80, int(y / 8)))]


def fade(color, y, k):
    """Fade a colour toward the sky behind it (k=0 original, k=1 invisible)."""
    return mix(color, sky(y), k)


def glow(c, x, y, r, color, layers=5, a=1.0, bg=None, tags=()):
    """Soft radial glow made of stacked ovals blended into the background."""
    bg = bg or sky(y)
    base = mix(bg, color, a)
    for i in range(layers, 0, -1):
        rr = r * i / layers
        c.create_oval(x - rr, y - rr, x + rr, y + rr,
                      fill=mix(base, bg, i / (layers + 1)), outline="",
                      tags=tags)


def rrect(c, x1, y1, x2, y2, r=10, **kw):
    """Rounded rectangle."""
    pts = [x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r, x2, y2,
           x2 - r, y2, x1 + r, y2, x1, y2, x1, y2 - r, x1, y1 + r, x1, y1]
    return c.create_polygon(pts, smooth=True, **kw)


def shadow_text(c, x, y, text, fill, font, anchor="center",
                shade="#000000", off=2):
    c.create_text(x + off, y + off, text=text, fill=shade, font=font,
                  anchor=anchor)
    c.create_text(x, y, text=text, fill=fill, font=font, anchor=anchor)


def pick_font(root):
    try:
        have = set(tkfont.families(root))
    except tk.TclError:
        return "Helvetica"
    for name in ("Segoe UI", "SF Pro Display", "Helvetica Neue", "Ubuntu",
                 "DejaVu Sans", "Arial", "Helvetica"):
        if name in have:
            return name
    return "Helvetica"



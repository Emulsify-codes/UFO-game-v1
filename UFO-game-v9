def pets_on_click(self, event):
    x, y = self.c.to_game(event.x, event.y)
    if self.state == "menu" and self.hit(self.menu_rects, x, y) == "pets":
        self.mouse_x, self.mouse_y = x, y
        self.open_pets()
        return
    if self.state == "pets":
        self.mouse_x, self.mouse_y = x, y
        action = self.hit(self.pet_rects, x, y)
        if action == "back":
            self.close_leaderboard()
        elif isinstance(action, tuple):
            kind, value = action
            if kind == "tab":
                self.pets_tab = value
                self.pet_scroll = 0
            elif kind == "buy":
                buy_pet_egg(self, value)
            elif kind == "hatch":
                hatch_pet_egg(self, value)
            elif kind == "rarity":
                self.pet_rarity = value
                self.pet_scroll = 0
            elif kind == "equip":
                pets = self.data["pets"]
                pets["equipped"] = (None if pets["equipped"] == value
                                    else value)
                self.save_ok = save_data(self.data)
                self.pet_message = ("Companion unequipped."
                                    if pets["equipped"] is None
                                    else f"{PET_BY_ID[value]['name']} equipped.")
                self.pet_message_t = 2.0
                self.sfx("click")
        return
    _pets_previous_on_click(self, event)


def pets_on_key_down(self, event):
    key = event.keysym.lower()
    if self.state == "menu" and key == "p":
        self.open_pets()
        return
    if self.state == "pets":
        if key in ("escape", "backspace", "return"):
            self.close_leaderboard()
        elif key in ("left", "right", "tab"):
            self.pets_tab = ("collection" if self.pets_tab == "eggs"
                             else "eggs")
            self.pet_scroll = 0
        elif self.pets_tab == "collection" and key in ("up", "down"):
            found = [pet for pet in PET_CATALOG[self.pet_rarity]
                     if pet["id"] in self.data["pets"]["owned"]]
            self.pet_scroll = min(max(0, len(found) - 7),
                                  max(0, self.pet_scroll
                                      + (-1 if key == "up" else 1)))
        elif key.isdigit():
            index = 9 if key == "0" else int(key) - 1
            if index < len(PET_RARITIES):
                self.pet_rarity = PET_RARITIES[index][0]
                self.pets_tab = "collection"
                self.pet_scroll = 0
        return
    _pets_previous_on_key_down(self, event)


def pets_scroll(self, direction):
    if self.state == "pets" and self.pets_tab == "collection":
        found = [pet for pet in PET_CATALOG[self.pet_rarity]
                 if pet["id"] in self.data["pets"]["owned"]]
        self.pet_scroll = min(max(0, len(found) - 7),
                              max(0, self.pet_scroll + direction))
        return
    _pets_previous_scroll(self, direction)



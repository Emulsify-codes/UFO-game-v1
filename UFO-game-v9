def quest_period_keys(now=None):
    now = now or datetime.datetime.now()
    today = now.date()
    iso = today.isocalendar()
    return (today.isoformat(), f"{iso.year}-W{iso.week:02d}")


def quest_set(period, daily):
    if daily:
        offset = datetime.date.fromisoformat(period).toordinal()
        pool = DAILY_QUESTS
    else:
        year, week = period.split("-W")
        offset = datetime.date.fromisocalendar(
            int(year), int(week), 1).toordinal()
        pool = WEEKLY_QUESTS
    start = offset % len(pool)
    return [pool[(start + i) % len(pool)] for i in range(3)]


def ensure_quest_periods(self):
    data = self.data
    state = data.get("quests")
    if not isinstance(state, dict):
        state = {}
    daily_period, weekly_period = quest_period_keys()
    normalized = {}
    for name, period in (("daily", daily_period), ("weekly", weekly_period)):
        period_key = name + "_period"
        progress_key = name + "_progress"
        claimed_key = name + "_claimed"
        old_progress = state.get(progress_key)
        if state.get(period_key) != period or not isinstance(old_progress, dict):
            normalized[period_key] = period
            normalized[progress_key] = {}
            normalized[claimed_key] = []
        else:
            normalized[period_key] = period
            normalized[progress_key] = {}
            for metric in QUEST_METRICS:
                try:
                    normalized[progress_key][metric] = max(
                        0, int(old_progress.get(metric, 0)))
                except (TypeError, ValueError):
                    normalized[progress_key][metric] = 0
            old_claimed = state.get(claimed_key, [])
            normalized[claimed_key] = (
                [quest_id for quest_id in old_claimed
                 if isinstance(quest_id, str)]
                if isinstance(old_claimed, list) else [])
    data["quests"] = normalized
    for period_name, daily in (("daily", True), ("weekly", False)):
        active = quest_set(normalized[period_name + "_period"], daily)
        progress = normalized[period_name + "_progress"]
        claimed = normalized[period_name + "_claimed"]
        for quest in active:
            if progress.get(quest["metric"], 0) >= quest["target"] \
                    and quest["id"] not in claimed:
                grant_quest_reward(self, period_name, quest)
    if state != normalized:
        self.save_ok = save_data(data)


def grant_quest_reward(self, period_name, quest):
    claimed = self.data["quests"][period_name + "_claimed"]
    if quest["id"] in claimed:
        return False
    reward = QUEST_GEM_REWARDS[period_name]
    claimed.append(quest["id"])
    self.data["gems"] += reward
    if hasattr(self, "floaters") and self.state == "play":
        self.floaters.append([
            self.px, GROUND - 70,
            f"QUEST COMPLETE  +{reward} GEMS", 1.8])
    if hasattr(self, "snd"):
        self.sfx("badge")
    return True


def quest_count(self, period_name, metric):
    ensure_quest_periods(self)
    return self.data["quests"][period_name + "_progress"].get(metric, 0)


def add_quest_progress(self, metric, amount=1):
    if metric not in QUEST_METRICS or amount <= 0:
        return
    ensure_quest_periods(self)
    changed = False
    reward_granted = False
    for period_name, daily in (("daily", True), ("weekly", False)):
        period = self.data["quests"][period_name + "_period"]
        active = quest_set(period, daily)
        matching = [q for q in active if q["metric"] == metric]
        progress = self.data["quests"][period_name + "_progress"]
        previous = progress.get(metric, 0)
        target = max((q["target"] for q in matching), default=0)
        new_value = min(target, previous + amount) if target else previous
        if new_value != previous:
            progress[metric] = new_value
            changed = True
        if target and previous < target <= new_value:
            for quest in matching:
                if quest["target"] == target:
                    reward_granted = grant_quest_reward(
                        self, period_name, quest) or reward_granted
    if changed and (metric != "score" or reward_granted):
        self.save_ok = save_data(self.data)


def open_quests(self):
    ensure_quest_periods(self)
    self.sfx("click")
    self.lb_return = "menu"

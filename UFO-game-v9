    def draw_rank_medal(self, cx, cy, rank):
        c = self.c
        tier = rank.split()[0]
        colors = {
            "Bronze": "#cd7f32",
            "Silver": "#c7d2e0",
            "Gold": "#ffd24d",
            "Platinum": "#65e6d0",
            "Diamond": "#62b7ff",
            "Master": "#b36bff",
            "Grandmaster": "#ff5a8a",
            "Unranked": "#65709e",
        }
        color = colors.get(tier, "#65709e")
        dark = mix(color, "#10152f", 0.45)
        c.create_polygon(cx - 5, cy + 2, cx - 1, cy + 2, cx - 2, cy + 10,
                         cx - 6, cy + 7, fill=dark, outline="")
        c.create_polygon(cx + 1, cy + 2, cx + 5, cy + 2, cx + 6, cy + 7,
                         cx + 2, cy + 10, fill=dark, outline="")
        c.create_oval(cx - 8, cy - 8, cx + 8, cy + 8, fill=dark,
                      outline=color, width=1)
        c.create_oval(cx - 5.5, cy - 5.5, cx + 5.5, cy + 5.5,
                      fill=color, outline="")
        points = []
        for i in range(10):
            radius = 4 if i % 2 == 0 else 1.8
            angle = i * math.pi / 5 - math.pi / 2
            points.extend((cx + math.cos(angle) * radius,
                           cy + math.sin(angle) * radius))
        c.create_polygon(points, fill="#fff4c2", outline="")


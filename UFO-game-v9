                anchor="w")
    c.create_text(104, 106, anchor="w",
                  text="Your lifetime achievements across every run.",
                  fill="#8293b8", font=(FONT, 9))

    bosses = sum(self.stat("kill_" + kind)
                 for kind in set(BOSS_WAVES.values()))
    highest_wave = max(
        (int(run.get("cleared_wave", run.get("wave", 0)))
         for run in self.scores), default=0)
    metrics = (
        ("ACTIVE RUN TIME", stats_play_time(self.stat("time_played")),
         "Tracked from now; menus, shops and pauses are excluded.",
         "#4dd8ff"),
        ("UFOs DESTROYED", f"{self.stat('kills'):,}",

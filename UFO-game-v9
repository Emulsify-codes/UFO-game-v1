# WEATHER EVENTS: WORMHOLE + SOLAR FLARE
# (paste this whole block into ufo_shooter.py, directly ABOVE the line:
#     if __name__ == "__main__":
#  It must come AFTER all the other add-on blocks, including the
#  POWER-UP DROPS block.)
#
# Each wave (not boss waves, by default) has a chance to roll ONE weather
# event. A banner announces it and a small panel on the left of the HUD
# shows its status.
#
#   WORMHOLE   A portal opens in the sky and marks a danger zone on the
#              ground. When it fires, anything standing in the zone is
#              FROZEN for 3 seconds: no moving, shooting, missiles, beam,
#              ricochet, minions or shockwave. UFOs keep attacking, so dodge
#              out of the zone while the portal warms up. You get a short
#              grace period of invulnerability when you thaw.
#              (Set WORMHOLE_DODGEABLE = False and the zone tracks you, so
#              the freeze always lands.)
#              Each appearance grows the next portal until it fills the
#              screen, making the danger zone impossible to escape.
#
#   SOLAR FLARE   Lasts the whole wave:
#                 * UFOs move faster and have more hull
#                 * your gun fires slower
#                 * all your damage is reduced (gun, missiles, beam, shock,
#                   ricochet, minions)
#                 Clearing the wave pays out bonus credits.
#
# Everything is tuned by the constants below.
# ==========================================================================
WEATHER_ENABLED = True
WEATHER_CHANCE = 0.30            # chance that a wave gets a weather event
WEATHER_ON_BOSS_WAVES = False    # allow weather on boss waves?
WEATHER_BANNER_T = 3.0           # seconds the announcement is shown

WORMHOLE_START_WAVE = 2          # first wave a wormhole can appear on
WORMHOLE_FREEZE_T = 3.0          # seconds you are frozen
WORMHOLE_WARN_T = 2.0            # seconds of warning before it fires
WORMHOLE_RADIUS = 80             # half-width of the danger zone, in px
WORMHOLE_GROWTH = 1.5            # radius multiplier for each later appearance
WORMHOLE_DODGEABLE = True        # False = the zone follows you, no escape
WORMHOLE_DELAY = (4.0, 9.0)      # random seconds after wave start it opens
WORMHOLE_THAW_INV = 1.0          # invulnerable seconds after thawing

FLARE_START_WAVE = 3             # first wave a solar flare can appear on
FLARE_UFO_SPEED = 1.30           # UFO movement speed multiplier
FLARE_UFO_HP = 1.30              # UFO hull multiplier
FLARE_FIRE_DELAY = 1.35          # your gun's time between shots multiplier
FLARE_DAMAGE = 0.75              # your damage multiplier
FLARE_CLEAR_BONUS = 60           # bonus credits for clearing a flare wave


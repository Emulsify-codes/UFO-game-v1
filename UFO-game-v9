_pets_base_delay = Game.delay.fget
_pets_base_bullet_speed = Game.bullet_speed.fget
_pets_base_shots = Game.shots.fget
_pets_base_pierce = Game.pierce.fget
_pets_base_kill_ufo = Game.kill_ufo
_pets_base_hud = Game.draw_hud


def _pet_damage(self):
    value = _pets_base_damage(self)
    buff, amount = _pet_equipped_buff(self)
    return round(value * (1 + amount), 2) if buff == "damage" else value


def _pet_power(self):
    value = _pets_base_power(self)
    buff, amount = _pet_equipped_buff(self)
    return value * (1 + amount) if buff == "damage" else value


def _pet_delay(self):
    value = _pets_base_delay(self)
    buff, amount = _pet_equipped_buff(self)
    return value / (1 + amount) if buff == "fire_rate" else value


def _pet_bullet_speed(self):
    value = _pets_base_bullet_speed(self)
    buff, amount = _pet_equipped_buff(self)
    return round(value * (1 + amount)) if buff == "bullet_speed" else value


def _pet_shots(self):
    value = _pets_base_shots(self)
    buff, amount = _pet_equipped_buff(self)
    return value + amount if buff == "multishot" else value


def _pet_pierce(self):
    value = _pets_base_pierce(self)
    buff, amount = _pet_equipped_buff(self)
    return value + amount if buff == "piercing" else value


def _pet_kill_ufo(self, u, src=None):
    before_score, before_credits = self.score, self.credits
    _pets_base_kill_ufo(self, u, src)
    buff, amount = _pet_equipped_buff(self)
    if buff != "credits_score":
        return
    score_reward = max(0, self.score - before_score)
    credit_reward = max(0, self.credits - before_credits)
    self.score += round(score_reward * amount)
    self.credits += round(credit_reward * amount)


def _pet_hud(self):
    _pets_base_hud(self)
    if self.state not in ("play", "paused"):
        return
    data = getattr(self, "data", {})
    pets = data.get("pets", {}) if isinstance(data, dict) else {}
    pet_id = pets.get("equipped") if isinstance(pets, dict) else None
    if pet_id not in PET_BY_ID:
        return
    pet = PET_BY_ID[pet_id]
    buff_name, _, buff_description = pet_buff_details(pet)
    self.c.create_text(
        W - 10, 191, anchor="ne",
        text=f"PET: {pet['name']}  ·  {buff_name} {buff_description}",
        fill=pet["color"], font=(FONT, 8, "bold"))



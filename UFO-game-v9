ADAPTIVE_PRESSURE_MAX = 5
_adaptive_base_reset = Game.reset
_adaptive_base_start_wave = Game.start_wave
_adaptive_base_fire = Game.fire
_adaptive_base_hurt_player = Game.hurt_player
_adaptive_base_update = Game.update


def adaptive_reset(self):
    _adaptive_base_reset(self)
    self.adaptive_pressure = 0
    self.adaptive_wave_shots = 0
    self.adaptive_wave_hits = 0
    self.adaptive_wave_damage = 0


def adaptive_start_wave(self):
    _adaptive_base_start_wave(self)
    self.adaptive_wave_shots = 0
    self.adaptive_wave_hits = 0
    self.adaptive_wave_damage = 0
    if self.run_mode != "adaptive" or self.adaptive_pressure <= 0:
        return
    eligible = [kind for kind in self.queue if kind not in ("boss", "grand")]
    if not eligible:
        eligible = ["scout"]
    extra = self.adaptive_pressure * 2
    self.queue.extend(random.choices(eligible, k=extra))
    self.wave_total += extra


def adaptive_fire(self):
    before = len(self.bullets)
    _adaptive_base_fire(self)
    for bullet in self.bullets[before:]:
        bullet["adaptive_shot"] = True
        self.adaptive_wave_shots += 1


def adaptive_hurt_player(self, damage):
    before = self.hp
    _adaptive_base_hurt_player(self, damage)
    self.adaptive_wave_damage += max(0, before - self.hp)


def adaptive_update(self, dt):
    cleared_before = self.cleared_wave
    _adaptive_base_update(self, dt)
    if self.run_mode != "adaptive" or self.cleared_wave <= cleared_before:
        return

    shots = self.adaptive_wave_shots
    hits = self.adaptive_wave_hits
    damage = self.adaptive_wave_damage
    accuracy = hits / shots if shots else 0.0
    old_pressure = self.adaptive_pressure
    if damage <= 1 and shots >= 10 and accuracy >= 0.55:
        self.adaptive_pressure = min(ADAPTIVE_PRESSURE_MAX,
                                     self.adaptive_pressure + 1)
    elif damage >= 3 or (shots >= 10 and accuracy < 0.25):
        self.adaptive_pressure = max(0, self.adaptive_pressure - 1)
    if self.adaptive_pressure != old_pressure:
        self.shop_msg += (
            f" Adaptive threat {self.adaptive_pressure}/"
            f"{ADAPTIVE_PRESSURE_MAX} "
            f"({accuracy:.0%} accuracy, {damage} hull lost).")


Game.reset = adaptive_reset

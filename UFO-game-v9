def draw_crate_anim(self, t):
    c = self.c
    a = self.crate_anim
    age = t - a["t0"]
    cr, bk = a["crate"], a["book"]
    en = ENCH_BY_ID[bk["id"]]
    col = RARITY_COL[en["rarity"]]
    bg = "#0b0f26"
    revealed = age >= CRATE_REVEAL_T
    rrect(c, 170, 140, 630, 510, 18, fill=bg,
          outline=col if revealed else cr["trim"], width=3)
    if not revealed:
        k = age / CRATE_REVEAL_T
        lid = max(0.0, (age - (CRATE_REVEAL_T - 0.45)) / 0.45)
        self.draw_crate(400, 320, 2.3, cr, t, 0.3 + 1.8 * k * k, lid,
                        cr["glow"] if k > 0.5 else None)
        c.create_text(400, 180, text=f"Opening {cr['name']}...",
                      fill="#ffffff", font=(FONT, 16, "bold"))
        c.create_text(400, 484, text="click to skip", fill="#6a6f99",
                      font=(FONT, 10))
        return
    if not a["sfx"]:
        a["sfx"] = True
        self.sfx(("buy", "tier2", "clear", "badge", "badge")[en["rarity"]])
    g = age - CRATE_REVEAL_T
    grow = min(1.0, g / 0.5)
    for i in range(18):
        ang = i * math.tau / 18 + t * 0.4
        r0 = 50
        r1 = 50 + (40 + 35 * math.sin(t * 4 + i * 1.3)) * grow
        c.create_line(400 + math.cos(ang) * r0, 285 + math.sin(ang) * r0,
                      400 + math.cos(ang) * r1, 285 + math.sin(ang) * r1,
                      fill=mix(bg, col, 0.7), width=2)
    if g < 0.5:
        p = g / 0.5
        r = 20 + 200 * p
        c.create_oval(400 - r, 285 - r, 400 + r, 285 + r,
                      outline=mix(col, bg, p), width=max(1, 6 * (1 - p)))
    sc = 3.0 * min(1.0, 0.3 + g * 3)
    self.draw_book(400, 285 + math.sin(t * 2.5) * 4, sc, col, t, bg)
    pulse = 0.5 + 0.5 * math.sin(t * 6)
    c.create_text(400, 372, text=f"{RARITIES[en['rarity']].upper()}  BOOK",
                  fill=mix(col, "#ffffff",
                           pulse * 0.5 if en["rarity"] >= 3 else 0),
                  font=(FONT, 12, "bold"))
    shadow_text(c, 400, 400, f"{en['name']} {ROMAN[bk['lvl']]}", "#ffffff",
                (FONT, 26, "bold"))
    c.create_text(400, 434, text=en["desc"](bk["lvl"]), fill="#cfd6ff",
                  font=(FONT, 13))
    if bk["lvl"] == en["max"] and en["max"] > 1:
        c.create_text(400, 456, text="MAX LEVEL", fill="#ffe066",
                      font=(FONT, 10, "bold"))
    c.create_text(400, 486, text="Added to your Library  -  click to continue",
                  fill="#8a93c9", font=(FONT, 10))



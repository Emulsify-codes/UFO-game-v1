def apply_ench_globals(self):
    """Push the equipped books into the tuning constants at the top of the
    script (bounces, beam size, minion stats...). Safe to call any time."""
    global BOUNCE_MAX, BOUNCE_DIRS, MINION_PER_SIDE, MINION_LIFE
    global MINION_FIRE_DELAY, MINION_DMG_SHARE, MINION_MISSILE_SHARE
    global MISSILE_DMG, BEAM_HW, BEAM_DUR, BEAM_TICK_DMG, CHARGE_T, UFO_SPEED
    L = self.ench_lvl
    BOUNCE_MAX = _B_BOUNCE_MAX + 2 * L("rebound") + L("echo")
    BOUNCE_DIRS = _B_BOUNCE_DIRS + 2 * L("scatter")
    MINION_PER_SIDE = _BASE_MINIONS + L("legion")
    MINION_LIFE = _B_MLIFE + 4.0 * L("fuel")
    MINION_FIRE_DELAY = _B_MFIRE * 0.85 ** L("rapid")
    MINION_DMG_SHARE = _B_MDS + 0.15 * L("might")
    MINION_MISSILE_SHARE = _B_MMS + 0.15 * L("might")
    MISSILE_DMG = _B_MDMG * (1 + 0.25 * L("warhead"))
    BEAM_HW = tuple(h * (1 + 0.15 * L("widebeam")) for h in _B_HW)
    BEAM_DUR = tuple(d * (1 + 0.25 * L("lingering")) for d in _B_DUR)
    BEAM_TICK_DMG = tuple(max(1, int(d * (1 + 0.25 * L("focus")) + 0.5))
                          for d in _B_TICK)
    CHARGE_T = tuple(t * 0.92 ** L("quick") for t in _B_CHARGE)
    UFO_SPEED = _B_UFO_SPEED * (1 - 0.06 * L("frost"))



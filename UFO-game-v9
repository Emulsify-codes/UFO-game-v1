class ScaledCanvas(tk.Canvas):
    def __init__(self, *a, **kw):
        super().__init__(*a, **kw)
        self.k = 1.0
        self.ox = 0.0
        self.oy = 0.0
        self._fade_rgb_cache = {}

    def set_view(self, k, ox, oy):
        self.k, self.ox, self.oy = k, ox, oy

    def to_game(self, x, y):
        """Convert window pixels to game coordinates."""
        return (x - self.ox) / self.k, (y - self.oy) / self.k

    def _xy(self, args):
        if len(args) == 1 and isinstance(args[0], (list, tuple)):
            args = args[0]
        return [v * self.k + (self.ox if i % 2 == 0 else self.oy)
                for i, v in enumerate(args)]

    def _kw(self, kw):
        k = self.k
        if k != 1.0:
            if "width" in kw:
                kw["width"] = kw["width"] * k
            if "dash" in kw:
                kw["dash"] = tuple(max(1, int(d * k)) for d in kw["dash"])
            f = kw.get("font")
            if isinstance(f, tuple) and len(f) > 1:
                kw["font"] = (f[0], max(1, round(f[1] * k))) + f[2:]
        fade = getattr(self, "_pan_fade", 1.0)
        if fade < 1.0:
            bg = hex2rgb(BG)
            for option in ("fill", "outline"):
                color = kw.get(option)
                if not isinstance(color, str) or not color:
                    continue
                rgb = self._fade_rgb_cache.get(color)
                if rgb is None:
                    rgb = tuple(round(v / 257) for v in self.winfo_rgb(color))
                    self._fade_rgb_cache[color] = rgb
                kw[option] = "#%02x%02x%02x" % tuple(
                    round(bg[i] + (rgb[i] - bg[i]) * fade)
                    for i in range(3))
        return kw

    def letterbox(self, sw, sh):
        """Cover everything outside the game area with the background colour."""
        rect = tk.Canvas.create_rectangle
        x2, y2 = self.ox + W * self.k, self.oy + H * self.k
        if self.ox > 0.5:
            rect(self, 0, 0, self.ox, sh, fill=BG, outline="")
            rect(self, x2, 0, sw, sh, fill=BG, outline="")
        if self.oy > 0.5:
            rect(self, 0, 0, sw, self.oy, fill=BG, outline="")
            rect(self, 0, y2, sw, sh, fill=BG, outline="")


def _scaled(name):
    base = getattr(tk.Canvas, name)

    def method(self, *args, **kw):
        return base(self, *self._xy(args), **self._kw(kw))
    method.__name__ = name
    return method


for _name in ("create_oval", "create_rectangle", "create_line",
              "create_polygon", "create_text", "create_arc", "create_image"):
    setattr(ScaledCanvas, _name, _scaled(_name))


# --------------------------------------------------------------------------
# sound effects: synthesised at start-up, so no audio files are needed
# --------------------------------------------------------------------------
SR = 22050                  # sample rate of the generated sounds


def _tone(f0, f1, dur, vol=0.5, shape="sine", decay=2.0):
    """One oscillator gliding from f0 to f1 Hz with a fading envelope."""
    n = int(SR * dur)
    att = max(1, int(SR * 0.004))          # tiny fade-in avoids clicks
    out, ph = [], 0.0
    for i in range(n):
        t = i / n
        ph += math.tau * (f0 + (f1 - f0) * t) / SR
        if shape == "square":
            s = 1.0 if math.sin(ph) >= 0 else -1.0
        elif shape == "saw":
            s = (ph / math.tau) % 1.0 * 2 - 1
        elif shape == "tri":
            s = abs((ph / math.tau) % 1.0 * 4 - 2) - 1
        else:
            s = math.sin(ph)
        out.append(s * vol * (1 - t) ** decay * min(1.0, i / att))
    return out


def _note(f, dur, shape="tri", vol=0.5, decay=1.0):
    return _tone(f, f, dur, vol, shape, decay)


def _noise(dur, vol=0.5, decay=2.0, cut0=0.9, cut1=0.1, seed=1):
    """Noise burst. A low-pass filter sweeps from cut0 to cut1 (1 = bright,
    small = dull), which turns hiss into a boom or a thud."""
    rng = random.Random(seed)
    n = int(SR * dur)
    out, y = [], 0.0
    for i in range(n):
        t = i / n
        y += (cut0 + (cut1 - cut0) * t) * (rng.uniform(-1, 1) - y)
        out.append(y * vol * (1 - t) ** decay * min(1.0, i / 40))
    return out


def _mix(*tracks):
    out = [0.0] * max(len(t) for t in tracks)
    for t in tracks:
        for i, s in enumerate(t):
            out[i] += s
    return out


def _seq(*tracks):
    out = []
    for t in tracks:
        out += t
    return out


def _gap(dur):
    return [0.0] * int(SR * dur)


def _norm(x, peak):
    """Scale a clip so its loudest sample is exactly `peak` (0..1)."""
    k = peak / (max((abs(s) for s in x), default=0.0) or 1.0)
    return [s * k for s in x]


def _wav_bytes(samples, volume=1.0):
    pcm = array.array("h", (int(max(-1.0, min(1.0, s * volume)) * 32767)
                            for s in samples))
    if sys.byteorder == "big":
        pcm.byteswap()
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(SR)
        w.writeframes(pcm.tobytes())
    return buf.getvalue()


def _scaled_wav_bytes(raw, volume):
    with wave.open(io.BytesIO(raw), "rb") as source:
        channels = source.getnchannels()
        sample_width = source.getsampwidth()
        rate = source.getframerate()
        frames = source.readframes(source.getnframes())
    if sample_width != 2:
        raise ValueError(f"Unsupported sound sample width: {sample_width}")
    pcm = array.array("h")
    pcm.frombytes(frames)
    if sys.byteorder == "big":
        pcm.byteswap()
    for i, sample in enumerate(pcm):
        pcm[i] = round(sample * volume)
    if sys.byteorder == "big":
        pcm.byteswap()
    buf = io.BytesIO()
    with wave.open(buf, "wb") as output:
        output.setnchannels(channels)
        output.setsampwidth(sample_width)
        output.setframerate(rate)
        output.writeframes(pcm.tobytes())
    return buf.getvalue()



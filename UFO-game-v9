def _feature_draw_scene(self):
    if self.state in ("options", "briefing", "run_summary"):
        c = self.c
        dead = [i for i in c.find_all() if i not in self.bg_ids]
        if dead:
            c.delete(*dead)
        self.draw_stars()
        if self.state == "options":
            draw_feature_options(self)
        elif self.state == "briefing":
            draw_feature_briefing(self)
        else:
            draw_feature_summary(self)
        self.draw_toasts()
        return
    old_shake = self.shake
    if self.reduced_shake:
        self.shake = 0
    try:
        _base_draw_scene(self)
    finally:
        self.shake = old_shake



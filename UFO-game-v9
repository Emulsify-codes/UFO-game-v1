def load_data():
    data = _pets_previous_load_data()
    pets = dict(owned={}, eggs={rarity: 0 for rarity, *_ in PET_RARITIES},
                equipped=None)
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as save_file:
            raw = json.load(save_file)
    except OSError:
        raw = None
    except ValueError:
        raw = None
    saved = raw.get("pets") if isinstance(raw, dict) else None
    if isinstance(saved, dict):
        owned = saved.get("owned")
        if isinstance(owned, dict):
            for pet_id, count in owned.items():
                if pet_id not in PET_BY_ID:
                    continue
                try:
                    count = max(0, int(count))
                except (TypeError, ValueError):
                    continue
                if count:
                    pets["owned"][pet_id] = count
        eggs = saved.get("eggs")
        if isinstance(eggs, dict):
            for rarity in pets["eggs"]:
                try:
                    pets["eggs"][rarity] = max(0, int(eggs.get(rarity, 0)))
                except (TypeError, ValueError):
                    continue
        equipped = saved.get("equipped")
        if isinstance(equipped, str) and equipped in pets["owned"]:
            pets["equipped"] = equipped
    data["pets"] = pets
    return data


def _pets_ensure_data(self):
    if "pets" not in self.data or not isinstance(self.data["pets"], dict):
        self.data["pets"] = dict(owned={}, eggs={r: 0 for r, *_ in PET_RARITIES},
                                 equipped=None)
    pets = self.data["pets"]
    if not isinstance(pets.get("owned"), dict):
        pets["owned"] = {}
    if not isinstance(pets.get("eggs"), dict):
        pets["eggs"] = {}
    for rarity, *_ in PET_RARITIES:
        pets["eggs"].setdefault(rarity, 0)
    if not isinstance(pets.get("equipped"), str) or \
            pets["equipped"] not in pets["owned"]:
        pets["equipped"] = None


def open_pets(self):
    _pets_ensure_data(self)
    self.lb_return = "menu"
    self.pets_tab = "eggs"
    self.pet_rarity = "Common"
    self.pet_scroll = 0
    self.pet_rects = []

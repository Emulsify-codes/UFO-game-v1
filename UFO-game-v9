    def unlock(self, bid):
        badges = self.data["badges"]
        if bid in badges or bid not in BADGE_BY_ID:
            return
        badges[bid] = dict(date=time.strftime("%Y-%m-%d"))
        self.run_badges += 1
        self.sfx("badge")
        self.toasts.append([bid, TOAST_T])
        self.save_ok = save_data(self.data)

    def check_badges(self):
        have = self.data["badges"]
        for b in BADGES:
            if b["id"] not in have and b["test"] and b["test"](self):
                self.unlock(b["id"])

    def progress_objectives(self, event):
        for objective in self.run_objectives:
            if objective["completed"] or objective["event"] != event:
                continue
            objective["progress"] = min(
                objective["target"], objective["progress"] + 1)
            if objective["progress"] < objective["target"]:
                continue
            objective["completed"] = True
            self.score += OBJECTIVE_REWARD_SCORE
            self.credits += OBJECTIVE_REWARD_CREDITS
            self.floaters.append([
                self.px, GROUND - 70,
                f"OBJECTIVE COMPLETE  +{OBJECTIVE_REWARD_SCORE}", 1.5])
            self.sfx("badge")

    def sfx(self, name):
        self.snd.play(name)

    def toggle_sound(self):
        on = self.snd.toggle()
        self.data["settings"]["sound"] = on
        self.sound_toast = 1.6
        save_data(self.data)
        if on:
            self.sfx("click")

    def on_close(self):
        # an unfinished run (playing, in the shop, or paused) still counts
        if self.state in ("play", "shop", "paused") and self.score > 0:
            self.record_run()
        save_data(self.data)
        self.snd.close()
        self.root.destroy()

    def record_run(self):
        """Save the run that just ended to the JSON file."""
        if self.run_saved:          # never save the same run twice
            return
        self.run_saved = True
        self.data["current"] = None     # the checkpoint is no longer needed
        if self.score <= 0:             # nothing worth recording
            self.save_ok = save_data(self.data)
            return
        self.run_gems = int(self.score / 100 + 0.5)    # score / 100, rounded
        self.data["gems"] += self.run_gems
        entry = dict(score=self.score, wave=self.wave,
                     cleared_wave=self.cleared_wave,
                     rank=rank_for_wave(self.cleared_wave),
                     date=time.strftime("%Y-%m-%d %H:%M"),
                     mode=self.run_mode, difficulty=self.difficulty,
                     objectives=sum(o["completed"]
                                    for o in self.run_objectives))
        self.scores.append(entry)
        self.data["runs"] = self.scores
        self.latest = entry
        self.best = max(self.best, self.score)
        self.check_badges()
        self.save_ok = save_data(self.data)

    def sorted_scores(self):
        """Best score first; ties go to the higher wave, then the older run."""
        rows = [r for r in self.scores
                if r.get("mode", "normal") == self.lb_mode_filter
                and r.get("difficulty", "normal")
                == self.lb_difficulty_filter]
        return sorted(rows, key=lambda r: (-r["score"], -r["wave"]))

    def max_lb_scroll(self):
        return max(0, len(self.sorted_scores()) - LB_VISIBLE)

    def scroll_lb(self, d):
        if self.state == "leaderboard":
            self.lb_scroll = min(self.max_lb_scroll(),
                                 max(0, self.lb_scroll + d))
        elif self.state == "badges":
            self.bd_scroll = min(max(0, len(BADGES) - BD_VISIBLE),
                                 max(0, self.bd_scroll + d))
        elif self.state == "skins":
            n = len(SKIN_CATS[self.skin_tab][0])
            self.skin_scroll = min(max(0, n - SK_VISIBLE),
                                   max(0, self.skin_scroll + d))
        elif self.state == "index":
            self.index_scroll = min(max(0, len(UFO_SPECS) - INDEX_VISIBLE),
                                    max(0, self.index_scroll + d))
        elif self.state == "enchantments":
            self.enchantment_scroll = min(
                max(0, len(self.enchantment_entries()) - INDEX_VISIBLE),
                max(0, self.enchantment_scroll + d))


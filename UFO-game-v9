def _feature_controls(self):
    controls = dict(CONTROL_DEFAULTS)
    saved = self.data["settings"].get("controls", {})
    if isinstance(saved, dict):
        values = [saved.get(action, key) for action, key in controls.items()]
        valid_keys = set("abcdefghijklmnopqrstuvwxyz0123456789")
        valid_keys.update(("left", "right", "up", "down", "space"))
        if all(isinstance(key, str) and
               (key in valid_keys) for key in values) \
                and len(set(values)) == len(values):
            controls.update(dict(zip(controls, values)))
    return controls



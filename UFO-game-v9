# SHOCKWAVE  (paste this whole block into ufo_shooter.py, directly ABOVE the
# line:   if __name__ == "__main__":
# It must come AFTER the DESTROYER + EXTERMINATOR block.)
#
# S (during a run) = the gun sends out shockwaves for SHOCK_DURATION seconds.
# Every SHOCK_INTERVAL seconds a new ring expands from the gun in ALL
# directions. Rings damage every UFO they sweep over (once per ring), pass
# straight through UFOs, and do not bounce off walls - they just keep
# expanding until they are off screen.
#
# NOTE: S used to toggle sound. While you are playing, S is now Shockwave;
# in the menus S still toggles sound (and so does the SOUND button).
# ==========================================================================
SHOCK_DURATION = 3.0        # seconds the gun keeps emitting shockwaves
SHOCK_INTERVAL = 0.4        # seconds between rings
SHOCK_CD = 25.0             # seconds from activation until it can be used again
SHOCK_SPEED = 430           # how fast a ring expands, px / second
SHOCK_MAX_R = 950           # ring vanishes at this radius
SHOCK_DMG_BASE = 3          # ring damage = (base + 0.5 * your damage) * power
SHOCK_COL = "#7fe8ff"

# ---- sound -----------------------------------------------------------------
_sh_build_sounds = build_sounds


def build_sounds():
    S = _sh_build_sounds()
    S["shock"] = _norm(_mix(_tone(240, 60, 0.35, 0.6, "sine", 1.2),
                            _tone(900, 200, 0.18, 0.3, "saw", 1.5),
                            _noise(0.2, 0.5, 2.0, 0.4, 0.05, 53)), 0.45)
    return S


SFX_META["shock"] = (2, 0.2, 2)

# ---- originals we wrap -----------------------------------------------------
_sh_reset = Game.reset
_sh_clear_field = Game.clear_field
_sh_update = Game.update
_sh_key_down = Game.on_key_down
_sh_draw_beams = Game.draw_beams
_sh_draw_hud = Game.draw_hud


def sh_reset(self):
    _sh_reset(self)
    self.shock_cd = 0.0
    self.shock_t = 0.0
    self.shock_emit = 0.0
    self.shocks = []


def sh_clear_field(self):
    _sh_clear_field(self)
    self.shocks = []
    self.shock_t = 0.0


def fire_shock(self):
    if self.shock_cd > 0 or self.shock_t > 0:
        self.sfx("deny")
        return
    k = max(0.2, 1 - 0.08 * self.ench_lvl("cooldown"))
    self.shock_cd = SHOCK_CD * k
    self.shock_t = SHOCK_DURATION
    self.shock_emit = 0.0
    self.shake = max(self.shake, 0.15)


def update_shock(self, dt):
    self.shock_cd = max(0.0, self.shock_cd - dt)
    # emit new rings from the gun while the ability is active
    if self.shock_t > 0:
        self.shock_t -= dt
        self.shock_emit -= dt
        if self.shock_emit <= 0:
            self.shock_emit += SHOCK_INTERVAL
            self.shocks.append(dict(x=self.px, y=GROUND - 20, r=0.0,
                                    prev=0.0, hit=set()))
            self.recoil = max(self.recoil, 4.0)
            self.sfx("shock")
    # expand rings and damage whatever they sweep over
    dmg = max(1, round((SHOCK_DMG_BASE + 0.5 * self.damage) * self.power))
    for s in self.shocks:
        s["prev"] = s["r"]
        s["r"] += SHOCK_SPEED * dt
        for u in self.ufos:
            if u["dead"] or u["mode"] == "dying" or u["y"] < -20 \
                    or id(u) in s["hit"]:
                continue
            size = UFO_SPECS[u["kind"]]["size"] * 0.9
            d = math.hypot(u["x"] - s["x"], u["y"] - s["y"])
            # swept test, so a fast ring can't skip over a UFO
            if d + size >= s["prev"] and d - size <= s["r"]:
                s["hit"].add(id(u))
                self.explode(u["x"], u["y"], SHOCK_COL, 6, 150)
                self.hurt_ufo(u, dmg, "shock")
    self.shocks = [s for s in self.shocks if s["r"] < SHOCK_MAX_R]
    self.ufos = [u for u in self.ufos if not u["dead"]]


def sh_update(self, dt):
    _sh_update(self, dt)
    if self.state == "play":
        self.update_shock(dt)
    elif self.state != "paused":
        self.shocks = []
        self.shock_t = 0.0


def sh_key_down(self, e):
    if self.state == "play" and e.keysym.lower() == "s":
        self.keys.add("s")
        self.fire_shock()
        return
    _sh_key_down(self, e)


def sh_draw_beams(self, ox, oy):
    _sh_draw_beams(self, ox, oy)
    self.draw_shocks(ox, oy)


def draw_shocks(self, ox, oy):
    c = self.c
    for s in self.shocks:
        p = min(1.0, s["r"] / SHOCK_MAX_R)
        r = max(2.0, s["r"])
        x, y = s["x"] + ox, s["y"] + oy
        # soft outer band, bright middle, white core
        c.create_oval(x - r - 7, y - r - 7, x + r + 7, y + r + 7,
                      outline=fade(SHOCK_COL, y, 0.75 + 0.2 * p), width=8)
        c.create_oval(x - r - 2, y - r - 2, x + r + 2, y + r + 2,
                      outline=fade(SHOCK_COL, y, 0.35 + 0.5 * p), width=4)
        c.create_oval(x - r, y - r, x + r, y + r,
                      outline=fade("#ffffff", y, 0.2 + 0.7 * p), width=2)


def sh_draw_hud(self):
    _sh_draw_hud(self)
    c = self.c
    rrect(c, 8, 156, 160, 178, 9, fill="#0b0f26", outline="#3a4690", width=2)
    active = self.shock_t > 0
    ready = self.shock_cd <= 0
    c.create_text(16, 167, anchor="w",
                  fill=SHOCK_COL if (ready or active) else "#8a93c9",
                  font=(FONT, 9, "bold"),
                  text=f"[S] {self.shock_t:.1f}s" if active else "[S] SHOCK")
    c.create_rectangle(88, 163, 150, 171, fill="#171c3e", outline="")
    if active:
        frac, col = self.shock_t / SHOCK_DURATION, SHOCK_COL
    else:
        frac = 1.0 if ready else 1 - self.shock_cd / SHOCK_CD
        col = "#7CFC00" if ready else "#4da6ff"
    c.create_rectangle(88, 163, 88 + 62 * frac, 171, fill=col, outline="")



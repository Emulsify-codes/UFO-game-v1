def kill_ufo(self, u, src=None):
    c0 = self.credits
    _o_kill_ufo(self, u, src)
    f = self.ench_lvl("fortune")
    if f:
        self.credits += round((self.credits - c0) * 0.10 * f)
    ls = self.ench_lvl("lifesteal")
    if ls and 0 < self.hp < self.max_hp and random.random() < 0.03 * ls:
        self.hp += 1
        self.floaters.append([u["x"], u["y"] - 20, "+1 HULL", 0.9])


def hurt_player(self, dmg):
    if self.inv <= 0 and self.ench_lvl("wind") and not self.wind_used \
            and self.hp - dmg <= 0:
        self.wind_used = True
        self.wave_hit = True
        self.hp = max(1, self.max_hp // 2)
        self.inv = 2.0
        self.shake = 0.4
        self.hit_flash = 0.5
        self.flash_col = "#ffd24d"
        self.explode(self.px, GROUND, "#ffd24d", 30, 320)
        self.rings.append([self.px, GROUND, 150, 0.6, 0.6, "#ffd24d"])
        self.floaters.append([self.px, GROUND - 70, "SECOND WIND!", 1.4])
        self.sfx("repair")
        return
    _o_hurt_player(self, dmg)


def record_run(self):
    was = self.run_saved
    _o_record_run(self)
    m = self.ench_lvl("magnet")
    if not was and m and self.run_gems > 0:
        extra = round(self.run_gems * 0.15 * m)
        if extra:
            self.run_gems += extra
            self.data["gems"] += extra
            self.save_ok = save_data(self.data)
    self.award_level_crates()


# ---- crate logic ----------------------------------------------------------
def award_level_crates(self):
    """Add one free Ancient Crate for each newly reached lifetime level."""
    ench = self.data["ench"]
    level = self.level_progress[0]
    gained = level - ench["level_reward_level"]
    if gained <= 0:
        return 0
    ench["level_reward_level"] = level
    ench["free_ancient"] += gained
    if self.state == "play":
        crate_label = "CRATE" if gained == 1 else "CRATES"
        self.floaters.append(
            [self.px, GROUND - 70, f"+{gained} ANCIENT {crate_label}", 1.4])
    self.save_ok = save_data(self.data)
    return gained


def crate_books(self):
    return sorted(self.data["ench"]["books"],
                  key=lambda b: (-ENCH_BY_ID[b["id"]]["rarity"],
                                 ENCH_BY_ID[b["id"]]["name"], -b["lvl"]))


def find_book(self, uid):
    return next((b for b in self.data["ench"]["books"] if b["uid"] == uid),
                None)


def can_combine(self, b):
    if b["lvl"] >= ENCH_BY_ID[b["id"]]["max"]:
        return False
    return any(o is not b and o["id"] == b["id"] and o["lvl"] == b["lvl"]
               for o in self.data["ench"]["books"])


def open_crates(self):
    self.sfx("click")
    self.lb_return = "menu"
    self.crate_tab = "shop"
    self.crate_page = 0
    self.crate_msg = ""
    self.crate_scroll = 0
    self.crate_anim = None
    self.state = "crates"


def leave_crates(self):
    self.crate_anim = None
    self.close_leaderboard()


def open_crate(self, cid):
    if self.crate_anim:
        return
    cr = CRATE_BY_ID[cid]
    ench = self.data["ench"]
    use_free_crate = cid == "ancient" and ench["free_ancient"] > 0
    if not use_free_crate and self.data["gems"] < cr["cost"]:
        self.crate_msg = f"Not enough gems - you need {cr['cost'] - self.data['gems']} more."
        self.sfx("deny")
        return
    if use_free_crate:
        ench["free_ancient"] -= 1
    else:
        self.data["gems"] -= cr["cost"]
    rar = random.choices(range(len(cr["weights"])), weights=cr["weights"])[0]
    en = random.choice([x for x in ENCHANTS if x["rarity"] == rar])
    lvl = 1
    while lvl < en["max"] and random.random() < cr["lvl_p"]:
        lvl += 1
    e = ench
    book = dict(uid=e["nuid"], id=en["id"], lvl=lvl)
    e["nuid"] += 1
    e["opened"] += 1
    e["books"].append(book)
    self.save_ok = save_data(self.data)     # saved before the animation
    self.crate_msg = ""
    self.crate_anim = dict(t0=time.time(), crate=cr, book=book, sfx=False)
    self.sfx("chargeup")


def equip_book(self, uid):
    e = self.data["ench"]
    b = self.find_book(uid)
    if b is None:
        return
    name = f"{ENCH_BY_ID[b['id']]['name']} {ROMAN[b['lvl']]}"
    if uid in e["equipped"]:
        e["equipped"].remove(uid)
        self.crate_msg = f"Unequipped {name}."
        self.sfx("click")
    else:
        for u2 in list(e["equipped"]):          # same enchantment: swap
            b2 = self.find_book(u2)
            if b2 and b2["id"] == b["id"]:
                e["equipped"].remove(u2)
        if len(e["equipped"]) >= ENCH_SLOTS:
            self.crate_msg = f"All {ENCH_SLOTS} slots are full - unequip a book first."
            self.sfx("deny")
            return
        e["equipped"].append(uid)
        self.crate_msg = f"Equipped {name}."
        self.sfx("buy")
    self._ench_cache = None
    self.save_ok = save_data(self.data)


def combine_book(self, uid):
    e = self.data["ench"]
    b = self.find_book(uid)
    if b is None:
        return
    en = ENCH_BY_ID[b["id"]]
    if b["lvl"] >= en["max"]:
        self.crate_msg = f"{en['name']} is already at max level."
        self.sfx("deny")
        return
    other = next((o for o in e["books"] if o is not b and o["id"] == b["id"]
                  and o["lvl"] == b["lvl"]), None)
    if other is None:
        self.crate_msg = "You need two identical books to combine."
        self.sfx("deny")
        return
    was_eq = b["uid"] in e["equipped"] or other["uid"] in e["equipped"]
    e["equipped"] = [u for u in e["equipped"] if u not in (b["uid"], other["uid"])]
    e["books"] = [x for x in e["books"] if x is not b and x is not other]
    new = dict(uid=e["nuid"], id=b["id"], lvl=b["lvl"] + 1)
    e["nuid"] += 1
    e["books"].append(new)
    if was_eq:
        e["equipped"].append(new["uid"])
    self.crate_msg = f"Combined into {en['name']} {ROMAN[new['lvl']]}!"
    self._ench_cache = None
    self.sfx("badge")
    self.save_ok = save_data(self.data)


def crate_dismiss(self):
    """Click / key while a crate is opening: skip ahead, then dismiss."""
    a = self.crate_anim
    if not a:
        return False
    age = time.time() - a["t0"]
    if age < CRATE_REVEAL_T:
        a["t0"] -= CRATE_REVEAL_T - age
    elif age > CRATE_REVEAL_T + 0.35:
        self.crate_anim = None
        self.sfx("click")
    return True


def crate_key(self, k):
    if self.crate_dismiss():
        return
    if k in ("escape", "backspace"):
        self.leave_crates()
    elif k in ("left", "right", "tab"):
        self.crate_tab = "library" if self.crate_tab == "shop" else "shop"
        self.crate_scroll = 0
        self.crate_msg = ""
        self.sfx("click")
    elif self.crate_tab == "shop" and k in ("next", "n"):
        self.crate_page = min(CRATE_PAGE_COUNT - 1, self.crate_page + 1)
        self.sfx("click")
    elif self.crate_tab == "shop" and k in ("prior", "p"):
        self.crate_page = max(0, self.crate_page - 1)
        self.sfx("click")
    elif k == "up":
        self.scroll_lb(-1)
    elif k == "down":
        self.scroll_lb(1)
    elif k == "prior":
        self.scroll_lb(-CR_ROWS)
    elif k == "next":
        self.scroll_lb(CR_ROWS)
    elif k.replace("kp_", "").isdigit():
        i = int(k.replace("kp_", "")) - 1
        if self.crate_tab == "shop":
            page_crates = CRATES[
                self.crate_page * CRATES_PER_PAGE:
                (self.crate_page + 1) * CRATES_PER_PAGE]
            if 0 <= i < len(page_crates):
                self.open_crate(page_crates[i]["id"])
        else:
            rows = self.crate_books()
            j = self.crate_scroll + i
            if 0 <= i < CR_ROWS and j < len(rows):
                self.equip_book(rows[j]["uid"])


def crate_click(self, x, y):
    if self.crate_dismiss():
        return
    key = self.hit(self.crate_rects, x, y)
    if key == "back":
        self.leave_crates()
    elif isinstance(key, tuple):
        kind, val = key
        if kind == "tab":
            if val != self.crate_tab:
                self.crate_tab = val
                self.crate_scroll = 0
                self.crate_msg = ""
                self.sfx("click")
        elif kind == "crate":
            self.open_crate(val)
        elif kind == "page":
            self.crate_page = min(
                CRATE_PAGE_COUNT - 1, max(0, self.crate_page + val))
            self.crate_msg = ""
            self.sfx("click")
        elif kind in ("equip", "slot"):
            self.equip_book(val)
        elif kind == "combine":
            self.combine_book(val)


# ---- input wrappers -------------------------------------------------------
def on_key_down(self, e):
    k = e.keysym.lower()
    if self.state == "crates":
        self.keys.add(k)
        if k in ("f11", "f"):
            self.set_fullscreen(not self.fullscreen)
        elif k == "s":
            self.toggle_sound()
        elif k == "escape" and self.fullscreen:
            self.set_fullscreen(False)
        else:
            self.crate_key(k)
        return
    if self.state == "menu" and k == "c":
        self.keys.add(k)
        self.open_crates()
        return
    _o_key_down(self, e)


def on_click(self, e):
    if self.state == "crates":
        self.mouse_x, self.mouse_y = self.c.to_game(e.x, e.y)
        self.crate_click(self.mouse_x, self.mouse_y)
        return
    if self.state == "menu":
        x, y = self.c.to_game(e.x, e.y)
        if self.hit(self.menu_rects, x, y) == "crates":
            self.mouse_x, self.mouse_y = x, y
            self.open_crates()
            return
    _o_click(self, e)


def scroll_lb(self, d):
    if self.state == "crates":
        if self.crate_tab == "library":
            n = len(self.data["ench"]["books"])
            self.crate_scroll = min(max(0, n - CR_ROWS),
                                    max(0, self.crate_scroll + d))
        return
    _o_scroll(self, d)



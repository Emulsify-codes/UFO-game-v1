# NEAR MISS BONUS
# ==========================================================================
NEAR_MISS_CREDITS = 10
NEAR_MISS_RADIUS = 38        # closest-approach distance that counts (a real
                             # hit is 24 px, so this is a 14 px window)
NEAR_MISS_COOLDOWN = 0.35    # seconds between payouts

_nm_reset = Game.reset
_nm_update = Game.update


def _nm_closest(px, py, ax, ay, bx, by):
    """Shortest distance from point P to the segment A -> B."""
    dx, dy = bx - ax, by - ay
    L2 = dx * dx + dy * dy
    t = 0.0 if L2 == 0 else max(0.0, min(1.0, ((px - ax) * dx
                                               + (py - ay) * dy) / L2))
    return math.hypot(px - (ax + dx * t), py - (ay + dy * t))


def nm_reset(self):
    _nm_reset(self)
    self._nm_track = {}      # id(bullet) -> [prev x, prev y, closest so far]
    self._nm_cd = 0.0


def nm_update(self, dt):
    _nm_update(self, dt)
    if self.state != "play":
        self._nm_track = {}
        return
    self._nm_cd = max(0.0, self._nm_cd - dt)
    cx, cy = self.px, GROUND + 8        # same point the hit test uses
    old = self._nm_track
    new = {}
    for e in self.ebullets:
        key = id(e)
        px_, py_, best, passed = old.get(key, (e[0], e[1], 1e9, False))
        if passed:                      # already judged: never pay twice
            new[key] = [e[0], e[1], best, True]
            continue
        best = min(best, _nm_closest(cx, cy, px_, py_, e[0], e[1]))
        if e[1] >= cy and e[3] > 0:     # the bullet has flown past the gun
            if best <= NEAR_MISS_RADIUS and self._nm_cd <= 0:
                self.credits += NEAR_MISS_CREDITS
                self._nm_cd = NEAR_MISS_COOLDOWN
                self.floaters.append([cx, GROUND - 60,
                                      f"NEAR MISS  +{NEAR_MISS_CREDITS}c",
                                      0.9])
                self.rings.append([e[0], e[1], 22, 0.2, 0.2, "#ffe066"])
                self.sfx("buy")
            new[key] = [e[0], e[1], best, True]   # done with this bullet
            continue
        new[key] = [e[0], e[1], best, False]
    # bullets that hit you, were destroyed or left the screen simply vanish
    # from the list, so they are dropped here without a payout
    self._nm_track = new


Game._nm_track = {}

def load_data():
    """Read runs, badges and lifetime stats. Missing/corrupt file = fresh start."""
    data = dict(runs=[], badges={}, stats={}, discovered_ufos=[], current=None,
                settings=dict(sound=True, volume=100, reduced_shake=False,
                              high_contrast=False, reduce_flashes=False,
                              large_hud_text=False, tutorial_done=False,
                              controls={}), gems=0,
                quests={},
                skins=dict(bullets=["default"], guns=["standard"],
                           missiles=["classic"], bullet="default",
                           gun="standard", missile="classic"))
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except OSError:
        return data
    except ValueError:                      # corrupt file: keep a copy, start fresh
        try:
            os.replace(SAVE_FILE, SAVE_FILE + ".corrupt")
        except OSError:
            pass
        return data
    if isinstance(raw, list):               # very old format: just a run list
        raw = {"runs": raw}
    if not isinstance(raw, dict):
        return data
    quests = raw.get("quests")
    if isinstance(quests, dict):
        data["quests"] = quests
    for r in raw.get("runs", []) if isinstance(raw.get("runs"), list) else []:
        if isinstance(r, dict):
            try:
                wave = int(r["wave"])
                cleared_wave = int(r.get("cleared_wave", wave))
                mode = r.get("mode")
                difficulty = r.get("difficulty")
                try:
                    objectives = max(0, min(3, int(r.get("objectives", 0))))
                except (TypeError, ValueError):
                    objectives = 0
                data["runs"].append(dict(
                    score=int(r["score"]), wave=wave,
                    cleared_wave=cleared_wave,
                    rank=rank_for_wave(cleared_wave),
                    date=str(r.get("date", "")),
                    mode=mode if mode in ("normal", "infinity", "adaptive") else "normal",
                    difficulty=difficulty
                    if isinstance(difficulty, str)
                    and difficulty in DIFFICULTIES else "normal",
                    objectives=objectives))
            except (KeyError, TypeError, ValueError):
                continue
    badges = raw.get("badges")
    if isinstance(badges, dict):
        for k, v in badges.items():
            date = v.get("date", "") if isinstance(v, dict) else ""
            data["badges"][str(k)] = dict(date=str(date))
    stats = raw.get("stats")
    if isinstance(stats, dict):
        for k, v in stats.items():
            try:
                data["stats"][str(k)] = int(v)
            except (TypeError, ValueError):
                continue
    discovered = raw.get("discovered_ufos")
    if isinstance(discovered, list):
        for kind in discovered:
            if isinstance(kind, str) and kind in UFO_SPECS \
                    and kind not in data["discovered_ufos"]:
                data["discovered_ufos"].append(kind)
    for kind in UFO_SPECS:
        if data["stats"].get("kill_" + kind, 0) > 0 \
                and kind not in data["discovered_ufos"]:
            data["discovered_ufos"].append(kind)
    settings = raw.get("settings")
    if isinstance(settings, dict):
        data["settings"]["sound"] = bool(settings.get("sound", True))
        try:
            data["settings"]["volume"] = max(
                0, min(100, int(settings.get("volume", 100))))
        except (TypeError, ValueError):
            pass
        data["settings"]["reduced_shake"] = bool(
            settings.get("reduced_shake", False))
        data["settings"]["high_contrast"] = bool(
            settings.get("high_contrast", False))
        data["settings"]["reduce_flashes"] = bool(
            settings.get("reduce_flashes", False))
        data["settings"]["large_hud_text"] = bool(
            settings.get("large_hud_text", False))
        data["settings"]["tutorial_done"] = bool(
            settings.get("tutorial_done", False))
        controls = settings.get("controls")
        if isinstance(controls, dict):
            data["settings"]["controls"] = {
                str(action): str(key).lower()
                for action, key in controls.items()
                if isinstance(action, str) and isinstance(key, str)
                and len(key) <= 12}
    try:
        data["gems"] = max(0, int(raw.get("gems", 0)))
    except (TypeError, ValueError):
        pass
    sk = raw.get("skins")
    if isinstance(sk, dict):
        for cat, (_lst, table, key, dflt) in SKIN_CATS.items():
            lst = sk.get(cat)
            owned = [dflt]
            if isinstance(lst, list):
                owned += [s for s in lst if isinstance(s, str)
                          and s in table and s != dflt and s not in owned]
            data["skins"][cat] = owned
            eq = sk.get(key)
            data["skins"][key] = eq if eq in owned else dflt
    # a run that was checkpointed but never finished (game killed mid-run)
    cur = raw.get("current")
    if isinstance(cur, dict):
        try:
            score, wave = int(cur["score"]), int(cur["wave"])
            cleared_wave = int(cur.get("cleared_wave", wave))
            if score > 0:
                mode = cur.get("mode")
                difficulty = cur.get("difficulty")
                try:
                    objectives = max(
                        0, min(3, int(cur.get("objectives", 0))))
                except (TypeError, ValueError):
                    objectives = 0
                data["runs"].append(dict(
                    score=score, wave=wave, cleared_wave=cleared_wave,
                    rank=rank_for_wave(cleared_wave),
                    date=str(cur.get("date", "")),
                    mode=mode if mode in ("normal", "infinity", "adaptive") else "normal",
                    difficulty=difficulty
                    if isinstance(difficulty, str)
                    and difficulty in DIFFICULTIES else "normal",
                    objectives=objectives))
                data["gems"] += int(score / 100 + 0.5)
        except (KeyError, TypeError, ValueError):
            pass
    return data


def save_data(data):
    """Write atomically so a crash can't leave a half-written file."""
    tmp = SAVE_FILE + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, SAVE_FILE)
        return True
    except OSError:
        return False



    def enchantment_entries(self):
        owned = {book["id"] for book in self.data["ench"]["books"]}
        if self.enchantment_filter == "owned":
            return [en for en in ENCHANTS if en["id"] in owned]
        if self.enchantment_filter == "missing":
            return [en for en in ENCHANTS if en["id"] not in owned]
        return ENCHANTS

    def skin_click(self, cat, sid):
        """Equip a skin, or buy it (and equip it) if it isn't owned yet."""
        if cat not in SKIN_CATS:
            return
        _lst, table, key, _dflt = SKIN_CATS[cat]
        sk = table.get(sid)
        if sk is None:
            return
        sd = self.data["skins"]
        if sid in sd[cat]:
            if sd[key] == sid:
                self.skin_msg = f"{sk['name']} is already equipped."
                return
            sd[key] = sid
            self.skin_msg = f"Equipped {sk['name']}."
            self.sfx("click")
        elif self.data["gems"] >= sk["cost"]:
            self.data["gems"] -= sk["cost"]
            sd[cat].append(sid)
            sd[key] = sid
            self.skin_msg = f"Bought and equipped {sk['name']}!"
            self.sfx("buy")
        else:
            need = sk["cost"] - self.data["gems"]
            self.skin_msg = f"Not enough gems - you need {need} more."
            self.sfx("deny")
            return
        self.save_ok = save_data(self.data)

    def open_leaderboard(self, came_from):
        self.sfx("click")
        self.lb_return = came_from
        self.lb_scroll = 0
        if self.latest is not None and came_from in ("gameover", "victory"):
            self.lb_mode_filter = self.latest.get("mode", "normal")
            self.lb_difficulty_filter = self.latest.get("difficulty", "normal")
            rows = self.sorted_scores()
            for i, r in enumerate(rows):
                if r is self.latest and i >= LB_VISIBLE:
                    self.lb_scroll = min(self.max_lb_scroll(),
                                         i - LB_VISIBLE + 1)
                    break
        self.state = "leaderboard"

    def close_leaderboard(self):
        self.sfx("click")
        self.state = self.lb_return
        self.last = time.time()

    def go_menu(self):
        if self.state in ("play", "shop", "paused") and self.score > 0:
            self.record_run()

        self.clear_field()
        self.cancel_charge()
        self.mouse_down = False
        self.sfx("click")
        self.state = "menu"
        self.last = time.time()

    @staticmethod
    def hit(rects, x, y):
        for x1, y1, x2, y2, key in rects:
            if x1 <= x <= x2 and y1 <= y <= y2:
                return key
        return None

    # ------------------------------------------------------------------
    # input
    # ------------------------------------------------------------------
    def on_key_down(self, e):
        k = e.keysym.lower()
        self.keys.add(k)
        if k in ("f11", "f"):
            self.set_fullscreen(not self.fullscreen)
            return
        if k == "s":
            self.toggle_sound()
            return
        if k == "escape" and self.fullscreen and \
                self.state in ("menu", "mode_select", "difficulty_select",
                               "play", "paused", "shop"):
            self.set_fullscreen(False)
            return
        if self.state == "menu":
            if k in ("return", "space"):
                self.show_mode_select()
            elif k == "l":
                self.open_leaderboard("menu")
            elif k == "b":
                self.open_badges()
            elif k == "k":
                self.open_skins()
            elif k == "i":
                self.open_index()
            elif k == "e":
                self.open_enchantments()
            elif k == "g":
                self.open_levels()
        elif self.state == "mode_select":
            if k in ("escape", "backspace"):
                self.state = "menu"
                self.sfx("click")
            elif k in ("return", "space", "n"):
                self.show_difficulty_select("normal")
            elif k == "i":
                self.show_difficulty_select("infinity")
            elif k == "a":
                self.show_difficulty_select("adaptive")
        elif self.state == "difficulty_select":
            if k in ("escape", "backspace"):
                self.state = "mode_select"
                self.sfx("click")
            else:
                difficulty_keys = {
                    "1": "easy", "e": "easy",
                    "2": "normal", "n": "normal",
                    "3": "hard", "h": "hard",
                    "4": "nightmare", "m": "nightmare",
                }
                difficulty = difficulty_keys.get(k)
                if difficulty:
                    self.start_game(self.selected_run_mode, difficulty)
        elif self.state == "skins":
            if k in ("escape", "backspace", "b", "return"):
                self.close_leaderboard()
            elif k in ("left", "right", "tab"):
                step = -1 if k == "left" else 1
                i = (SKIN_TABS.index(self.skin_tab) + step) % len(SKIN_TABS)
                self.skin_tab = SKIN_TABS[i]
                self.skin_scroll = 0
                self.sfx("click")
            elif k == "up":
                self.scroll_lb(-1)
            elif k == "down":
                self.scroll_lb(1)
            elif k == "prior":
                self.scroll_lb(-SK_VISIBLE)
            elif k == "next":
                self.scroll_lb(SK_VISIBLE)
            elif k.replace("kp_", "").isdigit():
                # number keys pick one of the rows currently on screen
                i = int(k.replace("kp_", "")) - 1 + self.skin_scroll
                lst = SKIN_CATS[self.skin_tab][0]
                if self.skin_scroll <= i < min(len(lst),
                                               self.skin_scroll + SK_VISIBLE):
                    self.skin_click(self.skin_tab, lst[i]["id"])
        elif self.state in ("leaderboard", "badges"):
            page = LB_VISIBLE if self.state == "leaderboard" else BD_VISIBLE
            if k in ("escape", "backspace", "return", "b"):
                self.close_leaderboard()
            elif k == "up":
                self.scroll_lb(-1)
            elif k == "down":
                self.scroll_lb(1)
            elif k == "prior":
                self.scroll_lb(-page)
            elif k == "next":
                self.scroll_lb(page)
        elif self.state == "index":
            if k in ("escape", "backspace", "return", "b", "i"):
                self.close_leaderboard()
            elif k == "up":
                self.scroll_lb(-1)
            elif k == "down":
                self.scroll_lb(1)
            elif k == "prior":
                self.scroll_lb(-INDEX_VISIBLE)
            elif k == "next":
                self.scroll_lb(INDEX_VISIBLE)
        elif self.state == "enchantments":
            if k in ("escape", "backspace", "return", "b", "e"):
                self.close_leaderboard()
            elif k == "up":
                self.scroll_lb(-1)
            elif k == "down":
                self.scroll_lb(1)
            elif k == "prior":
                self.scroll_lb(-INDEX_VISIBLE)
            elif k == "next":
                self.scroll_lb(INDEX_VISIBLE)
        elif self.state == "levels":
            if k in ("escape", "backspace", "return", "b", "g"):
                self.close_leaderboard()
        elif self.state == "shop":
            if k in ("return", "space"):
                self.start_wave()
            elif k.replace("kp_", "").isdigit():      # number row or keypad
                i = int(k.replace("kp_", "")) - 1
                if 0 <= i < len(UPGRADES):
                    self.buy(UPGRADES[i][0])
                elif i == len(UPGRADES):
                    self.buy("repair")
        elif self.state == "gameover":
            if k in ("r", "return"):
                self.start_game(self.run_mode, self.difficulty)
            elif k in ("m", "escape"):
                self.go_menu()
            elif k == "l":
                self.open_leaderboard("gameover")
        elif self.state == "victory":
            if k in ("r", "return"):
                self.start_game(self.run_mode, self.difficulty)
            elif k in ("m", "escape"):
                self.go_menu()
            elif k == "l":
                self.open_leaderboard("victory")
        elif self.state == "play" and k == "t":
            self.fire_missile()
        elif self.state == "play" and k == "b":
            self.fire_bounce()
        elif self.state == "play" and k == "m":
            self.summon_minions()
        elif self.state == "play" and k == "v":
            self.begin_charge()
        elif self.state in ("play", "paused") and k == "p":
            self.state = "paused" if self.state == "play" else "play"
            self.cancel_charge()
            self.sfx("pause")
            self.last = time.time()

    def on_key_up(self, e):
        k = e.keysym.lower()
        self.keys.discard(k)
        if k == "v" and self.charging:
            # Some systems send a fake release between auto-repeated key
            # presses, so the release is only acted on if no new press follows
            # right away (see update_charge).
            self.charge_up_t = time.time()

    def on_motion(self, e):
        self.mouse_x, self.mouse_y = self.c.to_game(e.x, e.y)
        if self.state == "play":
            self.px = min(W - 25, max(25, self.mouse_x))

    def on_wheel(self, e):
        if e.delta:
            self.scroll_lb(-1 if e.delta > 0 else 1)

    def on_click(self, e):
        self.mouse_down = True
        self.mouse_x, self.mouse_y = self.c.to_game(e.x, e.y)
        if self.state == "menu":
            key = self.hit(self.menu_rects, self.mouse_x, self.mouse_y)
            if key == "play":
                self.show_mode_select()
            elif key == "board":
                self.open_leaderboard("menu")
            elif key == "badges":
                self.open_badges()
            elif key == "skins":
                self.open_skins()
            elif key == "index":
                self.open_index()
            elif key == "enchantments":
                self.open_enchantments()
            elif key == "levels":
                self.open_levels()
            elif key == "sound":
                self.toggle_sound()
        elif self.state == "mode_select":
            key = self.hit(self.mode_rects, self.mouse_x, self.mouse_y)
            if key == "normal":
                self.show_difficulty_select("normal")
            elif key == "infinity":
                self.show_difficulty_select("infinity")
            elif key == "adaptive":
                self.show_difficulty_select("adaptive")
            elif key == "back":
                self.state = "menu"
                self.sfx("click")
        elif self.state == "difficulty_select":
            key = self.hit(self.difficulty_rects, self.mouse_x, self.mouse_y)
            if key in DIFFICULTIES:
                self.start_game(self.selected_run_mode, key)
            elif key == "back":
                self.state = "mode_select"
                self.sfx("click")
        elif self.state == "skins":
            key = self.hit(self.skin_rects, self.mouse_x, self.mouse_y)
            if key == "back":
                self.close_leaderboard()
            elif isinstance(key, tuple):
                if key[0] == "tab":
                    if key[1] != self.skin_tab:
                        self.skin_tab = key[1]
                        self.skin_scroll = 0
                        self.sfx("click")
                else:
                    self.skin_click(self.skin_tab, key[1])
        elif self.state in ("leaderboard", "badges", "index",
                            "enchantments", "levels"):
            rects = (self.index_rects if self.state == "index" else
                     self.enchantment_rects if self.state == "enchantments"
                     else self.lb_rects)
            key = self.hit(rects, self.mouse_x, self.mouse_y)
            if self.state == "leaderboard" and isinstance(key, tuple):
                if key[0] == "mode":
                    self.lb_mode_filter = key[1]
                    self.lb_scroll = 0
                    self.sfx("click")
                elif key[0] == "difficulty":
                    self.lb_difficulty_filter = key[1]
                    self.lb_scroll = 0
                    self.sfx("click")
            elif self.state == "enchantments" and isinstance(key, tuple) \
                    and key[0] == "filter":
                self.enchantment_filter = key[1]
                self.enchantment_scroll = 0
                self.sfx("click")
            elif key == "back":
                self.close_leaderboard()
        elif self.state == "gameover":
            key = self.hit(self.over_rects, self.mouse_x, self.mouse_y)
            if key == "play":
                self.start_game(self.run_mode, self.difficulty)
            elif key == "board":
                self.open_leaderboard("gameover")
            elif key == "menu":
                self.go_menu()
        elif self.state == "victory":
            key = self.hit(self.over_rects, self.mouse_x, self.mouse_y)
            if key == "play":
                self.start_game(self.run_mode, self.difficulty)
            elif key == "board":
                self.open_leaderboard("victory")
            elif key == "menu":
                self.go_menu()
        elif self.state == "shop":
            key = self.hit(self.shop_rects, self.mouse_x, self.mouse_y)
            if key == "next":
                self.start_wave()
            elif key:
                self.buy(key)

    def on_release(self, e):
        self.mouse_down = False

    def on_focus_out(self, e):
        """Alt-tabbing away: pause the game and forget held keys (otherwise the
        gun keeps sliding because the key-release event never arrives)."""
        if e.widget is not self.root or time.time() < self.fs_guard:
            return
        self.keys.clear()
        self.mouse_down = False
        self.cancel_charge()
        if self.state == "play":
            self.state = "paused"

    def set_fullscreen(self, on):
        root = self.root
        try:
            if on:
                root.resizable(True, True)
                root.attributes("-fullscreen", True)
            else:
                root.attributes("-fullscreen", False)
                root.resizable(False, False)
        except tk.TclError:
            return
        self.fullscreen = on
        self.fs_guard = time.time() + 0.8
        root.update_idletasks()
        if on:
            sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
            k = min(sw / W, sh / H)
        else:
            sw, sh, k = W, H, 1.0
        self.c.config(width=sw, height=sh)
        if not on:
            root.geometry("")
        self.c.set_view(k, (sw - W * k) / 2, (sh - H * k) / 2)
        self.screen = (sw, sh)
        self.build_background()
        self.last = time.time()

    # ------------------------------------------------------------------
    # game flow
    # ------------------------------------------------------------------
    def show_mode_select(self):
        self.state = "mode_select"
        self.sfx("click")

    def show_difficulty_select(self, mode):
        if mode not in ("normal", "infinity", "adaptive"):
            raise ValueError(f"Unknown run mode: {mode}")
        self.selected_run_mode = mode
        self.state = "difficulty_select"
        self.sfx("click")

    def start_game(self, mode="normal", difficulty="normal"):
        if mode not in ("normal", "infinity", "adaptive"):
            raise ValueError(f"Unknown run mode: {mode}")
        if difficulty not in DIFFICULTIES:
            raise ValueError(f"Unknown difficulty: {difficulty}")
        self.reset()
        self.run_mode = mode
        self.difficulty = difficulty
        self.difficulty_settings = DIFFICULTIES[difficulty]
        self.run_objectives = [
            dict(objective, progress=0, completed=False)
            for objective in random.sample(RUN_OBJECTIVES, 3)]
        self.latest = None          # clear the old "LATEST" highlight
        self.mouse_down = False     # don't fire from the click on PLAY
        st = self.data["stats"]
        st["games"] = st.get("games", 0) + 1
        self.start_wave()

    def start_wave(self):
        self.victory = False
        self.victory_confetti = []
        self.wave += 1
        self.wave_hit = False
        self.clear_field()
        w = self.wave
        pool = ["scout"]
        weights = [6]
        if w >= 2:
            pool.append("saucer"); weights.append(4 + w)
        if w >= 3:
            pool.append("diver"); weights.append(2 + w // 2)
        if w >= 4:
            pool.append("heavy"); weights.append(1 + w // 2)
        if w >= 11:
            pool.extend(("wraith", "leviathan"))
            weights.extend((1 + w // 4, 1 + w // 6))
        if w >= 51:
            pool.extend(("siren", "ravager"))
            weights.extend((1 + w // 8, 1 + w // 10))
        if w >= 76:
            pool.extend(("interceptor", "bomber", "phantom", "sentinel",
                         "tempest", "reaper"))
            weights.extend((1 + w // 8, 1 + w // 10, 1 + w // 9,
                            1 + w // 11, 1 + w // 12, 1 + w // 13))
        count = 5 + w * 2
        self.queue = random.choices(pool, weights, k=count)
        if w == 10:
            self.queue = self.queue[: count // 3]
            self.queue.insert(0, "grand")
        elif w == 5:
            self.queue = self.queue[: count // 2]
            self.queue.insert(0, "boss")
        self.wave_total = max(1, len(self.queue))
        self.spawn_timer = 0.8
        self.banner = BANNER_T
        self.state = "play"
        self.last = time.time()
        self.sfx("boss" if _boss_for_wave(w) else "wave")
        self.check_badges()

    def buy(self, key):
        if key == "repair":
            if self.hp >= self.max_hp:
                self.shop_msg = "Hull is already full."
                self.sfx("deny")
            elif self.credits < REPAIR_COST:
                self.shop_msg = "Not enough credits."
                self.sfx("deny")
            else:
                self.credits -= REPAIR_COST
                self.hp = self.max_hp
                self.shop_msg = "Hull fully repaired!"
                self.sfx("repair")
            return
        for k, name, _, mx, _, _ in UPGRADES:
            if k != key:
                continue
            if self.level[k] >= mx:
                self.shop_msg = f"{name} is already maxed."
                self.sfx("deny")
                return
            c = self.cost(k)
            if self.credits < c:
                self.shop_msg = "Not enough credits."
                self.sfx("deny")
                return
            self.credits -= c
            self.level[k] += 1
            self.sfx("buy")
            self.upgrades_bought += 1
            if k == "hull":
                self.hp = min(self.max_hp, self.hp + 2)
            self.shop_msg = f"Upgraded {name} to level {self.level[k]}!"
            self.check_badges()

    # ------------------------------------------------------------------
    # spawning / helpers
    # ------------------------------------------------------------------
    def spawn_ufo(self, kind, x=None, y=None):
        spec = UFO_SPECS[kind]
        # Health growth: waves 1-5 are unchanged. From wave 6 on, UFOs gain
        # extra health every wave (tune the HP_* numbers below).
        extra = max(0, self.wave - HP_RAMP_START)
        scale = 1 + (self.wave - 1) * 0.12 + extra * HP_RAMP_NORMAL
        hp = max(1, round(spec["hp"] * scale))
        if kind == "boss":
            hp = 45 + self.wave * 8 + extra * HP_RAMP_BOSS
        elif kind == "grand":
            hp = 150 + self.wave * 12 + extra * HP_RAMP_GRAND
        if x is None:
            x = random.uniform(50, W - 50)
        if y is None:
            y = -40.0
        x = min(W - 40, max(40, x))
        u = dict(kind=kind, x=x, y=y, hp=hp, maxhp=hp, t=0.0,
                 base_x=x, vx=random.choice((-1, 1)) * random.uniform(90, 150),
                 vy=0.0, shoot=random.uniform(1.5, 4.0), flash=0.0,
                 shot_warning=0.0,
                 mode="enter", timer=0.0, dead=False, kvx=0.0, kvy=0.0)
        if kind == "scout":
            u["vx"] *= 1.6
        if kind == "boss":
            u["x"] = u["base_x"] = W / 2
            u["shoot"] = 1.5
        elif kind == "grand":
            u["x"] = u["base_x"] = W / 2
            u["y"] = -90.0
            u["shoot"] = 2.0
            u["timer"] = 3.0        # countdown to launching escorts
        self.ufos.append(u)
        discovered = self.data["discovered_ufos"]
        if kind not in discovered:
            discovered.append(kind)
            self.save_ok = save_data(self.data)

    def explode(self, x, y, color, n=18, speed=220):
        for _ in range(n):
            a = random.uniform(0, math.tau)
            s = random.uniform(40, speed)
            life = random.uniform(0.3, 0.8)
            # x, y, vx, vy, life, colour, max life, kind (0 = spark)
            self.particles.append([x, y, math.cos(a) * s, math.sin(a) * s,
                                   life, color, life, 0])
        if n >= 14:                       # shockwave ring: x, y, max r, life...
            self.rings.append([x, y, 28 + n * 1.5, 0.38, 0.38, color])

    def enemy_shot(self, x, y, tx=None, ty=None, speed=240):
        self.sfx("enemy")
        if tx is None:
            vx, vy = 0, speed
        else:
            d = math.hypot(tx - x, ty - y) or 1
            vx, vy = (tx - x) / d * speed, (ty - y) / d * speed
        self.ebullets.append([x, y, vx, vy])

    def hurt_player(self, dmg):
        if self.inv > 0:
            return
        self.wave_hit = True
        self.hp -= dmg
        self.inv = 0.9
        self.shake = 0.25
        self.hit_flash = 0.35
        self.flash_col = "#ff2a2a"
        self.explode(self.px, GROUND, "#ff5555", 14, 180)
        self.sfx("hurt")
        if self.hp <= 0:
            self.cancel_weapons()
            self.minions = []
            self.state = "gameover"
            self.sfx("over")
            self.record_run()

    # ------------------------------------------------------------------
    # special weapons: homing missile (T) and charge beam (V)
    # ------------------------------------------------------------------
    def cancel_charge(self):
        self.charging = False
        self.charge_t = 0.0
        self.charge_seen = 0        # highest power level already announced
        self.charge_up_t = None     # when V was released (None = still held)

    def cancel_weapons(self):
        self.cancel_charge()
        self.missiles = []
        self.beams = []

    def summon_minions(self):
        """M: call small copies of your gun that fly beside it for a while."""
        if self.minion_cd > 0:
            self.sfx("deny")
            return
        self.minion_cd = MINION_CD
        self.minions = []
        n = 0
        for slot in range(MINION_PER_SIDE):
            for side in (-1, 1):
                self.minions.append(dict(
                    side=side, slot=slot, x=self.px,
                    y=GROUND + 30 - 30 * MINION_SCALE, age=0.0,
                    life=MINION_LIFE,
                    fire=0.25 + 0.12 * n,           # stagger the first shots
                    mt=MINION_MISSILE_EVERY + 0.4 * n,
                    recoil=0.0, muzzle=0.0))
                n += 1
        self.rings.append([self.px, GROUND, 90, 0.4, 0.4, "#9fe8ff"])
        self.explode(self.px, GROUND - 10, "#9fe8ff", 16, 200)
        self.sfx("summon")

    def update_minions(self, dt):
        """Minions follow the gun, shoot bullets all the time, and fire a
        homing missile every few seconds - but only while an enemy is on
        screen."""
        keep = []
        for mn in self.minions:
            mn["age"] += dt
            mn["life"] -= dt
            if mn["life"] <= 0:                     # time is up: vanish
                self.explode(mn["x"], mn["y"], "#9fe8ff", 10, 150)
                self.rings.append([mn["x"], mn["y"], 34, 0.25, 0.25,
                                   "#9fe8ff"])
                continue
            keep.append(mn)
            tx = self.px + mn["side"] * (MINION_SPACING
                                         + mn["slot"] * MINION_GAP)
            tx = min(W - 18, max(18, tx))
            mn["x"] += (tx - mn["x"]) * min(1.0, dt * 12)
            mn["recoil"] = max(0.0, mn["recoil"] - 40 * dt)
            mn["muzzle"] = max(0.0, mn["muzzle"] - dt)
            if mn["age"] < 0.35:                    # still arriving
                continue
            # bullets: straight up, like the real gun
            mn["fire"] -= dt
            if mn["fire"] <= 0:
                mn["fire"] = MINION_FIRE_DELAY
                self.bullets.append(dict(
                    x=mn["x"], y=mn["y"] - 22, vx=0.0, vy=-self.bullet_speed,
                    dmg=max(1, round(self.damage * MINION_DMG_SHARE)),
                    pierce=0, hit=set(), dead=False, trail=[], kills=0,
                    s=0.8))
                mn["recoil"] = 4.0
                mn["muzzle"] = 0.06
                self.sfx("minionshot")
            # missiles: only when there is something to shoot at
            mn["mt"] = max(0.0, mn["mt"] - dt)
            if mn["mt"] <= 0:
                tg = self.nearest_ufo(mn["x"], mn["y"])
                if tg is not None:
                    mn["mt"] = MINION_MISSILE_EVERY
                    self.missiles.append(dict(
                        x=mn["x"], y=mn["y"] - 20, a=-math.pi / 2, sp=240.0,
                        vx=0.0, vy=-240.0, target=tg, life=5.0, age=0.0,
                        smoke=0.0, dead=False, mul=MINION_MISSILE_SHARE,
                        s=0.8))
                    mn["recoil"] = 7.0
                    self.explode(mn["x"], mn["y"] - 20, self.missile_boom(),
                                 4, 100)
                    self.sfx("missile")
        self.minions = keep

    def draw_minions(self, ox, oy):
        """Mini copies of the gun (same skin), each with a small timer bar."""
        c = self.c
        t = time.time()
        for mn in self.minions:
            grow = min(1.0, mn["age"] / 0.35)
            grow = 1 - (1 - grow) ** 2
            frac = max(0.0, mn["life"] / MINION_LIFE)
            if mn["life"] < 2.0 and int(mn["life"] * 8) % 2 == 0:
                continue                            # blink before vanishing
            x, y = mn["x"] + ox, mn["y"] + oy
            sc = max(0.06, MINION_SCALE * grow)
            if grow < 1.0:                          # materialising
                y = GROUND + 30 - 30 * sc + oy
            self.draw_gun(x, y, self.gun_skin, sc, 1, mn["recoil"] * sc / 0.5,
                          self.level["damage"], mn["muzzle"], self.bullet_skin)
            # little time-left bar under the minion
            bw = 22
            c.create_rectangle(x - bw / 2, GROUND + 37 + oy, x + bw / 2,
                               GROUND + 40 + oy, fill="#171c3e", outline="")
            c.create_rectangle(x - bw / 2, GROUND + 37 + oy,
                               x - bw / 2 + bw * frac, GROUND + 40 + oy,
                               fill="#4dd8ff" if frac > 0.25 else "#ff9f43",
                               outline="")

    def bounce_angles(self):
        """Directions of the ricochet burst, in radians (0 = straight up,
        positive = to the right)."""
        n = max(1, BOUNCE_DIRS)
        arc = math.radians(BOUNCE_ARC)
        if n == 1:
            base = [0.0]
        elif BOUNCE_ARC >= 360:             # full ring: no doubled direction
            base = [i * math.tau / n for i in range(n)]
        else:                               # fan centred on straight up
            base = [-arc / 2 + arc * i / (n - 1) for i in range(n)]
        per = max(1, BOUNCE_PER_DIR)
        out = []
        for a in base:                      # several bullets per direction:
            for j in range(per):            # spread them by a few degrees
                out.append(a + (j - (per - 1) / 2) * 0.07)
        return out

    def fire_bounce(self):
        """B: a burst of bullets that ricochet off the edges of the screen."""
        if self.bounce_cd > 0 or self.charging:
            self.sfx("deny")
            return
        self.bounce_cd = BOUNCE_CD
        v = self.bullet_speed * BOUNCE_SPEED
        for a in self.bounce_angles():
            sa, ca = math.sin(a), math.cos(a)
            self.bullets.append(dict(
                x=self.px + sa * 36, y=GROUND - ca * 36,
                vx=sa * v, vy=-ca * v, dmg=self.damage, pierce=99,
                hit=set(), dead=False, trail=[], kills=0,
                bn=0, life=BOUNCE_LIFE))
        self.muzzle = 0.1
        self.recoil = 10.0
        self.explode(self.px, GROUND - 38, "#9fe8ff", 10, 150)
        self.rings.append([self.px, GROUND - 38, 44, 0.25, 0.25, "#9fe8ff"])
        self.sfx("bounceshot")

    def bounce_bullet(self, b, dt):
        """Reflect a ricochet bullet off the screen edges (left, right, top
        and the ground line). After BOUNCE_MAX bounces it vanishes on the next
        wall it touches."""
        left, right, top, bottom = 6.0, W - 6.0, 6.0, HORIZON - 8.0
        touched = False
        if b["x"] < left:
            b["x"] = 2 * left - b["x"]
            b["vx"] = abs(b["vx"])
            touched = True
        elif b["x"] > right:
            b["x"] = 2 * right - b["x"]
            b["vx"] = -abs(b["vx"])
            touched = True
        if b["y"] < top:
            b["y"] = 2 * top - b["y"]
            b["vy"] = abs(b["vy"])
            touched = True
        elif b["y"] > bottom:
            b["y"] = 2 * bottom - b["y"]
            b["vy"] = -abs(b["vy"])
            touched = True
        b["life"] -= dt
        if touched:
            if b["bn"] >= BOUNCE_MAX:       # used up all its bounces
                b["dead"] = True
                self.explode(b["x"], b["y"], "#9fe8ff", 8, 130)
                return
            b["bn"] += 1
            b["hit"].clear()                # it can hurt the same UFO again
            b["trail"] = []
            self.rings.append([b["x"], b["y"], 20, 0.2, 0.2, "#ffffff"])
            self.explode(b["x"], b["y"], "#9fe8ff", 4, 110)
            self.sfx("ricochet")
        if b["life"] <= 0:
            b["dead"] = True

    def nearest_ufo(self, x, y):
        """The closest UFO that is on screen and not already blowing up."""
        best, bd = None, 1e9
        for u in self.ufos:
            if u["dead"] or u["mode"] == "dying" or u["y"] < -20:
                continue
            d = math.hypot(u["x"] - x, u["y"] - y)
            if d < bd:
                best, bd = u, d
        return best

    def hurt_ufo(self, u, dmg, src=None):
        """Damage a UFO from a missile or beam. Returns True if it was killed."""
        if u["dead"] or u["mode"] == "dying":
            return False
        u["hp"] -= nb_damage_taken(self, u, dmg)
        u["flash"] = 0.08
        if u["hp"] <= 0:
            self.kill_ufo(u, src)
            return True
        self.sfx("hit")
        return False

    def fire_missile(self):
        if self.missile_cd > 0:
            self.sfx("deny")
            return
        if self.nearest_ufo(self.px, GROUND) is None:
            self.floaters.append([self.px, GROUND - 70, "NO TARGET", 0.9])
            self.sfx("deny")
            return
        self.missile_cd = MISSILE_CD
        self.missiles.append(dict(
            x=self.px, y=GROUND - 30, a=-math.pi / 2, sp=240.0,
            vx=0.0, vy=-240.0, target=self.nearest_ufo(self.px, GROUND),
            life=5.0, age=0.0, smoke=0.0, dead=False))
        self.recoil = 8.0
        self.explode(self.px, GROUND - 30, self.missile_boom(), 6, 120)
        self.sfx("missile")

    def missile_boom(self):
        sk = self.missile_skin
        if sk["mode"] == "rainbow":
            return hsv(time.time() * 0.9, 0.8, 1.0)
        return sk["boom"]

    def update_missiles(self, dt):
        for m in self.missiles:
            m["age"] += dt
            m["life"] -= dt
            tg = m["target"]
            if tg is None or tg["dead"] or tg["mode"] == "dying" or \
                    not any(o is tg for o in self.ufos):
                tg = m["target"] = self.nearest_ufo(m["x"], m["y"])
            if tg is not None:                  # steer toward the target
                want = math.atan2(tg["y"] - m["y"], tg["x"] - m["x"])
                diff = (want - m["a"] + math.pi) % math.tau - math.pi
                rate = (3.5 + 5.0 * min(1.0, m["age"] / 0.8)) * dt
                m["a"] += max(-rate, min(rate, diff))
            m["sp"] = min(MISSILE_SPEED, m["sp"] + 520 * dt)
            m["vx"] = math.cos(m["a"]) * m["sp"]
            m["vy"] = math.sin(m["a"]) * m["sp"]
            m["x"] += m["vx"] * dt
            m["y"] += m["vy"] * dt
            m["smoke"] -= dt
            if m["smoke"] <= 0:                 # exhaust trail
                m["smoke"] = 0.03
                bx = m["x"] - math.cos(m["a"]) * 12
                by = m["y"] - math.sin(m["a"]) * 12
                sk = self.missile_skin
                mode = sk["mode"]
                col = hsv(time.time() * 0.9 + m["age"] * 2, 0.8, 1.0) \
                    if mode == "rainbow" else sk["smoke"]
                life = 1.0 if mode == "comet" else 0.6
                self.particles.append([bx, by, random.uniform(-12, 12),
                                       random.uniform(-12, 12), life,
                                       col, life, 1])
                if mode in ("fire", "comet", "snow", "rainbow"):
                    # extra sparks / flakes falling off the trail
                    self.particles.append([
                        bx, by, random.uniform(-45, 45),
                        random.uniform(-45, 45), 0.5,
                        "#ffffff" if mode in ("comet", "snow") else
                        (sk["flame"] if mode == "fire" else col), 0.5, 0])
            for u in self.ufos:
                if u["dead"] or u["mode"] == "dying":
                    continue
                s = UFO_SPECS[u["kind"]]["size"]
                dx = (m["x"] - u["x"]) / (s + 5)
                dy = (m["y"] - u["y"]) / (s * 0.6 + 5)
                if dx * dx + dy * dy < 1.0:
                    dmg = max(1, round(MISSILE_DMG * self.power
                                       * m.get("mul", 1.0)))
                    self.explode(m["x"], m["y"], self.missile_boom(), 18, 270)
                    self.explode(m["x"], m["y"], "#ffffff", 6, 170)
                    self.sfx("boom")
                    self.shake = max(self.shake, 0.1)
                    if not self.hurt_ufo(u, dmg, "missile"):
                        self.knock_ufo(u, m)
                    m["dead"] = True
                    break
            if not m["dead"]:
                if m["life"] <= 0:              # ran out of fuel
                    self.explode(m["x"], m["y"], self.missile_boom(), 8, 140)
                    m["dead"] = True
                elif m["y"] < -60 or m["y"] > H + 20 or \
                        m["x"] < -60 or m["x"] > W + 60:
                    m["dead"] = True
        self.missiles = [m for m in self.missiles if not m["dead"]]

    def charge_tier(self):
        """0 = not charged enough yet, 1 = small, 2 = medium, 3 = large."""
        t = self.charge_t
        return 3 if t >= CHARGE_T[2] else 2 if t >= CHARGE_T[1] \
            else 1 if t >= CHARGE_T[0] else 0

    def begin_charge(self):
        if self.charging:               # auto-repeat press: still holding V
            self.charge_up_t = None
            return
        self.charging = True
        self.charge_t = 0.0
        self.charge_seen = 0
        self.charge_up_t = None
        self.sfx("chargeup")

    def update_charge(self, dt):
        if not self.charging:
            return
        self.charge_t += dt
        tier = self.charge_tier()
        if tier > self.charge_seen:     # reached a new power level
            self.charge_seen = tier
            self.sfx("tier%d" % tier)
            self.rings.append([self.px, GROUND - 50, 50 + tier * 20, 0.35,
                               0.35, CHARGE_COL[tier]])
        if self.charge_up_t is not None and \
                time.time() - self.charge_up_t > 0.08:
            self.release_charge()

    def release_charge(self):
        tier = self.charge_tier()
        self.cancel_charge()
        if tier == 0:                   # let go too early: it fizzles out
            self.explode(self.px, GROUND - 44, "#9fb0ff", 5, 90)
            self.sfx("deny")
            return
        self.beams.append(dict(tier=tier, t=0.0, dur=BEAM_DUR[tier - 1],
                               tick=0.0, x=self.px, kills=0))
        self.recoil = 7.0 + 5.0 * tier
        self.muzzle = 0.1
        self.shake = max(self.shake, (0.12, 0.2, 0.35)[tier - 1])
        if tier == 3:
            self.hit_flash = 0.2
            self.flash_col = BEAM_COL[2]
            self.unlock("overcharge")
        self.sfx("beam%d" % tier)

    def update_beams(self, dt):
        for bm in self.beams:
            bm["t"] += dt
            bm["x"] = self.px           # the beam follows the gun
            bm["tick"] -= dt
            while bm["tick"] <= 0:
                bm["tick"] += BEAM_TICK
                self.beam_hit(bm)
        self.beams = [b for b in self.beams if b["t"] < b["dur"]]

    def beam_hit(self, bm):
        tier = bm["tier"]
        hw = BEAM_HW[tier - 1]
        dmg = max(1, round(BEAM_TICK_DMG[tier - 1] * self.power))
        col = BEAM_COL[tier - 1]
        for u in self.ufos:
            if u["dead"] or u["mode"] == "dying":
                continue
            if u["y"] < -20 or u["y"] > GROUND - 10:
                continue
            s = UFO_SPECS[u["kind"]]["size"]
            if abs(u["x"] - bm["x"]) < hw + s * 0.9:
                self.explode(u["x"], u["y"], col, 4, 150)
                if self.hurt_ufo(u, dmg, "beam"):
                    bm["kills"] += 1
                    if bm["kills"] >= 4:
                        self.unlock("laserwipe")
        for e in self.ebullets:         # the beam also vaporises enemy shots
            if abs(e[0] - bm["x"]) < hw + 6 and e[1] < GROUND - 20:
                self.explode(e[0], e[1], col, 4, 100)
                e[1] = H + 100

    # ------------------------------------------------------------------
    # update
    # ------------------------------------------------------------------
    def update(self, dt):
        # starfield always scrolls
        for s in self.stars:
            s[1] += s[2] * dt
            if s[1] > STAR_MAX_Y:
                s[0], s[1] = random.uniform(0, W), 0
        self.update_meteor(dt)
        for m in self.menu_ufos:
            m["x"] += m["vx"] * dt
            m["t"] += dt
            if m["x"] < -70:
                m["x"] = W + 70
            elif m["x"] > W + 70:
                m["x"] = -70

        # purely cosmetic timers (run in every state)
        self.score_pop = max(0.0, self.score_pop - dt)
        self.sound_toast = max(0.0, self.sound_toast - dt)
        self.hit_flash = max(0.0, self.hit_flash - dt)
        for tt in self.toasts[:3]:
            tt[1] -= dt
        self.toasts = [tt for tt in self.toasts if tt[1] > 0]
        if self.disp_score < self.score:
            step = max(1.0, (self.score - self.disp_score) * min(1.0, dt * 8))
            self.disp_score = min(self.score, self.disp_score + step)
        if self.state != "paused":
            self.update_fx(dt)

        if self.state == "levels":
            self.levels_anim_time += dt
            return

        if self.state != "play":
            return

        # boss-kill slow motion (hit-stop)
        if self.slow > 0:
            self.slow -= dt
            dt *= 0.3

        # player movement
        move = 0
        if "left" in self.keys or "a" in self.keys:
            move -= 1
        if "right" in self.keys or "d" in self.keys:
            move += 1
        if move:
            self.px += move * PLAYER_SPEED * dt
        self.px = min(W - 25, max(25, self.px))

        self.inv = max(0.0, self.inv - dt)
        self.shake = max(0.0, self.shake - dt)
        self.banner = max(0.0, self.banner - dt)
        self.muzzle = max(0.0, self.muzzle - dt)
        self.recoil = max(0.0, self.recoil - 55 * dt)
        self.missile_cd = max(0.0, self.missile_cd - dt)
        self.bounce_cd = max(0.0, self.bounce_cd - dt)
        self.minion_cd = max(0.0, self.minion_cd - dt)

        # smoke when the hull is low
        if 0 < self.hp <= self.max_hp * 0.4:
            self.smoke_t -= dt
            if self.smoke_t <= 0:
                self.smoke_t = 0.07
                self.particles.append([self.px + random.uniform(-9, 9),
                                       GROUND - 4, random.uniform(-14, 14),
                                       random.uniform(-65, -35), 0.9,
                                       "#a4a4bc", 0.9, 1])

        # shooting (the normal gun is busy while a charge is building)
        self.cooldown -= dt
        if (self.mouse_down or "space" in self.keys) and self.cooldown <= 0 \
                and not self.charging:
            self.fire()
            self.cooldown = self.delay

        self.update_minions(dt)

        # bullets
        for b in self.bullets:
            b["trail"].append((b["x"], b["y"]))
            if len(b["trail"]) > 6:
                b["trail"].pop(0)
            b["x"] += b["vx"] * dt
            b["y"] += b["vy"] * dt
            if "bn" in b:                   # ricochet bullet
                self.bounce_bullet(b, dt)
        self.bullets = [b for b in self.bullets
                        if -20 < b["y"] < H and -20 < b["x"] < W + 20]

        # spawning
        if self.queue:
            self.spawn_timer -= dt
            if self.spawn_timer <= 0:
                self.spawn_ufo(self.queue.pop(0))
                self.spawn_timer = max(0.35, 1.1 - self.wave * 0.05)

        # UFOs
        for u in self.ufos:
            self.update_ufo(u, dt)
            if u["mode"] != "dying" and u.get("shoot") is not None \
                    and 0 < u["shoot"] <= SHOT_WARNING_TIME:
                u["shot_warning"] = min(
                    1.0, u.get("shot_warning", 0.0) + dt * 5)
            else:
                u["shot_warning"] = max(
                    0.0, u.get("shot_warning", 0.0) - dt * 4)

        # bullets vs UFOs
        for b in self.bullets:
            if b["dead"]:
                continue
            for u in self.ufos:
                if u["dead"] or u["mode"] == "dying" or id(u) in b["hit"]:
                    continue
                s = UFO_SPECS[u["kind"]]["size"]
                dx, dy = (b["x"] - u["x"]) / s, (b["y"] - u["y"]) / (s * 0.55)
                if dx * dx + dy * dy < 1.0:
                    u["hp"] -= nb_damage_taken(self, u, b["dmg"])
                    u["flash"] = 0.08
                    if b.get("adaptive_shot") and not b.get("adaptive_hit"):
                        self.adaptive_wave_hits += 1
                        b["adaptive_hit"] = True
                    b["hit"].add(id(u))
                    self.explode(b["x"], b["y"], "#ffffaa", 3, 90)
                    if u["hp"] > 0:
                        self.sfx("hit")
                        self.knock_ufo(u, b)
                    if u["hp"] <= 0:
                        self.kill_ufo(u, "bounce" if b.get("bn", 0) > 0
                                      else None)
                        b["kills"] += 1
                        if b["kills"] >= 3:
                            self.unlock("skewer")
                    if b["pierce"] > 0:
                        b["pierce"] -= 1
                    else:
                        b["dead"] = True
                        break
        self.bullets = [b for b in self.bullets if not b["dead"]]
        self.ufos = [u for u in self.ufos if not u["dead"]]

        # special weapons: homing missiles, charge ball, laser beams
        self.update_missiles(dt)
        self.update_beams(dt)
        self.update_charge(dt)
        self.ufos = [u for u in self.ufos if not u["dead"]]

        # enemy bullets
        for e in self.ebullets:
            e[0] += e[2] * dt
            e[1] += e[3] * dt
            if math.hypot(e[0] - self.px, e[1] - (GROUND + 8)) < 24:
                e[1] = H + 100
                self.hurt_player(1)
        self.ebullets = [e for e in self.ebullets
                         if -20 < e[1] < H and -20 < e[0] < W + 20]

        # wave cleared?
        self.finale = max(0.0, self.finale - dt)
        if self.state == "play" and not self.queue and not self.ufos \
                and self.finale <= 0:
            bonus = 20 + self.wave * 10
            self.credits += bonus
            self.score += bonus
            self.shop_msg = f"Wave {self.wave} cleared!  Bonus +{bonus} credits."
            if not self.wave_hit and self.wave >= 3:
                self.unlock("untouchable")
            if self.hp == 1:
                self.unlock("close")
            self.progress_objectives("wave")
            if not self.wave_hit:
                self.progress_objectives("clean")
            self.check_badges()
            # checkpoint: if the game is killed now, this run is recovered
            self.cleared_wave = self.wave
            if self.wave == 100 and self.run_mode == "normal":
                self.victory = True
                self.victory_time = 0.0
                self.victory_confetti_spawn = 0.0
            self.data["current"] = dict(
                score=self.score, wave=self.wave,
                cleared_wave=self.cleared_wave,
                rank=rank_for_wave(self.cleared_wave),
                date=time.strftime("%Y-%m-%d %H:%M"),
                mode=self.run_mode, difficulty=self.difficulty,
                objectives=sum(o["completed"]
                               for o in self.run_objectives),
                run_objectives=self.run_objectives)
            self.save_ok = save_data(self.data)
            self.cancel_weapons()
            self.sfx("clear")
            if self.victory:
                self.state = "victory"
                self.record_run()
            else:
                self.state = "shop"

    def update_fx(self, dt):
        """Particles, shockwaves and floating text (also run on game over)."""
        for p in self.particles:
            p[0] += p[2] * dt
            p[1] += p[3] * dt
            p[4] -= dt
            if p[7] in (0, 2):
                p[3] += 140 * dt          # sparks fall a little
        self.particles = [p for p in self.particles if p[4] > 0]
        for r in self.rings:
            r[3] -= dt
        self.rings = [r for r in self.rings if r[3] > 0]
        for f in self.floaters:
            f[1] -= 35 * dt
            f[3] -= dt
        self.floaters = [f for f in self.floaters if f[3] > 0]
        if self.victory and self.state == "victory" and self.victory_time < 4.0:
            self.victory_time += dt
            self.victory_confetti_spawn += dt
            while self.victory_confetti_spawn >= 0.08:
                self.victory_confetti_spawn -= 0.08
                for _ in range(2):
                    self.victory_confetti.append(dict(
                        x=random.uniform(80, W - 80),
                        y=random.uniform(25, 45),
                        vx=random.uniform(-35, 35),
                        vy=random.uniform(35, 90),
                        angle=random.uniform(0, math.tau),
                        spin=random.uniform(-8, 8),
                        life=random.uniform(1.0, 1.8),
                        color=random.choice(("#ffe066", "#ff65b8", "#4dd8ff",
                                             "#8df0bd", "#ff9f43")),
                        size=random.uniform(3, 6)))
        for piece in self.victory_confetti:
            piece["x"] += piece["vx"] * dt
            piece["y"] += piece["vy"] * dt
            piece["vy"] += 35 * dt
            piece["angle"] += piece["spin"] * dt
            piece["life"] -= dt
        self.victory_confetti = [
            piece for piece in self.victory_confetti
            if piece["life"] > 0 and piece["y"] < 108]

    def update_meteor(self, dt):
        m = self.meteor
        if m:
            m[0] += m[2] * dt
            m[1] += m[3] * dt
            m[4] -= dt
            if m[4] <= 0:
                self.meteor = None
        elif random.random() < dt * 0.12:
            self.meteor = [random.uniform(150, W), random.uniform(0, 150),
                           -440, 270, 0.9]

    def fire(self):
        n = self.shots
        self.muzzle = 0.07
        self.recoil = 7.0
        self.sfx("shoot")
        for i in range(n):
            a = (i - (n - 1) / 2) * 0.14
            v = self.bullet_speed
            self.bullets.append(dict(
                x=self.px + math.sin(a) * 36, y=GROUND - math.cos(a) * 36,
                vx=math.sin(a) * v, vy=-math.cos(a) * v,
                dmg=self.damage, pierce=self.pierce, hit=set(), dead=False,
                trail=[], kills=0))

    def kill_ufo(self, u, src=None):
        spec = UFO_SPECS[u["kind"]]
        st = self.data["stats"]
        st["kills"] = st.get("kills", 0) + 1
        key = "kill_" + u["kind"]
        st[key] = st.get(key, 0) + 1
        source_key = {
            "missile": "kill_missile",
            "bounce": "kill_bounce",
            "beam": "kill_beam",
            "shock": "kill_shock",
        }.get(src)
        if source_key:
            st[source_key] = st.get(source_key, 0) + 1
        if u["kind"] == "boss":
            self.unlock("mothership")
        elif u["kind"] == "grand":
            self.unlock("grand")
        self.score += spec["score"]
        self.credits += spec["credits"]
        self.score_pop = 0.25
        if u["kind"] in ("boss", "grand"):
            self.begin_boss_death(u)        # animated; dies a moment later
        else:
            u["dead"] = True
            self.sfx("boom")
            self.explode(u["x"], u["y"], spec["color"], 22, 240)
            self.floaters.append([u["x"], u["y"], f"+{spec['credits']}c", 0.9])
        self.check_badges()

    def knock_ufo(self, u, b):
        """Shove a UFO along the bullet's direction (decays in update_ufo)."""
        lvl = self.knock
        if lvl <= 0 or u["mode"] == "dying":
            return
        v = math.hypot(b["vx"], b["vy"]) or 1.0
        power = 170 * lvl * KB_RESIST.get(u["kind"], 1.0)
        u["kvx"] = max(-400, min(400, u["kvx"] + b["vx"] / v * power * 0.6))
        u["kvy"] = max(-650, min(650, u["kvy"] + b["vy"] / v * power))
        self.rings.append([b["x"], b["y"], 16, 0.18, 0.18, "#ffffff"])
        self.sfx("knock")

    def begin_boss_death(self, u):
        u["mode"] = "dying"
        u["dtm"] = 0.0
        u["dur"] = 2.4 if u["kind"] == "boss" else 3.4
        u["prog"] = 0.0
        u["shk"] = 1.5
        u["burst"] = 0.0
        u["r2"] = False
        u["seed"] = random.randrange(1 << 30)
        for e in self.ebullets:             # pop every enemy bullet
            self.explode(e[0], e[1], "#ff8a8a", 4, 90)
        self.ebullets = []
        self.slow = 0.35                    # brief hit-stop
        self.shake = 0.3
        self.sfx("rumble")

    def update_dying(self, u, dt):
        """Boss death animation: it shakes, cracks and chain-explodes, then
        blows up. Runs on real time, not the UFO speed multiplier."""
        s = UFO_SPECS[u["kind"]]["size"]
        u["dtm"] += dt
        prog = min(1.0, u["dtm"] / u["dur"])
        u["prog"] = prog
        u["shk"] = 1.5 + 6.0 * prog
        u["y"] += 10 * dt
        if u["kind"] == "grand" and not u["r2"] and u["dtm"] >= 2.4:
            u["r2"] = True
            self.sfx("rumble")
        u["burst"] -= dt
        if u["burst"] <= 0:
            u["burst"] = max(0.05, 0.22 - 0.17 * prog)
            bx = u["x"] + random.uniform(-0.9, 0.9) * s
            by = u["y"] + random.uniform(-0.35, 0.35) * s
            col = random.choice(("#ffd24d", "#ff9f43", "#ff5a3a", "#ffffff"))
            self.explode(bx, by, col, 9, 170)
            self.particles.append([bx, by, random.uniform(-20, 20),
                                   random.uniform(-70, -30), 1.0,
                                   "#7a7a96", 1.0, 1])
            self.rings.append([bx, by, 22 + 14 * prog, 0.25, 0.25, col])
            self.shake = max(self.shake, 0.12)
            self.sfx("crackle")
        if u["dtm"] >= u["dur"]:
            self.finish_boss_death(u)

    def finish_boss_death(self, u):
        spec = UFO_SPECS[u["kind"]]
        grand = u["kind"] == "grand"
        s = spec["size"]
        x, y = u["x"], u["y"]
        u["dead"] = True
        self.explode(x, y, spec["color"], 110 if grand else 70, 460)
        self.explode(x, y, spec["dome"], 70 if grand else 40, 320)
        self.explode(x, y, "#ffffff", 20, 520)
        for _ in range(36 if grand else 24):            # flying hull chunks
            a = random.uniform(0, math.tau)
            sp = random.uniform(80, 340)
            life = random.uniform(0.9, 1.6)
            self.particles.append([
                x + random.uniform(-0.8, 0.8) * s,
                y + random.uniform(-0.3, 0.3) * s,
                math.cos(a) * sp, math.sin(a) * sp - 90, life,
                random.choice((spec["color"], spec["dome"], "#3a3a55")),
                life, 2])
        self.rings.append([x, y, 340, 0.9, 0.9, "#ffffff"])
        self.rings.append([x, y, 230, 0.7, 0.7, spec["color"]])
        self.rings.append([x, y, 130, 0.5, 0.5, spec["dome"]])
        self.slow = 0.6
        self.hit_flash = 0.6
        self.flash_col = spec["color"]
        self.shake = 0.5
        self.finale = 2.2 if grand else 1.6     # let the blast play out
        self.floaters.append([x, y, f"+{spec['credits']}c", 1.6])
        self.sfx("death")

    def update_ufo(self, u, dt):
        kind = u["kind"]
        mv = dt * UFO_SPEED * self.difficulty_settings["speed"]
        u["t"] += mv
        u["flash"] = max(0.0, u["flash"] - dt)

        if u["mode"] == "dying":
            self.update_dying(u, dt)
            return

        # knockback: slide along the push, then slow down
        if u["kvx"] or u["kvy"]:
            u["x"] += u["kvx"] * dt
            u["base_x"] = min(W - 40, max(40, u["base_x"] + u["kvx"] * dt))
            u["x"] = min(W - 30, max(30, u["x"]))
            u["y"] = max(-60.0, u["y"] + u["kvy"] * dt)
            damp = math.exp(-7.0 * dt)
            u["kvx"] *= damp
            u["kvy"] *= damp
            if abs(u["kvx"]) < 4:
                u["kvx"] = 0.0
            if abs(u["kvy"]) < 4:
                u["kvy"] = 0.0

        if kind == "scout":
            u["x"] += u["vx"] * mv
            u["y"] += 22 * mv
            if u["y"] < 40:
                u["y"] += 120 * mv
            if u["x"] < 30 or u["x"] > W - 30:
                u["vx"] = -u["vx"]
                u["x"] = min(W - 30, max(30, u["x"]))
                u["y"] += 38

        elif kind == "saucer":
            u["y"] += 38 * mv
            u["x"] = min(W - 40, max(40, u["base_x"] + math.sin(u["t"] * 2.0) * 110))
            if self.wave >= 3:
                u["shoot"] -= dt
                if u["shoot"] <= 0:
                    u["shoot"] = random.uniform(3.0, 5.0)
                    self.enemy_shot(u["x"], u["y"] + 15, speed=230)

        elif kind == "heavy":
            u["y"] += 20 * mv
            u["x"] = min(W - 50, max(50, u["base_x"] + math.sin(u["t"] * 0.8) * 50))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.6
                self.enemy_shot(u["x"], u["y"] + 20, self.px, GROUND, 250)

        elif kind == "wraith":
            u["y"] += 34 * mv
            u["x"] = min(W - 42, max(42, u["base_x"]
                                     + math.sin(u["t"] * 2.4) * 145))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = random.uniform(2.2, 3.2)
                for side in (-1, 1):
                    self.enemy_shot(u["x"] + side * 10, u["y"] + 12,
                                    self.px + side * 90, GROUND, 245)

        elif kind == "leviathan":
            u["y"] += 15 * mv
            u["x"] = min(W - 60, max(60, u["base_x"]
                                     + math.sin(u["t"] * 0.65) * 70))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.8
                for off in (-0.28, 0.0, 0.28):
                    ang = math.atan2(GROUND - u["y"], self.px - u["x"]) + off
                    self.ebullets.append([u["x"], u["y"] + 22,
                                          math.cos(ang) * 235,
                                          math.sin(ang) * 235])
                self.sfx("enemy")

        elif kind == "siren":
            u["y"] += 30 * mv
            u["x"] = min(W - 45, max(45, u["base_x"]
                                     + math.sin(u["t"] * 1.8) * 120))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.0
                self.enemy_shot(u["x"] - 12, u["y"] + 14, self.px - 100,
                                GROUND, 260)
                self.enemy_shot(u["x"] + 12, u["y"] + 14, self.px + 100,
                                GROUND, 260)

        elif kind == "ravager":
            u["y"] += 18 * mv
            u["x"] = min(W - 65, max(65, u["base_x"]
                                     + math.sin(u["t"] * 0.55) * 60))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.4
                for i in range(-2, 3):
                    ang = math.pi / 2 + i * 0.22
                    self.ebullets.append([u["x"], u["y"] + 25,
                                          math.cos(ang) * 250,
                                          math.sin(ang) * 250])
                self.sfx("enemy")

        elif kind == "interceptor":
            u["y"] += 48 * mv
            u["x"] = min(W - 38, max(38, u["base_x"]
                                     + math.sin(u["t"] * 3.2) * 155))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 1.7
                self.enemy_shot(u["x"], u["y"] + 14, self.px, GROUND, 290)

        elif kind == "bomber":
            u["y"] += 16 * mv
            u["x"] = min(W - 55, max(55, u["base_x"]
                                     + math.sin(u["t"] * 0.9) * 75))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 3.0
                for off in (-0.3, 0.0, 0.3):
                    ang = math.pi / 2 + off
                    self.ebullets.append([u["x"], u["y"] + 22,
                                          math.cos(ang) * 190,
                                          math.sin(ang) * 190])
                self.sfx("enemy")

        elif kind == "phantom":
            u["y"] += 40 * mv
            u["x"] = min(W - 42, max(42, u["base_x"]
                                     + math.sin(u["t"] * 2.7) * 130))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.4
                for side in (-1, 1):
                    self.enemy_shot(u["x"] + side * 10, u["y"] + 14,
                                    self.px + side * 80, GROUND, 270)

        elif kind == "sentinel":
            u["y"] += 19 * mv
            u["x"] = min(W - 58, max(58, u["base_x"]
                                     + math.sin(u["t"] * 0.75) * 55))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.5
                for off in (-0.16, 0.0, 0.16):
                    ang = math.atan2(GROUND - u["y"], self.px - u["x"]) + off
                    self.ebullets.append([u["x"], u["y"] + 22,
                                          math.cos(ang) * 240,
                                          math.sin(ang) * 240])
                self.sfx("enemy")

        elif kind == "tempest":
            u["y"] += 30 * mv
            u["x"] = min(W - 48, max(48, u["base_x"]
                                     + math.sin(u["t"] * 1.8) * 115))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.2
                for i in range(-2, 3):
                    ang = math.pi / 2 + i * 0.2
                    self.ebullets.append([u["x"], u["y"] + 18,
                                          math.cos(ang) * 235,
                                          math.sin(ang) * 235])
                self.sfx("enemy")

        elif kind == "reaper":
            u["y"] += 14 * mv
            u["x"] = min(W - 62, max(62, u["base_x"]
                                     + math.sin(u["t"] * 0.6) * 65))
            u["shoot"] -= dt
            if u["shoot"] <= 0:
                u["shoot"] = 2.0
                self.enemy_shot(u["x"] - 12, u["y"] + 24,
                                self.px - 70, GROUND, 275)
                self.enemy_shot(u["x"] + 12, u["y"] + 24,
                                self.px + 70, GROUND, 275)

        elif kind == "diver":
            if u["mode"] == "enter":
                u["y"] += 110 * mv
                if u["y"] >= 110:
                    u["mode"] = "aim"
                    u["timer"] = 0.9
                    self.sfx("warn")
            elif u["mode"] == "aim":
                u["timer"] -= dt
                u["x"] += math.sin(u["t"] * 50) * 40 * mv   # telegraph wobble
                if u["timer"] <= 0:
                    d = math.hypot(self.px - u["x"], GROUND - u["y"]) or 1
                    u["vx"] = (self.px - u["x"]) / d * 330
                    u["vy"] = (GROUND - u["y"]) / d * 330
                    u["mode"] = "dive"
            else:
                u["x"] += u["vx"] * mv
                u["y"] += u["vy"] * mv
                if math.hypot(u["x"] - self.px, u["y"] - GROUND) < 30:
                    u["dead"] = True
                    self.explode(u["x"], u["y"], "#ff4d6d", 25)
                    self.hurt_player(2)
                    return

        elif kind == "boss":
            if u["y"] < 95:
                u["y"] += 60 * mv
            else:
                u["x"] = W / 2 + math.sin(u["t"] * 0.7) * (W / 2 - 110)
            u["shoot"] -= dt
            if u["shoot"] <= 0 and u["y"] >= 90:
                u["shoot"] = 1.8
                for i in range(-2, 3):
                    ang = math.pi / 2 + i * 0.28
                    self.ebullets.append([u["x"], u["y"] + 30,
                                          math.cos(ang) * 230, math.sin(ang) * 230])
                self.enemy_shot(u["x"], u["y"] + 30, self.px, GROUND, 280)

        elif kind == "grand":
            if u["y"] < 150:
                u["y"] += 45 * mv
            else:
                u["x"] = W / 2 + math.sin(u["t"] * 0.4) * (W / 2 - 170)
            ready = u["y"] >= 140
            # wide spread of shots plus one aimed shot
            u["shoot"] -= dt
            if u["shoot"] <= 0 and ready:
                u["shoot"] = 2.4
                for i in range(-3, 4):
                    ang = math.pi / 2 + i * 0.24
                    self.ebullets.append([u["x"], u["y"] + 45,
                                          math.cos(ang) * 210, math.sin(ang) * 210])
                self.enemy_shot(u["x"], u["y"] + 45, self.px, GROUND, 270)
            # launch Scouts and Saucers
            u["timer"] -= dt
            if u["timer"] <= 0 and ready:
                u["timer"] = max(2.0, 4.0 - self.wave * 0.1)
                escorts = sum(1 for o in self.ufos
                              if o["kind"] in ("scout", "saucer") and not o["dead"])
                if escorts < 10:
                    for off in (-70, 70):
                        self.spawn_ufo(random.choice(("scout", "saucer")),
                                       u["x"] + off, u["y"] + 55)

        # reached the ground
        if kind not in ("boss", "grand") and not u["dead"] and u["y"] > GROUND - 20:
            u["dead"] = True
            self.explode(u["x"], GROUND, "#ffaa33", 20)
            self.hurt_player(1)

    # ------------------------------------------------------------------
    # drawing
    # ------------------------------------------------------------------
    def draw(self):
        self.draw_scene()
        self.draw_sound_toast()
        self.c.letterbox(*self.screen)

    def draw_sound_toast(self):
        """Small 'SOUND ON / OFF' note in the top-right corner after pressing S."""
        if self.sound_toast <= 0:
            return
        if self.snd.enabled and self.snd.backend is None:
            txt = "NO AUDIO PLAYER FOUND"
        else:
            txt = "SOUND ON" if self.snd.enabled else "SOUND OFF"
        shadow_text(self.c, W - 14, 62, txt, "#ffe066", (FONT, 10, "bold"),
                    anchor="e", off=1)

    def draw_scene(self):
        c = self.c
        # delete everything except the static background
        dead = [i for i in c.find_all() if i not in self.bg_ids]
        if dead:
            c.delete(*dead)
        ox = oy = 0
        if self.shake > 0 and self.state == "play":
            ox, oy = random.randint(-4, 4), random.randint(-4, 4)

        self.draw_stars()

        if self.state == "menu":
            self.draw_menu()
            return
        if self.state == "mode_select":
            self.draw_mode_select()
            return
        if self.state == "difficulty_select":
            self.draw_difficulty_select()
            return
        if self.state == "victory":
            self.draw_victory()
            self.draw_toasts()
            return
        if self.state == "leaderboard":
            self.draw_leaderboard()
            return
        if self.state == "badges":
            self.draw_badges()
            return
        if self.state == "skins":
            self.draw_skins()
            return
        if self.state == "index":
            self.draw_index()
            return
        if self.state == "enchantments":
            self.draw_enchantments()
            return
        if self.state == "levels":
            self.draw_levels()
            self.draw_toasts()
            return

        for u in self.ufos:
            self.draw_ufo(u, ox, oy)

        for b in self.bullets:
            self.draw_bullet(b, ox, oy)
        for m in self.missiles:
            self.draw_missile(m, ox, oy)
        for e in self.ebullets:
            x, y = e[0] + ox, e[1] + oy
            glow(c, x, y, 13, "#ff3b3b", layers=3, a=0.55)
            c.create_oval(x - 5, y - 5, x + 5, y + 5, fill="#ff4d4d",
                          outline="#ffaaaa")
            c.create_oval(x - 2, y - 2, x + 2, y + 2, fill="#ffffff",
                          outline="")

        self.draw_fx(ox, oy)

        for f in self.floaters:
            k = min(1.0, f[3] / 0.45)
            shade_c = mix("#000000", sky(f[1]), 1 - k)
            c.create_text(f[0] + 1, f[1] + 1, text=f[2], fill=shade_c,
                          font=(FONT, 11, "bold"))
            c.create_text(f[0], f[1], text=f[2],
                          fill=mix(sky(f[1]), "#ffe066", k),
                          font=(FONT, 11, "bold"))

        self.draw_beams(ox, oy)
        if self.state != "gameover":
            self.draw_player(ox, oy)
            self.draw_minions(ox, oy)
            self.draw_charge(ox, oy)
        self.draw_hud()
        self.draw_flash()

        if self.banner > 0 and self.state == "play":
            self.draw_banner()
        if self.state == "paused":
            rrect(c, W / 2 - 190, H / 2 - 55, W / 2 + 190, H / 2 + 55, 16,
                  fill="#0b0f26", outline="#4a5bd0", width=3)
            shadow_text(c, W / 2, H / 2 - 8, "PAUSED", "#ffffff",
                        (FONT, 30, "bold"))
            c.create_text(W / 2, H / 2 + 28, text="press P to resume",
                          fill="#8a93c9", font=(FONT, 11))
        if self.state == "shop":
            self.draw_shop()
        if self.state == "gameover":
            self.draw_gameover()
        self.draw_toasts()

    def draw_stars(self):
        c = self.c
        t = time.time()
        mx, my, mr = MOON
        for x, y, sp, sz, ph, br in self.stars:
            if (x - mx) ** 2 + (y - my) ** 2 < (mr + 8) ** 2:
                continue
            tw = 0.75 + 0.25 * math.sin(t * ph + x)
            g = min(255, int((90 + sp * 2.5) * br * tw))
            c.create_rectangle(x, y, x + sz, y + sz,
                               fill=f"#{g:02x}{g:02x}{min(255, g + 40):02x}",
                               outline="", tags="stars")
        m = self.meteor
        if m:
            k = max(0.0, min(1.0, m[4] / 0.9))
            for i in range(4):
                f0, f1 = i * 0.045, (i + 1) * 0.045
                col = mix("#ffffff", sky(m[1]), 1 - k * (1 - i * 0.25))
                c.create_line(m[0] - m[2] * f0, m[1] - m[3] * f0,
                              m[0] - m[2] * f1, m[1] - m[3] * f1,
                              fill=col, width=3 - i * 0.6, tags="stars")
        # stars sit above the sky but behind mountains / city / ground
        c.tag_lower("stars", self.front_first)

    def draw_bullet(self, b, ox, oy):
        trail = [(tx + ox, ty + oy) for tx, ty in b["trail"]]
        # ricochet bullets are drawn a little bigger so you can follow them
        self.draw_bullet_skin(self.bullet_skin, b["x"] + ox, b["y"] + oy,
                              trail, 1.3 if "bn" in b else b.get("s", 1.0))

    def draw_bullet_skin(self, sk, x, y, trail, s=1.0, bg=None, t=None):
        """One bullet with its trail, in the given skin (also used as the
        preview in the skin shop)."""
        c = self.c
        t = time.time() if t is None else t
        mode = sk.get("mode")
        n = len(trail)
        for i, (tx, ty) in enumerate(trail):
            k = (i + 1) / (n + 1)
            r = (1 + 2.5 * k) * s
            if mode == "rainbow":
                col = hsv(t * 0.9 + i * 0.09, 0.85, 1.0)
            elif mode == "fire":
                col = mix("#ff3b1f", "#ffd24d", k)
            elif mode == "duo":
                col = mix(sk["trail"], sk["trail2"], k)
            else:
                col = sk["trail"]
            if mode == "matrix":            # falling 0s and 1s
                c.create_text(tx, ty, text="01"[(i + int(t * 12)) % 2],
                              fill=mix(col, bg or sky(ty), 1 - k * 0.9),
                              font=(FONT, max(6, int(10 * s)), "bold"))
                continue
            fade_c = mix(col, bg or sky(ty), 1 - k * 0.85)
            if mode == "bubble":            # empty soap-bubble rings
                rb = r * 1.7
                c.create_oval(tx - rb, ty - rb, tx + rb, ty + rb,
                              outline=fade_c, width=1)
                continue
            if mode == "petal":             # fluttering petals
                px = tx + math.sin(i * 2.1 + t * 6) * 5 * s
                c.create_polygon(px, ty - r * 1.6, px + r * 1.1, ty,
                                 px, ty + r * 1.6, px - r * 1.1, ty,
                                 fill=fade_c, outline="")
                continue
            if mode == "heart":             # tiny hearts
                c.create_polygon(self.heart_pts(tx, ty, r * 1.3),
                                 fill=fade_c, outline="")
                continue
            if mode == "beam":              # drawn as one streak below
                continue
            c.create_oval(tx - r, ty - r, tx + r, ty + r,
                          fill=mix(col, bg or sky(ty), 1 - k * 0.85),
                          outline="")
            if mode == "sparkle" and (i + int(t * 18)) % 3 == 0:
                sx = tx + math.sin(i * 5 + t * 10) * 5 * s
                c.create_line(sx - 2 * s, ty, sx + 2 * s, ty,
                              fill="#ffffff", width=1)
                c.create_line(sx, ty - 2 * s, sx, ty + 2 * s,
                              fill="#ffffff", width=1)
        if mode == "zap" and n >= 1:        # jagged lightning along the trail
            pts = []
            for tx, ty in trail:
                pts += [tx + random.uniform(-5, 5) * s, ty]
            pts += [x, y]
            c.create_line(pts, fill="#ffffff", width=2)
            c.create_line([v + (random.uniform(-3, 3) * s if j % 2 == 0
                                else 0) for j, v in enumerate(pts)],
                          fill="#ffe84d", width=1)
        if mode == "rainbow":
            hue = t * 0.9
            glowc, body = hsv(hue, 0.8, 1.0), hsv(hue + 0.15, 0.3, 1.0)
            outline = hsv(hue, 0.9, 1.0)
        else:
            glowc, body, outline = sk["glow"], sk["body"], sk["outline"]
        glow(c, x, y, 13 * s, glowc, layers=3, a=0.55, bg=bg)
        if mode == "beam":                  # a thin laser streak
            top = trail[0][1] if trail else y + 16 * s
            c.create_line(x, min(top, y + 12 * s), x, y - 8 * s,
                          fill=mix(sk["trail"], bg or sky(y), 0.35),
                          width=3 * s, capstyle="round")
            c.create_line(x, y + 10 * s, x, y - 14 * s, fill=sk["trail"],
                          width=3 * s, capstyle="round")
            c.create_line(x, y + 9 * s, x, y - 12 * s, fill="#ffffff",
                          width=1.2 * s, capstyle="round")
            return
        if mode == "heart":
            c.create_polygon(self.heart_pts(x, y, 7.5 * s), fill=body,
                             outline=outline)
            c.create_oval(x - 3.5 * s, y - 4 * s, x - 1.5 * s, y - 2 * s,
                          fill="#ffffff", outline="")
            return
        if mode == "bubble":
            c.create_oval(x - 6 * s, y - 6 * s, x + 6 * s, y + 6 * s,
                          fill=mix(body, bg or sky(y), 0.7), outline=outline,
                          width=1)
            c.create_oval(x - 3.5 * s, y - 4 * s, x - 1 * s, y - 1.5 * s,
                          fill="#ffffff", outline="")
            return
        if mode == "orbit":                 # nucleus with 2 electrons
            ring = mix(sk["outline"], bg or sky(y), 0.55)
            for rx, ry in ((9, 4), (4, 9)):         # two crossed orbits
                c.create_oval(x - rx * s, y - ry * s, x + rx * s,
                              y + ry * s, outline=ring, width=1)
                ang = t * 9 + (0 if rx > ry else math.pi)
                ex, ey = x + math.cos(ang) * rx * s, y + math.sin(ang) * ry * s
                c.create_oval(ex - 1.8 * s, ey - 1.8 * s, ex + 1.8 * s,
                              ey + 1.8 * s, fill="#ffffff", outline="")
            c.create_oval(x - 3.5 * s, y - 3.5 * s, x + 3.5 * s, y + 3.5 * s,
                          fill=sk["glow"], outline=outline)
            c.create_oval(x - 1.5 * s, y - 1.5 * s, x + 1.5 * s, y + 1.5 * s,
                          fill="#ffffff", outline="")
            return
        if mode == "coin":                  # a coin spinning on its edge
            wd = max(0.6, abs(math.cos(t * 11))) * 6 * s
            c.create_oval(x - wd, y - 7 * s, x + wd, y + 7 * s, fill=body,
                          outline=outline, width=1)
            if wd > 3 * s:
                c.create_oval(x - wd * 0.55, y - 4 * s, x + wd * 0.55,
                              y + 4 * s, outline=mix(body, "#7a5a00", 0.5),
                              width=1)
            c.create_line(x - wd * 0.6, y - 4 * s, x - wd * 0.2, y - 6 * s,
                          fill="#ffffff", width=1)
            return
        if mode in ("rainbow", "void"):
            c.create_oval(x - 5 * s, y - 9 * s, x + 5 * s, y + 9 * s,
                          outline=hsv(t * 0.9 + 0.5, 0.8, 1.0)
                          if mode == "rainbow" else "#8a3dff", width=1)
        c.create_oval(x - 3 * s, y - 7 * s, x + 3 * s, y + 7 * s,
                      fill=body, outline=outline)
        c.create_oval(x - 1 * s, y - 4 * s, x + 1 * s, y + 2 * s,
                      fill=sk["core"], outline="")

    @staticmethod
    def heart_pts(cx, cy, hw):
        """Outline of a heart, hw = half its width (flat list of x, y)."""
        pts = []
        for j in range(16):
            a = j * math.tau / 16
            hx = 16 * math.sin(a) ** 3
            hy = -(13 * math.cos(a) - 5 * math.cos(2 * a)
                   - 2 * math.cos(3 * a) - math.cos(4 * a))
            pts += [cx + hx * hw / 16, cy + hy * hw / 16 + hw * 0.1]
        return pts

    def draw_missile(self, m, ox, oy):
        """A homing missile with a flame, plus a lock-on reticle on its target."""
        c = self.c
        t = time.time()
        x, y, a = m["x"] + ox, m["y"] + oy, m["a"]

        # lock-on reticle
        tg = m["target"]
        if tg is not None and not tg["dead"] and tg["mode"] != "dying" \
                and any(o is tg for o in self.ufos):
            s = UFO_SPECS[tg["kind"]]["size"]
            tx, ty = tg["x"] + ox, tg["y"] + oy
            r = s * 1.1 + 4 + 2 * math.sin(t * 10)
            col = mix("#ff3b3b", "#ffd0d0", 0.5 + 0.5 * math.sin(t * 12))
            kk = r * 0.45
            for sx, sy in ((-1, -1), (1, -1), (1, 1), (-1, 1)):
                cx, cy = tx + sx * r, ty + sy * r * 0.7
                c.create_line(cx - sx * kk, cy, cx, cy, cx, cy - sy * kk * 0.7,
                              fill=col, width=2)

        self.draw_missile_skin(self.missile_skin, x, y, a, m.get("s", 1.0),
                               m["age"], t)

    def draw_missile_skin(self, sk, x, y, a, s=1.0, age=0.0, t=None, bg=None):
        """One missile (flame, fins, body) pointing in direction `a`, in the
        given skin. Also used for the preview in the skin shop (scaled by s)."""
        c = self.c
        t = time.time() if t is None else t
        mode = sk["mode"]
        ca, sa = math.cos(a), math.sin(a)

        def P(d, w):                    # point d along the missile, w sideways
            return (x + (ca * d - sa * w) * s, y + (sa * d + ca * w) * s)

        def poly(pts, **kw):
            flat = []
            for px, py in pts:
                flat += [px, py]
            c.create_polygon(flat, **kw)

        if mode == "rainbow":
            hue = t * 0.9 + age
            body = hsv(hue, 0.55, 1.0)
            nose, fin = hsv(hue + 0.33, 0.8, 1.0), hsv(hue + 0.66, 0.8, 1.0)
            stripe = hsv(hue + 0.5, 0.9, 1.0)
            flame, flame2 = hsv(hue + 0.15, 0.8, 1.0), "#ffffff"
            gcol = hsv(hue, 0.7, 1.0)
        else:
            body, nose, fin = sk["body"], sk["nose"], sk["fin"]
            stripe, flame, flame2 = sk["stripe"], sk["flame"], sk["flame2"]
            gcol = sk["glow"]
        edge = mix(body, "#000000", 0.4)

        # exhaust flame
        fx, fy = P(-12, 0)
        if mode != "comet":
            glow(c, fx, fy, 16 * s, gcol, layers=3, a=0.6, bg=bg)
        L = (11 + 6 * math.sin(t * 45 + age * 30)) * (1.5 if mode == "fire"
                                                      else 1.0)
        poly([P(-9, -3), P(-9 - L, 0), P(-9, 3)], fill=flame, outline="")
        poly([P(-9, -1.7), P(-9 - L * 0.6, 0), P(-9, 1.7)], fill=flame2,
             outline="")

        if mode == "comet":                 # no rocket: a glowing star
            glow(c, x, y, 20 * s, gcol, layers=4, a=0.8, bg=bg)
            r = 7 * s
            c.create_oval(x - r, y - r, x + r, y + r, fill="#ffffff",
                          outline=mix("#ffffff", gcol, 0.5), width=1)
            r2 = 3.5 * s
            c.create_oval(x - r2, y - r2, x + r2, y + r2,
                          fill=mix("#ffffff", gcol, 0.35), outline="")
            for k in range(4):              # four-point sparkle
                ang = t * 3 + k * math.pi / 2
                p2 = (x + math.cos(ang) * 13 * s, y + math.sin(ang) * 13 * s)
                c.create_line(x, y, p2[0], p2[1], fill="#ffffff", width=1)
            return

        # fins, body, nose cone, stripe
        for sg in (-1, 1):
            poly([P(-10, sg * 3.4), P(-15, sg * 8.5), P(-4, sg * 3.4)],
                 fill=fin, outline="")
        poly([P(-10, -3.5), P(7, -3.5), P(14, 0), P(7, 3.5), P(-10, 3.5)],
             fill=body, outline=edge)
        if mode == "hazard":                # warning stripes along the body
            for d in (-9, -3, 3):
                poly([P(d, -3.5), P(d + 3, -3.5), P(d + 3, 3.5), P(d, 3.5)],
                     fill=stripe, outline="")
        elif mode == "snow":                # icy glints
            for d, w in ((-6, -1.5), (-1, 1.5), (3, -1)):
                r = 0.9 * s
                px, py = P(d, w)
                c.create_oval(px - r, py - r, px + r, py + r,
                              fill="#ffffff", outline="")
        elif mode == "fire":                # flame licks along the body
            poly([P(-10, -3.5), P(-4, -1), P(-1, -3.5)], fill=stripe,
                 outline="")
            poly([P(-10, 3.5), P(-4, 1), P(-1, 3.5)], fill=stripe, outline="")
        poly([P(7, -3.5), P(14, 0), P(7, 3.5)], fill=nose, outline="")
        if mode not in ("hazard", "fire"):
            poly([P(-3, -3.5), P(0, -3.5), P(0, 3.5), P(-3, 3.5)],
                 fill=stripe, outline="")

    def draw_charge(self, ox, oy):
        """The energy ball that grows at the gun's muzzle while V is held."""
        if not self.charging:
            return
        c = self.c
        t = time.time()
        tier = self.charge_tier()
        frac = min(1.0, self.charge_t / CHARGE_T[2])
        r = 5 + 19 * frac
        col = CHARGE_COL[tier]
        x = self.px + ox
        y = GROUND - 46 - r * 0.5 + oy
        pulse = 1 + 0.08 * math.sin(t * (12 + 4 * tier))
        glow(c, x, y, (r * 2.3 + 4) * pulse, col, layers=5, a=0.8)
        # energy being sucked in
        for i in range(6):
            ph = (t * 1.6 + i / 6) % 1.0
            ang = i * math.tau / 6 + t * 0.9
            d0 = r + 6 + (1 - ph) * 46
            d1 = d0 - 9
            c.create_line(x + math.cos(ang) * d0, y + math.sin(ang) * d0,
                          x + math.cos(ang) * d1, y + math.sin(ang) * d1,
                          fill=mix(sky(y), col, ph), width=2)
        c.create_oval(x - r, y - r, x + r, y + r,
                      fill=mix(col, "#000000", 0.4), outline=col, width=2)
        c.create_oval(x - r * 0.7, y - r * 0.7, x + r * 0.7, y + r * 0.7,
                      fill=col, outline="")
        c.create_oval(x - r * 0.35, y - r * 0.35, x + r * 0.35, y + r * 0.35,
                      fill="#ffffff", outline="")
        # orbiting sparks (more of them at higher levels)
        n = 3 + tier * 2
        for i in range(n):
            ang = t * (5 + tier) + i * math.tau / n
            rr = r * 1.55 + 4 * math.sin(t * 7 + i)
            sx, sy = x + math.cos(ang) * rr, y + math.sin(ang) * rr * 0.75
            c.create_oval(sx - 2, sy - 2, sx + 2, sy + 2,
                          fill=mix(col, "#ffffff", 0.6), outline="")
        # progress ring
        rr = r + 9
        c.create_arc(x - rr, y - rr, x + rr, y + rr, start=90,
                     extent=-359.9 * frac, style="arc", outline="#ffffff",
                     width=3)

    def draw_beams(self, ox, oy):
        """The laser beams: layered columns from the muzzle to the top."""
        c = self.c
        t = time.time()
        for bm in self.beams:
            tier = bm["tier"]
            col = BEAM_COL[tier - 1]
            age, dur = bm["t"], bm["dur"]
            env = max(0.0, min(1.0, age / 0.06, (dur - age) / 0.18))
            if env <= 0:
                continue
            hw = BEAM_HW[tier - 1] * env * (0.93 + 0.07 * math.sin(t * 70))
            x = bm["x"] + ox
            yb = GROUND - 40 + oy
            yt = -10 + oy
            bgc = sky(300)
            glow(c, x, yb, hw * 2.6 + 12, col, layers=4, a=0.7)
            for f, fill in ((1.7, mix(bgc, col, 0.16)),
                            (1.3, mix(bgc, col, 0.32)),
                            (1.0, mix(bgc, col, 0.72)),
                            (0.65, mix(col, "#ffffff", 0.55)),
                            (0.32, "#ffffff")):
                c.create_rectangle(x - hw * f, yt, x + hw * f, yb,
                                   fill=fill, outline="")
            # energy streaks racing up the beam
            span = yb - yt
            for i in range(10):
                yy = yb - ((t * 700 + i * 97) % span)
                sx = x + math.sin(i * 1.7) * hw * 0.6
                c.create_line(sx, yy, sx, yy - 18,
                              fill=mix(col, "#ffffff", 0.7), width=2)
            glow(c, x, yb, hw * 2 + 6, "#ffffff", layers=3, a=0.5)

    def draw_fx(self, ox, oy):
        c = self.c
        for x, y, maxr, life, mlife, col in self.rings:
            p = 1 - life / mlife
            r = maxr * (1 - (1 - p) ** 2)
            x, y = x + ox, y + oy
            if p < 0.25:                       # bright flash at the centre
                fr = maxr * 0.4 * (1 - p * 2)
                c.create_oval(x - fr, y - fr, x + fr, y + fr,
                              fill=mix("#ffffff", col, p * 4), outline="")
            c.create_oval(x - r, y - r, x + r, y + r,
                          outline=fade(col, y, p * 0.9),
                          width=max(1, 5 * (1 - p)))
        for x, y, vx, vy, life, col, mlife, kind in self.particles:
            k = max(0.0, life / mlife)
            x, y = x + ox, y + oy
            if kind == 2:                      # hull chunk
                r = 2 + 3 * k
                c.create_rectangle(x - r, y - r, x + r, y + r,
                                   fill=fade(col, y, (1 - k) * 0.8),
                                   outline="")
                continue
            if kind == 1:                      # smoke puff
                r = 3 + (1 - k) * 7
                c.create_oval(x - r, y - r, x + r, y + r,
                              fill=fade(col, y, 0.45 + 0.55 * (1 - k)),
                              outline="")
            else:                              # spark streak
                hot = mix(col, "#ffffff", max(0.0, k - 0.5))
                c.create_line(x, y, x - vx * 0.035, y - vy * 0.035,
                              fill=fade(hot, y, 1 - k), width=2,
                              capstyle="round")

    def draw_flash(self):
        """Screen-edge vignette for damage / boss kills (no alpha in tk)."""
        if self.hit_flash <= 0:
            return
        c = self.c
        k = min(1.0, self.hit_flash / 0.35)
        for i in range(7):
            col = mix(self.flash_col, "#05060f", 1 - k * (1 - i / 7))
            c.create_rectangle(i * 5 + 2, i * 5 + 2, W - i * 5 - 2,
                               H - i * 5 - 2, outline=col, width=5)

    def draw_banner(self):
        c = self.c
        t = self.banner
        a = max(0.0, min(1.0, (BANNER_T - t) / 0.35, t / 0.6))
        slide = -18 * (1 - min(1.0, (BANNER_T - t) / 0.35))
        boss = self.wave in (5, 10)
        bg = sky(H / 2)
        yy = H / 2 - 50 + slide
        shadow_text(c, W / 2, yy, f"WAVE {self.wave}",
                    mix(bg, "#ffffff", a), (FONT, 38, "bold"),
                    shade=mix(bg, "#000000", a))
        if boss:
            sub = ("GRANDMOTHERSHIP INCOMING!" if self.wave == 10
                   else "MOTHERSHIP INCOMING!")
            pulse = 0.65 + 0.35 * math.sin(time.time() * 10)
            shadow_text(c, W / 2, yy + 48, sub,
                        mix(bg, mix("#ff5a5a", "#ffb0b0", pulse), a),
                        (FONT, 18, "bold"), shade=mix(bg, "#000000", a))
        elif self.wave == 1:
            shadow_text(c, W / 2, yy + 44,
                        "T = homing missile   |   hold V to charge a laser",
                        mix(bg, "#9fe8ff", a), (FONT, 14, "bold"),
                        shade=mix(bg, "#000000", a), off=1)
            shadow_text(c, W / 2, yy + 68,
                        "B = ricochet burst   |   M = summon gun minions",
                        mix(bg, "#7fe8ff", a), (FONT, 12, "bold"),
                        shade=mix(bg, "#000000", a), off=1)

    def draw_ufo(self, u, ox, oy, scale=1.0):
        c = self.c
        kind = u["kind"]
        spec = UFO_SPECS[kind]
        s = spec["size"] * scale
        live = u["mode"] != "x"
        bob = math.sin(u["t"] * 3 + len(kind)) * 2 * scale
        x, y = u["x"] + ox, u["y"] + oy + bob
        color = spec["color"]
        flashing = u["flash"] > 0
        if u["mode"] == "dying":            # shake and strobe white
            x += random.uniform(-1, 1) * u["shk"]
            y += random.uniform(-1, 1) * u["shk"] * 0.5
            if int(u["dtm"] * (8 + 18 * u["prog"])) % 2 == 0:
                flashing = True
        body = "#ffffff" if flashing else color
        if kind == "diver" and u["mode"] == "aim" and not flashing \
                and int(u["t"] * 30) % 2 == 0:
            body = "#ffffff"
        dark = mix(color, "#000000", 0.5)
        light = mix(color, "#ffffff", 0.5)
        big = kind in ("boss", "grand")

        # ground shadow: grows and darkens as the UFO gets closer
        if live and u["y"] > -20:
            k = max(0.0, min(1.0, u["y"] / GROUND))
            sw = s * (0.45 + 0.7 * k)
            c.create_oval(x - sw, HORIZON + 6, x + sw, HORIZON + 12,
                          fill=mix("#10142a", "#03040a", 0.3 + 0.7 * k),
                          outline="")

        # diver targeting line
        if live and kind == "diver" and u["mode"] == "aim":
            k = 1 - u["timer"] / 0.9
            c.create_line(x, y, self.px + ox, GROUND + oy,
                          fill=fade("#ff4d6d", y, 0.7 - 0.7 * k),
                          dash=(3, 7), width=2)

        # glow
        glow(c, x, y + s * 0.2, s * (1.5 if big else 1.3), color,
             layers=4 if big else 3, a=0.45 if big else 0.32)

        if big:
            pr = s * (1.25 + 0.06 * math.sin(u["t"] * 4))
            c.create_oval(x - pr, y - s * 0.35, x + pr, y + s * 0.7,
                          outline=color, width=2)
        if kind == "grand":
            c.create_oval(x - s * 1.45, y - s * 0.5, x + s * 1.45, y + s * 0.9,
                          outline="#bfeaff", width=2, dash=(6, 4))

        # dome (with a little highlight)
        c.create_oval(x - s * 0.45, y - s * 0.75, x + s * 0.45, y + s * 0.1,
                      fill=spec["dome"], outline=mix(spec["dome"], color, 0.5))
        c.create_oval(x - s * 0.3, y - s * 0.62, x - s * 0.06, y - s * 0.38,
                      fill="#ffffff", outline="")
        # underside (darker) then main hull then top sheen = rounded look
        c.create_oval(x - s * 0.8, y + s * 0.02, x + s * 0.8, y + s * 0.52,
                      fill=dark, outline="")
        c.create_oval(x - s, y - s * 0.35, x + s, y + s * 0.4,
                      fill=body, outline=light, width=1)
        if not flashing:
            c.create_oval(x - s * 0.78, y - s * 0.3, x + s * 0.3, y - s * 0.06,
                          fill=mix(body, "#ffffff", 0.3), outline="")
            c.create_arc(x - s * 0.95, y - s * 0.3, x + s * 0.95, y + s * 0.36,
                         start=200, extent=140, style="arc",
                         outline=dark, width=1)

        # rim lights that chase around the hull
        n = {"boss": 9, "grand": 13}.get(kind, 5)
        pos = int(u["t"] * 8) % n
        lr = max(1.5, 2 * scale)
        for i in range(n):
            lx = x + (i - (n - 1) / 2) * (s * 1.5 / max(1, n - 1))
            d = (i - pos) % n
            lc = ("#ffffb0", "#ffd24d", "#a08a30")[d] if d < 3 else "#44402a"
            c.create_oval(lx - lr, y + s * 0.04 - lr, lx + lr,
                          y + s * 0.04 + lr + 1, fill=lc, outline="")

        warning = u.get("shot_warning", 0.0)
        if live and warning > 0.05 and u["mode"] != "dying" \
                and not (kind == "diver" and u["mode"] == "aim"):
            pulse = 0.5 + 0.5 * math.sin(time.time() * 18)
            ring = min(s * 1.25, 70)
            warn_col = "#fff200" if getattr(
                self, "high_contrast", False) else mix("#ff4d6d", "#ffe066", pulse)
            c.create_oval(x - ring, y - ring * 0.62,
                          x + ring, y + ring * 0.62,
                          outline=warn_col, width=2, dash=(5, 3))
            c.create_text(x, y - s * 0.9 - 8, text="!",
                          fill=warn_col, font=(FONT, 12, "bold"))

        if kind == "diver" and u["mode"] == "aim":
            warn_col = "#fff200" if getattr(
                self, "high_contrast", False) else "#ff4d6d"
            c.create_text(x, y - s - 12, text="!", fill=warn_col,
                          font=(FONT, 14, "bold"))
        if u["mode"] == "dying":            # glowing cracks spread over the hull
            rng = random.Random(u["seed"])
            for _ in range(1 + int(u["prog"] * 9)):
                a = rng.uniform(0, math.tau)
                px = x + rng.uniform(-0.3, 0.3) * s
                py = y + rng.uniform(-0.1, 0.1) * s
                pts = [px, py]
                for _j in range(4):
                    a += rng.uniform(-0.7, 0.7)
                    px += math.cos(a) * s * 0.28
                    py += math.sin(a) * s * 0.12
                    pts += [px, py]
                c.create_line(pts, fill="#ffe9a0", width=2)
        # small health bar (bosses get a big one at the top of the screen)
        if live and not big and u["hp"] < u["maxhp"]:
            bw = s * 1.6
            frac = max(0, u["hp"] / u["maxhp"])
            c.create_rectangle(x - bw / 2 - 1, y - s - 8, x + bw / 2 + 1,
                               y - s - 1, fill="#1a0a0a", outline="#552222")
            c.create_rectangle(x - bw / 2, y - s - 7, x - bw / 2 + bw * frac,
                               y - s - 2, fill=mix("#ff3b3b", "#ffd24d", frac),
                               outline="")

    def draw_player(self, ox, oy):
        if self.inv > 0 and int(self.inv * 14) % 2 == 0:
            return
        self.draw_gun(self.px + ox, GROUND + oy, self.gun_skin, 1.0,
                      self.shots, self.recoil, self.level["damage"],
                      self.muzzle, self.bullet_skin)

    def draw_gun(self, x, y, skin, sc=1.0, shots=1, rec=0.0, dmg=0,
                 muzzle=0.0, bskin=None, bg=None, t=None):
        """The player's gun: armoured turret, finned base, a pattern panel and
        proper barrels with breech, rings and a muzzle brake. `sc` scales it
        (the skin shop draws small previews)."""
        c = self.c
        t = time.time() if t is None else t
        bgc = bg or sky(y)
        pat = skin["pattern"]
        base, plate, dark = skin["base"], skin["plate"], skin["dark"]
        accent, trim = skin["accent"], skin["trim"]
        barrel, core = skin["barrel"], skin["core"]
        if pat == "prism":
            accent = hsv(t * 0.4, 0.65, 1.0)
            trim = mix(accent, "#ffffff", 0.5)
            core = accent
        dl = min(1.0, dmg / 10)
        barrel = mix(barrel, "#ffd24d", dl * 0.45)

        def pl(pts, **kw):
            flat = []
            for px, py in pts:
                flat += [x + px * sc, y + py * sc]
            return c.create_polygon(flat, **kw)

        def ln(p1, p2, col, w=1.0):
            c.create_line(x + p1[0] * sc, y + p1[1] * sc,
                          x + p2[0] * sc, y + p2[1] * sc,
                          fill=col, width=max(1.0, w * sc))

        glow(c, x, y + 20 * sc, 48 * sc, accent, layers=3, a=0.3, bg=bgc)

        # ---- barrels
        n = max(1, shots)
        hw = 3.6 + 2.4 * dl
        if n > 1:
            hw *= max(0.55, 1 - 0.11 * (n - 1))
        L = 38 - rec
        dark_m = mix(barrel, "#000000", 0.45)
        for i in range(n):
            a = (i - (n - 1) / 2) * 0.14
            sa, ca = math.sin(a), math.cos(a)

            def B(d, w, sa=sa, ca=ca):
                return (sa * d + ca * w, -2 - ca * d + sa * w)

            # tube (slides back with the recoil), shaded in two tones + glint
            pl([B(2, -hw * .85), B(2, hw * .85), B(L - 8, hw * .72),
                B(L - 8, -hw * .72)], fill=dark_m, outline="")
            pl([B(2, -hw * .85), B(2, -hw * .05), B(L - 8, -hw * .05),
                B(L - 8, -hw * .72)], fill=barrel, outline="")
            pl([B(3, -hw * .6), B(3, -hw * .38), B(L - 9, -hw * .32),
                B(L - 9, -hw * .52)], fill=mix(barrel, "#ffffff", .65),
               outline="")
            for j, d0 in enumerate((L - 25, L - 17)):      # accent rings
                rc = hsv(t * 0.5 + j * 0.2, 0.7, 1.0) if pat == "prism" \
                    else accent
                pl([B(d0, -hw * .92), B(d0, hw * .92), B(d0 + 3, hw * .92),
                    B(d0 + 3, -hw * .92)], fill=rc, outline="")
            # breech block (stays put)
            pl([B(0, -hw * 1.3), B(0, hw * 1.3), B(11, hw * 1.12),
                B(11, -hw * 1.12)], fill=dark, outline=trim, width=1)
            pl([B(5, -hw * 1.2), B(5, hw * 1.2), B(7, hw * 1.17),
                B(7, -hw * 1.17)], fill=accent, outline="")
            # muzzle brake with slots and a dark bore
            m0 = L - 8
            pl([B(m0, -hw * 1.1), B(m0, hw * 1.1), B(L, hw * 1.32),
                B(L, -hw * 1.32)], fill=dark_m, outline=trim, width=1)
            for d in (m0 + 2.7, m0 + 5.3):
                ln(B(d, -hw * 1.2), B(d, hw * 1.2), dark, 1.2)
            tip = B(L, 0)
            r = hw * 0.5 * sc
            c.create_oval(x + tip[0] * sc - r, y + tip[1] * sc - r * .6,
                          x + tip[0] * sc + r, y + tip[1] * sc + r * .6,
                          fill="#05060f", outline="")

        # ---- muzzle flash (coloured like the bullet skin)
        if muzzle > 0:
            k = muzzle / 0.07
            fcol = bskin["glow"] if bskin else "#ffe9a0"
            if bskin and bskin.get("mode") == "rainbow":
                fcol = hsv(t * 0.9, 0.7, 1.0)
            for i in range(n):
                a = (i - (n - 1) / 2) * 0.14
                tx = x + math.sin(a) * (L + 3) * sc
                ty = y + (-2 - math.cos(a) * (L + 3)) * sc
                glow(c, tx, ty, (10 + 12 * k) * sc, fcol, layers=3, a=0.9,
                     bg=bgc)
                r = (3 + 5 * k) * sc
                c.create_oval(tx - r, ty - r, tx + r, ty + r,
                              fill=mix(fcol, "#ffffff", 0.75), outline="")

        # ---- side fins with blinking lights
        for sg in (-1, 1):
            pl([(sg * 38, 30), (sg * 28, 10), (sg * 20, 30)], fill=dark,
               outline=accent, width=1)
            pl([(sg * 33, 29), (sg * 28, 16), (sg * 25, 29)], fill=plate,
               outline="")
            blink = 0.5 + 0.5 * math.sin(t * 5 + sg)
            lx, ly = x + sg * 28 * sc, y + 11 * sc
            glow(c, lx, ly, 6 * sc, accent, layers=2, a=0.2 + 0.5 * blink,
                 bg=bgc)
            c.create_oval(lx - 1.5 * sc, ly - 1.5 * sc, lx + 1.5 * sc,
                          ly + 1.5 * sc, fill=mix(accent, "#ffffff", .5),
                          outline="")

        # ---- base, patterned plate, foot
        pl([(-30, 30), (-19, 0), (19, 0), (30, 30)], fill=base,
           outline=trim, width=2)
        for sg in (-1, 1):
            ln((sg * 26, 28), (sg * 18, 3), mix(trim, base, 0.35), 1)
        pl(GUN_PLATE, fill=plate, outline="")
        self.gun_pattern(x, y, sc, pat, accent, trim, dark, plate, t, pl, ln)
        pl(GUN_PLATE, fill="", outline=mix(trim, base, 0.4), width=1)
        c.create_rectangle(x - 33 * sc, y + 26 * sc, x + 33 * sc, y + 30 * sc,
                           fill=dark, outline=accent)

        # ---- turret ring and glowing core
        glow(c, x, y + 1 * sc, 19 * sc, core, layers=3, a=0.75, bg=bgc)
        c.create_oval(x - 15 * sc, y - 9 * sc, x + 15 * sc, y + 9 * sc,
                      fill=dark, outline=trim, width=2)
        c.create_oval(x - 10 * sc, y - 6 * sc, x + 10 * sc, y + 6 * sc,
                      fill=core,
                      outline=mix(core, "#ffffff", 0.35 + 0.25 * math.sin(t * 4)))
        c.create_oval(x - 6 * sc, y - 4 * sc, x - 1 * sc, y - 1 * sc,
                      fill=mix(core, "#ffffff", 0.8), outline="")

    def gun_pattern(self, x, y, sc, pat, accent, trim, dark, plate, t, pl, ln):
        """Pattern drawn on the gun's front plate, clipped to the plate."""
        c = self.c

        def clipped(pts, **kw):
            q = clip_convex(pts, GUN_PLATE)
            if len(q) >= 3:
                pl(q, **kw)

        if pat == "hazard":
            pl(GUN_PLATE, fill="#161616", outline="")
            for i in range(-1, 6):
                x0 = i * 9
                clipped([(x0, 5), (x0 + 4.5, 5), (x0 + 4.5 - 22, 27),
                         (x0 - 22, 27)], fill=accent, outline="")
        elif pat == "camo":
            pl(GUN_PLATE, fill="#35552f", outline="")
            for poly, col in CAMO:
                clipped(poly, fill=col, outline="")
        elif pat == "flame":
            pl(GUN_PLATE, fill="#2a0c08", outline="")
            for j, cx in enumerate(range(-18, 19, 6)):
                h = 12 + 5 * math.sin(t * 6 + j * 1.7) + (j % 2) * 4
                clipped([(cx - 4, 27), (cx - 3, 27 - h * .45),
                         (cx - .5, 27 - h * .6), (cx, 27 - h),
                         (cx + 1.5, 27 - h * .55), (cx + 4, 27 - h * .4),
                         (cx + 4, 27)], fill="#ff5a1f", outline="")
                h2 = h * 0.6
                clipped([(cx - 2, 27), (cx - 1, 27 - h2 * .5), (cx, 27 - h2),
                         (cx + 1, 27 - h2 * .5), (cx + 2, 27)],
                        fill="#ffd24d", outline="")
        elif pat == "circuit":
            pl(GUN_PLATE, fill="#07121c", outline="")
            for path in CIRCUIT:
                for a, b in zip(path, path[1:]):
                    ln(a, b, mix(accent, "#07121c", 0.35), 1.0)
                for px, py in (path[0], path[-1]):
                    r = 1.6 * sc
                    c.create_oval(x + px * sc - r, y + py * sc - r,
                                  x + px * sc + r, y + py * sc + r,
                                  fill=accent, outline="")
            path = CIRCUIT[int(t * 1.2) % len(CIRCUIT)]
            px, py = polyline_point(path, (t * 1.2) % 1.0)
            glow(c, x + px * sc, y + py * sc, 7 * sc, trim, layers=2, a=0.6,
                 bg="#07121c")
            r = 1.8 * sc
            c.create_oval(x + px * sc - r, y + py * sc - r, x + px * sc + r,
                          y + py * sc + r, fill="#ffffff", outline="")
        elif pat == "galaxy":
            pl(GUN_PLATE, fill="#0c0620", outline="")
            clipped(ellipse_poly(-8 + 3 * math.sin(t * 0.5), 14, 14, 8),
                    fill="#3b1f8f", outline="")
            clipped(ellipse_poly(9, 19 + 2 * math.cos(t * 0.4), 11, 7),
                    fill="#7a2fb0", outline="")
            clipped(ellipse_poly(-2, 13, 7, 4), fill="#b86be0", outline="")
            for sx, sy, ph in GALAXY_STARS:
                tw = 0.5 + 0.5 * math.sin(t * ph + sx)
                r = (0.7 + 0.7 * tw) * sc
                c.create_rectangle(x + sx * sc - r, y + sy * sc - r,
                                   x + sx * sc + r, y + sy * sc + r,
                                   fill=mix("#3b1f8f", "#ffffff",
                                            0.35 + 0.65 * tw), outline="")
        elif pat == "carbon":
            pl(GUN_PLATE, fill="#101014", outline="")
            for row in range(8):                        # woven checker
                for col in range(-5, 6):
                    if (row + col) % 2 == 0:
                        x0, y0 = col * 5.5, 5 + row * 3
                        clipped([(x0, y0), (x0 + 5.5, y0), (x0 + 5.5, y0 + 3),
                                 (x0, y0 + 3)], fill="#22222a", outline="")
            clipped([(-22, 19), (22, 19), (22, 21.5), (-22, 21.5)],
                    fill=accent, outline="")             # racing stripe
        elif pat == "ice":
            pl(GUN_PLATE, fill="#16384f", outline="")
            for pts, col in (([(-17, 27), (-12, 9), (-7, 27)], "#3a9bd0"),
                             ([(-7, 27), (-1, 6), (5, 27)], "#4fb4e6"),
                             ([(5, 27), (11, 11), (17, 27)], "#3a9bd0")):
                clipped(pts, fill=col, outline="")
                clipped([pts[0], pts[1], (pts[1][0], pts[0][1])],
                        fill=mix(col, "#ffffff", 0.45), outline="")
            x0 = -30 + (t * 28) % 80                    # passing glint
            clipped([(x0, 5), (x0 + 5, 5), (x0 - 8, 27), (x0 - 13, 27)],
                    fill="#bfeeff", outline="")
        elif pat == "bio":
            pl(GUN_PLATE, fill="#0f2412", outline="")
            clipped([(-22, 20), (22, 20), (22, 27), (-22, 27)],
                    fill="#1c4a22", outline="")           # sludge pool
            for i in range(7):                           # rising bubbles
                ph = (t * 0.5 + i * 0.37) % 1.0
                bx = -16 + i * 5.3 + math.sin(t * 2 + i) * 2
                by = 27 - ph * 22
                br = 1.2 + (i % 3) * 0.8
                clipped(ellipse_poly(bx, by, br, br, 8),
                        fill=mix(accent, "#0f2412", 0.3 + 0.6 * ph),
                        outline="")
        elif pat == "grid":
            pl(GUN_PLATE, fill="#12082a", outline="")
            clipped([(math.cos(math.pi + i * math.pi / 8) * 9,
                      14 + math.sin(math.pi + i * math.pi / 8) * 9)
                     for i in range(9)], fill="#ff9a3b", outline="")   # sun
            clipped([(-22, 14), (22, 14), (22, 27), (-22, 27)],
                    fill="#1a0b30", outline="")           # ground
            hw = lambda yy: 14 + (yy - 5) * 8 / 22
            for i in range(5):                           # scrolling lines
                yy = 14 + ((i + (t * 0.8) % 1.0) / 5) ** 1.6 * 13
                ln((-hw(yy), yy), (hw(yy), yy), accent, 1.0)
            for xx in (-18, -9, 0, 9, 18):
                ln((xx * 0.3, 14), (xx * 1.3, 27), trim, 1.0)
        elif pat == "gold":
            pl(GUN_PLATE, fill="#a37c1c", outline="")
            for row in range(5):                         # diamond lattice
                for col in range(-3, 4):
                    cx, cy = col * 8 + (row % 2) * 4, 8 + row * 5
                    clipped([(cx, cy - 3), (cx + 3.5, cy), (cx, cy + 3),
                             (cx - 3.5, cy)], fill="#c9a02c", outline="")
            x0 = -30 + (t * 30) % 80                    # gleaming shine
            clipped([(x0, 5), (x0 + 4, 5), (x0 - 9, 27), (x0 - 13, 27)],
                    fill="#fff6c0", outline="")
        elif pat == "checker":
            pl(GUN_PLATE, fill="#f2f2f2", outline="")
            off = (t * 8) % 11                          # scrolling squares
            for row in range(5):
                for col in range(-6, 6):
                    if (row + col) % 2 == 0:
                        x0, y0 = col * 5.5 + off, 5 + row * 4.4
                        clipped([(x0, y0), (x0 + 5.5, y0), (x0 + 5.5, y0 + 4.4),
                                 (x0, y0 + 4.4)], fill="#141414", outline="")
        elif pat == "tiger":
            pl(GUN_PLATE, fill="#d9781c", outline="")
            for i in range(-5, 5):
                x0 = i * 5 + (i % 2) * 1.5
                clipped([(x0, 5), (x0 + 2.4, 5), (x0 + 3.4, 16), (x0 + 1.4, 27),
                         (x0 - 1.2, 27), (x0 + 0.8, 16)],
                        fill="#1a0e06", outline="")
            clipped([(-22, 25), (22, 25), (22, 27), (-22, 27)],
                    fill="#f6e0b8", outline="")         # pale belly
        elif pat == "ocean":
            pl(GUN_PLATE, fill="#0a3a6a", outline="")
            for j, col in enumerate(("#1b78c0", "#12589a", "#0b3d72")):
                yb = 19.5 + j * 2.8         # (only the lower strip is visible)
                top = [(xx, yb + math.sin(xx * 0.32 + t * 3 + j * 1.7) * 2)
                       for xx in range(-24, 25, 4)]
                clipped(top + [(24, 27), (-24, 27)], fill=col, outline="")
                if j == 0:                              # foamy crest
                    for a, b in zip(top, top[1:]):
                        ln(a, b, "#e6fbff", 1.0)
        elif pat == "digital":
            pl(GUN_PLATE, fill="#030a05", outline="")
            fsz = max(4, int(5 * sc))
            for i in range(8):
                cx = -18 + i * 5.2
                for k in range(4):
                    ty = 17 + (t * (7 + i * 1.5) + k * 2.6 + i * 3) % 10
                    if abs(cx) > 14 + (ty - 5) * 8 / 22 - 2:
                        continue                        # outside the plate
                    c.create_text(x + cx * sc, y + ty * sc,
                                  text="01"[(i + k + int(t * 6)) % 2],
                                  fill=mix(accent, "#030a05", 0.2 + k * 0.22)
                                  if k else "#ffffff",
                                  font=(FONT, fsz, "bold"))
        elif pat == "lava":
            pl(GUN_PLATE, fill="#1a0a06", outline="")
            wob = math.sin(t * 2.5)
            clipped([(-22, 22 + wob), (-10, 20 - wob), (0, 22 + wob),
                     (10, 20 - wob), (22, 22 + wob), (22, 27), (-22, 27)],
                    fill="#c2400f", outline="")         # bubbling pool
            for idx, path in enumerate(LAVA_CRACKS):
                glowc = mix(accent, trim, 0.5 + 0.5 * math.sin(t * 3 + idx))
                for a, b in zip(path, path[1:]):
                    ln(a, b, mix(glowc, "#1a0a06", 0.55), 3)
                    ln(a, b, glowc, 1.3)
        elif pat == "storm":
            phase = (t * 0.9) % 3.0
            flash = phase < 0.2 or 0.3 < phase < 0.4
            pl(GUN_PLATE, fill="#3a3a5a" if flash else "#141830", outline="")
            for cx, cy, rx, ry in ((-11, 21.5, 9, 2.8), (6, 21, 9, 2.8),
                                   (-2, 24, 12, 2.6), (14, 24.5, 8, 2.2),
                                   (-16, 25, 7, 2.2)):
                clipped(ellipse_poly(cx + math.sin(t * 0.6 + cx) * 1.5, cy,
                                     rx, ry),
                        fill="#6a72a0" if flash else "#2e3560", outline="")
            if flash:                                   # the lightning bolt
                bolt = [(1, 19.5), (-2.5, 22.5), (2, 23.5), (-1.5, 27)]
                for a, b in zip(bolt, bolt[1:]):
                    ln(a, b, "#fff6a8", 3)
                    ln(a, b, "#ffffff", 1.2)
        elif pat == "skull":
            # (only the lower strip of the plate shows, so this is a small
            # skull with crossbones)
            pl(GUN_PLATE, fill="#161616", outline="")
            for sg in (-1, 1):                          # crossbones
                for (x1, y1, x2, y2) in ((9, 20.5, 17, 26.5),
                                         (9, 26.5, 17, 20.5)):
                    ln((sg * x1, y1), (sg * x2, y2), "#d8d8d8", 2.2)
                for ex in (9, 17):
                    for ey in (20.5, 26.5):
                        r = 1.3 * sc
                        c.create_oval(x + sg * ex * sc - r, y + ey * sc - r,
                                      x + sg * ex * sc + r, y + ey * sc + r,
                                      fill="#d8d8d8", outline="")
            pl(ellipse_poly(0, 22.6, 5.2, 3.8, 16), fill="#ececec", outline="")
            pl([(-2.8, 24.5), (2.8, 24.5), (2.4, 27), (-2.4, 27)],
               fill="#e0e0e0", outline="")
            for xx in (-1, 0, 1):                       # teeth
                ln((xx, 25.6), (xx, 27), "#3a3a3a", 0.8)
            pulse = 0.5 + 0.5 * math.sin(t * 4)
            eye = mix("#ff3b3b", "#ffb0b0", pulse)
            for sg in (-1, 1):
                ex, ey = sg * 2.1, 22.4
                pl(ellipse_poly(ex, ey, 1.5, 1.7, 8), fill="#2a0a0a",
                   outline="")
                pl(ellipse_poly(ex, ey, 0.9, 1.1, 8), fill=eye, outline="")
            pl([(0, 23.8), (-0.8, 25), (0.8, 25)], fill="#2a2a2a", outline="")
        elif pat == "prism":
            w = 44 / 7
            for i in range(7):
                col = mix(hsv(t * 0.35 + i / 7, 0.75, 1.0), "#000000", 0.25)
                clipped([(-22 + i * w, 5), (-22 + (i + 1) * w, 5),
                         (-22 + (i + 1) * w, 27), (-22 + i * w, 27)],
                        fill=col, outline="")
        else:                                  # plain: vents and a status bar
            for yy in (11, 16, 21):
                ln((-12, yy), (12, yy), dark, 2)
            pl([(-6, 23), (6, 23), (6, 25), (-6, 25)], fill=accent,
               outline="")

    def draw_hud(self):
        c = self.c
        panel = dict(fill="#0b0f26", outline="#3a4690", width=2)

        # score
        rrect(c, 8, 8, 176, 42, 9, **panel)
        c.create_text(20, 25, anchor="w", fill="#8a93c9",
                      font=(FONT, 9, "bold"), text="SCORE")
        pop = self.score_pop
        c.create_text(166, 25, anchor="e",
                      fill=mix("#ffffff", "#7CFC00", min(1.0, pop * 4)),
                      font=(FONT, 13 + int(pop * 28), "bold"),
                      text=str(int(self.disp_score)))
        c.create_text(14, 54, anchor="w", fill="#4dd8ff",
                      font=(FONT, 9, "bold"),
                      text=f"GEMS +{int(self.score / 100 + 0.5)}")
        self.draw_weapons_hud()
        # wave + progress
        boss = _boss_for_wave(self.wave) is not None
        rrect(c, W / 2 - 92, 8, W / 2 + 92, 52, 9, **panel)
        c.create_text(W / 2, 21, fill="#ff8a8a" if boss else "#9fb0ff",
                      font=(FONT, 12, "bold"), text=f"WAVE {self.wave}")
        remaining = len(self.queue) + sum(1 for u in self.ufos if not u["dead"])
        total = max(self.wave_total, remaining, 1)
        frac = 1 - remaining / total
        bx1, bx2 = W / 2 - 74, W / 2 + 74
        c.create_rectangle(bx1, 36, bx2, 44, fill="#171c3e", outline="")
        if frac > 0:
            c.create_rectangle(bx1, 36, bx1 + (bx2 - bx1) * frac, 44,
                               fill="#ff6b6b" if boss else "#7CFC00",
                               outline="")
        # credits
        rrect(c, W - 176, 8, W - 8, 42, 9, **panel)
        c.create_text(W - 164, 25, anchor="w", fill="#8a93c9",
                      font=(FONT, 9, "bold"), text="CREDITS")
        c.create_text(W - 18, 25, anchor="e", fill="#ffe066",
                      font=(FONT, 13, "bold"), text=str(self.credits))

        if self.run_objectives:
            x1, x2 = W - 158, W - 8
            rrect(c, x1, 58, x2, 151, 8, fill="#090e20",
                  outline="#354264", width=1)
            c.create_text(x1 + 8, 68, anchor="w", text="FLIGHT OBJECTIVES",
                          fill="#93a5ca", font=(FONT, 7, "bold"))
            for i, objective in enumerate(self.run_objectives):
                yy = 83 + i * 21
                done = objective["completed"]
                color = "#7CFC00" if done else "#d6def1"
                c.create_text(x1 + 8, yy, anchor="w",
                              text=objective["title"], fill=color,
                              font=(FONT, 7, "bold"))
                progress = (objective["target"] if done
                            else objective["progress"])
                c.create_text(x2 - 8, yy, anchor="e",
                              text="DONE" if done
                              else f"{progress}/{objective['target']}",
                              fill="#7CFC00" if done else "#8a93c9",
                              font=(FONT, 7, "bold"))
                bx1, bx2, by = x1 + 8, x2 - 8, yy + 7
                c.create_rectangle(bx1, by, bx2, by + 3,
                                   fill="#202944", outline="")
                frac = progress / objective["target"]
                if frac > 0:
                    c.create_rectangle(bx1, by, bx1 + (bx2 - bx1) * frac,
                                       by + 3, fill=color, outline="")

        # boss health bar
        bosses = [u for u in self.ufos
                  if u["kind"] in ("boss", "grand") and not u["dead"]
                  and u["mode"] != "dying"]
        if bosses:
            u = bosses[0]
            spec = UFO_SPECS[u["kind"]]
            x1, x2 = 170, W - 170
            rrect(c, x1 - 5, 60, x2 + 5, 84, 8, fill="#14080c",
                  outline=spec["color"], width=2)
            frac = max(0.0, u["hp"] / u["maxhp"])
            if frac > 0:
                c.create_rectangle(x1, 66, x1 + (x2 - x1) * frac, 78,
                                   fill=spec["color"], outline="")
                c.create_rectangle(x1, 66, x1 + (x2 - x1) * frac, 70,
                                   fill=mix(spec["color"], "#ffffff", 0.4),
                                   outline="")
            c.create_text(W / 2, 72, text=spec["name"].upper(),
                          fill="#ffffff", font=(FONT, 8, "bold"))

        # hull (segmented)
        rrect(c, 8, H - 40, 340, H - 8, 9, **panel)
        c.create_text(20, H - 24, anchor="w", fill="#ff9a9a",
                      font=(FONT, 10, "bold"), text="HULL")
        n = self.max_hp
        x0, total_w, gap = 62, 210, 3
        sw = (total_w - (n - 1) * gap) / n
        hurt = self.inv > 0
        for i in range(n):
            sx = x0 + i * (sw + gap)
            if i < self.hp:
                col = "#ffffff" if hurt else mix("#ff3b3b", "#ff9a7a",
                                                 i / max(1, n - 1))
            else:
                col = "#3a1818"
            c.create_rectangle(sx, H - 31, sx + sw, H - 17, fill=col,
                               outline="")
        c.create_text(x0 + total_w + 10, H - 24, anchor="w", fill="#ff9a9a",
                      font=(FONT, 10), text=f"{max(0, self.hp)}/{self.max_hp}")

        # gun stats
        rrect(c, W - 372, H - 40, W - 8, H - 8, 9, **panel)
        c.create_text(W - 20, H - 24, anchor="e", fill="#8a93c9",
                      font=(FONT, 10),
                      text=f"DMG {self.damage}  |  Barrels {self.shots}  |  "
                           f"Pierce {self.pierce}  |  Knock {self.knock}  |  "
                           f"{1 / self.delay:.1f} shots/s")

    def draw_weapons_hud(self):
        """Little gauges for the homing missile (T), the charge beam (V) and
        the ricochet burst (B)."""
        c = self.c
        rrect(c, 8, 66, 160, 152, 9, fill="#0b0f26", outline="#3a4690",
              width=2)
        # minions: time left while they are out, otherwise the cooldown
        active = bool(self.minions)
        ready = self.minion_cd <= 0
        left = max((mn["life"] for mn in self.minions), default=0.0)
        ability_bar_x1, ability_bar_x2 = 104, 150
        c.create_text(16, 138, anchor="w",
                      fill="#ffe066" if (ready or active) else "#8a93c9",
                      font=(FONT, 9, "bold"),
                      text=f"[M] {left:.0f}s LEFT" if active else "[M] MINIONS")
        c.create_rectangle(ability_bar_x1, 134, ability_bar_x2, 142,
                           fill="#171c3e", outline="")
        if active:
            frac, col = left / MINION_LIFE, "#4dd8ff"
        else:
            frac = 1.0 if ready else 1 - self.minion_cd / MINION_CD
            col = "#7CFC00" if ready else "#b36bff"
        c.create_rectangle(ability_bar_x1, 134,
                           ability_bar_x1 + (ability_bar_x2 - ability_bar_x1)
                           * frac, 142, fill=col, outline="")

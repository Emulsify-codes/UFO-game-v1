def wx_clear(self):
    """Forget any weather (called between waves and on reset)."""
    self.weather = None          # None | "wormhole" | "flare"
    self.wh = None               # the open portal, if any
    self.wh_times = []           # seconds (since wave start) portals open at
    self.wh_clock = 0.0
    self.freeze_t = 0.0
    self.freeze_px = getattr(self, "px", W / 2)


def wx_reset(self):
    _wx_reset(self)
    wx_clear(self)
    self.wh_appearances = 0
    self.weather_banner = 0.0
    self._wx_wave = 0
    self._wx_cleared = 0


def wx_roll(self):
    """Decide the weather for the wave that just started."""
    wx_clear(self)
    w = self.wave
    if not WEATHER_ENABLED or w < WORMHOLE_START_WAVE:
        return
    if BOSS_WAVES.get(w) and not WEATHER_ON_BOSS_WAVES:
        return
    chance = WEATHER_CHANCE
    if self.run_mode == "adaptive":
        chance = min(0.65, chance + 0.07 * self.adaptive_pressure)
    if random.random() >= chance:
        return
    pool = ["wormhole"]
    if w >= FLARE_START_WAVE:
        pool.append("flare")
    self.weather = random.choice(pool)
    self.weather_banner = WEATHER_BANNER_T
    if self.weather == "wormhole":
        self.wh_times = [random.uniform(*WORMHOLE_DELAY)]
        self.sfx("warn")
    else:
        self.sfx("flare")


# ---- wormhole -------------------------------------------------------------
def wx_open_wormhole(self):
    x = min(W - 60, max(60, self.px + random.uniform(-140, 140)))
    max_radius = math.ceil(math.hypot(W, H) * WORMHOLE_RADIUS / 46)
    radius = min(max_radius, round(
        WORMHOLE_RADIUS * WORMHOLE_GROWTH ** self.wh_appearances))
    self.wh_appearances += 1
    self.wh = dict(x=x, y=150.0, r=radius, t=0.0, fired=False, done_t=0.0)
    self.sfx("wormhole")


def wx_freeze(self, secs):
    self.freeze_t = secs
    self.freeze_px = self.px
    self.cancel_charge()
    self.hit_flash = 0.4
    self.flash_col = "#4dd8ff"
    self.shake = max(self.shake, 0.2)
    self.explode(self.px, GROUND - 10, "#9fe8ff", 24, 260)
    self.rings.append([self.px, GROUND - 20, 120, 0.5, 0.5, "#9fe8ff"])
    self.floaters.append([self.px, GROUND - 70, "FROZEN!", 1.2])
    self.sfx("freeze")


def wx_update_wormhole(self, dt):
    self.wh_clock += dt
    w = self.wh
    if w is None:
        if self.wh_times and self.freeze_t <= 0 \
                and self.wh_clock >= self.wh_times[0]:
            self.wh_times.pop(0)
            self.open_wormhole()
        return
    w["t"] += dt
    if not w["fired"]:
        if not WORMHOLE_DODGEABLE:      # the zone homes in on you
            w["x"] += (self.px - w["x"]) * min(1.0, dt * 4)
        if w["t"] >= WORMHOLE_WARN_T:
            w["fired"] = True
            inside = (not WORMHOLE_DODGEABLE) \
                or abs(self.px - w["x"]) < w["r"]
            if inside and self.freeze_t <= 0:
                self.freeze(WORMHOLE_FREEZE_T)
            else:
                self.floaters.append([self.px, GROUND - 70, "DODGED!", 1.0])
                self.sfx("deny")
    else:
        w["done_t"] += dt
        if w["done_t"] > 0.6:
            self.wh = None


# ---- update wrapper ---------------------------------------------------------
def wx_update(self, dt):
    if self.state == "play" and self.wave != self._wx_wave:
        self._wx_wave = self.wave
        wx_roll(self)

    # while frozen the gun ignores all movement and fire input
    frozen = self.state == "play" and self.freeze_t > 0
    if frozen:
        self.px = self.freeze_px
        keys, mouse = self.keys, self.mouse_down
        self.keys, self.mouse_down = set(), False
    try:
        _wx_update(self, dt)
    finally:
        if frozen:
            self.keys, self.mouse_down = keys, mouse

    if self.state == "play":
        self.weather_banner = max(0.0, self.weather_banner - dt)
        if self.weather == "wormhole":
            self.update_wormhole(dt)
        if self.freeze_t > 0:
            self.freeze_t -= dt
            if self.freeze_t <= 0:
                self.freeze_t = 0.0
                self.inv = max(self.inv, WORMHOLE_THAW_INV)
                self.floaters.append([self.px, GROUND - 70, "THAWED", 1.0])
                self.explode(self.px, GROUND - 10, "#bfeeff", 12, 180)
                self.sfx("thaw")

    if self.cleared_wave > self._wx_cleared:
        if self.weather == "flare":
            self.credits += FLARE_CLEAR_BONUS
            self.shop_msg += f"  Solar Flare bonus +{FLARE_CLEAR_BONUS} credits."
        self._wx_cleared = self.cleared_wave

    if self.state not in ("play", "paused"):
        wx_clear(self)


# ---- solar flare effects ----------------------------------------------------
def wx_spawn_ufo(self, kind, x=None, y=None):
    _wx_spawn_ufo(self, kind, x, y)
    if self.weather == "flare":
        u = self.ufos[-1]
        u["hp"] = u["maxhp"] = max(1, round(u["maxhp"] * FLARE_UFO_HP))


def wx_update_ufo(self, u, dt):
    if self.weather == "flare" and self.state == "play":
        ds = self.difficulty_settings
        old = ds["speed"]
        ds["speed"] = old * FLARE_UFO_SPEED
        try:
            _wx_update_ufo(self, u, dt)
        finally:
            ds["speed"] = old
    else:
        _wx_update_ufo(self, u, dt)


def wx_damage_taken(self, u, dmg):
    if getattr(self, "weather", None) == "flare":
        dmg *= FLARE_DAMAGE
    return _wx_damage_taken(self, u, dmg)


nb_damage_taken = wx_damage_taken       # every hit looks this name up


def wx_delay(self):
    d = _wx_delay(self)
    return d * FLARE_FIRE_DELAY if self.weather == "flare" else d


# ---- input ------------------------------------------------------------------
def wx_key_down(self, e):
    if self.state == "play" and self.freeze_t > 0:
        k = e.keysym.lower()
        if k not in (_feature_controls(self)["pause"], "p", "f", "f11",
                     "escape"):
            self.keys.add(k)            # remembered, but does nothing yet
            return
    _wx_key_down(self, e)


# ---- drawing ----------------------------------------------------------------
def draw_wormhole(self, ox, oy):
    w = self.wh
    if w is None:
        return
    c = self.c
    t = time.time()
    x, y = w["x"] + ox, w["y"] + oy
    warn = min(1.0, w["t"] / WORMHOLE_WARN_T)
    grow = min(1.0, w["t"] / 0.6)
    fade_out = 1.0 if not w["fired"] else max(0.0, 1.0 - w["done_t"] / 0.6)
    k = grow * fade_out
    if k <= 0.02:
        return
    bgc = sky(300)
    pulse = 0.5 + 0.5 * math.sin(t * (8 + 14 * warn))
    col = mix("#b36bff", "#4dd8ff", 0.5 + 0.5 * math.sin(t * 3))
    danger = "#fff200" if self.high_contrast else mix("#ff5577", "#ffd0dd",
                                                      pulse)
    r = w["r"]
    if not w["fired"]:
        lc = mix(bgc, danger, 0.3 + 0.7 * warn)
        for sx in (-r, r):              # the danger column
            c.create_line(x + sx, y + 40 * k, x + sx, GROUND + 34 + oy,
                          fill=lc, dash=(6, 6), width=2)
        c.create_oval(x - r, GROUND + 22 + oy, x + r, GROUND + 42 + oy,
                      outline=lc, width=2)
        inner = r * (1 - warn)          # closing ring = time left
        if inner > 4:
            c.create_oval(x - inner, GROUND + 26 + oy, x + inner,
                          GROUND + 38 + oy, outline=lc, width=1)
        if abs(self.px - w["x"]) < r:
            c.create_text(self.px + ox, GROUND - 60 + oy, text="MOVE!",
                          fill=danger, font=(FONT, 12, "bold"))
    else:                               # the strike
        a = fade_out
        for sx in (-r * 0.5, 0, r * 0.5):
            c.create_line(x + sx, y, x + sx, GROUND + 40 + oy,
                          fill=mix(bgc, "#bfeeff", a), width=4)
    # swirling portal
    portal_scale = r / WORMHOLE_RADIUS
    for i in range(3):
        rr = (46 - i * 12) * portal_scale * k
        for j in range(3):
            st = (t * (240 + i * 90) * (1 if i % 2 == 0 else -1)
                  + j * 120) % 360
            c.create_arc(x - rr, y - rr, x + rr, y + rr, start=st, extent=60,
                         style="arc", outline=mix(col, "#ffffff", i * 0.2),
                         width=max(3, min(16, 3 * portal_scale)))
    center_r = 9 * portal_scale * k
    c.create_oval(x - center_r, y - center_r, x + center_r, y + center_r,
                  fill="#05030f",
                  outline=col, width=2)
    for i in range(6):
        a = t * 3 + i * math.tau / 6
        orbit_r = 52 * portal_scale * k
        px, py = x + math.cos(a) * orbit_r, y + math.sin(a) * orbit_r
        particle_r = max(2, min(8, 2 * portal_scale)) * k
        c.create_oval(px - particle_r, py - particle_r,
                      px + particle_r, py + particle_r, fill="#ffffff",
                      outline="")


def draw_flare_world(self):
    if self.weather != "flare":
        return
    c = self.c
    t = time.time()
    pulse = 0.5 + 0.5 * math.sin(t * 3)
    for i in range(5):                  # hot orange screen edge
        col = mix("#05060f", "#ff7a2d", (0.55 - i * 0.1) * (0.7 + 0.3 * pulse))
        c.create_rectangle(i * 5 + 2, i * 5 + 2, W - i * 5 - 2,
                           H - i * 5 - 2, outline=col, width=5)
    for i in range(16):                 # embers streaking down
        ph = (t * 0.35 + i * 0.137) % 1.0
        sx = (i * 97.3 + t * 25) % W
        sy = ph * (HORIZON - 40)
        c.create_line(sx, sy, sx - 10, sy + 22,
                      fill=mix(sky(sy), "#ffb347", 0.6 * (1 - ph)), width=2)


def wx_draw_beams(self, ox, oy):
    _wx_draw_beams(self, ox, oy)
    draw_flare_world(self)
    draw_wormhole(self, ox, oy)


def draw_freeze(self):
    c = self.c
    t = time.time()
    frac = self.freeze_t / WORMHOLE_FREEZE_T
    melt = min(1.0, frac / 0.25)        # shards shrink as it thaws
    x, y = self.px, GROUND
    for dx, h, wd in ((-34, 50, 12), (-18, 64, 14), (0, 74, 16),
                      (18, 62, 14), (34, 48, 12)):
        h *= melt
        c.create_polygon(x + dx - wd / 2, y + 32, x + dx, y + 32 - h,
                         x + dx + wd / 2, y + 32,
                         fill=mix("#1d5a80", "#bfeeff", 0.35 + 0.3 * math.sin(
                             t * 6 + dx)), outline="#e6fbff")
    c.create_oval(x - 44, y - 16, x + 44, y + 40, outline="#9fe8ff", width=2)
    c.create_text(x, y - 90, text=f"FROZEN  {self.freeze_t:.1f}s",
                  fill="#bfeeff", font=(FONT, 11, "bold"))
    c.create_rectangle(x - 30, y - 80, x + 30, y - 75, fill="#171c3e",
                       outline="")
    c.create_rectangle(x - 30, y - 80, x - 30 + 60 * frac, y - 75,
                       fill="#4dd8ff", outline="")


def wx_draw_hud(self):
    _wx_draw_hud(self)
    c = self.c
    t = time.time()
    if self.freeze_t > 0:
        draw_freeze(self)
    if not self.weather:
        return
    flare = self.weather == "flare"
    col = "#ffb347" if flare else "#b36bff"
    if self.high_contrast:
        col = "#fff200"
    # status panel (left side, under the shockwave gauge)
    rrect(c, 8, 184, 160, 228, 9, fill="#0b0f26", outline=col, width=2)
    c.create_text(16, 196, anchor="w", fill=col, font=(FONT, 9, "bold"),
                  text="SOLAR FLARE" if flare else "WORMHOLE")
    if flare:
        l1 = f"UFOs +{round((FLARE_UFO_SPEED - 1) * 100)}% SPD, " \
             f"+{round((FLARE_UFO_HP - 1) * 100)}% HP"
        l2 = f"YOU: -{round((1 - FLARE_DAMAGE) * 100)}% DMG, SLOWER FIRE"
    else:
        if self.freeze_t > 0:
            l1 = "FROZEN!"
        elif self.wh is not None:
            l1 = "DANGER ZONE!" if not self.wh["fired"] else "PORTAL CLOSING"
        elif self.wh_times:
            l1 = "Portal incoming..."
        else:
            l1 = "Portal closed"
        l2 = f"Freezes you for {WORMHOLE_FREEZE_T:g}s"
    c.create_text(16, 208, anchor="w", fill="#d6def1", font=(FONT, 7, "bold"),
                  text=l1)
    c.create_text(16, 220, anchor="w", fill="#8a93c9", font=(FONT, 7),
                  text=l2)
    # announcement banner
    if self.weather_banner > 0:
        tb = self.weather_banner
        a = max(0.0, min(1.0, (WEATHER_BANNER_T - tb) / 0.4, tb / 0.6))
        bg = sky(H / 2)
        if flare:
            name, sub = "SOLAR FLARE", \
                "UFOs are faster and tougher - your fire is slower and weaker"
        else:
            name = "WORMHOLE ACTIVITY"
            sub = ("A portal will freeze you - stay out of the danger zone"
                   if WORMHOLE_DODGEABLE else "A portal will freeze you")
        shadow_text(c, W / 2, H / 2 + 62, name, mix(bg, col, a),
                    (FONT, 24, "bold"), shade=mix(bg, "#000000", a))
        shadow_text(c, W / 2, H / 2 + 92, sub, mix(bg, "#ffffff", a),
                    (FONT, 12, "bold"), shade=mix(bg, "#000000", a), off=1)



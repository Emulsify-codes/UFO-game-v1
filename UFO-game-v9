def _feature_start_wave_game(self):
    next_wave = self.wave + 1
    if self.state == "shop" and getattr(self, "_briefing_bypass", False):
        self.active_modifier = self._briefing_modifier
        _base_start_wave(self)
        return
    if self.state == "shop" and not getattr(self, "_briefing_bypass", False) \
            and next_wave <= 100 and (
            next_wave % 3 == 0 or next_wave % 5 == 0):
        self._briefing_wave = next_wave
        self._briefing_step = "bonus" if next_wave % 3 == 0 else "modifier"
        self._briefing_modifier = None
        self.state = "briefing"
        self.sfx("click")
        return
    self.active_modifier = None
    _base_start_wave(self)


def _launch_briefed_wave(self):
    self.active_modifier = self._briefing_modifier
    self._briefing_wave = 0
    self._briefing_step = ""
    self.state = "shop"
    self._briefing_bypass = True
    try:
        _feature_start_wave_game(self)
    finally:
        self._briefing_bypass = False
        self._briefing_modifier = None


def _choose_briefing(self, choice):
    wave = self._briefing_wave
    if self._briefing_step == "bonus":
        if 0 <= choice < len(RUN_BONUS_CHOICES):
            bonus_choice = RUN_BONUS_CHOICES[choice]
            tier = min(
                RUN_BONUS_TIER_MAX,
                self.run_bonus_tiers.get(bonus_choice["id"], 0) + 1)
            self.run_bonus_tiers[bonus_choice["id"]] = tier
            perk = dict(bonus_choice, waves_left=3, tier=tier)
            self.run_bonuses = [
                bonus for bonus in self.run_bonuses
                if bonus["id"] != perk["id"]]
            self.run_bonuses.append(perk)
            self.floaters.append([
                self.px, GROUND - 70,
                f"{perk['name']} TIER {tier} · 3 WAVES", 1.5])
        if wave % 5 == 0:
            self._briefing_step = "modifier"
            self.sfx("click")
            return
    elif self._briefing_step == "modifier":
        if 0 <= choice < len(WAVE_MODIFIERS):
            self._briefing_modifier = WAVE_MODIFIERS[choice]["id"]
    _launch_briefed_wave(self)



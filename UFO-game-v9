    def button(self, rects, r, label, key, style="blue", size=14):
        """Draw a hover-aware rounded button and register its click area."""
        x1, y1, x2, y2 = r
        rects.append((x1, y1, x2, y2, key))
        hov = x1 <= self.mouse_x <= x2 and y1 <= self.mouse_y <= y2
        (fill, fill_h), (line, line_h) = BTN_STYLES[style]
        rrect(self.c, x1, y1, x2, y2, 12, fill=fill_h if hov else fill,
              outline=line_h if hov else line, width=3 if hov else 2)
        shadow_text(self.c, (x1 + x2) / 2, (y1 + y2) / 2, label, "#ffffff",
                    (FONT, size, "bold"), off=1)

    def home_button(self, rects, r, label, hint, key, style, size=13):
        """Draw a layered navigation button for the home screen."""
        c = self.c
        x1, y1, x2, y2 = r
        rects.append((x1, y1, x2, y2, key))
        hov = x1 <= self.mouse_x <= x2 and y1 <= self.mouse_y <= y2
        (fill, fill_h), (line, line_h) = BTN_STYLES[style]
        accent = line_h if hov else line
        compact = y2 - y1 < 40
        inset = 2 if compact else 3
        rrect(c, x1, y1 + 3, x2, y2 + 3, 11, fill="#070918",
              outline="")
        rrect(c, x1, y1, x2, y2, 11,
              fill=fill_h if hov else fill, outline=accent,
              width=3 if hov else 2)
        rrect(c, x1 + inset, y1 + inset, x2 - inset, y2 - inset, 9,
              fill=mix(fill_h if hov else fill, "#ffffff", 0.08 if hov else 0.025),
              outline="")
        c.create_line(x1 + 12, y1 + 4, x2 - 12, y1 + 4,
                      fill=mix(accent, "#ffffff", 0.35 if hov else 0.12),
                      width=1)

        if compact:
            ix, iy = x1 + 16, (y1 + y2) / 2
            c.create_oval(ix - 7, iy - 7, ix + 7, iy + 7,
                          fill=mix(fill, "#080b1c", 0.45), outline=accent,
                          width=1)
            self.draw_home_icon(key, ix, iy, accent)
            c.create_text(ix + 12, iy, anchor="w", text=label,
                          fill="#ffffff", font=(FONT, size, "bold"))
        else:
            cx = (x1 + x2) / 2
            iy = y1 + 13
            c.create_oval(cx - 9, iy - 9, cx + 9, iy + 9,
                          fill=mix(fill, "#080b1c", 0.48), outline=accent,
                          width=1)
            self.draw_home_icon(key, cx, iy, accent)
            c.create_text(cx, y1 + 29, text=label, fill="#ffffff",
                          font=(FONT, min(size, 10), "bold"))
            c.create_text(cx, y1 + 43, text=hint.upper(),
                          fill=mix(accent, "#ffffff", 0.12 if hov else 0.0),
                          font=(FONT, 7, "bold"))
        if hov:
            c.create_oval(x2 - 13, y1 + 9, x2 - 9, y1 + 13,
                          fill="#ffffff", outline="")

    def draw_home_icon(self, key, cx, cy, col):
        c = self.c
        if key == "play":
            c.create_polygon(cx - 3, cy - 5, cx + 5, cy, cx - 3, cy + 5,
                             fill=col, outline="")

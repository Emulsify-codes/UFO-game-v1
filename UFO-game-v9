# ---- state ----------------------------------------------------------------
def el_reset(self):
    _el_prev_reset(self)
    self.element = None
    self.elements = ()
    self.el_t = 0.0
    self.el_cd = {}
    self.el_cd_max = {}


def el_ids(value):
    if not value:
        return ()
    return value if isinstance(value, tuple) else (value,)


def el_primary(value):
    elements = el_ids(value)
    return elements[0] if elements else None


def activate_element(self, eid):
    spec = ELEMENTS[eid]
    active = el_ids(getattr(self, "elements", ()))
    if active and eid not in active \
            and ELEMENT_PARTNERS.get(active[0]) != eid:
        self.floaters.append([self.px, GROUND - 70,
                              "ELEMENT PAIR INCOMPATIBLE", 0.9])
        self.sfx("deny")
        return
    left = self.el_cd.get(eid, 0.0)
    if left > 0:
        self.floaters.append([self.px, GROUND - 70,
                              f"{spec['name']} {left:.0f}s", 0.8])
        self.sfx("deny")
        return
    k = max(0.2, 1 - 0.08 * self.ench_lvl("cooldown"))
    self.el_cd[eid] = self.el_cd_max[eid] = ELEMENT_CD * k
    self.elements = active + (eid,) if eid not in active else active
    self.element = self.elements[0]
    self.el_t = ELEMENT_DURATION
    self.explode(self.px, GROUND - 20, spec["color"], 22, 240)
    self.rings.append([self.px, GROUND - 20, 110, 0.45, 0.45, spec["color"]])
    self.floaters.append([self.px, GROUND - 70,
                          f"{' + '.join(ELEMENTS[e]['name'] for e in self.elements)} "
                          "IMBUED", 1.2])
    self.sfx("el_" + eid)


# ---- status effects on UFOs -------------------------------------------------
def apply_element(self, u, eid, dmg=1, kind="bullet"):
    """Put an element's status effect on a UFO that was just hit."""
    if not eid or u["dead"] or u["mode"] == "dying":
        return
    big = u["kind"] in _EL_BOSS_KINDS
    col = ELEMENTS[eid]["color"]
    x, y = u["x"], u["y"]
    if eid == "frost":
        fresh = u.get("frost_t", 0.0) <= 0
        u["frost_t"] = FROST_DURATION
        u["frost_f"] = FROST_SLOW_BOSS if big else FROST_SLOW
        if fresh:
            self.explode(x, y, col, 6, 120)
    elif eid == "thunder":
        if big and u.get("stun_imm", 0.0) > 0:
            return
        fresh = u.get("stun_t", 0.0) <= 0.05
        u["stun_t"] = max(u.get("stun_t", 0.0),
                          THUNDER_STUN_BOSS if big else THUNDER_STUN)
        if fresh:
            self.explode(x, y, col, 8, 170)
            self.rings.append([x, y, 30 + UFO_SPECS[u["kind"]]["size"] * 0.4,
                               0.22, 0.22, col])
            self.sfx("stun")
    elif eid == "fire":
        if kind != "beam" or random.random() < 0.25:
            self.explode(x, y, col, 3, 120)
    elif eid == "poison":
        if kind == "beam":
            dps = dmg * POISON_BEAM_MULT
        else:
            dps = dmg * POISON_TOTAL / POISON_DURATION
        fresh = u.get("poison_t", 0.0) <= 0
        if fresh:
            u["poison_tick"] = POISON_TICK
            u["poison_acc"] = 0.0
            u["poison_dps"] = 0.0
        u["poison_t"] = POISON_DURATION
        u["poison_dps"] = max(u["poison_dps"], dps)


def el_poison_damage(self, u, amount):
    prev = getattr(self, "_damage_source", "gun")
    self._damage_source = "poison"
    try:
        dealt = nb_damage_taken(self, u, amount)
    finally:
        self._damage_source = prev
    u["hp"] -= dealt
    col = ELEMENTS["poison"]["color"]
    for _ in range(2):
        self.particles.append([u["x"] + random.uniform(-12, 12),
                               u["y"] + random.uniform(-8, 8),
                               random.uniform(-10, 10),
                               random.uniform(-40, -15), 0.6, col, 0.6, 1])
    if u["hp"] <= 0:
        self.kill_ufo(u, "poison")


def el_update_ufo(self, u, dt):
    if u["mode"] == "dying":
        return _el_prev_update_ufo(self, u, dt)
    big = u["kind"] in _EL_BOSS_KINDS
    if u.get("stun_imm", 0.0) > 0:
        u["stun_imm"] -= dt
    # poison ticks (damage is applied in chunks every POISON_TICK seconds)
    if u.get("poison_t", 0.0) > 0:
        step = min(dt, u["poison_t"])
        u["poison_t"] -= dt
        u["poison_acc"] = u.get("poison_acc", 0.0) \
            + u.get("poison_dps", 0.0) * step
        u["poison_tick"] = u.get("poison_tick", POISON_TICK) - dt
        if u["poison_tick"] <= 0 or u["poison_t"] <= 0:
            amount, u["poison_acc"] = u["poison_acc"], 0.0
            u["poison_tick"] = POISON_TICK
            if u["poison_t"] <= 0:
                u["poison_dps"] = 0.0
            if amount > 0:
                el_poison_damage(self, u, amount)
            if u["dead"] or u["mode"] == "dying":
                return
    # stun: frozen in place, no moving or shooting
    if u.get("stun_t", 0.0) > 0:
        u["stun_t"] -= dt
        u["flash"] = max(0.0, u["flash"] - dt)
        if u["stun_t"] <= 0 and big:
            u["stun_imm"] = THUNDER_BOSS_IMMUNE
        return
    scale = 1.0
    if u.get("frost_t", 0.0) > 0:
        u["frost_t"] -= dt
        scale = u.get("frost_f", FROST_SLOW)
    _el_prev_update_ufo(self, u, dt * scale)


def el_hurt_ufo(self, u, dmg, src=None):
    """Missiles, beams and shockwaves pass their element on here."""
    eid, pos = None, None
    if src == "missile":
        live = [m for m in self.missiles if not m["dead"]]
        if live:
            m = min(live, key=lambda mm: math.hypot(mm["x"] - u["x"],
                                                    mm["y"] - u["y"]))
            eid, pos = m.get("elem"), (m["x"], m["y"])
    elif src == "beam":
        eid = self._cur_beam_elem
    elif src == "shock":
        eid = self._cur_shock_elem
    killed = _el_orig_hurt_ufo(self, u, dmg, src)
    if eid and not killed:
        if pos is not None:
            primary = el_primary(eid)
            self.explode(pos[0], pos[1], ELEMENTS[primary]["color"], 14, 240)
        for element in el_ids(eid):
            apply_element(self, u, element, dmg, src)
    return killed


# ---- tagging projectiles ----------------------------------------------------
def el_tag(self):
    """Every bullet / missile remembers the element it was fired with."""
    cur = el_ids(getattr(self, "elements", self.element))
    for b in self.bullets:
        if "elem" not in b:
            b["elem"] = cur
            if "fire" in cur:
                b["vx"] *= FIRE_BULLET_SPEED
                b["vy"] *= FIRE_BULLET_SPEED
    for m in self.missiles:
        if "elem" not in m:
            m["elem"] = cur


def el_update(self, dt):
    was_play = self.state == "play"
    self.el_tag()
    pre_ufos = {id(u): u for u in self.ufos}
    pre_bullets = list(self.bullets)
    _el_prev_update(self, dt)
    if was_play:
        for k in list(self.el_cd):
            self.el_cd[k] = max(0.0, self.el_cd[k] - dt)
        if self.element:
            self.el_t -= dt
            if self.el_t <= 0:
                self.element, self.el_t = None, 0.0
                self.elements = ()
    self.el_tag()
    # bullets that hit something: apply their element (once per UFO hit)
    seen = {id(b): b for b in pre_bullets}
    for b in self.bullets:
        seen[id(b)] = b
    for b in seen.values():
        elements = el_ids(b.get("elem"))
        if not elements:
            continue
        done = b.setdefault("el_done", set())
        done &= b["hit"]                 # ricochet bullets clear "hit"
        for uid in b["hit"] - done:
            done.add(uid)
            u = pre_ufos.get(uid)
            if u is not None and not u["dead"]:
                for eid in elements:
                    apply_element(self, u, eid, b["dmg"], "bullet")
    # fire missiles fly faster
    if was_play:
        extra = FIRE_MISSILE_SPEED - 1
        for m in self.missiles:
            if "fire" in el_ids(m.get("elem")) and not m["dead"]:
                m["x"] += m["vx"] * dt * extra
                m["y"] += m["vy"] * dt * extra


# ---- combos: missile, shockwave, charge beam --------------------------------
def el_fire_missile(self):
    n = len(self.missiles)
    _el_prev_fire_missile(self)
    if len(self.missiles) > n:
        for m in self.missiles[n:]:
            m.setdefault("elem", el_ids(getattr(self, "elements",
                                                 self.element)))
        if self.element:
            names = " + ".join(
                ELEMENTS[e]["name"] for e in el_ids(self.elements))
            self.floaters.append([self.px, GROUND - 90,
                                  f"{names} MISSILE", 1.0])


def el_fire_shock(self):
    ready = self.shock_cd <= 0 and self.shock_t <= 0
    _el_prev_fire_shock(self)
    if ready and self.shock_t > 0 and self.element:
        names = " + ".join(
            ELEMENTS[e]["name"] for e in el_ids(self.elements))
        self.floaters.append([self.px, GROUND - 90,
                              f"{names} SHOCKWAVE", 1.0])


def el_release_charge(self):
    n = len(self.beams)
    _el_orig_release(self)
    if len(self.beams) > n and self.element:
        elements = el_ids(getattr(self, "elements", self.element))
        spec = ELEMENTS[elements[0]]
        self.beams[-1]["elem"] = elements
        self.rings.append([self.px, GROUND - 50, 120, 0.4, 0.4, spec["color"]])
        names = " + ".join(ELEMENTS[e]["name"] for e in elements)
        self.floaters.append([self.px, GROUND - 100,
                              f"{names} CHARGE", 1.2])


def el_beam_hit(self, bm):
    eid = bm.get("elem")
    self._cur_beam_elem = eid
    try:
        _el_orig_beam_hit(self, bm)
        if "fire" in el_ids(eid):       # fire beams tick 1.5x as often
            bm["_ft"] = bm.get("_ft", 0) + 1
            if bm["_ft"] % 2 == 0:
                _el_orig_beam_hit(self, bm)
    finally:
        self._cur_beam_elem = None


def el_update_shock(self, dt):
    """Shockwave with per-ring elements (replaces the original)."""
    self.shock_cd = max(0.0, self.shock_cd - dt)
    if self.shock_t > 0:
        self.shock_t -= dt
        self.shock_emit -= dt
        if self.shock_emit <= 0:
            self.shock_emit += SHOCK_INTERVAL
            self.shocks.append(dict(x=self.px, y=GROUND - 20, r=0.0,
                                    prev=0.0, hit=set(),
                                    elem=el_ids(getattr(
                                        self, "elements", self.element))))
            self.recoil = max(self.recoil, 4.0)
            self.sfx("shock")
    dmg = max(1, round((SHOCK_DMG_BASE + 0.5 * self.damage) * self.power))
    for s in self.shocks:
        eid = s.get("elem")
        primary = el_primary(eid)
        col = ELEMENTS[primary]["color"] if primary else SHOCK_COL
        s["prev"] = s["r"]
        s["r"] += SHOCK_SPEED * (
            FIRE_SHOCK_SPEED if "fire" in el_ids(eid) else 1.0) * dt
        for u in self.ufos:
            if u["dead"] or u["mode"] == "dying" or u["y"] < -20 \
                    or id(u) in s["hit"]:
                continue
            size = UFO_SPECS[u["kind"]]["size"] * 0.9
            d = math.hypot(u["x"] - s["x"], u["y"] - s["y"])
            if d + size >= s["prev"] and d - size <= s["r"]:
                s["hit"].add(id(u))
                self.explode(u["x"], u["y"], col, 6, 150)
                self._cur_shock_elem = eid
                try:
                    self.hurt_ufo(u, dmg, "shock")
                finally:
                    self._cur_shock_elem = None
    self.shocks = [s for s in self.shocks if s["r"] < SHOCK_MAX_R]
    self.ufos = [u for u in self.ufos if not u["dead"]]


# ---- input ----------------------------------------------------------------
def el_key_down(self, e):
    if self.state == "play":
        k = e.keysym.lower()
        if k.startswith("kp_"):
            k = k[3:]
        eid = _EL_BY_KEY.get(k)
        if eid and k not in _feature_controls(self).values():
            if getattr(self, "freeze_t", 0.0) <= 0:   # frozen: no input
                self.activate_element(eid)
            return
    _el_prev_key_down(self, e)


# ---- drawing ----------------------------------------------------------------
def el_draw_bullet(self, b, ox, oy):
    trail = [(tx + ox, ty + oy) for tx, ty in b["trail"]]
    eid = b.get("elem")
    primary = el_primary(eid)
    sk = ELEMENTS[primary]["bullet"] if primary else self.bullet_skin
    self.draw_bullet_skin(sk, b["x"] + ox, b["y"] + oy, trail,
                          1.3 if "bn" in b else b.get("s", 1.0))


def el_draw_missile(self, m, ox, oy):
    eid = el_primary(m.get("elem"))
    self._mskin_over = ELEMENTS[eid]["missile"] if eid else None
    try:
        _el_prev_draw_missile(self, m, ox, oy)
    finally:
        self._mskin_over = None


def el_draw_beams(self, ox, oy):
    global BEAM_COL
    saved = BEAM_COL
    eid = next((el_primary(b.get("elem")) for b in reversed(self.beams)
                if b.get("elem")), None)
    if eid:
        BEAM_COL = ELEMENTS[eid]["beam"]
    try:
        _el_prev_draw_beams(self, ox, oy)
    finally:
        BEAM_COL = saved


def el_draw_charge(self, ox, oy):
    global CHARGE_COL
    saved = CHARGE_COL
    if self.charging and self.element:
        CHARGE_COL = ELEMENTS[el_primary(self.elements)]["charge"]
    try:
        _el_prev_draw_charge(self, ox, oy)
    finally:
        CHARGE_COL = saved


def el_draw_shocks(self, ox, oy):
    c = self.c
    for s in self.shocks:
        eid = el_primary(s.get("elem"))
        col = ELEMENTS[eid]["color"] if eid else SHOCK_COL
        p = min(1.0, s["r"] / SHOCK_MAX_R)
        r = max(2.0, s["r"])
        x, y = s["x"] + ox, s["y"] + oy
        c.create_oval(x - r - 7, y - r - 7, x + r + 7, y + r + 7,
                      outline=fade(col, y, 0.75 + 0.2 * p), width=8)
        c.create_oval(x - r - 2, y - r - 2, x + r + 2, y + r + 2,
                      outline=fade(col, y, 0.35 + 0.5 * p), width=4)
        c.create_oval(x - r, y - r, x + r, y + r,
                      outline=fade("#ffffff", y, 0.2 + 0.7 * p), width=2)


def el_draw_ufo(self, u, ox, oy, scale=1.0):
    _el_prev_draw_ufo(self, u, ox, oy, scale)
    if u.get("mode") == "x" or u.get("dead"):
        return
    frost = u.get("frost_t", 0.0) > 0
    stun = u.get("stun_t", 0.0) > 0
    poison = u.get("poison_t", 0.0) > 0
    if not (frost or stun or poison):
        return
    c = self.c
    t = time.time()
    s = UFO_SPECS[u["kind"]]["size"] * scale
    x = u["x"] + ox
    y = u["y"] + oy + math.sin(u["t"] * 3 + len(u["kind"])) * 2 * scale
    seed = (id(u) >> 4) % 97
    if frost:
        col = ELEMENTS["frost"]["color"]
        c.create_oval(x - s * 1.08, y - s * 0.52, x + s * 1.08, y + s * 0.58,
                      outline=col, width=2, dash=(4, 3))
        for i in range(4):
            a = t * 1.2 + i * math.tau / 4 + seed
            cp_sparkle(c, x + math.cos(a) * s, y + math.sin(a) * s * 0.3,
                       3 + 1.5 * math.sin(t * 6 + i), "#ffffff")
    if stun:
        col = ELEMENTS["thunder"]["color"]
        for i in range(3):
            a = t * 7 + i * math.tau / 3 + seed
            cp_sparkle(c, x + math.cos(a) * s * 0.9,
                       y - s * 0.85 + math.sin(a) * s * 0.18, 4, col)
        for _ in range(2):
            bx = x + random.uniform(-s, s)
            c.create_line(bx, y - s * 0.4,
                          bx + random.uniform(-6, 6), y - s * 0.1,
                          bx + random.uniform(-8, 8), y + s * 0.2,
                          bx + random.uniform(-6, 6), y + s * 0.45,
                          fill=col, width=2)
    if poison:
        col = ELEMENTS["poison"]["color"]
        c.create_oval(x - s * 1.05, y - s * 0.55, x + s * 1.05, y + s * 0.6,
                      outline=mix(col, sky(y), 0.4), width=1)
        for i in range(5):
            ph = (t * 0.8 + i * 0.2 + seed * 0.1) % 1.0
            bx = x + math.sin(ph * 6 + i * 2 + seed) * s * 0.55
            by = y + s * 0.3 - ph * s * 1.1
            r = 1.5 + 2.0 * (1 - ph)
            c.create_oval(bx - r, by - r, bx + r, by + r, outline=col,
                          fill=mix(col, "#05060f", 0.6))


def el_draw_player(self, ox, oy):
    if self.element and not (self.inv > 0 and int(self.inv * 14) % 2 == 0):
        active = el_ids(self.elements)
        if self.el_t > 2.0 or int(self.el_t * 6) % 2 == 0:   # blinks at the end
            c = self.c
            t = time.time()
            x = self.px + ox
            for idx, eid in enumerate(active):
                spec = ELEMENTS[eid]
                glow(c, x, GROUND + 14 + oy, 54 - idx * 8,
                     spec["color"], layers=3, a=0.24)
                for i in range(3):
                    a = t * 2.4 + i * math.tau / 3 + idx * math.pi / 3
                    ex = x + math.cos(a) * (38 - idx * 8)
                    ey = GROUND + 10 + oy + math.sin(a) * 14
                    c.create_oval(ex - 3, ey - 3, ex + 3, ey + 3,
                                  fill=spec["color"], outline="#ffffff")
    _el_prev_draw_player(self, ox, oy)


def el_draw_hud(self):
    _el_prev_draw_hud(self)
    if self.state not in ("play", "paused"):
        return
    c = self.c
    active_elements = el_ids(getattr(self, "elements", self.element))
    act = ELEMENTS[active_elements[0]]["color"] if active_elements else None
    rrect(c, 8, 234, 160, 314, 9, fill="#0b0f26", outline=act or "#3a4690",
          width=2)
    for i, eid in enumerate(ELEMENT_ORDER):
        spec = ELEMENTS[eid]
        y = 247 + i * 18
        active = eid in active_elements
        cd = self.el_cd.get(eid, 0.0)
        ready = cd <= 0
        lab = "#ffffff" if active else (spec["color"] if ready else "#8a93c9")
        c.create_text(16, y, anchor="w", fill=lab, font=(FONT, 9, "bold"),
                      text=f"[{ELEMENT_KEYS[eid]}] {spec['name']}")
        c.create_rectangle(98, y - 4, 150, y + 4, fill="#171c3e", outline="")
        if active:
            frac, bar = max(0.0, self.el_t / ELEMENT_DURATION), spec["color"]
        elif ready:
            frac, bar = 1.0, "#7CFC00"
        else:
            frac = 1 - cd / max(0.1, self.el_cd_max.get(eid, ELEMENT_CD))
            bar = mix(spec["color"], "#171c3e", 0.45)
        c.create_rectangle(98, y - 4, 98 + 52 * frac, y + 4, fill=bar,
                           outline="")
        if active:
            c.create_rectangle(97, y - 5, 151, y + 5, outline=spec["color"],
                               width=1)
    if self.charging and self.element:

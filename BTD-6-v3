                  freeze="freeze time", boss_mult="boss dmg x", income="$/round", chain="chain links",
                  cone="spread", aura="% ally speed", interest="% interest", cap="mine cap")


def describe(mods):
    parts = []
    for k, v in mods.items():
        if k == "rate":
            parts.append("faster fire")
        else:
            parts.append(f"+{v:g} {STAT_LABEL[k]}")
    return ", ".join(parts)


def stat_text(t):
    s = t.stats
    if t.kind == "Trading Post":
        return [f"Income ${s['income']}/rd", f"Interest {s['interest']}%", f"Ally speed {s['aura']}%",
                f"Range {s['range']}"]
    parts = []
    if s.get("dmg"):
        parts.append(f"Dmg {s['dmg']}")
    parts.append(f"{60 / s['rate']:.1f} shots/s")
    if s["range"] < 5000:
        parts.append(f"Range {s['range']}")
    for k, lab in (("pierce", "Pierce"), ("shots", "Shots"), ("radius", "Blast"), ("chain", "Chain"),
                   ("cone", "Spread"), ("cap", "Mines"), ("freeze", "Freeze")):
        if k in s:
            parts.append(f"{lab} {s[k]:g}")
    if s["boss_mult"] > 1:
        parts.append(f"Boss x{s['boss_mult']}")
    if s["income"]:
        parts.append(f"+${s['income']}/rd")
    return parts


class Tower:
    def __init__(self, kind, x, y):
        self.kind = kind
        self.x, self.y = x, y
        self.base = TOWER_TYPES[kind]
        skip = ("paths", "desc", "color", "cost")
        self.stats = {k: v for k, v in self.base.items() if k not in skip}
        self.stats.setdefault("boss_mult", 1)
        self.stats.setdefault("income", 0)
        self.tiers = [0, 0, 0]
        self.cooldown = 0
        self.angle = 0.0
        self.mode = 0
        self.recoil = 0
        self.spent = self.base["cost"]

    def upgrade_status(self, path):
        """Returns (upgrade tuple or None, reason). reason is None if allowed by the path rules."""
        tier = self.tiers[path]
        if tier >= 5:
            return None, "Maxed"
        new = self.tiers[:]
        new[path] = tier + 1
        if sum(1 for t in new if t > 0) > 2:
            return self.base["paths"][path][1][tier], "Locked"
        if sum(1 for t in new if t > 2) > 1:
            return self.base["paths"][path][1][tier], "Locked"
        return self.base["paths"][path][1][tier], None

    def upgrade(self, path):
        up, reason = self.upgrade_status(path)
        if reason:
            return False
        cost, _, mods = up
        for k, v in mods.items():
            self.stats[k] = self.stats.get(k, 0) + v
        self.stats["rate"] = max(8, self.stats["rate"])
        self.spent += cost
        self.tiers[path] += 1
        return True

    def pick(self, balloons):
        r = self.stats["range"]
        cands = [b for b in balloons if b.alive and math.dist((b.x, b.y), (self.x, self.y)) <= r + b.radius]
        if not cands:
            return None
        if self.mode == 0:
            return max(cands, key=lambda b: b.dist)
        if self.mode == 1:
            return min(cands, key=lambda b: b.dist)
        return max(cands, key=lambda b: (b.hp if b.boss else b.tier))

    def update(self, game):
        if self.recoil > 0:
            self.recoil -= 1
        if self.cooldown > 0:
            self.cooldown -= 1
            return
        s = self.stats
        bm = s["boss_mult"]
        if self.kind == "Trading Post":
            return
        if self.kind == "Frost Tower":
            hit = False
            for b in game.balloons:
                if b.alive and math.dist((b.x, b.y), (self.x, self.y)) <= s["range"]:
                    b.slow_timer = max(b.slow_timer, s["freeze"])
                    hit = True
                    if s["dmg"]:
                        game.damage(b, s["dmg"], bm)
            if hit:
                game.effects.append(["ring", self.x, self.y, s["range"], 12])
                self.cooldown = max(4, int(s["rate"] * game.buff_for(self)))
                self.recoil = 8
            return
        if self.kind == "Crystal Beacon":
            hit = False
            for b in game.balloons:
                if b.alive and math.dist((b.x, b.y), (self.x, self.y)) <= s["range"] + b.radius:
                    game.damage(b, s["dmg"], bm)
                    hit = True
            if hit:
                game.effects.append(["ring", self.x, self.y, s["range"], 16])
                self.cooldown = max(4, int(s["rate"] * game.buff_for(self)))
                self.recoil = 12
            return
        target = self.pick(game.balloons)
        if not target:
            return
        self.angle = math.atan2(target.y - self.y, target.x - self.x)
        self.cooldown = max(4, int(s["rate"] * game.buff_for(self)))
        self.recoil = 8
        if self.kind == "Dart Turret":
            n = s["shots"]
            for i in range(n):
                off = (i - (n - 1) / 2) * 0.18
                game.projectiles.append(Dart(self.x, self.y, self.angle + off, 9, s["dmg"], s["pierce"],
                                             int(s["range"] / 9) + 6, bm))
        elif self.kind == "Crossbow":
            n = int(s["shots"])
            for i in range(n):
                off = (i - (n - 1) / 2) * 0.24
                game.projectiles.append(Dart(self.x, self.y, self.angle + off, 11, s["dmg"], s["pierce"],
                                             int(s["range"] / 7) + 8, bm, (120, 220, 100)))
        elif self.kind == "Tack Ring":
            n = s["shots"]
            for i in range(n):
                a = math.tau * i / n
                game.projectiles.append(Dart(self.x, self.y, a, 6, s["dmg"], s["pierce"],
                                             int((s["range"] + 6) / 6), bm, (255, 200, 120)))
        elif self.kind == "Bomb Cannon":
            game.projectiles.append(Bomb(self.x, self.y, target.x, target.y, s["dmg"], s["radius"], bm))
        elif self.kind == "Rocket Launcher":
            game.projectiles.append(Bomb(self.x, self.y, target.x, target.y, s["dmg"], s["radius"], bm))
        elif self.kind == "Sniper":
            game.effects.append(["shot", self.x, self.y, target.x, target.y, 6])
            game.damage(target, s["dmg"], bm)
        elif self.kind == "Storm Coil":
            hits, prev, cur = [], (self.x, self.y), target
            for _ in range(int(s["chain"])):
                if cur is None:
                    break
                hits.append(cur)
                game.effects.append(["bolt", prev[0], prev[1], cur.x, cur.y, 7])
                game.damage(cur, s["dmg"], bm)
                prev = (cur.x, cur.y)
                nxt = [b for b in game.balloons
                       if b.alive and b not in hits and math.dist((b.x, b.y), prev) <= 85]
                cur = min(nxt, key=lambda b: math.dist((b.x, b.y), prev)) if nxt else None
        elif self.kind == "Chakram Thrower":
            n = int(s["shots"])
            d = min(s["range"], max(60, math.dist((target.x, target.y), (self.x, self.y)) + 25))
            for i in range(n):
                ang = self.angle + (i - (n - 1) / 2) * 0.5
                game.projectiles.append(Chakram(self.x, self.y, self.x + math.cos(ang) * d,
                                                self.y + math.sin(ang) * d, s["dmg"], int(s["pierce"]), bm))
        elif self.kind == "Flame Brazier":
            cone = min(s["cone"], math.pi)
            game.effects.append(["flame", self.x, self.y, self.angle, s["range"], cone, 8])
            for b in list(game.balloons):
                if not b.alive:
                    continue
                dx, dy = b.x - self.x, b.y - self.y
                if math.hypot(dx, dy) <= s["range"] + b.radius:
                    to = math.atan2(dy, dx)
                    diff = math.atan2(math.sin(to - self.angle), math.cos(to - self.angle))
                    if abs(diff) <= cone:
                        game.damage(b, s["dmg"], bm)
        elif self.kind == "Mine Layer":
            count = sum(1 for p in game.projectiles if isinstance(p, Mine) and p.owner is self)
            for i in range(int(s["shots"])):
                if count >= s["cap"]:
                    break
                d = min(TOTAL, target.dist + 25 + i * 26)
                mx, my = pos_at(d)
                if math.dist((mx, my), (self.x, self.y)) > s["range"] + 20:
                    mx, my = target.x, target.y
                game.projectiles.append(Mine(mx, my, s["dmg"], s["radius"], bm, self))
                count += 1
        elif self.kind == "Prism Tower":
            n = int(s["shots"])
            length = s["range"] + 60
            for i in range(n):
                ang = self.angle + (i - (n - 1) / 2) * 0.3
                ca, sa = math.cos(ang), math.sin(ang)
                game.effects.append(["beam", self.x, self.y, self.x + ca * length, self.y + sa * length, 7])
                for b in list(game.balloons):
                    if not b.alive:
                        continue
                    bx, by = b.x - self.x, b.y - self.y
                    along = bx * ca + by * sa
                    perp = abs(-bx * sa + by * ca)
                    if 0 <= along <= length and perp <= b.radius + 3:
                        game.damage(b, s["dmg"], bm)


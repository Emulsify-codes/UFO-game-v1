def _fresh_quest_state():
    return {"shards": 0, "done": [], "totals": {k: 0 for k in QUEST_STATS},
            "best": {"waves": 0, "inf_waves": 0}, "pets": [], "equipped": "",
            "daily": {"date": DAILY_DATE, "progress": 0, "completed": False, "double_shards": False},
            "dirty": False}


def load_quests(path=None):
    """Read saved quest progress; a missing or damaged file just starts fresh."""
    st = _fresh_quest_state()
    try:
        with open(path or QUEST_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        st["shards"] = max(0, int(data.get("shards", 0)))
        st["done"] = [i for i in data.get("done", []) if i in QUEST_IDS]
        for k in QUEST_STATS:
            st["totals"][k] = max(0, int(data.get("totals", {}).get(k, 0)))
        for k in ("waves", "inf_waves"):
            st["best"][k] = max(0, int(data.get("best", {}).get(k, 0)))
        st["pets"] = [i for i in dict.fromkeys(data.get("pets", [])) if i in PET_IDS]
        eq = data.get("equipped", "")
        st["equipped"] = eq if eq in st["pets"] else ""
        daily = data.get("daily", {})
        if isinstance(daily, dict) and str(daily.get("date", "")) == DAILY_DATE:
            st["daily"] = {
                "date": DAILY_DATE,
                "progress": max(0, int(daily.get("progress", 0))),
                "completed": bool(daily.get("completed", False)),
                "double_shards": bool(daily.get("double_shards", False)),
            }
        else:
            st["daily"] = {"date": DAILY_DATE, "progress": 0, "completed": False,
                           "double_shards": False}
    except (OSError, ValueError, TypeError, AttributeError):
        return _fresh_quest_state()
    return st


def save_quests(path=None, force=False):
    if not (QSTATE["dirty"] or force):
        return True
    target = path or QUEST_FILE
    try:
        out = {k: QSTATE[k] for k in ("shards", "done", "totals", "best", "pets", "equipped", "daily")}
        tmp = target + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(out, f, indent=2)
        os.replace(tmp, target)
        QSTATE["dirty"] = False
        return True
    except OSError:
        return False



class SoundManager:
    SAMPLE_RATE = 44100

    def __init__(self):
        self.enabled = pygame.mixer.get_init() is not None
        self.sounds = {}
        self.last_pop = 0
        if self.enabled:
            self.sounds = {
                "ui": self.make_tone(680, 0.045, 0.20, sweep=-120),
                "place": self.make_tone(280, 0.11, 0.28, sweep=420),
                "upgrade": self.make_chime((520, 660, 880), 0.38),
                "sell": self.make_tone(420, 0.13, 0.22, sweep=-260),
                "round": self.make_chime((330, 440, 550), 0.42),
                "pop": self.make_pop(0.045, 0.30),
                "boss": self.make_pop(0.14, 0.42, sweep=90),
                "clink": self.make_tone(900, 0.055, 0.12, sweep=-350),
                "leak": self.make_tone(170, 0.16, 0.26, sweep=-70),
                "win": self.make_chime((523, 659, 784, 1047), 0.85),
                "lose": self.make_chime((330, 277, 220), 0.72, descending=True),
                "fast": self.make_tone(760, 0.07, 0.20, sweep=180),
                "hatch": self.make_chime((392, 523, 659, 784), 0.60),
            }

    def make_tone(self, frequency, duration, volume=0.25, sweep=0):
        count = int(self.SAMPLE_RATE * duration)
        data = bytearray(count * 2)
        for i in range(count):
            t = i / self.SAMPLE_RATE
            phase = 2 * math.pi * (frequency + sweep * t / duration) * t
            env = min(1.0, i / (count * 0.06), (count - i) / (count * 0.12))
            sample = int(32767 * volume * env * math.sin(phase))
            struct.pack_into("<h", data, i * 2, sample)
        return pygame.mixer.Sound(buffer=bytes(data))

    def make_pop(self, duration, volume=0.25, sweep=0):
        count = int(self.SAMPLE_RATE * duration)
        data = bytearray(count * 2)
        frequency = 240 + sweep
        for i in range(count):
            t = i / self.SAMPLE_RATE
            env = max(0.0, 1.0 - i / count)
            frequency_now = max(70, frequency * (1.0 - 0.75 * i / count))
            phase = 2 * math.pi * frequency_now * t
            noise = random.uniform(-1, 1)
            wave = math.sin(phase) * 0.75 + noise * 0.25
            sample = int(32767 * volume * env * env * wave)
            struct.pack_into("<h", data, i * 2, sample)
        return pygame.mixer.Sound(buffer=bytes(data))

    def make_chime(self, notes, duration, descending=False):
        data = bytearray(int(self.SAMPLE_RATE * duration) * 2)
        note_length = duration / len(notes)
        for i in range(len(data) // 2):
            t = i / self.SAMPLE_RATE
            index = min(len(notes) - 1, int(t / note_length))
            local = t - index * note_length
            frequency = notes[index]
            env = min(1.0, local / 0.025) * max(0.0, 1.0 - local / note_length)
            sample = int(32767 * 0.22 * env * math.sin(2 * math.pi * frequency * t))
            struct.pack_into("<h", data, i * 2, sample)
        return pygame.mixer.Sound(buffer=bytes(data))

    def play(self, name):
        if self.enabled and name in self.sounds:
            self.sounds[name].play()

    def pop(self, boss=False):
        now = pygame.time.get_ticks()
        if now - self.last_pop >= 35:
            self.last_pop = now
            self.play("boss" if boss else "pop")



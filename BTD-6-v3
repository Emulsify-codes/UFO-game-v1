def burst(x, y, color):
    for _ in range(12):
        a, sp = random.uniform(0, math.tau), random.uniform(1.5, 4.5)
        MENU_FX.append([x, y, math.cos(a) * sp, math.sin(a) * sp - 1, random.randint(18, 32), color])


def update_menu_show():
    for t in MENU_TOWERS:
        if t.recoil > 0:
            t.recoil -= 1
        cands = [b for b in MENU_BALLOONS if 40 < b.y < t.y - 70 and abs(b.x - t.x) < 360]
        if not cands:
            t.angle += (-math.pi / 2 - t.angle) * 0.05
            continue
        tgt = min(cands, key=lambda b: math.dist((b.x, b.y), (t.x, t.y)))
        d = math.dist((tgt.x, tgt.y), (t.x, t.y))
        want = math.atan2(tgt.y - tgt.rise * d / 10 - t.y, tgt.x - t.x)  # lead the target
        diff = math.atan2(math.sin(want - t.angle), math.cos(want - t.angle))
        t.angle += diff * 0.15
        t.cooldown -= 1
        if t.cooldown <= 0:
            t.cooldown = random.randint(45, 75)
            t.recoil = 8
            MENU_DARTS.append([t.x, t.y, math.cos(want) * 10, math.sin(want) * 10, 70,
                               shade(t.base["color"], 1.5)])
    for d in MENU_DARTS:
        d[0] += d[2]
        d[1] += d[3]
        d[4] -= 1
        for b in MENU_BALLOONS:
            if math.dist((d[0], d[1]), (b.x, b.y)) < b.radius + 6:
                burst(b.x, b.y, TIER_COLORS[b.tier])
                respawn_menu_balloon(b)
                d[4] = 0
                break
    MENU_DARTS[:] = [d for d in MENU_DARTS if d[4] > 0]
    for p in MENU_FX:
        p[0] += p[2]
        p[1] += p[3]
        p[3] += 0.15
        p[4] -= 1
    MENU_FX[:] = [p for p in MENU_FX if p[4] > 0]



def blimp_key(r):
    """Which blimp arrives on wave r, if any. In Infinity mode the last one returns every 20 waves."""
    if r in BLIMPS:
        return r
    if r > 100 and (r - 100) % 20 == 0:
        return 100
    return None


def blimp_hp_scale(r):
    return 1 + 0.5 * ((r - 100) // 20) if r > 100 else 1.0


def next_blimp_wave(r, active, mode):
    """Wave number of the next blimp; the running wave counts while it is in progress."""
    start = r if active else r + 1
    if mode == "Normal":
        cands = [w for w in BLIMP_WAVES if w <= MAX_ROUND]
    else:
        cands = BLIMP_WAVES + [100 + 20 * k for k in range(1, 400)]
    return next((w for w in cands if w >= start), None)


class Balloon:
    def __init__(self, tier, dist=0.0, boss=False, hp=120, speed_mult=1.0, kind="normal"):
        self.tier = tier
        self.max_tier = tier
        self.dist = dist
        self.boss = boss
        self.kind = kind
        self.spec = BLIMPS.get(kind, BLIMPS[10]) if boss else None
        kspec = None if boss else KINDS.get(kind)
        self.armor = kspec["armor"] if kspec else 0
        self.regrow = kspec["regrow"] if kspec else 0
        self.regrow_t = 0
        self.hp = hp if boss else 0
        self.max_hp = self.hp
        self.speed_mult = speed_mult
        self.slow_timer = 0
        self.alive = True
        self.x, self.y = pos_at(dist)

    @property
    def speed(self):
        if self.boss:
            s = self.spec["speed"]
        elif self.kind in KINDS:
            s = KINDS[self.kind]["speed"]
        else:
            s = TIER_SPEED.get(self.tier, 3.0)
        return s * self.speed_mult * (0.45 if self.slow_timer > 0 else 1)

    @property
    def radius(self):
        if self.boss:
            return int(26 * self.spec["scale"])
        return 13 + (self.tier > 3)

    def update(self):
        self.dist += self.speed
        if self.slow_timer > 0:
            self.slow_timer -= 1
        if self.regrow and self.tier < self.max_tier:
            self.regrow_t += 1
            if self.regrow_t >= self.regrow:
                self.regrow_t = 0
                self.tier += 1
        self.x, self.y = pos_at(self.dist)

    def draw_blimp(self, surf, x, y):
        sp = self.spec
        lvl, sc = sp["level"], sp["scale"]
        t = TICK[0]
        r = self.radius
        f = 1 if pos_at(self.dist + 6)[0] >= self.x else -1  # facing direction
        body_c, dark, fin = sp["body"], sp["dark"], sp["fin"]
        L, hh = r * 1.9, r * 0.95
        pygame.draw.ellipse(surf, (60, 110, 60), (x - L * 0.8, y + r + 16, L * 1.6, 12))  # ground shadow
        fl = 14 + 4 * lvl
        for s in (-1, 1):  # tail fins
            pts = [(x - f * L * 0.75, y + s * hh * 0.55), (x - f * (L + fl), y + s * (hh + 12 + 2 * lvl)),
                   (x - f * (L + fl), y + s * 2)]
            pygame.draw.polygon(surf, fin, pts)
        body = pygame.Rect(int(x - L), int(y - hh), int(L * 2), int(hh * 2))
        pygame.draw.ellipse(surf, dark, body)
        pygame.draw.ellipse(surf, body_c, body.inflate(-4, -4))
        ks = (-0.6, -0.3, 0, 0.3, 0.6) if lvl >= 2 else (-0.45, 0, 0.45)
        for k in ks:  # stripes
            px = x + k * L
            half = hh * math.sqrt(1 - k * k) - 3
            pygame.draw.line(surf, shade(body_c, 0.75), (px, y - half), (px, y + half), 3)
        pygame.draw.ellipse(surf, shade(body_c, 1.35), pygame.Rect(int(x - L * 0.55), int(y - hh * 0.8),
                                                                      int(L * 0.8), int(hh * 0.5)))
        if lvl >= 1:  # armour plates along the top and bottom
            for k in (-0.55, -0.2, 0.2, 0.55):
                pw = 10 + 3 * lvl
                pygame.draw.rect(surf, shade(body_c, 0.55), (x + k * L - pw / 2, y - hh + 2, pw, 7), border_radius=2)
                pygame.draw.rect(surf, shade(body_c, 0.55), (x + k * L - pw / 2, y + hh - 9, pw, 7), border_radius=2)
        for i in range(lvl):  # gun turrets on the spine
            tx = x + (i - (lvl - 1) / 2) * (L * 1.3 / max(1, lvl))
            ty = y - hh - 2
            pygame.draw.circle(surf, dark, (int(tx), int(ty)), 6)
            pygame.draw.circle(surf, shade(body_c, 1.2), (int(tx), int(ty)), 3)
            ang = t * 0.03 + i
            pygame.draw.line(surf, (25, 25, 30), (tx, ty), (tx + math.cos(ang) * 11, ty - abs(math.sin(ang)) * 11), 3)
        gw = int(24 * (0.8 + sc * 0.2))
        pygame.draw.rect(surf, (70, 70, 80), (x - gw // 2, y + hh - 3, gw, 9), border_radius=3)  # gondola
        for j in range(1 + lvl // 2):  # portholes
            pygame.draw.circle(surf, (190, 220, 250), (int(x + f * (L * 0.6 - j * 10)), int(y - 2)), 4)
        n_props = 1 + lvl // 2
        for j in range(n_props):  # propellers
            py = y + (j - (n_props - 1) / 2) * 16
            px = x - f * (L + fl + 2)
            a = t * 0.5 + j
            pygame.draw.line(surf, (30, 30, 35), (px - math.cos(a) * 8, py - math.sin(a) * 8),
                             (px + math.cos(a) * 8, py + math.sin(a) * 8), 3)
        if lvl >= 5:  # Doomsday: glowing red eye
            pulse = 5 + int(2 * math.sin(t * 0.2))
            pygame.draw.circle(surf, (120, 10, 10), (int(x + f * L * 0.45), int(y - 4)), pulse + 3)
            pygame.draw.circle(surf, (255, 70, 40), (int(x + f * L * 0.45), int(y - 4)), pulse)
        w = int(70 * (0.8 + sc * 0.3))
        top = y - r - 18 - lvl * 2
        put_text = FONT.render(sp["name"], True, (255, 235, 200))
        surf.blit(put_text, (x - put_text.get_width() // 2, top - 18))
        pygame.draw.rect(surf, (70, 0, 0), (x - w // 2, top, w, 8), border_radius=4)
        pygame.draw.rect(surf, (60, 210, 70),
                         (x - w // 2, top, w * max(0, self.hp) / self.max_hp, 8), border_radius=4)
        pygame.draw.rect(surf, (20, 20, 20), (x - w // 2, top, w, 8), 1, border_radius=4)

    def draw(self, surf):
        x, y = int(self.x), int(self.y)
        if self.boss:
            self.draw_blimp(surf, x, y)
            return
        t = TICK[0]
        kspec = KINDS.get(self.kind)
        if self.kind == "rainbow":
            base = rainbow_color(t * 0.012 + self.dist * 0.004)
        elif kspec:
            base = kspec["color"]
        else:
            base = tier_color(self.tier)
        slowed = self.slow_timer > 0
        if slowed:
            base = blend(base, (190, 235, 255), 0.55)
        r = self.radius
        sway = math.sin(t * 0.12 + self.dist * 0.04) * 2.0
        cx = x + sway
        bw, bh = r * 1.75, r * 2.2
        top = y - r * 1.15
        bottom = top + bh
        if self.kind == "zippy":  # speed streaks trailing behind
            nx, ny = pos_at(self.dist + 6)
            dx, dy = nx - self.x, ny - self.y
            n = math.hypot(dx, dy) or 1.0
            ux, uy = dx / n, dy / n
            for k in (-7, 0, 7):
                sx, sy = x - ux * (r + 6) - uy * k, y - uy * (r + 6) + ux * k
                pygame.draw.line(surf, (255, 246, 170), (sx, sy), (sx - ux * 12, sy - uy * 12), 2)
        # wavy string
        pts = [(cx, bottom + 3)]
        for i in range(1, 4):
            pts.append((cx + math.sin(t * 0.15 + i + self.dist * 0.05) * 3, bottom + 3 + i * 6))
        pygame.draw.lines(surf, (215, 215, 215), False, pts, 1)
        # body: outline, shade, base colour, glossy highlight
        body = pygame.Rect(int(cx - bw / 2), int(top), int(bw), int(bh))
        pygame.draw.ellipse(surf, shade(base, 0.5), body)
        pygame.draw.ellipse(surf, shade(base, 0.82), body.inflate(-3, -3))
        pygame.draw.ellipse(surf, base, body.inflate(-7, -7).move(-1, -1))
        pygame.draw.ellipse(surf, shade(base, 1.3), pygame.Rect(int(cx - bw * 0.3), int(top + bh * 0.13),
                                                                int(bw * 0.34), int(bh * 0.34)))

def toggle_fullscreen():
    try:
        pygame.display.toggle_fullscreen()
        ui["fs"] = not ui["fs"]
    except pygame.error:
        pass


def start_game():
    set_map(ui["map"])
    game.reset(ui["mode"], ui["difficulty"])
    ui["shop_scroll"] = 0
    ui.update(screen="game", paused=False, name="", new=None)


def finish_run(save):
    if save:
        ui["last_name"] = ui["name"].strip()
        ui["new"] = add_score(ui["name"], game)
    else:
        ui["new"] = None
    ui["screen"] = "board"


def on_click(pos):
    SOUNDS.play("ui")
    s = ui["screen"]
    if s == "menu":
        if M_MODE_NORMAL.collidepoint(pos):
            ui["mode"] = "Normal"
        elif M_MODE_INFINITY.collidepoint(pos):
            ui["mode"] = "Infinity"
        elif M_DIFF_EASY.collidepoint(pos):
            ui["difficulty"] = "Easy"
        elif M_DIFF_NORMAL.collidepoint(pos):
            ui["difficulty"] = "Normal"
        elif M_DIFF_HARD.collidepoint(pos):
            ui["difficulty"] = "Hard"
        elif M_DIFF_NIGHTMARE.collidepoint(pos):
            ui["difficulty"] = "Nightmare"
        elif M_MAP_PREV.collidepoint(pos):
            current = MAP_NAMES.index(ui["map"])
            ui["map"] = MAP_NAMES[(current - 1) % len(MAP_NAMES)]
        elif M_MAP_NEXT.collidepoint(pos):
            current = MAP_NAMES.index(ui["map"])
            ui["map"] = MAP_NAMES[(current + 1) % len(MAP_NAMES)]
        elif M_MAP_NAME.collidepoint(pos):
            current = MAP_NAMES.index(ui["map"])
            ui["map"] = MAP_NAMES[(current + 1) % len(MAP_NAMES)]
        elif M_PLAY.collidepoint(pos):
            start_game()
        elif M_BOARD.collidepoint(pos):
            ui.update(screen="board", new=None)
        elif M_QUESTS.collidepoint(pos):
            ui.update(screen="quests", qpage=0)
        elif M_PETS.collidepoint(pos):
            ui.update(screen="pets", hatch=None)
        elif M_DAILY.collidepoint(pos):
            ui["screen"] = "daily"
        elif FS_RECT.collidepoint(pos):
            toggle_fullscreen()
        elif M_QUIT.collidepoint(pos):
            save_quests()
            pygame.quit()
            sys.exit()
    elif s == "daily":
        if B_BACK.collidepoint(pos):
            ui["screen"] = "menu"
    elif s == "pets":
        h = ui["hatch"]
        if h:
            if h["t"] < HATCH_FRAMES:
                h["t"] = HATCH_FRAMES  # skip the shaking
            elif h["t"] > HATCH_FRAMES + 20:
                ui["hatch"] = None
        elif B_BACK.collidepoint(pos):
            ui["screen"] = "menu"
        else:
            pages = max(1, (len(PETS) + PET_PER_PAGE - 1) // PET_PER_PAGE)
            if P_PREV.collidepoint(pos):
                ui["ppage"] = max(0, ui["ppage"] - 1)
                return
            if P_NEXT.collidepoint(pos):
                ui["ppage"] = min(pages - 1, ui["ppage"] + 1)
                return
            for e, btn in zip(EGGS, EGG_BTNS):
                if btn.collidepoint(pos):
                    res = hatch_egg(e["id"])
                    if res:
                        ui["hatch"] = dict(egg=e, pet=res[0], dup=res[1], refund=res[2], t=0)
                        SOUNDS.play("hatch")
                    break
            else:
                page_pets = PETS[ui["ppage"] * PET_PER_PAGE:(ui["ppage"] + 1) * PET_PER_PAGE]
                for p, card in zip(page_pets, PET_CARDS):
                    if card.collidepoint(pos):
                        equip_pet(p["id"])
    elif s == "quests":
        pages = max(1, (len(QUESTS) + Q_PER_PAGE - 1) // Q_PER_PAGE)
        if B_BACK.collidepoint(pos):
            ui["screen"] = "menu"
        elif Q_PREV.collidepoint(pos):
            ui["qpage"] = max(0, ui["qpage"] - 1)
        elif Q_NEXT.collidepoint(pos):
            ui["qpage"] = min(pages - 1, ui["qpage"] + 1)
    elif s == "board":
        if B_BACK.collidepoint(pos):
            ui["screen"] = "menu"
        elif B_PLAY.collidepoint(pos):
            start_game()
    elif s == "name":
        if SAVE_RECT.collidepoint(pos):
            finish_run(True)
        elif SKIP_RECT.collidepoint(pos):
            finish_run(False)
    elif ui["paused"]:
        if P_RESUME.collidepoint(pos):
            ui["paused"] = False
        elif P_END.collidepoint(pos):
            ui["paused"] = False
            if game.stats["waves"] == 0 and game.stats["placed"] == 0:
                ui["screen"] = "menu"  # nothing worth recording
            else:
                game.state = "over"
        elif P_MENU.collidepoint(pos):
            save_quests()
            ui.update(screen="menu", paused=False)
        elif P_FS.collidepoint(pos):
            toggle_fullscreen()
    else:
        handle_click(pos)


def on_key(key, ch=""):
    if key == pygame.K_F11:
        toggle_fullscreen()
        return
    s = ui["screen"]
    if s == "menu":
        if key in (pygame.K_RETURN, pygame.K_SPACE):
            start_game()
    elif s == "board":
        if key == pygame.K_ESCAPE:
            ui["screen"] = "menu"
        elif key == pygame.K_RETURN:
            start_game()
    elif s == "pets":
        if key == pygame.K_ESCAPE:
            if ui["hatch"]:
                if ui["hatch"]["t"] > HATCH_FRAMES:
                    ui["hatch"] = None
            else:
                ui["screen"] = "menu"
        elif key == pygame.K_LEFT:
            ui["ppage"] = max(0, ui["ppage"] - 1)
        elif key == pygame.K_RIGHT:
            pages = max(1, (len(PETS) + PET_PER_PAGE - 1) // PET_PER_PAGE)
            ui["ppage"] = min(pages - 1, ui["ppage"] + 1)
    elif s == "quests":
        pages = max(1, (len(QUESTS) + Q_PER_PAGE - 1) // Q_PER_PAGE)
        if key == pygame.K_ESCAPE:
            ui["screen"] = "menu"
        elif key == pygame.K_LEFT:
            ui["qpage"] = max(0, ui["qpage"] - 1)
        elif key == pygame.K_RIGHT:
            ui["qpage"] = min(pages - 1, ui["qpage"] + 1)
    elif s == "daily":
        if key == pygame.K_ESCAPE:
            ui["screen"] = "menu"
    elif s == "name":
        if key == pygame.K_RETURN:
            finish_run(True)
        elif key == pygame.K_ESCAPE:
            finish_run(False)
        elif key == pygame.K_BACKSPACE:
            ui["name"] = ui["name"][:-1]
        elif ch and ch.isprintable() and len(ui["name"]) < MAX_NAME:
            ui["name"] += ch
    elif ui["paused"]:
        if key in (pygame.K_ESCAPE, pygame.K_p):
            ui["paused"] = False
    elif key == pygame.K_SPACE:
        game.start_round()
    elif key == pygame.K_f:
        game.fast = not game.fast
        SOUNDS.play("fast")
    elif key == pygame.K_p:
        ui["paused"] = True
    elif key == pygame.K_ESCAPE:
        if game.selected_shop or game.selected_tower:
            game.selected_shop = None
            game.selected_tower = None
        else:
            ui["paused"] = True


def main(max_frames=None):
    frames = 0
    while True:
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                save_quests()
                pygame.quit()
                sys.exit()
            elif e.type == pygame.MOUSEBUTTONDOWN:
                if e.button == 1:
                    on_click(e.pos)
                elif e.button == 3 and ui["screen"] == "game" and not ui["paused"]:
                    game.selected_shop = None
            elif e.type == pygame.MOUSEWHEEL:
                if ui["screen"] == "game" and not ui["paused"] and not game.selected_tower:
                    mx, my = pygame.mouse.get_pos()
                    if SHOP_VIEW.collidepoint((mx, my)):
                        ui["shop_scroll"] -= e.y * 42
                        clamp_shop_scroll()
            elif e.type == pygame.KEYDOWN:
                on_key(e.key, getattr(e, "unicode", ""))
        if ui["screen"] == "game" and not ui["paused"]:
            previous_state = game.state
            for _ in range(3 if game.fast else 1):
                game.step()
            if previous_state == "play" and game.state == "win":
                SOUNDS.play("win")
            elif previous_state == "play" and game.state == "over":
                SOUNDS.play("lose")
            quests_tick(game)
            if game.state != "play":
                quests_finish(game)
                ui.update(screen="name", name=ui["last_name"])
        TICK[0] += 1
        draw_screen()
        pygame.display.flip()
        clock.tick(60)
        frames += 1
        if max_frames and frames >= max_frames:
            return


if __name__ == "__main__":
    main()

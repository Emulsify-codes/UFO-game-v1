def draw_hatch(h):
    """Full-screen overlay: the egg shakes, cracks, then reveals the pet."""
    h["t"] += 1
    t = h["t"]
    dim = pygame.Surface((W, H), pygame.SRCALPHA)
    dim.fill((8, 10, 20, 225))
    screen.blit(dim, (0, 0))
    e, pet = h["egg"], h["pet"]
    rc = RARITY_COLORS[pet["rarity"]]
    if t < HATCH_FRAMES:
        f = t / HATCH_FRAMES
        draw_egg(W // 2, 330, e, 2.6, shake=2 + 14 * f)
        for i in range(int(f * 6)):  # growing cracks
            x = W // 2 + (i - 2.5) * 22
            pygame.draw.line(screen, (60, 40, 30), (x, 300 + i * 6 % 40), (x + 10, 322 + i * 9 % 50), 3)
        put(HEAD, "Hatching...", WHITE, (W // 2, 150), "center")
        put(SMALL, "Click to skip", (150, 160, 185), (W // 2, 560), "center")
        return
    n = t - HATCH_FRAMES
    if n < 14:  # white flash
        fl = pygame.Surface((W, H), pygame.SRCALPHA)
        fl.fill((255, 255, 255, int(255 * (1 - n / 14))))
        screen.blit(fl, (0, 0))
    for i in range(14):  # rays in the rarity colour
        a = TICK[0] * 0.02 + i * math.tau / 14
        pygame.draw.line(screen, shade(rc, 0.7), (W // 2 + math.cos(a) * 120, 320 + math.sin(a) * 120),
                         (W // 2 + math.cos(a) * 250, 320 + math.sin(a) * 250), 6)
    pygame.draw.circle(screen, shade(rc, 0.45), (W // 2, 320), 112)
    pygame.draw.circle(screen, rc, (W // 2, 320), 112, 4)
    draw_pet(W // 2, 330 + math.sin(TICK[0] * 0.1) * 5, pet, 3.0)
    put(HEAD, "NEW PET!" if not h["dup"] else "DUPLICATE", (255, 230, 120) if not h["dup"] else (200, 210, 230),
        (W // 2, 120), "center")
    put(HEAD, f"{pet['name']} the {pet['kind']}", WHITE, (W // 2, 478), "center")
    put(MED, pet["rarity"], rc, (W // 2, 516), "center")
    put(FONT, "   ".join(perk_lines(pet)), (205, 215, 235), (W // 2, 548), "center")
    if h["dup"]:
        draw_shard(W // 2 - 80, 590, 0.9)
        put(MED, f"+{h['refund']} Echo Shards back", (170, 235, 245), (W // 2 - 58, 590), "midleft")
    else:
        put(SMALL, "Click to continue", (150, 160, 185), (W // 2, 590), "center")



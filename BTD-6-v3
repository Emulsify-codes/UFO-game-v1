# ---- path helpers ---------------------------------------------------------
SEG = []
TOTAL = 0.0


def build_segments(waypoints):
    segments = []
    total = 0.0
    for a, b in zip(waypoints, waypoints[1:]):
        length = math.dist(a, b)
        segments.append((total, length, a, b))
        total += length
    return segments, total


SEG, TOTAL = build_segments(WAYPOINTS)


def pos_at(d):
    if d >= TOTAL:
        return WAYPOINTS[-1]
    for start, length, a, b in SEG:
        if d <= start + length:
            t = (d - start) / length
            return a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t
    return WAYPOINTS[-1]


def dist_to_path(p):
    best = 1e9
    for _, _, a, b in SEG:
        ax, ay = a
        bx, by = b
        dx, dy = bx - ax, by - ay
        t = max(0, min(1, ((p[0] - ax) * dx + (p[1] - ay) * dy) / (dx * dx + dy * dy)))
        best = min(best, math.dist(p, (ax + dx * t, ay + dy * t)))
    return best



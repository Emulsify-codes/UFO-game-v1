def quest_progress(q):
    """(current, target) for display; current never exceeds target."""
    if q["kind"] == "total":
        cur, tgt = QSTATE["totals"].get(q["stat"], 0), q["target"]
    elif q["kind"] == "run":
        cur, tgt = QSTATE["best"]["inf_waves" if q.get("mode") == "Infinity" else "waves"], q["target"]
    else:
        cur, tgt = (1 if q["id"] in QSTATE["done"] else 0), 1
    return min(cur, tgt), tgt


def _quest_met(q, g):
    if q["kind"] == "total":
        return QSTATE["totals"].get(q["stat"], 0) >= q["target"]
    if q["kind"] == "run":
        return g.stats[q["stat"]] >= q["target"] and q.get("mode", g.mode) == g.mode
    return (g.state == "win" and q.get("mode", g.mode) == g.mode
            and g.difficulty in q.get("diffs", tuple(DIFFICULTIES)))


def quests_check(g):
    """Award every quest that is now complete (called each frame and at the end of a run)."""
    for q in QUESTS:
        if q["id"] in QSTATE["done"] or not _quest_met(q, g):
            continue
        QSTATE["done"].append(q["id"])
        multiplier = 2 if QSTATE["daily"]["completed"] and QSTATE["daily"]["double_shards"] else 1
        reward = q["reward"] * multiplier
        QSTATE["shards"] += reward
        QSTATE["dirty"] = True
        g.q_earned += reward
        g.notices.append([f"QUEST COMPLETE: {q['name']}   +{reward} Echo Shards", 480])
        save_quests()


def daily_progress(g):
    challenge = daily_for_date()
    stat = challenge["stat"]
    if stat == "win":
        return 1 if g.state == "win" and g.mode == "Normal" else 0
    return g.stats.get(stat, 0)


def daily_check(g):
    """Complete today's challenge once and activate the 2x Echo Shard bonus for the day."""
    if QSTATE["daily"]["date"] != DAILY_DATE:
        QSTATE["daily"] = {"date": DAILY_DATE, "progress": 0, "completed": False,
                           "double_shards": False}
    if QSTATE["daily"]["completed"]:
        return
    challenge = daily_for_date()
    progress = daily_progress(g)
    QSTATE["daily"]["progress"] = max(QSTATE["daily"]["progress"], progress)
    if progress >= challenge["target"]:
        reward = challenge["reward"]
        QSTATE["daily"]["completed"] = True
        QSTATE["daily"]["double_shards"] = True
        QSTATE["daily"]["progress"] = challenge["target"]
        QSTATE["shards"] += reward
        g.q_earned += reward
        g.notices.append([f"DAILY COMPLETE: {challenge['name']}   +{reward} Echo Shards",
                          480])
        g.notices.append(["BONUS ACTIVE: 2x Echo Shards for the rest of today", 600])
        QSTATE["dirty"] = True
        save_quests(force=True)


def quests_tick(g):
    """Fold this frame's run stats into the lifetime totals, then check for finished quests."""
    for k, v in g.stats.items():
        d = v - g.q_seen.get(k, 0)
        if d > 0 and k in QSTATE["totals"]:
            QSTATE["totals"][k] += d
            QSTATE["dirty"] = True
        g.q_seen[k] = v
    w = g.stats["waves"]
    if w > QSTATE["best"]["waves"]:
        QSTATE["best"]["waves"] = w
        QSTATE["dirty"] = True
    if g.mode == "Infinity" and w > QSTATE["best"]["inf_waves"]:
        QSTATE["best"]["inf_waves"] = w
        QSTATE["dirty"] = True
    quests_check(g)
    daily_check(g)
    if QSTATE["dirty"] and TICK[0] % 300 == 0:
        save_quests()


def quests_finish(g):
    """Once per run, when it ends: count the run (and a win), then settle quests and save."""
    if g.q_finished:
        return
    g.q_finished = True
    if g.stats["waves"] > 0 or g.stats["placed"] > 0:
        QSTATE["totals"]["runs"] += 1
        if g.state == "win":
            QSTATE["totals"]["wins"] += 1
        QSTATE["dirty"] = True
    quests_tick(g)
    save_quests(force=True)


class Game:
    def __init__(self):
        self.reset()

    def reset(self, mode="Normal", difficulty="Normal"):
        self.balloons, self.projectiles, self.towers, self.effects = [], [], [], []
        self.map_name = ACTIVE_MAP
        self.mode = mode if mode in GAME_MODES else "Normal"
        self.difficulty = difficulty if difficulty in DIFFICULTIES else "Normal"
        config = DIFFICULTIES[self.difficulty]
        self.money, self.lives, self.round = config["money"], config["lives"], 0
        self.queue, self.frame = [], 0
        self.round_active = False
        self.selected_shop = None
        self.selected_tower = None
        self.fast = False
        self.state = "play"  # play / over / win
        # run statistics shown on the end screen and saved to the leaderboard
        self.stats = dict(waves=0, damage=0, popped=0, placed=0, upgrades=0, bosses=0)
        self.notices = []  # [text, frames_left] banners such as "NEW BALLOON: Lead"
        self.q_seen = {k: 0 for k in self.stats}  # stats already counted towards quests
        self.q_earned = 0  # Echo Shards earned during this run
        self.q_finished = False
        self.pet = pet_by_id(QSTATE.get("equipped"))  # equipped pet (or None) for this run
        perks = self.pet["perks"] if self.pet else {}
        self.money += perks.get("start", 0)
        self.lives += perks.get("lives", 0)

    def perk(self, key):
        return self.pet["perks"].get(key, 0) if self.pet else 0

    def hit_cash(self):
        """Cash for a hit: $1, plus a chance of a bonus $1 from the pet's cash perk."""
        self.money += 1
        if self.pet and random.random() * 100 < self.perk("pop"):
            self.money += 1

    def damage(self, b, dmg, bm=1):
        if not b.alive:
            return
        if self.pet and not b.boss and random.random() * 100 < self.perk("dmg"):
            dmg += 1  # pet damage boost: a chance to pop one extra layer
        if b.boss:
            bm = bm * (1 + (self.perk("dmg") + self.perk("boss")) / 100)
            dealt = dmg * bm
            self.stats["damage"] += int(max(0, min(b.hp, dealt)))
            b.hp -= dealt
            self.hit_cash()
            if b.hp <= 0:
                b.alive = False
                self.money += b.spec["reward"]
                self.stats["bosses"] += 1
                self.stats["popped"] += 1
                SOUNDS.pop(boss=True)
                layers, count, kind = b.spec["kids"]
                for i in range(count):
                    self.balloons.append(Balloon(layers, max(0, b.dist - i * 14),
                                                 speed_mult=b.speed_mult, kind=kind))
            return
        if dmg < b.armor:  # armoured balloons ignore weak hits
            if len(self.effects) < 150:
                self.effects.append(["clink", b.x, b.y, 8])
            SOUNDS.play("clink")
            return
        self.stats["damage"] += min(dmg, b.tier)
        b.tier -= dmg
        self.hit_cash()
        if b.tier <= 0:
            b.alive = False
            self.stats["popped"] += 1
            SOUNDS.pop()
            if b.kind == "split":
                for i in range(2):
                    self.balloons.append(Balloon(2, max(0, b.dist - i * 10), speed_mult=b.speed_mult))
        else:
            b.x, b.y = pos_at(b.dist)

    def start_round(self):
        if self.round_active or self.state != "play":
            return
        self.round += 1
        SOUNDS.play("round")
        for k, spec in KINDS.items():
            if spec["first"] == self.round:
                self.notices.append([f"NEW BALLOON: {spec['name']} - {spec['note']}", 420])
        key = blimp_key(self.round)
        if key:
            self.notices.append([f"BLIMP INCOMING: {BLIMPS[key]['name']}", 420])
        self.queue = make_round(self.round)
        self.frame = 0
        self.round_active = True

    def step(self):
        if self.state != "play":
            return
        if self.round_active:
            while self.queue and self.queue[0][0] <= self.frame:
                _, tier, boss, kind = self.queue.pop(0)
                cfg = DIFFICULTIES[self.difficulty]
                hp = 0
                if boss:
                    hp = int(BLIMPS[kind]["hp"] * cfg["hp"] * blimp_hp_scale(self.round))
                self.balloons.append(Balloon(tier, 0, boss, hp, cfg["speed"], kind))
            self.frame += 1
        for t in self.towers:
            t.update(self)
        for p in self.projectiles:
            p.update(self)
        for b in self.balloons:
            if b.alive:
                b.update()
                if b.dist >= TOTAL:
                    b.alive = False
                    leak = (b.spec["leak"] if b.boss else b.tier) * DIFFICULTIES[self.difficulty]["leak"]
                    self.lives -= max(1, int(leak))
                    SOUNDS.play("leak")
        self.balloons = [b for b in self.balloons if b.alive]
        self.projectiles = [p for p in self.projectiles if p.alive]
        for n in self.notices:
            n[1] -= 1
        self.notices = [n for n in self.notices if n[1] > 0]
        if self.lives <= 0:
            self.state = "over"
        if self.round_active and not self.queue and not self.balloons:
            self.round_active = False
            self.stats["waves"] = self.round
            self.money += 100 + self.round * 5 + sum(t.stats["income"] for t in self.towers) + self.perk("wave")
            self.money += sum(min(int(self.money * t.stats.get("interest", 0) / 100), 400)
                              for t in self.towers)
            if self.mode == "Normal" and self.round >= MAX_ROUND:
                self.state = "win"

    def buff_for(self, tower):
        """Fire-rate multiplier (lower = faster) from nearby Trading Post support auras."""
        mult = 1.0
        for o in self.towers:
            aura = o.stats.get("aura", 0)
            if o is not tower and aura and math.dist((o.x, o.y), (tower.x, tower.y)) <= o.stats["range"]:
                mult *= 1 - aura / 100
        return max(0.4, mult * (1 - self.perk("rate") / 100))

    def can_place(self, p):
        if p[0] > MAP_W - 20 or p[0] < 20 or p[1] < 20 or p[1] > H - 20:
            return False
        if dist_to_path(p) < PATH_WIDTH / 2 + 18:
            return False
        return all(math.dist(p, (t.x, t.y)) > 40 for t in self.towers)



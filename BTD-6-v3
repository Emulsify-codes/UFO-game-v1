def hatch_egg(eid):
    """Buy an egg and hatch it. Returns (pet, is_duplicate, refund) or None if you can't afford it.
    A duplicate pays back some shards; a first pet is equipped if you have none equipped."""
    e = egg_by_id(eid)
    if not e or QSTATE["shards"] < e["cost"]:
        return None
    QSTATE["shards"] -= e["cost"]
    rarity = random.choices(RARITIES, weights=e["odds"])[0]
    pet = random.choice([p for p in PETS if p["rarity"] == rarity])
    dup = pet["id"] in QSTATE["pets"]
    refund = DUP_REFUND[rarity] if dup else 0
    QSTATE["shards"] += refund
    if not dup:
        QSTATE["pets"].append(pet["id"])
        if not QSTATE.get("equipped"):
            QSTATE["equipped"] = pet["id"]
    save_quests(force=True)
    return pet, dup, refund



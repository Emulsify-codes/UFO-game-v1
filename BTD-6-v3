def make_round(r):
    """Spawn list of (frame, layers, is_blimp, kind). kind is a KINDS key, "normal", or a BLIMPS key."""
    over = max(0, r - 40)
    mult = min(2.0, 1 + 0.025 * over)  # waves past 40 (Infinity) keep getting bigger, up to 2x
    groups = []  # (layers, kind, count, gap)
    for tier in range(1, 7):
        start = (tier - 1) * 4 + 1
        if r >= start:
            n = 8 + 2 * (r - start)
            if r > start + 6:
                n //= 3
            groups.append((tier, "normal", min(int(min(n, 45) * mult), 120), max(8, 30 - tier * 3)))
    # special balloons mix into the wave once their first wave arrives
    if r >= KINDS["zippy"]["first"]:
        groups.append((1 + min(2, r // 15), "zippy", min(int((5 + r // 3) * mult), 40), 7))
    if r >= KINDS["lead"]["first"]:
        groups.append((2 + r // 25, "lead", min(int((4 + (r - 12) // 2) * mult), 30), 16))
    if r >= KINDS["regrow"]["first"]:
        groups.append((2 + min(3, (r - 16) // 10), "regrow", min(int((4 + (r - 16) // 2) * mult), 26), 14))
    if r >= KINDS["split"]["first"]:
        groups.append((2, "split", min(int((4 + (r - 22) // 2) * mult), 24), 14))
    if r >= KINDS["rainbow"]["first"]:
        groups.append((min(7, 4 + (r - 30) // 5), "rainbow", min(int((3 + (r - 30) // 2) * mult), 20), 12))
    queue = []
    t = 0
    for tier, kind, n, gap in groups:
        for _ in range(n):
            queue.append((t, tier, False, kind))
            t += gap
        t += 40
    key = blimp_key(r)
    if key:
        queue.append((t, 1, True, key))
    return queue



        if ui["paused"]:
            draw_pause()


def toggle_fullscreen():
    try:
        pygame.display.toggle_fullscreen()
        ui["fs"] = not ui["fs"]
    except pygame.error:
        pass


def start_game():
    game.reset(ui["mode"], ui["difficulty"])
    ui["shop_scroll"] = 0
    ui.update(screen="game", paused=False, name="", new=None)


def finish_run(save):
    if save:
        ui["last_name"] = ui["name"].strip()
        ui["new"] = add_score(ui["name"], game)
    else:
        ui["new"] = None
    ui["screen"] = "board"


def on_click(pos):
    s = ui["screen"]
    if s == "menu":
        if M_MODE_NORMAL.collidepoint(pos):
            ui["mode"] = "Normal"
        elif M_MODE_INFINITY.collidepoint(pos):
            ui["mode"] = "Infinity"
        elif M_DIFF_EASY.collidepoint(pos):
            ui["difficulty"] = "Easy"
        elif M_DIFF_NORMAL.collidepoint(pos):
            ui["difficulty"] = "Normal"
        elif M_DIFF_HARD.collidepoint(pos):
            ui["difficulty"] = "Hard"
        elif M_DIFF_NIGHTMARE.collidepoint(pos):
            ui["difficulty"] = "Nightmare"
        elif M_PLAY.collidepoint(pos):
            start_game()
        elif M_BOARD.collidepoint(pos):
            ui.update(screen="board", new=None)
        elif FS_RECT.collidepoint(pos):
            toggle_fullscreen()
        elif M_QUIT.collidepoint(pos):
            pygame.quit()
            sys.exit()
    elif s == "board":
        if B_BACK.collidepoint(pos):
            ui["screen"] = "menu"
        elif B_PLAY.collidepoint(pos):
            start_game()
    elif s == "name":
        if SAVE_RECT.collidepoint(pos):
            finish_run(True)
        elif SKIP_RECT.collidepoint(pos):
            finish_run(False)
    elif ui["paused"]:
        if P_RESUME.collidepoint(pos):
            ui["paused"] = False
        elif P_END.collidepoint(pos):
            ui["paused"] = False
            if game.stats["waves"] == 0 and game.stats["placed"] == 0:
                ui["screen"] = "menu"  # nothing worth recording
            else:
                game.state = "over"
        elif P_MENU.collidepoint(pos):
            ui.update(screen="menu", paused=False)
        elif P_FS.collidepoint(pos):
            toggle_fullscreen()
    else:
        handle_click(pos)


def on_key(key, ch=""):
    if key == pygame.K_F11:
        toggle_fullscreen()
        return
    s = ui["screen"]
    if s == "menu":
        if key in (pygame.K_RETURN, pygame.K_SPACE):
            start_game()
    elif s == "board":
        if key == pygame.K_ESCAPE:
            ui["screen"] = "menu"
        elif key == pygame.K_RETURN:
            start_game()
    elif s == "name":
        if key == pygame.K_RETURN:
            finish_run(True)
        elif key == pygame.K_ESCAPE:
            finish_run(False)
        elif key == pygame.K_BACKSPACE:
            ui["name"] = ui["name"][:-1]
        elif ch and ch.isprintable() and len(ui["name"]) < MAX_NAME:
            ui["name"] += ch
    elif ui["paused"]:
        if key in (pygame.K_ESCAPE, pygame.K_p):
            ui["paused"] = False
    elif key == pygame.K_SPACE:
        game.start_round()
    elif key == pygame.K_f:
        game.fast = not game.fast
    elif key == pygame.K_p:
        ui["paused"] = True
    elif key == pygame.K_ESCAPE:
        if game.selected_shop or game.selected_tower:
            game.selected_shop = None
            game.selected_tower = None
        else:
            ui["paused"] = True


def main(max_frames=None):
    frames = 0
    while True:
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            elif e.type == pygame.MOUSEBUTTONDOWN:
                if e.button == 1:
                    on_click(e.pos)
                elif e.button == 3 and ui["screen"] == "game" and not ui["paused"]:
                    game.selected_shop = None
            elif e.type == pygame.MOUSEWHEEL:
                if ui["screen"] == "game" and not ui["paused"] and not game.selected_tower:
                    mx, my = pygame.mouse.get_pos()
                    if SHOP_VIEW.collidepoint((mx, my)):
                        ui["shop_scroll"] -= e.y * 42
                        clamp_shop_scroll()
            elif e.type == pygame.KEYDOWN:
                on_key(e.key, getattr(e, "unicode", ""))
        if ui["screen"] == "game" and not ui["paused"]:
            for _ in range(3 if game.fast else 1):
                game.step()
            if game.state != "play":
                ui.update(screen="name", name=ui["last_name"])
        TICK[0] += 1
        draw_screen()
        pygame.display.flip()
        clock.tick(60)
        frames += 1
        if max_frames and frames >= max_frames:
            return


if __name__ == "__main__":
    main()

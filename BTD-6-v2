SCORE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "leaderboard.json")
MAX_SCORES = 50
MAX_NAME = 12


def score_key(e):
    return (-e["waves"], -e["damage"], -e["popped"])


def load_scores(path=None):
    """Read the leaderboard; a missing or damaged file just means an empty board."""
    try:
        with open(path or SCORE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        out = []
        for d in data:
            out.append(dict(
                name=str(d.get("name", "Player"))[:MAX_NAME],
                waves=int(d.get("waves", 0)), damage=int(d.get("damage", 0)),
                popped=int(d.get("popped", 0)), towers=int(d.get("towers", 0)),
                upgrades=int(d.get("upgrades", 0)), bosses=int(d.get("bosses", 0)),
                mode=str(d.get("mode", "Normal")), difficulty=str(d.get("difficulty", "Normal")),
                result=str(d.get("result", "Defeated")), date=str(d.get("date", ""))))
        out.sort(key=score_key)
        return out[:MAX_SCORES]
    except (OSError, ValueError, TypeError, AttributeError):
        return []


def save_scores(scores, path=None):
    target = path or SCORE_FILE
    try:
        tmp = target + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(scores, f, indent=2)
        os.replace(tmp, target)
        return True
    except OSError:
        return False


SCORES = load_scores()


def add_score(name, g, path=None):
    s = g.stats
    entry = dict(name=(name.strip() or "Player")[:MAX_NAME], waves=s["waves"], damage=s["damage"],
                 popped=s["popped"], towers=s["placed"], upgrades=s["upgrades"], bosses=s["bosses"],
                 mode=g.mode, difficulty=g.difficulty,
                 result="Victory" if g.state == "win" else "Defeated", date=time.strftime("%Y-%m-%d"))
    SCORES.append(entry)
    SCORES.sort(key=score_key)
    del SCORES[MAX_SCORES:]
    save_scores(SCORES, path)
    return entry



def handle_click(pos):
    if game.state != "play":
        return
    if pos[0] < MAP_W:
        if game.selected_shop:
            cost = TOWER_TYPES[game.selected_shop]["cost"]
            if game.money >= cost and game.can_place(pos):
                game.towers.append(Tower(game.selected_shop, *pos))
                game.money -= cost
                game.stats["placed"] += 1
                if not pygame.key.get_mods() & pygame.KMOD_SHIFT:
                    game.selected_shop = None
            return
        game.selected_tower = None
        for t in game.towers:
            if math.dist(pos, (t.x, t.y)) < 20:
                game.selected_tower = t
        return
    if not game.selected_tower:
        clamp_shop_scroll()
        for name in TOWER_TYPES:
            rect = shop_rect(name)
            if not SHOP_VIEW.collidepoint(pos) or not rect.collidepoint(pos):
                continue
            if rect.collidepoint(pos):
                game.selected_shop = None if game.selected_shop == name else name
                return
    t = game.selected_tower
    if t:
        if BACK_RECT.collidepoint(pos):
            game.selected_tower = None
            return
        for i, rect in enumerate(UPG_RECTS):
            if rect.collidepoint(pos):
                up, reason = t.upgrade_status(i)
                if up and not reason and game.money >= up[0]:
                    if t.upgrade(i):
                        game.money -= up[0]
                        game.stats["upgrades"] += 1
                return
        if MODE_RECT.collidepoint(pos) and t.kind not in NO_TARGET:
            t.mode = (t.mode + 1) % 3
        elif SELL_RECT.collidepoint(pos):
            game.money += int(t.spent * 0.7)
            game.towers.remove(t)
            game.selected_tower = None
    if START_RECT.collidepoint(pos):
        game.start_round()
    if FAST_RECT.collidepoint(pos):
        game.fast = not game.fast


